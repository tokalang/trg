pub shape ViewLineRecord (
    line_number: usize,
    kind: string,
    text: string
)

pub shape SymbolTargetInfo (
    name: string,
    kind: string,
    line: usize,
    range_start: usize,
    range_end: Option<usize>,
    range_status: string,
    scope: string,
    detail: string
)

impl SymbolTargetInfo {
    pub fn clone(self) -> SymbolTargetInfo {
        return SymbolTargetInfo(
            name = string::from(self.name.as_str()),
            kind = string::from(self.kind.as_str()),
            line = self.line,
            range_start = self.range_start,
            range_end = self.range_end,
            range_status = string::from(self.range_status.as_str()),
            scope = string::from(self.scope.as_str()),
            detail = string::from(self.detail.as_str())
        )
    }
}

pub shape SymbolCandidateInfo (
    name: string,
    kind: string,
    line: usize,
    range_start: usize,
    range_end: Option<usize>,
    range_status: string,
    scope: string,
    detail: string
)

impl SymbolCandidateInfo {
    pub fn clone(self) -> SymbolCandidateInfo {
        return SymbolCandidateInfo(
            name = string::from(self.name.as_str()),
            kind = string::from(self.kind.as_str()),
            line = self.line,
            range_start = self.range_start,
            range_end = self.range_end,
            range_status = string::from(self.range_status.as_str()),
            scope = string::from(self.scope.as_str()),
            detail = string::from(self.detail.as_str())
        )
    }
}

pub shape ViewOptions (
    file_path: string,
    line: Option<usize>,
    context: usize,
    block: bool,
    lines_range: Option<BlockRange>,
    symbol: Option<string>,
    symbol_scope: Option<string>,
    max_lines: Option<usize>,
    max_result_bytes: Option<usize>,
    max_columns: Option<usize>,
    max_block_lines: usize
)

pub shape ViewResult (
    text: string,
    truncated: bool,
    reason: string,
    lines_emitted: usize,
    bytes_emitted: usize,
    mode: string,
    path: string,
    requested_line: Option<usize>,
    requested_range: Option<BlockRange>,
    detected_block_range: Option<BlockRange>,
    emitted_range: Option<BlockRange>,
    target_included: Option<bool>,
    content_omitted: bool,
    complete: bool,
    eof_reached: bool,
    records: Vec<ViewLineRecord>,
    selection_status: string,
    range_status: Option<string>,
    output_status: string,
    target_symbol: Vec<SymbolTargetInfo>,
    candidates: Vec<SymbolCandidateInfo>,
    candidates_truncated: bool
)

pub fn format_view_line_record_json(line_number: usize, kind: str, text: str) -> string {
    auto item# = string::from("{\"line_number\":")
    item#.push_str(u64_to_string(line_number as u64).as_str())
    item#.push_str(",\"kind\":\"")
    item#.push_str(kind)
    item#.push_str("\",\"text\":\"")
    item#.push_str(json_escape(text).as_str())
    item#.push_str("\"}")
    return cede item
}

impl ViewResult {
    pub fn format_structured(self) -> string {
        auto resp# = string::from("{\"schema\":\"trg-mcp-view-result-v1\",\"mode\":\"")
        resp#.push_str(self.mode.as_str())
        resp#.push_str("\",\"path\":\"")
        resp#.push_str(json_escape(self.path.as_str()).as_str())
        resp#.push_str("\",\"requested_line\":")
        match self.requested_line {
            auto Option<usize>::Some(l) => {
                resp#.push_str(u64_to_string(l as u64).as_str())
            }
            auto Option<usize>::None => {
                resp#.push_str("null")
            }
        }
        resp#.push_str(",\"requested_range\":")
        match self.requested_range {
            auto Option<BlockRange>::Some(rr) => {
                resp#.push_str("[")
                resp#.push_str(u64_to_string(rr.start as u64).as_str())
                resp#.push_str(",")
                resp#.push_str(u64_to_string(rr.end as u64).as_str())
                resp#.push_str("]")
            }
            auto Option<BlockRange>::None => {
                resp#.push_str("null")
            }
        }
        resp#.push_str(",\"detected_block_range\":")
        match self.detected_block_range {
            auto Option<BlockRange>::Some(dbr) => {
                resp#.push_str("[")
                resp#.push_str(u64_to_string(dbr.start as u64).as_str())
                resp#.push_str(",")
                resp#.push_str(u64_to_string(dbr.end as u64).as_str())
                resp#.push_str("]")
            }
            auto Option<BlockRange>::None => {
                resp#.push_str("null")
            }
        }
        resp#.push_str(",\"emitted_range\":")
        match self.emitted_range {
            auto Option<BlockRange>::Some(er) => {
                resp#.push_str("[")
                resp#.push_str(u64_to_string(er.start as u64).as_str())
                resp#.push_str(",")
                resp#.push_str(u64_to_string(er.end as u64).as_str())
                resp#.push_str("]")
            }
            auto Option<BlockRange>::None => {
                resp#.push_str("null")
            }
        }
        resp#.push_str(",\"target_included\":")
        match self.target_included {
            auto Option<bool>::Some(ti) => {
                if ti {
                    resp#.push_str("true")
                } else {
                    resp#.push_str("false")
                }
            }
            auto Option<bool>::None => {
                resp#.push_str("null")
            }
        }
        resp#.push_str(",\"content_omitted\":")
        if self.content_omitted {
            resp#.push_str("true")
        } else {
            resp#.push_str("false")
        }
        resp#.push_str(",\"complete\":")
        if self.complete {
            resp#.push_str("true")
        } else {
            resp#.push_str("false")
        }
        resp#.push_str(",\"eof_reached\":")
        if self.eof_reached {
            resp#.push_str("true")
        } else {
            resp#.push_str("false")
        }
        resp#.push_str(",\"truncated\":")
        if self.truncated {
            resp#.push_str("true")
        } else {
            resp#.push_str("false")
        }
        resp#.push_str(",\"termination_reason\":\"")
        resp#.push_str(self.reason.as_str())
        resp#.push_str("\",\"lines_emitted\":")
        resp#.push_str(u64_to_string(self.lines_emitted as u64).as_str())
        resp#.push_str(",\"content_bytes_emitted\":")
        resp#.push_str(u64_to_string(self.bytes_emitted as u64).as_str())
        resp#.push_str(",\"records\":[")
        auto r_i# = 0:usize
        auto r_len = self.records.len()
        loop r_i < r_len {
            auto &r = self.records.borrow(r_i)
            if r_i > 0:usize {
                resp#.push_str(",")
            }
            auto r_json = format_view_line_record_json(r.line_number, r.kind.as_str(), r.text.as_str())
            resp#.push_str(r_json.as_str())
            r_i = r_i + 1:usize
        }
        resp#.push_str("]")
        if self.mode == "symbol" {
            auto sym_suffix = self.format_symbol_suffix_str(self.truncated)
            resp#.push_str(sym_suffix.as_str())
        }
        resp#.push_str("}")
        return cede resp
    }

    pub fn format_symbol_suffix_str(self, is_pruned: bool) -> string {
        auto resp# = string::from(",\"selection_status\":\"")
        resp#.push_str(self.selection_status.as_str())
        resp#.push_str("\",\"range_status\":")
        match self.range_status {
            auto Option<string>::Some(&rs) => {
                resp#.push_str("\"")
                resp#.push_str(rs.as_str())
                resp#.push_str("\"")
            }
            auto Option<string>::None => {
                resp#.push_str("null")
            }
        }
        resp#.push_str(",\"output_status\":\"")
        if is_pruned {
            resp#.push_str("budget_truncated")
        } else {
            resp#.push_str(self.output_status.as_str())
        }
        resp#.push_str("\",\"symbol\":")
        if self.target_symbol.len() > 0:usize {
            auto &sym = self.target_symbol.borrow(0)
            resp#.push_str("{\"name\":\"")
            resp#.push_str(json_escape(sym.name.as_str()).as_str())
            resp#.push_str("\",\"kind\":\"")
            resp#.push_str(sym.kind.as_str())
            resp#.push_str("\",\"line\":")
            resp#.push_str(u64_to_string(sym.line as u64).as_str())
            resp#.push_str(",\"range_start\":")
            resp#.push_str(u64_to_string(sym.range_start as u64).as_str())
            resp#.push_str(",\"range_end\":")
            match sym.range_end {
                auto Option<usize>::Some(re) => {
                    resp#.push_str(u64_to_string(re as u64).as_str())
                }
                auto Option<usize>::None => {
                    resp#.push_str("null")
                }
            }
            resp#.push_str(",\"range_status\":\"")
            resp#.push_str(sym.range_status.as_str())
            resp#.push_str("\",\"scope\":\"")
            resp#.push_str(json_escape(sym.scope.as_str()).as_str())
            resp#.push_str("\",\"detail\":\"")
            resp#.push_str(json_escape(sym.detail.as_str()).as_str())
            resp#.push_str("\"}")
        } else {
            resp#.push_str("null")
        }
        resp#.push_str(",\"candidates\":[")
        auto ci# = 0:usize
        loop ci < self.candidates.len() {
            if ci > 0:usize {
                resp#.push_str(",")
            }
            auto &c = self.candidates.borrow(ci)
            resp#.push_str("{\"name\":\"")
            resp#.push_str(json_escape(c.name.as_str()).as_str())
            resp#.push_str("\",\"kind\":\"")
            resp#.push_str(c.kind.as_str())
            resp#.push_str("\",\"line\":")
            resp#.push_str(u64_to_string(c.line as u64).as_str())
            resp#.push_str(",\"range_start\":")
            resp#.push_str(u64_to_string(c.range_start as u64).as_str())
            resp#.push_str(",\"range_end\":")
            match c.range_end {
                auto Option<usize>::Some(re) => {
                    resp#.push_str(u64_to_string(re as u64).as_str())
                }
                auto Option<usize>::None => {
                    resp#.push_str("null")
                }
            }
            resp#.push_str(",\"range_status\":\"")
            resp#.push_str(c.range_status.as_str())
            resp#.push_str("\",\"scope\":\"")
            resp#.push_str(json_escape(c.scope.as_str()).as_str())
            resp#.push_str("\",\"detail\":\"")
            resp#.push_str(json_escape(c.detail.as_str()).as_str())
            resp#.push_str("\"}")
            ci = ci + 1:usize
        }
        resp#.push_str("],\"candidates_truncated\":")
        if self.candidates_truncated {
            resp#.push_str("true")
        } else {
            resp#.push_str("false")
        }
        return cede resp
    }

    // Computes metadata length upper-bound using limit digit count as a conservative
    // bound, followed by final exact convergence in converge_structured.
    pub fn compute_candidate_meta_len(
        self,
        start_idx: usize,
        end_idx: usize,
        is_pruned: bool,
        limit: usize
    ) -> usize {
        auto lines_emitted# = 0:usize
        if end_idx >= start_idx {
            lines_emitted = end_idx - start_idx + 1:usize
        }

        auto s_schema = "{\"schema\":\"trg-mcp-view-result-v1\",\"mode\":\""
        auto l_schema = s_schema.len
        auto l_mode = self.mode.len()
        auto s_path_tag = "\",\"path\":\""
        auto l_path_tag = s_path_tag.len
        auto l_path = json_escape(self.path.as_str()).len()
        auto s_req_line_tag = "\",\"requested_line\":"
        auto l_req_line_tag = s_req_line_tag.len
        auto l_req_line# = 4:usize // "null"
        match self.requested_line {
            auto Option<usize>::Some(l) => {
                l_req_line = u64_to_string(l as u64).len()
            }
            _ => {}
        }
        auto s_req_range_tag = ",\"requested_range\":"
        auto l_req_range_tag = s_req_range_tag.len
        auto l_req_range# = 4:usize // "null"
        match self.requested_range {
            auto Option<BlockRange>::Some(rr) => {
                l_req_range = 3:usize + u64_to_string(rr.start as u64).len() + u64_to_string(rr.end as u64).len()
            }
            _ => {}
        }
        auto s_det_range_tag = ",\"detected_block_range\":"
        auto l_det_range_tag = s_det_range_tag.len
        auto l_det_range# = 4:usize // "null"
        match self.detected_block_range {
            auto Option<BlockRange>::Some(dbr) => {
                l_det_range = 3:usize + u64_to_string(dbr.start as u64).len() + u64_to_string(dbr.end as u64).len()
            }
            _ => {}
        }
        auto s_emit_range_tag = ",\"emitted_range\":"
        auto l_emit_range_tag = s_emit_range_tag.len
        auto l_emit_range# = 4:usize // "null"
        if lines_emitted > 0:usize {
            auto s_num = self.records.borrow(start_idx).line_number
            auto e_num = self.records.borrow(end_idx).line_number
            l_emit_range = 3:usize + u64_to_string(s_num as u64).len() + u64_to_string(e_num as u64).len()
        }
        auto s_target_inc_tag = ",\"target_included\":"
        auto l_target_inc_tag = s_target_inc_tag.len
        auto l_target_inc# = 4:usize // "null"
        match self.target_included {
            auto Option<bool>::Some(ti) => {
                if lines_emitted > 0:usize && ti {
                    l_target_inc = 4:usize // "true"
                } else {
                    l_target_inc = 5:usize // "false"
                }
            }
            _ => {}
        }
        auto s_content_omitted_tag = ",\"content_omitted\":"
        auto l_content_omitted_tag = s_content_omitted_tag.len
        auto l_content_omitted# = 5:usize
        if self.content_omitted {
            l_content_omitted = 4:usize
        }
        auto s_complete_tag = ",\"complete\":"
        auto l_complete_tag = s_complete_tag.len
        auto cand_comp# = self.complete
        if is_pruned {
            cand_comp = false
        }
        auto l_complete# = 5:usize
        if cand_comp {
            l_complete = 4:usize
        }
        auto s_eof_tag = ",\"eof_reached\":"
        auto l_eof_tag = s_eof_tag.len
        auto l_eof# = 5:usize
        if self.eof_reached {
            l_eof = 4:usize
        }
        auto s_truncated_tag = ",\"truncated\":"
        auto l_truncated_tag = s_truncated_tag.len
        auto cand_trunc# = self.truncated
        if is_pruned {
            cand_trunc = true
        }
        auto l_truncated# = 5:usize
        if cand_trunc {
            l_truncated = 4:usize
        }
        auto s_reason_tag = ",\"termination_reason\":\""
        auto l_reason_tag = s_reason_tag.len
        auto l_reason# = self.reason.len()
        if is_pruned {
            auto s_trunc = "max_result_bytes"
            l_reason = s_trunc.len
        }
        auto s_lines_emitted_tag = "\",\"lines_emitted\":"
        auto l_lines_emitted_tag = s_lines_emitted_tag.len
        auto l_lines_emitted = u64_to_string(lines_emitted as u64).len()
        auto s_bytes_emitted_tag = ",\"content_bytes_emitted\":"
        auto l_bytes_emitted_tag = s_bytes_emitted_tag.len
        auto l_bytes_emitted = u64_to_string(limit as u64).len()
        auto s_records_open = ",\"records\":["
        auto l_records_open = s_records_open.len
        auto s_records_close = "]}"
        auto l_records_close# = s_records_close.len
        if self.mode == "symbol" {
            auto sym_suffix = self.format_symbol_suffix_str(is_pruned)
            l_records_close = 2:usize + sym_suffix.len()
        }

        return l_schema + l_mode + l_path_tag + l_path + l_req_line_tag + l_req_line +
               l_req_range_tag + l_req_range + l_det_range_tag + l_det_range +
               l_emit_range_tag + l_emit_range + l_target_inc_tag + l_target_inc +
               l_content_omitted_tag + l_content_omitted + l_complete_tag + l_complete +
               l_eof_tag + l_eof + l_truncated_tag + l_truncated + l_reason_tag + l_reason +
               l_lines_emitted_tag + l_lines_emitted + l_bytes_emitted_tag + l_bytes_emitted +
               l_records_open + l_records_close
    }

    pub fn converge_structured(self#) -> Result<string, string> {
        self.bytes_emitted = 0:usize
        auto cur_s# = self.format_structured()
        self.bytes_emitted = cur_s.len()
        auto iter# = 0:usize
        loop iter < 10:usize {
            cur_s = self.format_structured()
            if cur_s.len() == self.bytes_emitted {
                return Result<string, string>::Ok(cede cur_s)
            }
            self.bytes_emitted = cur_s.len()
            iter = iter + 1:usize
        }
        return Result<string, string>::Err(string::from("view_json_budget_convergence_failed: failed to converge bytes_emitted after 10 iterations"))
    }

    pub fn prune_to_json_budget(self#, limit: usize) -> Result<string, string> {
        auto n_recs = self.records.len()
        if n_recs == 0:usize {
            if self.candidates.len() > 1:usize {
                loop self.candidates.len() > 1:usize {
                    auto cur_meta_len = self.compute_candidate_meta_len(1:usize, 0:usize, false, limit)
                    if cur_meta_len <= limit {
                        break
                    }
                    auto _ = self.candidates#.pop()
                    self.candidates_truncated = true
                }
            }
            auto meta_len = self.compute_candidate_meta_len(1:usize, 0:usize, false, limit)
            if meta_len > limit {
                auto err# = string::from("target_exceeds_max_result_bytes: View result metadata (")
                err#.push_str(u64_to_string(meta_len as u64).as_str())
                err#.push_str(" bytes) exceeds max_result_bytes (")
                err#.push_str(u64_to_string(limit as u64).as_str())
                err#.push_str(" bytes)")
                return Result<string, string>::Err(cede err)
            }
            return self#.converge_structured()
        }

        // 1. Check if unpruned result already converges within limit
        auto init_conv = self#.converge_structured()
        if init_conv.is_err() {
            return init_conv
        }
        auto init_json = init_conv.unwrap()
        if init_json.len() <= limit {
            return Result<string, string>::Ok(cede init_json)
        }

        // 2. Precompute exact record JSON lengths: O(B)
        auto rec_lens# = Vec<usize>::new()
        auto i# = 0:usize
        auto total_recs_len# = 0:usize
        loop i < n_recs {
            auto &r = self.records.borrow(i)
            auto r_json = format_view_line_record_json(r.line_number, r.kind.as_str(), r.text.as_str())
            auto l = r_json.len()
            rec_lens#.push(l)
            total_recs_len = total_recs_len + l
            i = i + 1:usize
        }

        // 3. Select candidate window [w_start, w_end] in O(N)
        auto w_start# = 0:usize
        auto w_end# = n_recs - 1:usize
        auto cur_recs_len# = total_recs_len
        auto has_records# = true

        auto req_line_opt = self.requested_line
        if req_line_opt.is_some() {
            auto target_line_num = req_line_opt.unwrap()
            // Point or Block mode: target line must be preserved
            auto target_idx_opt# = Option<usize>::None
            auto ti# = 0:usize
            loop ti < n_recs {
                if self.records.borrow(ti).line_number == target_line_num && self.records.borrow(ti).kind.as_str() == "target" {
                    target_idx_opt = Option<usize>::Some(ti)
                    break
                }
                ti = ti + 1:usize
            }

            if target_idx_opt.is_none() {
                return Result<string, string>::Err(string::from("target_not_found: Target record not found in view records"))
            }
            auto target_idx = target_idx_opt.unwrap()

            // Check if single target line fits
            auto single_records# = Vec<ViewLineRecord>::new()
            single_records#.push(ViewLineRecord(
                line_number = self.records.borrow(target_idx).line_number,
                kind = string::from(self.records.borrow(target_idx).kind.as_str()),
                text = string::from(self.records.borrow(target_idx).text.as_str())
            ))
            auto target_sym_clone# = Vec<SymbolTargetInfo>::new()
            if self.target_symbol.len() > 0:usize {
                auto &ts = self.target_symbol.borrow(0)
                target_sym_clone#.push(SymbolTargetInfo(
                    name = string::from(ts.name.as_str()),
                    kind = string::from(ts.kind.as_str()),
                    line = ts.line,
                    range_start = ts.range_start,
                    range_end = ts.range_end,
                    range_status = string::from(ts.range_status.as_str()),
                    scope = string::from(ts.scope.as_str()),
                    detail = string::from(ts.detail.as_str())
                ))
            }
            auto target_range_status_clone# = Option<string>::None
            match self.range_status {
                auto Option<string>::Some(&rs) => {
                    target_range_status_clone = Option<string>::Some(string::from(rs.as_str()))
                }
                auto Option<string>::None => {}
            }
            auto target_only_vr# = ViewResult(
                text = string::new(),
                truncated = true,
                reason = string::from("max_result_bytes"),
                lines_emitted = 1:usize,
                bytes_emitted = 0:usize,
                mode = string::from(self.mode.as_str()),
                path = string::from(self.path.as_str()),
                requested_line = self.requested_line,
                requested_range = self.requested_range,
                detected_block_range = self.detected_block_range,
                emitted_range = Option<BlockRange>::Some(BlockRange(start = target_line_num, end = target_line_num)),
                target_included = self.target_included,
                content_omitted = self.content_omitted,
                complete = false,
                eof_reached = self.eof_reached,
                records = cede single_records,
                selection_status = string::from(self.selection_status.as_str()),
                range_status = target_range_status_clone,
                output_status = string::from("budget_truncated"),
                target_symbol = cede target_sym_clone,
                candidates = Vec<SymbolCandidateInfo>::new(),
                candidates_truncated = false
            )
            auto to_conv = target_only_vr#.converge_structured()
            if to_conv.is_err() {
                return to_conv
            }
            auto to_json = to_conv.unwrap()
            if to_json.len() > limit {
                auto err# = string::from("target_exceeds_max_result_bytes: Target line formatted record (")
                err#.push_str(u64_to_string(to_json.len() as u64).as_str())
                err#.push_str(" bytes) exceeds max_result_bytes (")
                err#.push_str(u64_to_string(limit as u64).as_str())
                err#.push_str(" bytes)")
                return Result<string, string>::Err(cede err)
            }

            // Shrink window around target_idx until cand_total <= limit
            loop true {
                auto num_lines = w_end - w_start + 1:usize
                auto comma_len# = 0:usize
                if num_lines > 1:usize {
                    comma_len = num_lines - 1:usize
                }
                auto meta_len = self.compute_candidate_meta_len(w_start, w_end, true, limit)
                auto cand_total = meta_len + comma_len + cur_recs_len
                if cand_total <= limit {
                    break
                }
                if w_start == target_idx && w_end == target_idx {
                    break
                }

                auto can_remove_start = w_start < target_idx
                auto can_remove_end = w_end > target_idx

                auto remove_last# = false
                if can_remove_end && !can_remove_start {
                    remove_last = true
                } else if can_remove_start && !can_remove_end {
                    remove_last = false
                } else {
                    auto dist_before = target_line_num - self.records.borrow(w_start).line_number
                    auto dist_after = self.records.borrow(w_end).line_number - target_line_num
                    if dist_after >= dist_before {
                        remove_last = true
                    } else {
                        remove_last = false
                    }
                }

                if remove_last {
                    cur_recs_len = cur_recs_len - rec_lens.get(w_end)
                    w_end = w_end - 1:usize
                } else {
                    cur_recs_len = cur_recs_len - rec_lens.get(w_start)
                    w_start = w_start + 1:usize
                }
            }
        } else {
            // Range mode: prune from end, or 0 records if needed
            loop true {
                auto num_lines = w_end - w_start + 1:usize
                auto comma_len# = 0:usize
                if num_lines > 1:usize {
                    comma_len = num_lines - 1:usize
                }
                auto meta_len = self.compute_candidate_meta_len(w_start, w_end, true, limit)
                auto cand_total = meta_len + comma_len + cur_recs_len
                if cand_total <= limit {
                    break
                }
                if w_end > 0:usize {
                    cur_recs_len = cur_recs_len - rec_lens.get(w_end)
                    w_end = w_end - 1:usize
                } else {
                    // Even 1 line cannot fit, check if 0 records can fit
                    has_records = false
                    auto zero_meta = self.compute_candidate_meta_len(1:usize, 0:usize, true, limit)
                    if zero_meta > limit {
                        auto err# = string::from("target_exceeds_max_result_bytes: View result metadata (")
                        err#.push_str(u64_to_string(zero_meta as u64).as_str())
                        err#.push_str(" bytes) exceeds max_result_bytes (")
                        err#.push_str(u64_to_string(limit as u64).as_str())
                        err#.push_str(" bytes)")
                        return Result<string, string>::Err(cede err)
                    }
                    break
                }
            }
        }

        // 4. Slice records once and apply pruned metadata
        auto new_records# = Vec<ViewLineRecord>::new()
        if has_records {
            auto k# = w_start
            loop k <= w_end {
                new_records#.push(ViewLineRecord(
                    line_number = self.records.borrow(k).line_number,
                    kind = self.records.borrow(k).kind.clone(),
                    text = self.records.borrow(k).text.clone()
                ))
                k = k + 1:usize
            }
        }
        self.records = cede new_records
        self.truncated = true
        self.reason = string::from("max_result_bytes")
        self.output_status = string::from("budget_truncated")
        self.complete = false
        self.lines_emitted = self.records.len()
        if self.lines_emitted > 0:usize {
            self.emitted_range = Option<BlockRange>::Some(BlockRange(
                start = self.records.borrow(0).line_number,
                end = self.records.borrow(self.records.len() - 1:usize).line_number
            ))
        } else {
            self.emitted_range = Option<BlockRange>::None
        }

        // 5. Converge byte count and final assertion
        auto conv_res = self#.converge_structured()
        if conv_res.is_err() {
            return conv_res
        }
        auto final_json = conv_res.unwrap()
        if final_json.len() > limit {
            auto err = string::from("target_exceeds_max_result_bytes: Formatted record exceeds max_result_bytes")
            return Result<string, string>::Err(cede err)
        }
        return Result<string, string>::Ok(cede final_json)
    }
}

impl ViewOptions {
    pub fn new(file_path: string) -> ViewOptions {
        return ViewOptions(
            file_path = file_path.clone(),
            line = Option<usize>::None,
            context = 10:usize,
            block = false,
            lines_range = Option<BlockRange>::None,
            symbol = Option<string>::None,
            symbol_scope = Option<string>::None,
            max_lines = Option<usize>::None,
            max_result_bytes = Option<usize>::None,
            max_columns = Option<usize>::None,
            max_block_lines = 80:usize
        )
    }
}

pub fn read_file_lines(path: str) -> Result<Vec<string>, string> {
    auto path_str = string::from(path)
    auto mode_buf# = [0:char; 4]
    mode_buf[0] = 'r' as char
    mode_buf[1] = 'b' as char
    mode_buf[2] = 0 as char

    auto lines# = Vec<string>::new()

    unsafe {
        auto *mode_ptr = &mode_buf[0] as *char
        auto *path_c = path_str.c_str()
        auto nul *fp = libc_fopen(*path_c, *mode_ptr)
        if *fp == null {
            auto err# = string::from("Failed to open file '")
            err#.push_str(path)
            err#.push_str("': No such file or directory or permission denied")
            return Result<Vec<string>, string>::Err(cede err)
        }
        auto *file = fp.unwrap()
        auto nul *raw_buf = libc_malloc(65536:usize)
        if *raw_buf == null {
            libc_fclose(*file)
            return Result<Vec<string>, string>::Err(string::from("Out of memory reading file"))
        }
        auto *buf = raw_buf.unwrap()
        auto line_buf# = string::new()
        auto read_err# = false

        loop true {
            auto n = libc_fread(*buf, 1:usize, 65536:usize, *file)
            if n == 0 {
                if posix_ferror((*file) as Addr) {
                    read_err = true
                }
                break
            }

            auto *c_ptr = ((*buf) as Addr) as *char
            auto chunk_str = string::from_with_len(*c_ptr, n)
            auto chunk_view = chunk_str.as_str()
            auto cursor# = 0:usize

            loop cursor < chunk_view.len {
                auto rem = chunk_view.substr(cursor, chunk_view.len - cursor)
                auto nl_opt = rem.index_of('\n' as char)
                if nl_opt.is_none() {
                    line_buf#.push_str(rem)
                    break
                }
                auto nl_pos = nl_opt.unwrap()
                auto chunk_slice = rem.substr(0, nl_pos)
                line_buf#.push_str(chunk_slice)
                {
                    auto full_view = line_buf.as_str()
                    auto pat_text# = full_view
                    if full_view.len > 0 && full_view.byte_at(full_view.len - 1) == ('\r' as char) {
                        pat_text = full_view.substr(0, full_view.len - 1)
                    }
                    lines#.push(string::from(pat_text))
                }
                line_buf#.clear()
                cursor = cursor + nl_pos + 1
            }
        }

        if !read_err && line_buf.len() > 0 {
            {
                auto full_view = line_buf.as_str()
                auto pat_text# = full_view
                if full_view.len > 0 && full_view.byte_at(full_view.len - 1) == ('\r' as char) {
                    pat_text = full_view.substr(0, full_view.len - 1)
                }
                lines#.push(string::from(pat_text))
            }
            line_buf#.clear()
        }

        libc_free(*buf)
        libc_fclose(*file)

        if read_err {
            auto err# = string::from("Error reading file '")
            err#.push_str(path)
            err#.push_str("'")
            return Result<Vec<string>, string>::Err(cede err)
        }
    }

    return Result<Vec<string>, string>::Ok(cede lines)
}

pub fn parse_usize_val(s: str) -> Result<usize, string> {
    if s.len == 0 {
        return Result<usize, string>::Err(string::from("Expected positive integer"))
    }
    auto val# = 0:usize
    auto i# = 0:usize
    loop i < s.len {
        auto ch = s.byte_at(i)
        if ch < ('0' as char) || ch > ('9' as char) {
            return Result<usize, string>::Err(string::from("Expected integer digits"))
        }
        auto digit = (ch as usize) - ('0' as usize)
        if val > (9223372036854775807:usize - digit) / 10:usize {
            return Result<usize, string>::Err(string::from("Integer value exceeds maximum limit"))
        }
        val = val * 10:usize + digit
        i = i + 1
    }
    return Result<usize, string>::Ok(val)
}

pub fn parse_range_spec(s: str) -> Result<BlockRange, string> {
    auto dash_opt = s.index_of('-' as char)
    if dash_opt.is_none() {
        return Result<BlockRange, string>::Err(string::from("Invalid line range: expected '<start>-<end>'"))
    }
    auto dash_idx = dash_opt.unwrap()
    auto start_str = s.substr(0, dash_idx)
    auto end_str = s.substr(dash_idx + 1, s.len - dash_idx - 1)
    auto s_res = parse_usize_val(start_str)
    if s_res.is_err() { return Result<BlockRange, string>::Err(s_res.unwrap_err()) }
    auto e_res = parse_usize_val(end_str)
    if e_res.is_err() { return Result<BlockRange, string>::Err(e_res.unwrap_err()) }
    auto start = s_res.unwrap()
    auto end = e_res.unwrap()
    if start == 0:usize || end < start {
        return Result<BlockRange, string>::Err(string::from("Invalid line range: start must be >= 1 and <= end"))
    }
    return Result<BlockRange, string>::Ok(BlockRange(start = start, end = end))
}

fn find_last_colon(s: str) -> Option<usize> {
    auto i# = s.len
    loop i > 0 {
        i = i - 1
        if s.byte_at(i) == (':' as char) {
            return Option<usize>::Some(i)
        }
    }
    return Option<usize>::None
}

fn execute_view_stream_lines(
    opts: ViewOptions,
    start_req: usize,
    end_req: usize
) -> Result<ViewResult, string> {
    auto path_str = string::from(opts.file_path.as_str())
    auto mode_buf# = [0:char; 4]
    mode_buf[0] = 'r' as char
    mode_buf[1] = 'b' as char
    mode_buf[2] = 0 as char

    auto max_lines_val# = 0:usize
    auto has_max_lines# = false
    match opts.max_lines {
        auto Option<usize>::Some(v) => {
            max_lines_val = v
            has_max_lines = true
        }
        _ => {}
    }

    auto max_bytes_val# = 0:usize
    auto has_max_bytes# = false
    match opts.max_result_bytes {
        auto Option<usize>::Some(v) => {
            max_bytes_val = v
            has_max_bytes = true
        }
        _ => {}
    }

    auto max_cols_val# = 0:usize
    auto has_max_cols# = false
    match opts.max_columns {
        auto Option<usize>::Some(v) => {
            max_cols_val = v
            has_max_cols = true
        }
        _ => {}
    }

    auto out# = string::new()
    auto lines_emitted# = 0:usize
    auto bytes_emitted# = 0:usize
    auto truncated# = false
    auto trunc_reason# = string::new()
    auto total_lines# = 0:usize
    auto read_err# = false
    auto early_stop# = false
    auto eof_reached# = false
    auto content_omitted# = false
    auto records# = Vec<ViewLineRecord>::new()

    unsafe {
        auto *mode_ptr = &mode_buf[0] as *char
        auto *path_c = path_str.c_str()
        auto nul *fp = libc_fopen(*path_c, *mode_ptr)
        if *fp == null {
            auto err# = string::from("Failed to open file '")
            err#.push_str(opts.file_path.as_str())
            err#.push_str("': No such file or directory or permission denied")
            return Result<ViewResult, string>::Err(cede err)
        }
        auto *file = fp.unwrap()
        auto nul *raw_buf = libc_malloc(65536:usize)
        if *raw_buf == null {
            libc_fclose(*file)
            return Result<ViewResult, string>::Err(string::from("Out of memory reading file"))
        }
        auto *buf = raw_buf.unwrap()
        auto line_buf# = string::new()
        auto cur_line# = 1:usize

        loop true {
            auto n = libc_fread(*buf, 1:usize, 65536:usize, *file)
            if n == 0 {
                if posix_ferror((*file) as Addr) {
                    read_err = true
                }
                eof_reached = true
                break
            }

            auto *c_ptr = ((*buf) as Addr) as *char
            auto chunk_str = string::from_with_len(*c_ptr, n)
            auto chunk_view = chunk_str.as_str()
            auto cursor# = 0:usize

            loop cursor < chunk_view.len {
                auto rem = chunk_view.substr(cursor, chunk_view.len - cursor)
                auto nl_opt = rem.index_of('\n' as char)
                if nl_opt.is_none() {
                    if cur_line >= start_req {
                        line_buf#.push_str(rem)
                    }
                    break
                }

                auto nl_pos = nl_opt.unwrap()
                if cur_line >= start_req {
                    auto chunk_slice = rem.substr(0, nl_pos)
                    line_buf#.push_str(chunk_slice)

                    auto line_str = line_buf.clone()
                    line_buf#.clear()

                    auto full_view = line_str.as_str()
                    auto pat_text# = full_view
                    if full_view.len > 0 && full_view.byte_at(full_view.len - 1) == ('\r' as char) {
                        pat_text = full_view.substr(0, full_view.len - 1)
                    }

                    auto display_text# = pat_text
                    if has_max_cols && max_cols_val > 0 && pat_text.len > max_cols_val {
                        display_text = "[omitted]"
                        content_omitted = true
                    }

                    auto line_entry# = string::new()
                    line_entry#.push_str(u64_to_string(cur_line as u64).as_str())
                    line_entry#.push_str(":")
                    line_entry#.push_str(display_text)
                    line_entry#.push_str("\n")

                    if has_max_lines && lines_emitted >= max_lines_val {
                        truncated = true
                        trunc_reason = string::from("max_lines")
                        early_stop = true
                        cursor = cursor + nl_pos + 1
                        cur_line = cur_line + 1
                        break
                    }

                    if has_max_bytes && bytes_emitted + line_entry.len() > max_bytes_val {
                        truncated = true
                        trunc_reason = string::from("max_result_bytes")
                        early_stop = true
                        cursor = cursor + nl_pos + 1
                        cur_line = cur_line + 1
                        break
                    }

                    bytes_emitted = bytes_emitted + line_entry.len()
                    lines_emitted = lines_emitted + 1
                    out#.push_str(line_entry.as_str())
                    records#.push(ViewLineRecord(
                        line_number = cur_line,
                        kind = string::from("context"),
                        text = string::from(display_text)
                    ))

                    if cur_line == end_req {
                        early_stop = true
                        cursor = cursor + nl_pos + 1
                        cur_line = cur_line + 1
                        break
                    }
                }

                cur_line = cur_line + 1
                cursor = cursor + nl_pos + 1
            }

            if early_stop {
                break
            }
        }

        if !read_err && !early_stop && line_buf.len() > 0 {
            if cur_line >= start_req {
                auto line_str = line_buf.clone()
                auto full_view = line_str.as_str()
                auto pat_text# = full_view
                if full_view.len > 0 && full_view.byte_at(full_view.len - 1) == ('\r' as char) {
                    pat_text = full_view.substr(0, full_view.len - 1)
                }

                auto display_text# = pat_text
                if has_max_cols && max_cols_val > 0 && pat_text.len > max_cols_val {
                    display_text = "[omitted]"
                    content_omitted = true
                }

                auto line_entry# = string::new()
                line_entry#.push_str(u64_to_string(cur_line as u64).as_str())
                line_entry#.push_str(":")
                line_entry#.push_str(display_text)
                line_entry#.push_str("\n")

                auto can_emit# = true
                if has_max_lines && lines_emitted >= max_lines_val {
                    truncated = true
                    trunc_reason = string::from("max_lines")
                    can_emit = false
                }
                if can_emit && has_max_bytes && bytes_emitted + line_entry.len() > max_bytes_val {
                    truncated = true
                    trunc_reason = string::from("max_result_bytes")
                    can_emit = false
                }
                if can_emit {
                    bytes_emitted = bytes_emitted + line_entry.len()
                    lines_emitted = lines_emitted + 1
                    out#.push_str(line_entry.as_str())
                    records#.push(ViewLineRecord(
                        line_number = cur_line,
                        kind = string::from("context"),
                        text = string::from(display_text)
                    ))
                }
            }
            total_lines = cur_line
            line_buf#.clear()
        } else if !early_stop {
            total_lines = cur_line - 1
        }

        libc_free(*buf)
        libc_fclose(*file)

        if read_err {
            auto err# = string::from("Error reading file '")
            err#.push_str(opts.file_path.as_str())
            err#.push_str("'")
            return Result<ViewResult, string>::Err(cede err)
        }
    }

    if !early_stop {
        if total_lines == 0:usize {
            return Result<ViewResult, string>::Err(string::from("File is empty"))
        }
        if start_req > total_lines {
            auto err# = string::from("Line range start out of bounds: file has ")
            err#.push_str(u64_to_string(total_lines as u64).as_str())
            err#.push_str(" lines, requested start ")
            err#.push_str(u64_to_string(start_req as u64).as_str())
            return Result<ViewResult, string>::Err(cede err)
        }
    }

    auto emitted_range# = Option<BlockRange>::None
    if lines_emitted > 0:usize {
        emitted_range = Option<BlockRange>::Some(BlockRange(start = start_req, end = start_req + lines_emitted - 1:usize))
    }

    auto complete# = false
    if !truncated {
        complete = true
    }

    auto term_reason# = string::from("completed")
    if truncated {
        term_reason = trunc_reason.clone()
    }
    auto out_stat# = string::from("complete")
    if truncated {
        out_stat = string::from("budget_truncated")
    }

    return Result<ViewResult, string>::Ok(ViewResult(
        text = cede out,
        truncated = truncated,
        reason = cede term_reason,
        lines_emitted = lines_emitted,
        bytes_emitted = bytes_emitted,
        mode = string::from("range"),
        path = opts.file_path.clone(),
        requested_line = Option<usize>::None,
        requested_range = Option<BlockRange>::Some(BlockRange(start = start_req, end = end_req)),
        detected_block_range = Option<BlockRange>::None,
        emitted_range = emitted_range,
        target_included = Option<bool>::None,
        content_omitted = content_omitted,
        complete = complete,
        eof_reached = eof_reached,
        records = cede records,
        selection_status = string::from("found"),
        range_status = Option<string>::None,
        output_status = cede out_stat,
        target_symbol = Vec<SymbolTargetInfo>::new(),
        candidates = Vec<SymbolCandidateInfo>::new(),
        candidates_truncated = false
    ))
}

fn execute_view_stream_point(
    opts: ViewOptions,
    target_line: usize
) -> Result<ViewResult, string> {
    auto path_str = string::from(opts.file_path.as_str())
    auto mode_buf# = [0:char; 4]
    mode_buf[0] = 'r' as char
    mode_buf[1] = 'b' as char
    mode_buf[2] = 0 as char

    auto max_lines_val# = 0:usize
    auto has_max_lines# = false
    match opts.max_lines {
        auto Option<usize>::Some(v) => {
            max_lines_val = v
            has_max_lines = true
        }
        _ => {}
    }

    auto max_bytes_val# = 0:usize
    auto has_max_bytes# = false
    match opts.max_result_bytes {
        auto Option<usize>::Some(v) => {
            max_bytes_val = v
            has_max_bytes = true
        }
        _ => {}
    }

    auto max_cols_val# = 0:usize
    auto has_max_cols# = false
    match opts.max_columns {
        auto Option<usize>::Some(v) => {
            max_cols_val = v
            has_max_cols = true
        }
        _ => {}
    }

    auto before_lines# = Vec<string>::new()
    auto after_lines# = Vec<string>::new()
    auto target_text# = string::new()
    auto target_found# = false
    auto read_err# = false
    auto eof_reached# = false
    auto total_lines# = 0:usize

    auto start_req# = 1:usize
    if target_line > opts.context {
        start_req = target_line - opts.context
    }
    auto end_req = target_line + opts.context

    unsafe {
        auto *mode_ptr = &mode_buf[0] as *char
        auto *path_c = path_str.c_str()
        auto nul *fp = libc_fopen(*path_c, *mode_ptr)
        if *fp == null {
            auto err# = string::from("Failed to open file '")
            err#.push_str(opts.file_path.as_str())
            err#.push_str("': No such file or directory or permission denied")
            return Result<ViewResult, string>::Err(cede err)
        }
        auto *file = fp.unwrap()
        auto nul *raw_buf = libc_malloc(65536:usize)
        if *raw_buf == null {
            libc_fclose(*file)
            return Result<ViewResult, string>::Err(string::from("Out of memory reading file"))
        }
        auto *buf = raw_buf.unwrap()
        auto line_buf# = string::new()
        auto cur_line# = 1:usize
        auto stop_reading# = false

        loop true {
            auto n = libc_fread(*buf, 1:usize, 65536:usize, *file)
            if n == 0 {
                if posix_ferror((*file) as Addr) {
                    read_err = true
                }
                eof_reached = true
                break
            }

            auto *c_ptr = ((*buf) as Addr) as *char
            auto chunk_str = string::from_with_len(*c_ptr, n)
            auto chunk_view = chunk_str.as_str()
            auto cursor# = 0:usize

            loop cursor < chunk_view.len {
                auto rem = chunk_view.substr(cursor, chunk_view.len - cursor)
                auto nl_opt = rem.index_of('\n' as char)
                if nl_opt.is_none() {
                    line_buf#.push_str(rem)
                    break
                }

                auto nl_pos = nl_opt.unwrap()
                auto chunk_slice = rem.substr(0, nl_pos)
                line_buf#.push_str(chunk_slice)

                auto line_str = line_buf.clone()
                line_buf#.clear()

                auto full_view = line_str.as_str()
                auto pat_text# = full_view
                if full_view.len > 0 && full_view.byte_at(full_view.len - 1) == ('\r' as char) {
                    pat_text = full_view.substr(0, full_view.len - 1)
                }

                if cur_line >= start_req && cur_line < target_line {
                    before_lines#.push(string::from(pat_text))
                } else if cur_line == target_line {
                    target_text = string::from(pat_text)
                    target_found = true
                } else if cur_line > target_line && cur_line <= end_req {
                    after_lines#.push(string::from(pat_text))
                    if cur_line == end_req {
                        stop_reading = true
                        cursor = cursor + nl_pos + 1
                        cur_line = cur_line + 1
                        break
                    }
                }

                cur_line = cur_line + 1
                cursor = cursor + nl_pos + 1
            }

            if stop_reading {
                break
            }
        }

        if !read_err && !stop_reading && line_buf.len() > 0 {
            auto line_str = line_buf.clone()
            auto full_view = line_str.as_str()
            auto pat_text# = full_view
            if full_view.len > 0 && full_view.byte_at(full_view.len - 1) == ('\r' as char) {
                pat_text = full_view.substr(0, full_view.len - 1)
            }
            if cur_line >= start_req && cur_line < target_line {
                before_lines#.push(string::from(pat_text))
            } else if cur_line == target_line {
                target_text = string::from(pat_text)
                target_found = true
            } else if cur_line > target_line && cur_line <= end_req {
                after_lines#.push(string::from(pat_text))
            }
            total_lines = cur_line
            line_buf#.clear()
        } else if !stop_reading {
            total_lines = cur_line - 1
        }

        libc_free(*buf)
        libc_fclose(*file)

        if read_err {
            auto err# = string::from("Error reading file '")
            err#.push_str(opts.file_path.as_str())
            err#.push_str("'")
            return Result<ViewResult, string>::Err(cede err)
        }
    }

    if !target_found {
        if total_lines == 0:usize {
            return Result<ViewResult, string>::Err(string::from("File is empty"))
        }
        auto err# = string::from("Line number out of bounds: file has ")
        err#.push_str(u64_to_string(total_lines as u64).as_str())
        err#.push_str(" lines, requested line ")
        err#.push_str(u64_to_string(target_line as u64).as_str())
        return Result<ViewResult, string>::Err(cede err)
    }

    auto content_omitted# = false
    auto target_display# = target_text.as_str()
    if has_max_cols && max_cols_val > 0 && target_text.len() > max_cols_val {
        target_display = "[omitted]"
        content_omitted = true
    }

    auto target_entry# = string::new()
    target_entry#.push_str(u64_to_string(target_line as u64).as_str())
    target_entry#.push_str(":")
    target_entry#.push_str(target_display)
    target_entry#.push_str("\n")

    if has_max_bytes && target_entry.len() > max_bytes_val {
        auto err# = string::from("target_exceeds_max_result_bytes: Target line formatted record (")
        err#.push_str(u64_to_string(target_entry.len() as u64).as_str())
        err#.push_str(" bytes) exceeds max_result_bytes (")
        err#.push_str(u64_to_string(max_bytes_val as u64).as_str())
        err#.push_str(" bytes)")
        return Result<ViewResult, string>::Err(cede err)
    }

    if has_max_lines && max_lines_val < 1:usize {
        return Result<ViewResult, string>::Err(string::from("target_exceeds_max_lines: Target line cannot fit within max_lines 0"))
    }

    auto avail_before = before_lines.len()
    auto avail_after = after_lines.len()

    auto rem_lines# = avail_before + avail_after
    if has_max_lines {
        if max_lines_val > 1:usize {
            rem_lines = max_lines_val - 1:usize
        } else {
            rem_lines = 0:usize
        }
    }

    auto rem_bytes# = 18446744073709551615:usize
    if has_max_bytes {
        rem_bytes = max_bytes_val - target_entry.len()
    }

    auto b_take# = 0:usize
    auto a_take# = 0:usize
    auto truncated# = false
    auto trunc_reason# = string::new()

    loop b_take + a_take < rem_lines {
        auto can_b = b_take < avail_before
        auto can_a = a_take < avail_after
        if !can_b && !can_a {
            break
        }

        if can_b && (b_take <= a_take || !can_a) {
            auto b_line_num = target_line - 1:usize - b_take
            auto b_raw = before_lines.borrow(avail_before - 1:usize - b_take).as_str()
            auto b_disp# = b_raw
            if has_max_cols && max_cols_val > 0 && b_raw.len > max_cols_val {
                b_disp = "[omitted]"
                content_omitted = true
            }
            auto b_len = u64_to_string(b_line_num as u64).len() + 1:usize + b_disp.len + 1:usize
            if has_max_bytes && b_len > rem_bytes {
                truncated = true
                trunc_reason = string::from("max_result_bytes")
                break
            }
            if has_max_bytes {
                rem_bytes = rem_bytes - b_len
            }
            b_take = b_take + 1:usize
        }

        if b_take + a_take >= rem_lines {
            break
        }

        if can_a && (a_take < b_take || !can_b) {
            auto a_line_num = target_line + 1:usize + a_take
            auto a_raw = after_lines.borrow(a_take).as_str()
            auto a_disp# = a_raw
            if has_max_cols && max_cols_val > 0 && a_raw.len > max_cols_val {
                a_disp = "[omitted]"
                content_omitted = true
            }
            auto a_len = u64_to_string(a_line_num as u64).len() + 1:usize + a_disp.len + 1:usize
            if has_max_bytes && a_len > rem_bytes {
                truncated = true
                trunc_reason = string::from("max_result_bytes")
                break
            }
            if has_max_bytes {
                rem_bytes = rem_bytes - a_len
            }
            a_take = a_take + 1:usize
        }
    }

    if !truncated && (b_take + a_take < avail_before + avail_after) {
        truncated = true
        trunc_reason = string::from("max_lines")
    }

    auto out# = string::new()
    auto records# = Vec<ViewLineRecord>::new()

    // 1. Before lines in ascending order
    if b_take > 0:usize {
        auto idx# = b_take
        loop idx > 0:usize {
            auto b_line_num = target_line - idx
            auto b_raw = before_lines.borrow(avail_before - idx).as_str()
            auto b_disp# = b_raw
            if has_max_cols && max_cols_val > 0 && b_raw.len > max_cols_val {
                b_disp = "[omitted]"
            }
            out#.push_str(u64_to_string(b_line_num as u64).as_str())
            out#.push_str("-")
            out#.push_str(b_disp)
            out#.push_str("\n")
            records#.push(ViewLineRecord(
                line_number = b_line_num,
                kind = string::from("context"),
                text = string::from(b_disp)
            ))
            idx = idx - 1:usize
        }
    }

    // 2. Target line
    out#.push_str(target_entry.as_str())
    records#.push(ViewLineRecord(
        line_number = target_line,
        kind = string::from("target"),
        text = string::from(target_display)
    ))

    // 3. After lines in ascending order
    auto a_idx# = 0:usize
    loop a_idx < a_take {
        auto a_line_num = target_line + 1:usize + a_idx
        auto a_raw = after_lines.borrow(a_idx).as_str()
        auto a_disp# = a_raw
        if has_max_cols && max_cols_val > 0 && a_raw.len > max_cols_val {
            a_disp = "[omitted]"
        }
        out#.push_str(u64_to_string(a_line_num as u64).as_str())
        out#.push_str("-")
        out#.push_str(a_disp)
        out#.push_str("\n")
        records#.push(ViewLineRecord(
            line_number = a_line_num,
            kind = string::from("context"),
            text = string::from(a_disp)
        ))
        a_idx = a_idx + 1:usize
    }

    auto first_line = target_line - b_take
    auto last_line = target_line + a_take
    auto lines_emitted = 1:usize + b_take + a_take
    auto bytes_emitted = out.len()

    auto term_reason# = string::from("completed")
    if truncated {
        term_reason = trunc_reason.clone()
    }
    auto out_stat# = string::from("complete")
    if truncated {
        out_stat = string::from("budget_truncated")
    }

    return Result<ViewResult, string>::Ok(ViewResult(
        text = cede out,
        truncated = truncated,
        reason = cede term_reason,
        lines_emitted = lines_emitted,
        bytes_emitted = bytes_emitted,
        mode = string::from("point"),
        path = opts.file_path.clone(),
        requested_line = Option<usize>::Some(target_line),
        requested_range = Option<BlockRange>::None,
        detected_block_range = Option<BlockRange>::None,
        emitted_range = Option<BlockRange>::Some(BlockRange(start = first_line, end = last_line)),
        target_included = Option<bool>::Some(true),
        content_omitted = content_omitted,
        complete = !truncated,
        eof_reached = eof_reached,
        records = cede records,
        selection_status = string::from("found"),
        range_status = Option<string>::None,
        output_status = cede out_stat,
        target_symbol = Vec<SymbolTargetInfo>::new(),
        candidates = Vec<SymbolCandidateInfo>::new(),
        candidates_truncated = false
    ))
}

shape BlockStackFrame (
    line_number: usize,
    delimiter: BlockDelimiter,
    depth: usize
)

shape IndentStackFrame (
    line_number: usize,
    indent: usize
)

fn snap_block_start_decorators(
    initial_start: usize,
    first_stored_line: usize,
    before_ring: Vec<string>
) -> usize {
    auto cur_snap# = initial_start
    loop cur_snap > first_stored_line {
        auto check_line_no = cur_snap - 1:usize
        auto idx = check_line_no - first_stored_line
        if idx >= before_ring.len() {
            break
        }
        auto &raw_line = before_ring.borrow(idx)
        auto trimmed = raw_line.as_str().trim()
        if trimmed.len == 0 {
            break
        }
        if trimmed.starts_with("@") || trimmed.starts_with("#[") {
            cur_snap = check_line_no
            continue
        }
        if trimmed.ends_with(")") || trimmed.ends_with("]") {
            auto p_depth# = 0:i32
            auto found_opener# = false
            auto scan_up# = check_line_no
            loop scan_up >= first_stored_line {
                auto up_idx = scan_up - first_stored_line
                if up_idx >= before_ring.len() {
                    break
                }
                auto &up_line = before_ring.borrow(up_idx)
                auto up_trimmed = up_line.as_str().trim()
                if up_trimmed.len == 0 {
                    break
                }
                auto c_i# = up_trimmed.len
                loop c_i > 0 {
                    c_i = c_i - 1
                    auto ch = up_trimmed.byte_at(c_i)
                    if ch == (')' as char) || ch == (']' as char) {
                        p_depth = p_depth + 1
                    } else if ch == ('(' as char) || ch == ('[' as char) {
                        p_depth = p_depth - 1
                    }
                }
                if p_depth <= 0 && (up_trimmed.starts_with("@") || up_trimmed.starts_with("#[")) {
                    found_opener = true
                    cur_snap = scan_up
                    break
                }
                if scan_up == first_stored_line {
                    break
                }
                scan_up = scan_up - 1
            }
            if found_opener {
                continue
            }
        }
        break
    }
    return cur_snap
}

fn execute_view_stream_block(
    opts: ViewOptions,
    target_line: usize
) -> Result<ViewResult, string> {
    auto path_str = string::from(opts.file_path.as_str())
    auto mode_buf# = [0:char; 4]
    mode_buf[0] = 'r' as char
    mode_buf[1] = 'b' as char
    mode_buf[2] = 0 as char

    auto max_lines_val# = 0:usize
    auto has_max_lines# = false
    match opts.max_lines {
        auto Option<usize>::Some(v) => {
            max_lines_val = v
            has_max_lines = true
        }
        _ => {}
    }

    auto max_bytes_val# = 0:usize
    auto has_max_bytes# = false
    match opts.max_result_bytes {
        auto Option<usize>::Some(v) => {
            max_bytes_val = v
            has_max_bytes = true
        }
        _ => {}
    }

    auto max_cols_val# = 0:usize
    auto has_max_cols# = false
    match opts.max_columns {
        auto Option<usize>::Some(v) => {
            max_cols_val = v
            has_max_cols = true
        }
        _ => {}
    }

    if has_max_lines && max_lines_val < 1:usize {
        return Result<ViewResult, string>::Err(string::from("target_exceeds_max_lines: Target line cannot fit within max_lines 0"))
    }

    auto family = detect_syntax_family(opts.file_path.as_str())
    auto dialect = detect_lexical_dialect(opts.file_path.as_str())
    auto max_block_cap# = opts.max_block_lines
    if has_max_lines && max_lines_val < max_block_cap {
        max_block_cap = max_lines_val
    }

    auto before_ring# = Vec<string>::new()
    auto after_lines# = Vec<string>::new()
    auto target_text# = string::new()
    auto target_found# = false

    auto block_start# = target_line
    auto block_end# = target_line
    auto block_closed# = false
    auto read_err# = false
    auto early_stop# = false
    auto eof_reached# = false
    auto total_lines# = 0:usize

    // For Brace syntax
    auto d# = DelimiterDepths::new()
    auto block_stack# = Vec<BlockStackFrame>::new()
    auto delim# = BlockDelimiter::Brace
    auto target_depth# = 0:usize

    // For Indent syntax
    auto indent_stack# = Vec<IndentStackFrame>::new()
    auto target_indent# = 0:usize

    // First line stored in before_ring
    auto first_stored_line# = 1:usize
    if target_line > max_block_cap {
        first_stored_line = target_line - max_block_cap
    }

    unsafe {
        auto *mode_ptr = &mode_buf[0] as *char
        auto *path_c = path_str.c_str()
        auto nul *fp = libc_fopen(*path_c, *mode_ptr)
        if *fp == null {
            auto err# = string::from("Failed to open file '")
            err#.push_str(opts.file_path.as_str())
            err#.push_str("': No such file or directory or permission denied")
            return Result<ViewResult, string>::Err(cede err)
        }
        auto *file = fp.unwrap()
        auto nul *raw_buf = libc_malloc(65536:usize)
        if *raw_buf == null {
            libc_fclose(*file)
            return Result<ViewResult, string>::Err(string::from("Out of memory reading file"))
        }
        auto *buf = raw_buf.unwrap()
        auto line_buf# = string::new()
        auto cur_line# = 1:usize

        loop true {
            auto n = libc_fread(*buf, 1:usize, 65536:usize, *file)
            if n == 0 {
                if posix_ferror((*file) as Addr) {
                    read_err = true
                }
                eof_reached = true
                break
            }

            auto *c_ptr = ((*buf) as Addr) as *char
            auto chunk_str = string::from_with_len(*c_ptr, n)
            auto chunk_view = chunk_str.as_str()
            auto cursor# = 0:usize

            loop cursor < chunk_view.len {
                auto rem = chunk_view.substr(cursor, chunk_view.len - cursor)
                auto nl_opt = rem.index_of('\n' as char)
                if nl_opt.is_none() {
                    line_buf#.push_str(rem)
                    break
                }

                auto nl_pos = nl_opt.unwrap()
                auto chunk_slice = rem.substr(0, nl_pos)
                line_buf#.push_str(chunk_slice)

                auto line_str = line_buf.clone()
                line_buf#.clear()

                auto full_view = line_str.as_str()
                auto pat_text# = full_view
                if full_view.len > 0 && full_view.byte_at(full_view.len - 1) == ('\r' as char) {
                    pat_text = full_view.substr(0, full_view.len - 1)
                }

                auto lex = scan_line_lexical(pat_text, d#, dialect)

                if cur_line < target_line {
                    match family {
                        auto SyntaxFamily::Brace => {
                            if lex.starts_block || lex.depth_after_brace > lex.depth_before_brace || lex.depth_after_paren > lex.depth_before_paren {
                                auto d_type = lex.delimiter
                                auto depth_val# = lex.depth_before_paren
                                if d_type == BlockDelimiter::Brace {
                                    depth_val = lex.depth_before_brace
                                }
                                block_stack#.push(BlockStackFrame(
                                    line_number = cur_line,
                                    delimiter = d_type,
                                    depth = depth_val
                                ))
                            }

                            loop block_stack.len() > 0:usize {
                                auto top_idx = block_stack.len() - 1:usize
                                auto should_pop# = false
                                {
                                    auto &top_f = block_stack.borrow(top_idx)
                                    if top_f.delimiter == BlockDelimiter::Brace && lex.depth_after_brace <= top_f.depth {
                                        should_pop = true
                                    } else if top_f.delimiter == BlockDelimiter::Paren && lex.depth_after_paren <= top_f.depth {
                                        should_pop = true
                                    }
                                }
                                if should_pop {
                                    block_stack#.pop()
                                } else {
                                    break
                                }
                            }

                            if cur_line >= first_stored_line {
                                before_ring#.push(string::from(pat_text))
                            }
                        }
                        auto SyntaxFamily::Indent => {
                            if lex.participates_in_indent {
                                auto is_header = lex.code_text.as_str().trim().ends_with(":") || lex.starts_block
                                if is_header {
                                    auto indent = lex.statement_indent
                                    loop indent_stack.len() > 0:usize {
                                        auto top_idx = indent_stack.len() - 1:usize
                                        if indent_stack.borrow(top_idx).indent >= indent {
                                            indent_stack#.pop()
                                        } else {
                                            break
                                        }
                                    }
                                    indent_stack#.push(IndentStackFrame(line_number = cur_line, indent = indent))
                                } else {
                                    loop indent_stack.len() > 0:usize {
                                        auto top_idx = indent_stack.len() - 1:usize
                                        if indent_stack.borrow(top_idx).indent >= lex.statement_indent {
                                            indent_stack#.pop()
                                        } else {
                                            break
                                        }
                                    }
                                }
                            }

                            if cur_line >= first_stored_line {
                                before_ring#.push(string::from(pat_text))
                            }
                        }
                    }
                } else if cur_line == target_line {
                    target_text = string::from(pat_text)
                    target_found = true
                    match family {
                        auto SyntaxFamily::Brace => {
                            if lex.starts_block {
                                block_start = target_line
                                delim = lex.delimiter
                                if delim == BlockDelimiter::Brace {
                                    target_depth = lex.depth_before_brace
                                } else {
                                    target_depth = lex.depth_before_paren
                                }
                            } else if block_stack.len() > 0:usize {
                                // Target line is inside or at the end of an existing block: preserve opener!
                                auto top_idx = block_stack.len() - 1:usize
                                auto &top_f = block_stack.borrow(top_idx)
                                block_start = top_f.line_number
                                delim = top_f.delimiter
                                target_depth = top_f.depth
                            } else {
                                block_start = target_line
                                delim = BlockDelimiter::Brace
                                target_depth = 0:usize
                            }

                            if block_start == target_line && check_is_self_closed_structured(delim, lex.depth_after_brace, lex.depth_after_paren, target_depth, lex.has_code_brace_closer, lex.has_code_paren_closer) {
                                block_end = target_line
                                block_closed = true
                            } else if block_start < target_line {
                                // Target line is the closer for this enclosing block!
                                if delim == BlockDelimiter::Brace && lex.depth_before_brace > target_depth && lex.depth_after_brace <= target_depth && lex.has_code_brace_closer {
                                    block_end = target_line
                                    block_closed = true
                                } else if delim == BlockDelimiter::Paren && lex.depth_before_paren > target_depth && lex.depth_after_paren <= target_depth && lex.has_code_paren_closer {
                                    block_end = target_line
                                    block_closed = true
                                }
                            }
                        }
                        auto SyntaxFamily::Indent => {
                            auto is_header = lex.participates_in_indent && (lex.code_text.as_str().trim().ends_with(":") || lex.starts_block)
                            if is_header {
                                target_indent = lex.statement_indent
                                block_start = target_line
                            } else if lex.participates_in_indent {
                                loop indent_stack.len() > 0:usize {
                                    auto top_idx = indent_stack.len() - 1:usize
                                    if indent_stack.borrow(top_idx).indent >= lex.statement_indent {
                                        indent_stack#.pop()
                                    } else {
                                        break
                                    }
                                }
                                if indent_stack.len() > 0:usize {
                                    auto top_idx = indent_stack.len() - 1:usize
                                    auto &top_f = indent_stack.borrow(top_idx)
                                    block_start = top_f.line_number
                                    target_indent = top_f.indent
                                } else {
                                    target_indent = lex.statement_indent
                                    block_start = target_line
                                }
                            } else {
                                // Target line does NOT participate in indent (inside multiline string / comment):
                                // Do NOT pop indent stack! Inherit enclosing block from top of stack.
                                if indent_stack.len() > 0:usize {
                                    auto top_idx = indent_stack.len() - 1:usize
                                    auto &top_f = indent_stack.borrow(top_idx)
                                    block_start = top_f.line_number
                                    target_indent = top_f.indent
                                } else {
                                    target_indent = 0:usize
                                    block_start = target_line
                                }
                            }
                        }
                    }
                    block_start = snap_block_start_decorators(block_start, first_stored_line, before_ring)
                } else {
                    // cur_line > target_line: scan forward to find block_end
                    if cur_line <= target_line + max_block_cap {
                        after_lines#.push(string::from(pat_text))
                    }

                    match family {
                        auto SyntaxFamily::Brace => {
                            if check_is_runaway_definition_structured(lex.is_scope_decl, lex.depth_before_brace, delim, target_depth) {
                                early_stop = true
                                cursor = cursor + nl_pos + 1
                                cur_line = cur_line + 1
                                break
                            }

                            match delim {
                                auto BlockDelimiter::Paren => {
                                    if lex.depth_before_paren > target_depth && lex.depth_after_paren <= target_depth && lex.has_code_paren_closer {
                                        block_end = cur_line
                                        block_closed = true
                                        early_stop = true
                                        cursor = cursor + nl_pos + 1
                                        cur_line = cur_line + 1
                                        break
                                    }
                                }
                                auto BlockDelimiter::Brace => {
                                    if lex.depth_before_brace > target_depth && lex.depth_after_brace <= target_depth && lex.has_code_brace_closer {
                                        block_end = cur_line
                                        block_closed = true
                                        early_stop = true
                                        cursor = cursor + nl_pos + 1
                                        cur_line = cur_line + 1
                                        break
                                    }
                                }
                            }
                        }
                        auto SyntaxFamily::Indent => {
                            if lex.participates_in_indent && lex.statement_indent <= target_indent {
                                block_end = cur_line - 1:usize
                                block_closed = true
                                early_stop = true
                                cursor = cursor + nl_pos + 1
                                cur_line = cur_line + 1
                                break
                            }
                        }
                    }
                }

                cur_line = cur_line + 1
                cursor = cursor + nl_pos + 1
            }

            if early_stop {
                break
            }
        }

        if !read_err && !early_stop && line_buf.len() > 0 {
            auto line_str = line_buf.clone()
            auto full_view = line_str.as_str()
            auto pat_text# = full_view
            if full_view.len > 0 && full_view.byte_at(full_view.len - 1) == ('\r' as char) {
                pat_text = full_view.substr(0, full_view.len - 1)
            }

            auto lex = scan_line_lexical(pat_text, d#, dialect)

            if cur_line < target_line {
                match family {
                    auto SyntaxFamily::Brace => {
                        if lex.starts_block || lex.depth_after_brace > lex.depth_before_brace || lex.depth_after_paren > lex.depth_before_paren {
                            auto d_type = lex.delimiter
                            auto depth_val# = lex.depth_before_paren
                            if d_type == BlockDelimiter::Brace { depth_val = lex.depth_before_brace }
                            block_stack#.push(BlockStackFrame(line_number = cur_line, delimiter = d_type, depth = depth_val))
                        }
                        loop block_stack.len() > 0:usize {
                            auto top_idx = block_stack.len() - 1:usize
                            auto should_pop# = false
                            {
                                auto &top_f = block_stack.borrow(top_idx)
                                if top_f.delimiter == BlockDelimiter::Brace && lex.depth_after_brace <= top_f.depth { should_pop = true }
                                else if top_f.delimiter == BlockDelimiter::Paren && lex.depth_after_paren <= top_f.depth { should_pop = true }
                            }
                            if should_pop { block_stack#.pop() } else { break }
                        }
                        if cur_line >= first_stored_line {
                            before_ring#.push(string::from(pat_text))
                        }
                    }
                    auto SyntaxFamily::Indent => {
                        if lex.participates_in_indent {
                            auto is_header = lex.code_text.as_str().trim().ends_with(":") || lex.starts_block
                            if is_header {
                                auto indent = lex.statement_indent
                                loop indent_stack.len() > 0:usize {
                                    auto top_idx = indent_stack.len() - 1:usize
                                    if indent_stack.borrow(top_idx).indent >= indent {
                                        indent_stack#.pop()
                                    } else {
                                        break
                                    }
                                }
                                indent_stack#.push(IndentStackFrame(line_number = cur_line, indent = indent))
                            }
                        }
                        if cur_line >= first_stored_line {
                            before_ring#.push(string::from(pat_text))
                        }
                    }
                }
            } else if cur_line == target_line {
                target_text = string::from(pat_text)
                target_found = true
                match family {
                    auto SyntaxFamily::Brace => {
                        if lex.starts_block {
                            block_start = target_line
                            delim = lex.delimiter
                            if delim == BlockDelimiter::Brace {
                                target_depth = lex.depth_before_brace
                            } else {
                                target_depth = lex.depth_before_paren
                            }
                        } else if block_stack.len() > 0:usize {
                            // Target line is inside or at the end of an existing block: preserve opener!
                            auto top_idx = block_stack.len() - 1:usize
                            auto &top_f = block_stack.borrow(top_idx)
                            block_start = top_f.line_number
                            delim = top_f.delimiter
                            target_depth = top_f.depth
                        } else {
                            block_start = target_line
                            delim = BlockDelimiter::Brace
                            target_depth = 0:usize
                        }

                        if block_start == target_line && check_is_self_closed_structured(delim, lex.depth_after_brace, lex.depth_after_paren, target_depth, lex.has_code_brace_closer, lex.has_code_paren_closer) {
                            block_end = target_line
                            block_closed = true
                        } else if block_start < target_line {
                            // Target line is the closer for this enclosing block!
                            if delim == BlockDelimiter::Brace && lex.depth_before_brace > target_depth && lex.depth_after_brace <= target_depth && lex.has_code_brace_closer {
                                block_end = target_line
                                block_closed = true
                            } else if delim == BlockDelimiter::Paren && lex.depth_before_paren > target_depth && lex.depth_after_paren <= target_depth && lex.has_code_paren_closer {
                                block_end = target_line
                                block_closed = true
                            }
                        }
                    }
                    auto SyntaxFamily::Indent => {
                        auto is_header = lex.participates_in_indent && (lex.code_text.as_str().trim().ends_with(":") || lex.starts_block)
                        if is_header {
                            target_indent = lex.statement_indent
                            block_start = target_line
                        } else if lex.participates_in_indent {
                            loop indent_stack.len() > 0:usize {
                                auto top_idx = indent_stack.len() - 1:usize
                                if indent_stack.borrow(top_idx).indent >= lex.statement_indent {
                                    indent_stack#.pop()
                                } else {
                                    break
                                }
                            }
                            if indent_stack.len() > 0:usize {
                                auto top_idx = indent_stack.len() - 1:usize
                                auto &top_f = indent_stack.borrow(top_idx)
                                block_start = top_f.line_number
                                target_indent = top_f.indent
                            } else {
                                target_indent = lex.statement_indent
                                block_start = target_line
                            }
                        } else {
                            // Target line does NOT participate in indent (inside multiline string / comment):
                            // Do NOT pop indent stack! Inherit enclosing block from top of stack.
                            if indent_stack.len() > 0:usize {
                                auto top_idx = indent_stack.len() - 1:usize
                                auto &top_f = indent_stack.borrow(top_idx)
                                block_start = top_f.line_number
                                target_indent = top_f.indent
                            } else {
                                target_indent = 0:usize
                                block_start = target_line
                            }
                        }
                    }
                }
                block_start = snap_block_start_decorators(block_start, first_stored_line, before_ring)
            } else if cur_line > target_line {
                if cur_line <= target_line + max_block_cap {
                    after_lines#.push(string::from(pat_text))
                }
                match family {
                    auto SyntaxFamily::Brace => {
                        if check_is_runaway_definition_structured(lex.is_scope_decl, lex.depth_before_brace, delim, target_depth) {
                            early_stop = true
                        } else {
                            match delim {
                                auto BlockDelimiter::Paren => {
                                    if lex.depth_before_paren > target_depth && lex.depth_after_paren <= target_depth && lex.has_code_paren_closer {
                                        block_end = cur_line
                                        block_closed = true
                                    }
                                }
                                auto BlockDelimiter::Brace => {
                                    if lex.depth_before_brace > target_depth && lex.depth_after_brace <= target_depth && lex.has_code_brace_closer {
                                        block_end = cur_line
                                        block_closed = true
                                    }
                                }
                            }
                        }
                    }
                    auto SyntaxFamily::Indent => {
                        if lex.participates_in_indent && lex.statement_indent <= target_indent {
                            block_end = cur_line - 1:usize
                            block_closed = true
                        }
                    }
                }
            }
            total_lines = cur_line
            line_buf#.clear()
        } else if !early_stop {
            total_lines = cur_line - 1:usize
        }

        libc_free(*buf)
        libc_fclose(*file)

        if read_err {
            auto err# = string::from("Error reading file '")
            err#.push_str(opts.file_path.as_str())
            err#.push_str("'")
            return Result<ViewResult, string>::Err(cede err)
        }
    }

    if !target_found {
        if total_lines == 0:usize {
            return Result<ViewResult, string>::Err(string::from("File is empty"))
        }
        auto err# = string::from("Line number out of bounds: file has ")
        err#.push_str(u64_to_string(total_lines as u64).as_str())
        err#.push_str(" lines, requested line ")
        err#.push_str(u64_to_string(target_line as u64).as_str())
        return Result<ViewResult, string>::Err(cede err)
    }

    // Indent blocks close at EOF gracefully
    if !block_closed && family == SyntaxFamily::Indent {
        block_end = total_lines
        block_closed = true
    }

    if !block_closed {
        return Result<ViewResult, string>::Err(string::from("Unclosed code block: block could not be deterministically closed (fail-closed)"))
    }

    if block_end < target_line {
        block_end = target_line
    }

    auto block_len = block_end - block_start + 1:usize
    auto is_block_truncated = block_len > max_block_cap

    auto avail_before = target_line - block_start
    auto avail_after = block_end - target_line
    auto win_lines# = block_len
    if is_block_truncated {
        win_lines = max_block_cap
    }

    auto take_before# = 0:usize
    auto take_after# = 0:usize
    if win_lines > 1:usize {
        auto half_before = (win_lines - 1:usize) / 2:usize
        auto half_after = (win_lines - 1:usize) - half_before
        if avail_before < half_before {
            take_before = avail_before
            take_after = win_lines - 1:usize - take_before
            if take_after > avail_after {
                take_after = avail_after
            }
        } else if avail_after < half_after {
            take_after = avail_after
            take_before = win_lines - 1:usize - take_after
            if take_before > avail_before {
                take_before = avail_before
            }
        } else {
            take_before = half_before
            take_after = half_after
        }
    }

    auto win_start = target_line - take_before
    auto win_end = target_line + take_after

    auto content_omitted# = false
    auto target_display# = target_text.as_str()
    if has_max_cols && max_cols_val > 0 && target_text.len() > max_cols_val {
        target_display = "[omitted]"
        content_omitted = true
    }

    auto target_entry# = string::new()
    target_entry#.push_str(u64_to_string(target_line as u64).as_str())
    target_entry#.push_str(":")
    target_entry#.push_str(target_display)
    target_entry#.push_str("\n")

    auto header# = string::new()
    header#.push_str("[block: L")
    header#.push_str(u64_to_string(block_start as u64).as_str())
    header#.push_str("-L")
    header#.push_str(u64_to_string(block_end as u64).as_str())
    header#.push_str("]\n")

    auto base_bytes = header.len() + target_entry.len()
    if has_max_bytes && base_bytes > max_bytes_val {
        auto err# = string::from("target_exceeds_max_result_bytes: Target line formatted record (")
        err#.push_str(u64_to_string(base_bytes as u64).as_str())
        err#.push_str(" bytes) exceeds max_result_bytes (")
        err#.push_str(u64_to_string(max_bytes_val as u64).as_str())
        err#.push_str(" bytes)")
        return Result<ViewResult, string>::Err(cede err)
    }

    auto rem_bytes# = 18446744073709551615:usize
    if has_max_bytes {
        rem_bytes = max_bytes_val - base_bytes
    }

    auto b_take_actual# = 0:usize
    auto a_take_actual# = 0:usize
    auto byte_truncated# = false

    loop b_take_actual < take_before || a_take_actual < take_after {
        auto can_b = b_take_actual < take_before
        auto can_a = a_take_actual < take_after
        if !can_b && !can_a {
            break
        }

        if can_b && (b_take_actual <= a_take_actual || !can_a) {
            auto b_line_num = target_line - 1:usize - b_take_actual
            auto ring_idx = b_line_num - first_stored_line
            auto b_raw = before_ring.borrow(ring_idx).as_str()
            auto b_disp# = b_raw
            if has_max_cols && max_cols_val > 0 && b_raw.len > max_cols_val {
                b_disp = "[omitted]"
                content_omitted = true
            }
            auto b_len = u64_to_string(b_line_num as u64).len() + 1:usize + b_disp.len + 1:usize
            if has_max_bytes && b_len > rem_bytes {
                byte_truncated = true
                break
            }
            if has_max_bytes {
                rem_bytes = rem_bytes - b_len
            }
            b_take_actual = b_take_actual + 1:usize
        }

        if can_a && (a_take_actual < b_take_actual || !can_b) {
            auto a_line_num = target_line + 1:usize + a_take_actual
            auto after_idx = a_take_actual
            auto a_raw = after_lines.borrow(after_idx).as_str()
            auto a_disp# = a_raw
            if has_max_cols && max_cols_val > 0 && a_raw.len > max_cols_val {
                a_disp = "[omitted]"
                content_omitted = true
            }
            auto a_len = u64_to_string(a_line_num as u64).len() + 1:usize + a_disp.len + 1:usize
            if has_max_bytes && a_len > rem_bytes {
                byte_truncated = true
                break
            }
            if has_max_bytes {
                rem_bytes = rem_bytes - a_len
            }
            a_take_actual = a_take_actual + 1:usize
        }
    }

    auto truncated# = false
    auto trunc_reason# = string::from("completed")
    if byte_truncated {
        truncated = true
        trunc_reason = string::from("max_result_bytes")
    } else if is_block_truncated {
        truncated = true
        if has_max_lines && max_lines_val <= opts.max_block_lines {
            trunc_reason = string::from("max_lines")
        } else {
            trunc_reason = string::from("max_block_lines")
        }
    }

    auto out# = string::new()
    out#.push_str(header.as_str())

    auto records# = Vec<ViewLineRecord>::new()

    // 1. Before lines
    if b_take_actual > 0:usize {
        auto idx# = b_take_actual
        loop idx > 0:usize {
            auto b_line_num = target_line - idx
            auto ring_idx = b_line_num - first_stored_line
            auto b_raw = before_ring.borrow(ring_idx).as_str()
            auto b_disp# = b_raw
            if has_max_cols && max_cols_val > 0 && b_raw.len > max_cols_val {
                b_disp = "[omitted]"
            }
            out#.push_str(u64_to_string(b_line_num as u64).as_str())
            out#.push_str("-")
            out#.push_str(b_disp)
            out#.push_str("\n")
            records#.push(ViewLineRecord(
                line_number = b_line_num,
                kind = string::from("context"),
                text = string::from(b_disp)
            ))
            idx = idx - 1:usize
        }
    }

    // 2. Target line
    out#.push_str(target_entry.as_str())
    records#.push(ViewLineRecord(
        line_number = target_line,
        kind = string::from("target"),
        text = string::from(target_display)
    ))

    // 3. After lines
    auto a_idx# = 0:usize
    loop a_idx < a_take_actual {
        auto a_line_num = target_line + 1:usize + a_idx
        auto a_raw = after_lines.borrow(a_idx).as_str()
        auto a_disp# = a_raw
        if has_max_cols && max_cols_val > 0 && a_raw.len > max_cols_val {
            a_disp = "[omitted]"
        }
        out#.push_str(u64_to_string(a_line_num as u64).as_str())
        out#.push_str("-")
        out#.push_str(a_disp)
        out#.push_str("\n")
        records#.push(ViewLineRecord(
            line_number = a_line_num,
            kind = string::from("context"),
            text = string::from(a_disp)
        ))
        a_idx = a_idx + 1:usize
    }

    auto first_line = target_line - b_take_actual
    auto last_line = target_line + a_take_actual
    auto lines_emitted = 1:usize + b_take_actual + a_take_actual
    auto bytes_emitted = out.len()
    auto out_stat# = string::from("complete")
    if truncated {
        out_stat = string::from("budget_truncated")
    }

    return Result<ViewResult, string>::Ok(ViewResult(
        text = cede out,
        truncated = truncated,
        reason = cede trunc_reason,
        lines_emitted = lines_emitted,
        bytes_emitted = bytes_emitted,
        mode = string::from("block"),
        path = opts.file_path.clone(),
        requested_line = Option<usize>::Some(target_line),
        requested_range = Option<BlockRange>::None,
        detected_block_range = Option<BlockRange>::Some(BlockRange(start = block_start, end = block_end)),
        emitted_range = Option<BlockRange>::Some(BlockRange(start = first_line, end = last_line)),
        target_included = Option<bool>::Some(true),
        content_omitted = content_omitted,
        complete = !truncated,
        eof_reached = eof_reached,
        records = cede records,
        selection_status = string::from("found"),
        range_status = Option<string>::None,
        output_status = cede out_stat,
        target_symbol = Vec<SymbolTargetInfo>::new(),
        candidates = Vec<SymbolCandidateInfo>::new(),
        candidates_truncated = false
    ))
}

fn execute_view_stream_symbol(opts: ViewOptions) -> Result<ViewResult, string> {
    auto target_name# = string::new()
    match opts.symbol {
        auto Option<string>::Some(&s) => {
            target_name = string::from(s.as_str())
        }
        auto Option<string>::None => {}
    }
    auto target_has_scope# = false
    auto target_scope# = string::new()
    match opts.symbol_scope {
        auto Option<string>::Some(&sc) => {
            target_has_scope = true
            target_scope = string::from(sc.as_str())
        }
        auto Option<string>::None => {}
    }

    // 1. Syntax check
    if !is_symbol_view_supported(opts.file_path.as_str()) {
        auto msg# = string::from("trg view: file '")
        msg#.push_str(opts.file_path.as_str())
        msg#.push_str("' has unsupported syntax for symbol view")
        return Result<ViewResult, string>::Ok(ViewResult(
            text = cede msg,
            truncated = false,
            reason = string::from("unsupported_syntax"),
            lines_emitted = 0:usize,
            bytes_emitted = 0:usize,
            mode = string::from("symbol"),
            path = string::from(opts.file_path.as_str()),
            requested_line = Option<usize>::None,
            requested_range = Option<BlockRange>::None,
            detected_block_range = Option<BlockRange>::None,
            emitted_range = Option<BlockRange>::None,
            target_included = Option<bool>::None,
            content_omitted = false,
            complete = false,
            eof_reached = false,
            records = Vec<ViewLineRecord>::new(),
            selection_status = string::from("unsupported_syntax"),
            range_status = Option<string>::None,
            output_status = string::from("complete"),
            target_symbol = Vec<SymbolTargetInfo>::new(),
            candidates = Vec<SymbolCandidateInfo>::new(),
            candidates_truncated = false
        ))
    }

    // 2. Single bounded read into memory (10MB ceiling)
    auto path_str = string::from(opts.file_path.as_str())
    auto mode_buf# = [0:char; 4]
    mode_buf[0] = 'r' as char
    mode_buf[1] = 'b' as char
    mode_buf[2] = 0 as char

    auto lines# = Vec<string>::new()
    auto read_err# = false
    auto size_exceeded# = false
    auto open_err# = false
    auto bytes_read_accum# = 0:usize
    auto max_file_read_bytes = 10485760:usize

    unsafe {
        auto *mode_ptr = &mode_buf[0] as *char
        auto *path_c = path_str.c_str()
        auto nul *fp = libc_fopen(*path_c, *mode_ptr)
        if *fp == null {
            open_err = true
        } else {
            auto *file = fp.unwrap()
            auto nul *raw_buf = libc_malloc(65536:usize)
            if *raw_buf == null {
                libc_fclose(*file)
                read_err = true
            } else {
                auto *buf = raw_buf.unwrap()
                auto line_buf# = string::new()

                loop true {
                    auto n = libc_fread(*buf, 1:usize, 65536:usize, *file)
                    if n == 0 {
                        if posix_ferror((*file) as Addr) {
                            read_err = true
                        }
                        break
                    }

                    bytes_read_accum = bytes_read_accum + n
                    if bytes_read_accum > max_file_read_bytes {
                        size_exceeded = true
                        break
                    }

                    auto *c_ptr = ((*buf) as Addr) as *char
                    auto chunk_str = string::from_with_len(*c_ptr, n)
                    auto chunk_view = chunk_str.as_str()
                    auto cursor# = 0:usize

                    loop cursor < chunk_view.len {
                        auto rem = chunk_view.substr(cursor, chunk_view.len - cursor)
                        auto nl_opt = rem.index_of('\n' as char)
                        if nl_opt.is_none() {
                            line_buf#.push_str(rem)
                            break
                        }
                        auto nl_pos = nl_opt.unwrap()
                        auto chunk_slice = rem.substr(0, nl_pos)
                        line_buf#.push_str(chunk_slice)
                        lines#.push(line_buf.clone())
                        line_buf#.clear()
                        cursor = cursor + nl_pos + 1:usize
                    }
                }

                if !read_err && !size_exceeded && line_buf.len() > 0 {
                    lines#.push(line_buf.clone())
                    line_buf#.clear()
                }

                libc_free(*buf)
                libc_fclose(*file)
            }
        }
    }

    if open_err || read_err {
        auto msg# = string::from("trg view: error reading '")
        msg#.push_str(opts.file_path.as_str())
        msg#.push_str("'")
        return Result<ViewResult, string>::Ok(ViewResult(
            text = cede msg,
            truncated = false,
            reason = string::from("io_error"),
            lines_emitted = 0:usize,
            bytes_emitted = 0:usize,
            mode = string::from("symbol"),
            path = string::from(opts.file_path.as_str()),
            requested_line = Option<usize>::None,
            requested_range = Option<BlockRange>::None,
            detected_block_range = Option<BlockRange>::None,
            emitted_range = Option<BlockRange>::None,
            target_included = Option<bool>::None,
            content_omitted = false,
            complete = false,
            eof_reached = false,
            records = Vec<ViewLineRecord>::new(),
            selection_status = string::from("io_error"),
            range_status = Option<string>::None,
            output_status = string::from("complete"),
            target_symbol = Vec<SymbolTargetInfo>::new(),
            candidates = Vec<SymbolCandidateInfo>::new(),
            candidates_truncated = false
        ))
    }

    if size_exceeded {
        auto msg# = string::from("trg view: symbol scan incomplete for '")
        msg#.push_str(opts.file_path.as_str())
        msg#.push_str("' (file too large, exceeds 10MiB input read limit)")
        return Result<ViewResult, string>::Ok(ViewResult(
            text = cede msg,
            truncated = true,
            reason = string::from("scan_incomplete"),
            lines_emitted = 0:usize,
            bytes_emitted = 0:usize,
            mode = string::from("symbol"),
            path = string::from(opts.file_path.as_str()),
            requested_line = Option<usize>::None,
            requested_range = Option<BlockRange>::None,
            detected_block_range = Option<BlockRange>::None,
            emitted_range = Option<BlockRange>::None,
            target_included = Option<bool>::None,
            content_omitted = false,
            complete = false,
            eof_reached = false,
            records = Vec<ViewLineRecord>::new(),
            selection_status = string::from("scan_incomplete"),
            range_status = Option<string>::None,
            output_status = string::from("complete"),
            target_symbol = Vec<SymbolTargetInfo>::new(),
            candidates = Vec<SymbolCandidateInfo>::new(),
            candidates_truncated = false
        ))
    }

    // 3. Scan symbols from in-memory lines
    auto sym_res = outline_symbols_lines(lines, opts.file_path.as_str(), Option<Vec<string>>::None, Option<usize>::Some(5000:usize), Option<usize>::None)
    if sym_res.is_err() {
        auto msg# = string::from("trg view: error scanning symbols for '")
        msg#.push_str(opts.file_path.as_str())
        msg#.push_str("'")
        return Result<ViewResult, string>::Ok(ViewResult(
            text = cede msg,
            truncated = false,
            reason = string::from("io_error"),
            lines_emitted = 0:usize,
            bytes_emitted = 0:usize,
            mode = string::from("symbol"),
            path = string::from(opts.file_path.as_str()),
            requested_line = Option<usize>::None,
            requested_range = Option<BlockRange>::None,
            detected_block_range = Option<BlockRange>::None,
            emitted_range = Option<BlockRange>::None,
            target_included = Option<bool>::None,
            content_omitted = false,
            complete = false,
            eof_reached = false,
            records = Vec<ViewLineRecord>::new(),
            selection_status = string::from("io_error"),
            range_status = Option<string>::None,
            output_status = string::from("complete"),
            target_symbol = Vec<SymbolTargetInfo>::new(),
            candidates = Vec<SymbolCandidateInfo>::new(),
            candidates_truncated = false
        ))
    }

    auto sym_data = sym_res.unwrap()
    if sym_data.truncated {
        auto msg# = string::from("trg view: symbol scan incomplete for '")
        msg#.push_str(opts.file_path.as_str())
        msg#.push_str("' (internal symbol limit 5000 exceeded)")
        return Result<ViewResult, string>::Ok(ViewResult(
            text = cede msg,
            truncated = true,
            reason = string::from("scan_incomplete"),
            lines_emitted = 0:usize,
            bytes_emitted = 0:usize,
            mode = string::from("symbol"),
            path = string::from(opts.file_path.as_str()),
            requested_line = Option<usize>::None,
            requested_range = Option<BlockRange>::None,
            detected_block_range = Option<BlockRange>::None,
            emitted_range = Option<BlockRange>::None,
            target_included = Option<bool>::None,
            content_omitted = false,
            complete = false,
            eof_reached = false,
            records = Vec<ViewLineRecord>::new(),
            selection_status = string::from("scan_incomplete"),
            range_status = Option<string>::None,
            output_status = string::from("complete"),
            target_symbol = Vec<SymbolTargetInfo>::new(),
            candidates = Vec<SymbolCandidateInfo>::new(),
            candidates_truncated = false
        ))
    }

    // 4. Candidate matching
    auto matched_indices# = Vec<usize>::new()
    auto si# = 0:usize
    loop si < sym_data.symbols.len() {
        auto &s = sym_data.symbols.borrow(si)
        if s.name.as_str() == target_name.as_str() {
            auto scope_matches# = true
            if target_has_scope {
                if s.scope.as_str() != target_scope.as_str() {
                    scope_matches = false
                }
            }
            if scope_matches {
                matched_indices#.push(si)
            }
        }
        si = si + 1:usize
    }

    if matched_indices.len() == 0:usize {
        auto msg# = string::from("trg view: symbol '")
        msg#.push_str(target_name.as_str())
        if target_has_scope {
            msg#.push_str("' in scope '")
            msg#.push_str(target_scope.as_str())
        }
        msg#.push_str("' not found in ")
        msg#.push_str(opts.file_path.as_str())

        return Result<ViewResult, string>::Ok(ViewResult(
            text = cede msg,
            truncated = false,
            reason = string::from("completed"),
            lines_emitted = 0:usize,
            bytes_emitted = 0:usize,
            mode = string::from("symbol"),
            path = string::from(opts.file_path.as_str()),
            requested_line = Option<usize>::None,
            requested_range = Option<BlockRange>::None,
            detected_block_range = Option<BlockRange>::None,
            emitted_range = Option<BlockRange>::None,
            target_included = Option<bool>::None,
            content_omitted = false,
            complete = true,
            eof_reached = true,
            records = Vec<ViewLineRecord>::new(),
            selection_status = string::from("not_found"),
            range_status = Option<string>::None,
            output_status = string::from("complete"),
            target_symbol = Vec<SymbolTargetInfo>::new(),
            candidates = Vec<SymbolCandidateInfo>::new(),
            candidates_truncated = false
        ))
    }

    auto max_lines_val# = 0:usize
    auto has_max_lines# = false
    match opts.max_lines {
        auto Option<usize>::Some(ml) => {
            max_lines_val = ml
            has_max_lines = true
        }
        auto Option<usize>::None => {}
    }

    auto max_bytes_val# = 0:usize
    auto has_max_bytes# = false
    match opts.max_result_bytes {
        auto Option<usize>::Some(mb) => {
            max_bytes_val = mb
            has_max_bytes = true
        }
        auto Option<usize>::None => {}
    }

    auto max_cols_val# = 0:usize
    auto has_max_cols# = false
    match opts.max_columns {
        auto Option<usize>::Some(mc) => {
            max_cols_val = mc
            has_max_cols = true
        }
        auto Option<usize>::None => {}
    }

    if matched_indices.len() > 1:usize {
        auto total_matched = matched_indices.len()
        auto same_scope# = true
        auto first_idx = matched_indices.get(0)
        auto first_scope = string::from(sym_data.symbols.borrow(first_idx).scope.as_str())

        auto all_cands# = Vec<SymbolCandidateInfo>::new()
        auto cand_lines# = Vec<string>::new()

        auto mi# = 0:usize
        loop mi < total_matched {
            auto cand_idx = matched_indices.get(mi)
            auto &cand_sym = sym_data.symbols.borrow(cand_idx)
            if cand_sym.scope.as_str() != first_scope.as_str() {
                same_scope = false
            }
            auto cand_r_status# = string::from("confirmed")
            if cand_sym.range_reliability == "eof_fallback" || cand_sym.range_end.is_none() {
                cand_r_status = string::from("unknown")
            }

            auto cline# = string::new()
            cline#.push_str("  line ")
            cline#.push_str(u64_to_string(cand_sym.line as u64).as_str())
            cline#.push_str(": ")
            cline#.push_str(cand_sym.kind.as_str())
            cline#.push_str(" ")
            cline#.push_str(cand_sym.name.as_str())
            if cand_sym.scope.len() > 0:usize {
                cline#.push_str(" (scope: ")
                cline#.push_str(cand_sym.scope.as_str())
                cline#.push_str(")")
            }
            cline#.push_str(" - ")
            cline#.push_str(cand_sym.detail.as_str())
            cline#.push_str("\n")
            cand_lines#.push(cede cline)

            all_cands#.push(SymbolCandidateInfo(
                name = string::from(cand_sym.name.as_str()),
                kind = string::from(cand_sym.kind.as_str()),
                line = cand_sym.line,
                range_start = cand_sym.range_start,
                range_end = cand_sym.range_end,
                range_status = cede cand_r_status,
                scope = string::from(cand_sym.scope.as_str()),
                detail = string::from(cand_sym.detail.as_str())
            ))
            mi = mi + 1:usize
        }

        auto diag_head# = string::new()
        diag_head#.push_str("Multiple candidates found for symbol '")
        diag_head#.push_str(target_name.as_str())
        diag_head#.push_str("':\n")

        auto hint# = string::new()
        if same_scope {
            hint#.push_str("Hint: use 'trg view <path>:<line>' to select by line number\n")
        } else {
            hint#.push_str("Hint: specify enclosing scope with --scope <SCOPE> or --symbol '<SCOPE>::<NAME>'\n")
        }

        // Check minimum diagnostic byte budget (header + candidate 0 + omission + hint)
        auto min_bytes# = diag_head.len() + cand_lines.borrow(0).len() + hint.len()
        if total_matched > 1:usize {
            auto min_om# = string::from("  [and ")
            min_om#.push_str(u64_to_string((total_matched - 1:usize) as u64).as_str())
            min_om#.push_str(" more candidates omitted]\n")
            min_bytes = min_bytes + min_om.len()
        }
        if has_max_bytes && min_bytes > max_bytes_val {
            auto err# = string::from("target_exceeds_max_result_bytes: Multiple candidates diagnostic (")
            err#.push_str(u64_to_string(min_bytes as u64).as_str())
            err#.push_str(" bytes) exceeds max_result_bytes (")
            err#.push_str(u64_to_string(max_bytes_val as u64).as_str())
            err#.push_str(" bytes)")
            return Result<ViewResult, string>::Err(cede err)
        }

        auto max_k# = total_matched
        if max_k > 20:usize {
            max_k = 20:usize
        }

        auto chosen_k# = 1:usize
        auto k# = max_k
        loop k >= 1:usize {
            auto cand_bytes# = 0:usize
            auto ci# = 0:usize
            loop ci < k {
                cand_bytes = cand_bytes + cand_lines.borrow(ci).len()
                ci = ci + 1:usize
            }
            auto om_bytes# = 0:usize
            if k < total_matched {
                auto om# = string::from("  [and ")
                om#.push_str(u64_to_string((total_matched - k) as u64).as_str())
                om#.push_str(" more candidates omitted]\n")
                om_bytes = om.len()
            }
            auto total_d_bytes = diag_head.len() + cand_bytes + om_bytes + hint.len()
            if !has_max_bytes || total_d_bytes <= max_bytes_val {
                chosen_k = k
                break
            }
            k = k - 1:usize
        }

        auto diag# = string::new()
        diag#.push_str(diag_head.as_str())
        auto ci# = 0:usize
        loop ci < chosen_k {
            diag#.push_str(cand_lines.borrow(ci).as_str())
            ci = ci + 1:usize
        }
        auto is_cands_truncated = chosen_k < total_matched
        if is_cands_truncated {
            diag#.push_str("  [and ")
            diag#.push_str(u64_to_string((total_matched - chosen_k) as u64).as_str())
            diag#.push_str(" more candidates omitted]\n")
        }
        diag#.push_str(hint.as_str())

        auto final_cands# = Vec<SymbolCandidateInfo>::new()
        auto fci# = 0:usize
        loop fci < chosen_k {
            auto &c = all_cands.borrow(fci)
            final_cands#.push(SymbolCandidateInfo(
                name = string::from(c.name.as_str()),
                kind = string::from(c.kind.as_str()),
                line = c.line,
                range_start = c.range_start,
                range_end = c.range_end,
                range_status = string::from(c.range_status.as_str()),
                scope = string::from(c.scope.as_str()),
                detail = string::from(c.detail.as_str())
            ))
            fci = fci + 1:usize
        }

        auto diag_len = diag.len()
        auto is_budget_truncated = has_max_bytes && is_cands_truncated
        auto reason_str# = string::from("completed")
        auto output_status_str# = string::from("complete")
        if is_budget_truncated {
            reason_str = string::from("max_result_bytes")
            output_status_str = string::from("budget_truncated")
        }

        return Result<ViewResult, string>::Ok(ViewResult(
            text = cede diag,
            truncated = is_budget_truncated,
            reason = cede reason_str,
            lines_emitted = 0:usize,
            bytes_emitted = diag_len,
            mode = string::from("symbol"),
            path = string::from(opts.file_path.as_str()),
            requested_line = Option<usize>::None,
            requested_range = Option<BlockRange>::None,
            detected_block_range = Option<BlockRange>::None,
            emitted_range = Option<BlockRange>::None,
            target_included = Option<bool>::None,
            content_omitted = false,
            complete = !is_budget_truncated,
            eof_reached = true,
            records = Vec<ViewLineRecord>::new(),
            selection_status = string::from("multiple_candidates"),
            range_status = Option<string>::None,
            output_status = cede output_status_str,
            target_symbol = Vec<SymbolTargetInfo>::new(),
            candidates = cede final_cands,
            candidates_truncated = is_cands_truncated
        ))
    }

    auto target_sym_idx = matched_indices.get(0)
    auto &target_sym = sym_data.symbols.borrow(target_sym_idx)

    auto range_status_str# = string::from("confirmed")
    if target_sym.range_reliability == "eof_fallback" || target_sym.range_end.is_none() {
        range_status_str = string::from("unknown")
    }

    auto total_file_lines = lines.len()
    auto sym_start# = target_sym.range_start + 0:usize
    auto sym_end# = target_sym.line + 0:usize
    match target_sym.range_end {
        auto Option<usize>::Some(re) => {
            sym_end = re + 0:usize
        }
        auto Option<usize>::None => {}
    }
    if range_status_str == "unknown" {
        sym_end = sym_start + opts.max_block_lines - 1:usize
        if sym_end > total_file_lines {
            sym_end = total_file_lines
        }
    }
    if sym_end > total_file_lines {
        sym_end = total_file_lines
    }
    if sym_start > sym_end {
        sym_start = sym_end
    }

    auto header# = string::new()
    if range_status_str == "confirmed" {
        header#.push_str("[symbol: ")
        header#.push_str(target_sym.name.as_str())
        if target_sym.scope.len() > 0:usize {
            header#.push_str(", scope: ")
            header#.push_str(target_sym.scope.as_str())
        }
        header#.push_str(", lines: L")
        header#.push_str(u64_to_string(sym_start as u64).as_str())
        header#.push_str("-L")
        header#.push_str(u64_to_string(sym_end as u64).as_str())
        header#.push_str("]\n")
    } else {
        header#.push_str("[symbol: ")
        header#.push_str(target_sym.name.as_str())
        if target_sym.scope.len() > 0:usize {
            header#.push_str(", scope: ")
            header#.push_str(target_sym.scope.as_str())
        }
        header#.push_str(", preview: L")
        header#.push_str(u64_to_string(sym_start as u64).as_str())
        header#.push_str("-L")
        header#.push_str(u64_to_string(sym_end as u64).as_str())
        header#.push_str(" (unclosed structure)]\n")
    }

    if has_max_lines && max_lines_val < 1:usize {
        return Result<ViewResult, string>::Err(string::from("target_exceeds_max_lines: Target line cannot fit within max_lines 0"))
    }

    auto target_line_no = target_sym.line
    auto target_raw_text# = ""
    if target_line_no >= 1:usize && target_line_no <= total_file_lines {
        target_raw_text = lines.borrow(target_line_no - 1:usize).as_str()
        if target_raw_text.len > 0 && target_raw_text.byte_at(target_raw_text.len - 1) == ('\r' as char) {
            target_raw_text = target_raw_text.substr(0, target_raw_text.len - 1)
        }
    }
    auto content_omitted# = false
    auto target_disp# = target_raw_text
    if has_max_cols && max_cols_val > 0 && target_raw_text.len > max_cols_val {
        target_disp = "[omitted]"
        content_omitted = true
    }
    auto target_entry# = string::new()
    target_entry#.push_str(u64_to_string(target_line_no as u64).as_str())
    target_entry#.push_str(":")
    target_entry#.push_str(target_disp)
    target_entry#.push_str("\n")

    auto base_bytes = header.len() + target_entry.len()
    if has_max_bytes && base_bytes > max_bytes_val {
        auto err# = string::from("target_exceeds_max_result_bytes: Target line formatted record (")
        err#.push_str(u64_to_string(base_bytes as u64).as_str())
        err#.push_str(" bytes) exceeds max_result_bytes (")
        err#.push_str(u64_to_string(max_bytes_val as u64).as_str())
        err#.push_str(" bytes)")
        return Result<ViewResult, string>::Err(cede err)
    }

    auto avail_before = target_line_no - sym_start
    auto avail_after = sym_end - target_line_no
    auto block_len = sym_end - sym_start + 1:usize

    auto win_lines# = block_len
    if has_max_lines && win_lines > max_lines_val {
        win_lines = max_lines_val
    }

    auto take_before# = 0:usize
    auto take_after# = 0:usize
    if win_lines > 1:usize {
        auto half_before = (win_lines - 1:usize) / 2:usize
        auto half_after = (win_lines - 1:usize) - half_before
        if avail_before < half_before {
            take_before = avail_before
            take_after = win_lines - 1:usize - take_before
            if take_after > avail_after {
                take_after = avail_after
            }
        } else if avail_after < half_after {
            take_after = avail_after
            take_before = win_lines - 1:usize - take_after
            if take_before > avail_before {
                take_before = avail_before
            }
        } else {
            take_before = half_before
            take_after = half_after
        }
    }

    auto rem_bytes# = 18446744073709551615:usize
    if has_max_bytes {
        rem_bytes = max_bytes_val - base_bytes
    }

    auto b_take_actual# = 0:usize
    auto a_take_actual# = 0:usize
    auto byte_truncated# = false

    loop b_take_actual < take_before || a_take_actual < take_after {
        auto can_b = b_take_actual < take_before
        auto can_a = a_take_actual < take_after
        if !can_b && !can_a {
            break
        }

        if can_b && (b_take_actual <= a_take_actual || !can_a) {
            auto b_line_num = target_line_no - 1:usize - b_take_actual
            auto b_raw = lines.borrow(b_line_num - 1:usize).as_str()
            auto clean_b# = b_raw
            if b_raw.len > 0 && b_raw.byte_at(b_raw.len - 1) == ('\r' as char) {
                clean_b = b_raw.substr(0, b_raw.len - 1)
            }
            auto b_disp# = clean_b
            if has_max_cols && max_cols_val > 0 && clean_b.len > max_cols_val {
                b_disp = "[omitted]"
                content_omitted = true
            }
            auto b_len = u64_to_string(b_line_num as u64).len() + 1:usize + b_disp.len + 1:usize
            if has_max_bytes && b_len > rem_bytes {
                byte_truncated = true
                break
            }
            if has_max_bytes {
                rem_bytes = rem_bytes - b_len
            }
            b_take_actual = b_take_actual + 1:usize
        }

        if can_a && (a_take_actual < b_take_actual || !can_b) {
            auto a_line_num = target_line_no + 1:usize + a_take_actual
            auto a_raw = lines.borrow(a_line_num - 1:usize).as_str()
            auto clean_a# = a_raw
            if a_raw.len > 0 && a_raw.byte_at(a_raw.len - 1) == ('\r' as char) {
                clean_a = a_raw.substr(0, a_raw.len - 1)
            }
            auto a_disp# = clean_a
            if has_max_cols && max_cols_val > 0 && clean_a.len > max_cols_val {
                a_disp = "[omitted]"
                content_omitted = true
            }
            auto a_len = u64_to_string(a_line_num as u64).len() + 1:usize + a_disp.len + 1:usize
            if has_max_bytes && a_len > rem_bytes {
                byte_truncated = true
                break
            }
            if has_max_bytes {
                rem_bytes = rem_bytes - a_len
            }
            a_take_actual = a_take_actual + 1:usize
        }
    }

    auto truncated# = false
    auto trunc_reason# = string::from("completed")
    if byte_truncated {
        truncated = true
        trunc_reason = string::from("max_result_bytes")
    } else if has_max_lines && (1:usize + b_take_actual + a_take_actual < block_len) {
        truncated = true
        trunc_reason = string::from("max_lines")
    }

    auto out# = string::new()
    out#.push_str(header.as_str())

    auto records# = Vec<ViewLineRecord>::new()
    auto bytes_emitted# = header.len()
    auto lines_emitted = 1:usize + b_take_actual + a_take_actual

    // 1. Lines before target
    if b_take_actual > 0:usize {
        auto idx# = b_take_actual
        loop idx > 0:usize {
            auto l_num = target_line_no - idx
            auto raw = lines.borrow(l_num - 1:usize).as_str()
            auto clean_l# = raw
            if raw.len > 0 && raw.byte_at(raw.len - 1) == ('\r' as char) {
                clean_l = raw.substr(0, raw.len - 1)
            }
            auto disp# = clean_l
            if has_max_cols && max_cols_val > 0 && clean_l.len > max_cols_val {
                disp = "[omitted]"
            }
            auto line_entry# = string::new()
            line_entry#.push_str(u64_to_string(l_num as u64).as_str())
            line_entry#.push_str("-")
            line_entry#.push_str(disp)
            line_entry#.push_str("\n")
            bytes_emitted = bytes_emitted + line_entry.len()
            out#.push_str(line_entry.as_str())
            records#.push(ViewLineRecord(
                line_number = l_num,
                kind = string::from("context"),
                text = string::from(disp)
            ))
            idx = idx - 1:usize
        }
    }

    // 2. Target line
    bytes_emitted = bytes_emitted + target_entry.len()
    out#.push_str(target_entry.as_str())
    records#.push(ViewLineRecord(
        line_number = target_line_no,
        kind = string::from("target"),
        text = string::from(target_disp)
    ))

    // 3. Lines after target
    if a_take_actual > 0:usize {
        auto idx# = 1:usize
        loop idx <= a_take_actual {
            auto l_num = target_line_no + idx
            auto raw = lines.borrow(l_num - 1:usize).as_str()
            auto clean_l# = raw
            if raw.len > 0 && raw.byte_at(raw.len - 1) == ('\r' as char) {
                clean_l = raw.substr(0, raw.len - 1)
            }
            auto disp# = clean_l
            if has_max_cols && max_cols_val > 0 && clean_l.len > max_cols_val {
                disp = "[omitted]"
            }
            auto line_entry# = string::new()
            line_entry#.push_str(u64_to_string(l_num as u64).as_str())
            line_entry#.push_str("-")
            line_entry#.push_str(disp)
            line_entry#.push_str("\n")
            bytes_emitted = bytes_emitted + line_entry.len()
            out#.push_str(line_entry.as_str())
            records#.push(ViewLineRecord(
                line_number = l_num,
                kind = string::from("context"),
                text = string::from(disp)
            ))
            idx = idx + 1:usize
        }
    }

    auto emitted_range = Option<BlockRange>::Some(BlockRange(
        start = target_line_no - b_take_actual,
        end = target_line_no + a_take_actual
    ))

    auto target_included = Option<bool>::Some(true)

    auto target_info = SymbolTargetInfo(
        name = string::from(target_sym.name.as_str()),
        kind = string::from(target_sym.kind.as_str()),
        line = target_sym.line,
        range_start = target_sym.range_start,
        range_end = target_sym.range_end,
        range_status = string::from(range_status_str.as_str()),
        scope = string::from(target_sym.scope.as_str()),
        detail = string::from(target_sym.detail.as_str())
    )

    auto detected_block = BlockRange(start = sym_start, end = sym_end)
    auto requested_block# = Option<BlockRange>::None
    if range_status_str == "confirmed" {
        requested_block = Option<BlockRange>::Some(detected_block.clone())
    }

    auto output_status_str# = string::from("complete")
    if truncated {
        output_status_str = string::from("budget_truncated")
    }

    auto target_vec# = Vec<SymbolTargetInfo>::new()
    target_vec#.push(target_info)

    return Result<ViewResult, string>::Ok(ViewResult(
        text = cede out,
        truncated = truncated,
        reason = cede trunc_reason,
        lines_emitted = lines_emitted,
        bytes_emitted = bytes_emitted,
        mode = string::from("symbol"),
        path = string::from(opts.file_path.as_str()),
        requested_line = Option<usize>::Some(target_line_no),
        requested_range = requested_block,
        detected_block_range = Option<BlockRange>::Some(detected_block),
        emitted_range = emitted_range,
        target_included = target_included,
        content_omitted = content_omitted,
        complete = !truncated,
        eof_reached = !truncated && (sym_end == total_file_lines),
        records = cede records,
        selection_status = string::from("found"),
        range_status = Option<string>::Some(cede range_status_str),
        output_status = cede output_status_str,
        target_symbol = cede target_vec,
        candidates = Vec<SymbolCandidateInfo>::new(),
        candidates_truncated = false
    ))
}

pub fn execute_view_operation(opts: ViewOptions) -> Result<ViewResult, string> {
    if opts.symbol.is_some() {
        if opts.line.is_some() {
            return Result<ViewResult, string>::Err(string::from("Cannot specify both 'symbol' and target line"))
        }
        if opts.lines_range.is_some() {
            return Result<ViewResult, string>::Err(string::from("Cannot specify both 'symbol' and 'lines'"))
        }
        if opts.block {
            return Result<ViewResult, string>::Err(string::from("Cannot specify both 'symbol' and 'block'"))
        }
        return execute_view_stream_symbol(opts)
    }

    if opts.symbol_scope.is_some() {
        return Result<ViewResult, string>::Err(string::from("Cannot specify 'scope' without 'symbol'"))
    }

    if opts.lines_range.is_some() && opts.line.is_some() {
        return Result<ViewResult, string>::Err(string::from("Cannot specify both 'line' and 'lines'"))
    }
    if opts.block && opts.lines_range.is_some() {
        return Result<ViewResult, string>::Err(string::from("'block' cannot be used with explicit 'lines' range"))
    }

    match opts.lines_range {
        auto Option<BlockRange>::Some(range) => {
            return execute_view_stream_lines(opts, range.start, range.end)
        }
        auto Option<BlockRange>::None => {}
    }

    auto target_line# = 0:usize
    match opts.line {
        auto Option<usize>::Some(l) => {
            target_line = l
        }
        auto Option<usize>::None => {
            return Result<ViewResult, string>::Err(string::from("Viewing requires a target line number (e.g. <path>:<line>)"))
        }
    }

    if target_line == 0:usize {
        return Result<ViewResult, string>::Err(string::from("Line number must be >= 1"))
    }

    if opts.block {
        return execute_view_stream_block(opts, target_line)
    }

    return execute_view_stream_point(opts, target_line)
}

pub fn execute_view_cli(args: Vec<string>) -> i32 {
    auto num_args = args.len()
    if num_args < 3:usize {
        print_err("Usage: trg view <path>:<line> [-C N] [--block] | trg view <path> --lines <start>-<end> | trg view <path> --symbol <SPEC> [--scope <SCOPE>]")
        return 2
    }

    auto path_opt# = Option<string>::None
    auto line_opt# = Option<usize>::None
    auto context# = 10:usize
    auto context_passed# = false
    auto block# = false
    auto lines_range# = Option<BlockRange>::None
    auto symbol_raw_opt# = Option<string>::None
    auto scope_raw_opt# = Option<string>::None
    auto max_lines_opt# = Option<usize>::None
    auto max_bytes_opt# = Option<usize>::None
    auto max_columns_opt# = Option<usize>::None
    auto max_block_lines# = 80:usize

    auto i# = 2:usize
    loop i < num_args {
        auto &arg = args.borrow(i)
        auto view = arg.as_str()

        if view == "-h" || view == "--help" {
            println("Usage: trg view <path>:<line> [-C N] [--block] | trg view <path> --lines <start>-<end> | trg view <path> --symbol <SPEC> [--scope <SCOPE>]")
            println("")
            println("Options:")
            println("  -C, --context <NUM>       Lines of context around target line (default: 10)")
            println("      --block               Expand enclosing syntactic block context")
            println("      --lines <M-N>         Extract explicit physical line range M to N")
            println("      --symbol <NAME>       Extract enclosing code range for target symbol (e.g. 'fn_name' or 'Scope::name')")
            println("      --scope <SCOPE>       Optional enclosing scope to disambiguate target symbol")
            println("      --max-lines <NUM>     Maximum lines of output before truncating")
            println("      --max-bytes <SIZE>    Maximum hydrated output bytes (alias: --max-result-bytes; counts formatted view lines; default: unlimited; 0 stops hydration immediately)")
            println("      --max-columns <NUM>   Omit lines exceeding NUM characters with [omitted]")
            println("      --max-block-lines <NUM> Maximum lines per expanded block context or unknown symbol preview (default: 80)")
            return 0
        }

        if view == "--block" {
            block = true
            i = i + 1
            continue
        }

        if view == "--symbol" {
            if i + 1 >= num_args {
                print_err("Option requires an argument: --symbol")
                return 2
            }
            i = i + 1
            auto &val_arg = args.borrow(i)
            symbol_raw_opt = Option<string>::Some(string::from(val_arg.as_str()))
            i = i + 1
            continue
        }

        if view.starts_with("--symbol=") {
            auto val_str = view.substr(9:usize, view.len - 9:usize)
            symbol_raw_opt = Option<string>::Some(string::from(val_str))
            i = i + 1
            continue
        }

        if view == "--scope" {
            if i + 1 >= num_args {
                print_err("Option requires an argument: --scope")
                return 2
            }
            i = i + 1
            auto &val_arg = args.borrow(i)
            scope_raw_opt = Option<string>::Some(string::from(val_arg.as_str()))
            i = i + 1
            continue
        }

        if view.starts_with("--scope=") {
            auto val_str = view.substr(8:usize, view.len - 8:usize)
            scope_raw_opt = Option<string>::Some(string::from(val_str))
            i = i + 1
            continue
        }

        if view == "-C" || view == "--context" {
            if i + 1 >= num_args {
                print_err("Option requires an argument: -C / --context")
                return 2
            }
            i = i + 1
            auto &val_arg = args.borrow(i)
            auto c_res = parse_usize_val(val_arg.as_str())
            if c_res.is_err() {
                print_err("Invalid context number")
                return 2
            }
            context = c_res.unwrap()
            context_passed = true
            i = i + 1
            continue
        }

        if view.starts_with("-C") && view.len > 2:usize {
            auto val_str = view.substr(2:usize, view.len - 2:usize)
            auto c_res = parse_usize_val(val_str)
            if c_res.is_err() {
                print_err("Invalid context number")
                return 2
            }
            context = c_res.unwrap()
            context_passed = true
            i = i + 1
            continue
        }

        if view.starts_with("--context=") {
            auto val_str = view.substr(10:usize, view.len - 10:usize)
            auto c_res = parse_usize_val(val_str)
            if c_res.is_err() {
                print_err("Invalid context number")
                return 2
            }
            context = c_res.unwrap()
            context_passed = true
            i = i + 1
            continue
        }

        if view == "--lines" {
            if i + 1 >= num_args {
                print_err("Option requires an argument: --lines")
                return 2
            }
            i = i + 1
            auto &val_arg = args.borrow(i)
            auto r_res = parse_range_spec(val_arg.as_str())
            if r_res.is_err() {
                print_err(r_res.unwrap_err().as_str())
                return 2
            }
            lines_range = Option<BlockRange>::Some(r_res.unwrap())
            i = i + 1
            continue
        }

        if view.starts_with("--lines=") {
            auto val_str = view.substr(8:usize, view.len - 8:usize)
            auto r_res = parse_range_spec(val_str)
            if r_res.is_err() {
                print_err(r_res.unwrap_err().as_str())
                return 2
            }
            lines_range = Option<BlockRange>::Some(r_res.unwrap())
            i = i + 1
            continue
        }

        if view == "--max-lines" {
            if i + 1 >= num_args {
                print_err("Option requires an argument: --max-lines")
                return 2
            }
            i = i + 1
            auto &val_arg = args.borrow(i)
            auto res = parse_usize_val(val_arg.as_str())
            if res.is_err() {
                print_err("Invalid max-lines number")
                return 2
            }
            max_lines_opt = Option<usize>::Some(res.unwrap())
            i = i + 1
            continue
        }

        if view.starts_with("--max-lines=") {
            auto val_str = view.substr(12:usize, view.len - 12:usize)
            auto res = parse_usize_val(val_str)
            if res.is_err() {
                print_err("Invalid max-lines number")
                return 2
            }
            max_lines_opt = Option<usize>::Some(res.unwrap())
            i = i + 1
            continue
        }

        if view == "--max-bytes" || view == "--max-result-bytes" {
            if i + 1 >= num_args {
                auto err_req# = string::from("Option requires an argument: ")
                err_req#.push_str(view)
                print_err(err_req.as_str())
                return 2
            }
            i = i + 1
            auto &val_arg = args.borrow(i)
            auto res = parse_size_bytes_strict(val_arg.as_str(), view)
            if res.is_err() {
                print_err(res.unwrap_err().as_str())
                return 2
            }
            max_bytes_opt = Option<usize>::Some(res.unwrap())
            i = i + 1
            continue
        }

        if view.starts_with("--max-bytes=") {
            auto val_str = view.substr(12:usize, view.len - 12:usize)
            auto res = parse_size_bytes_strict(val_str, "--max-bytes")
            if res.is_err() {
                print_err(res.unwrap_err().as_str())
                return 2
            }
            max_bytes_opt = Option<usize>::Some(res.unwrap())
            i = i + 1
            continue
        }

        if view.starts_with("--max-result-bytes=") {
            auto val_str = view.substr(19:usize, view.len - 19:usize)
            auto res = parse_size_bytes_strict(val_str, "--max-result-bytes")
            if res.is_err() {
                print_err(res.unwrap_err().as_str())
                return 2
            }
            max_bytes_opt = Option<usize>::Some(res.unwrap())
            i = i + 1
            continue
        }

        if view == "--max-columns" {
            if i + 1 >= num_args {
                print_err("Option requires an argument: --max-columns")
                return 2
            }
            i = i + 1
            auto &val_arg = args.borrow(i)
            auto res = parse_usize_val(val_arg.as_str())
            if res.is_err() {
                print_err("Invalid max-columns number")
                return 2
            }
            max_columns_opt = Option<usize>::Some(res.unwrap())
            i = i + 1
            continue
        }

        if view.starts_with("--max-columns=") {
            auto val_str = view.substr(14:usize, view.len - 14:usize)
            auto res = parse_usize_val(val_str)
            if res.is_err() {
                print_err("Invalid max-columns number")
                return 2
            }
            max_columns_opt = Option<usize>::Some(res.unwrap())
            i = i + 1
            continue
        }

        if view == "--max-block-lines" {
            if i + 1 >= num_args {
                print_err("Option requires an argument: --max-block-lines")
                return 2
            }
            i = i + 1
            auto &val_arg = args.borrow(i)
            auto res = parse_usize_val(val_arg.as_str())
            if res.is_err() {
                print_err("Invalid max-block-lines number")
                return 2
            }
            auto parsed_val = res.unwrap()
            if parsed_val == 0 {
                print_err("Invalid max-block-lines number")
                return 2
            }
            max_block_lines = parsed_val
            i = i + 1
            continue
        }

        if view.starts_with("--max-block-lines=") {
            auto val_str = view.substr(18:usize, view.len - 18:usize)
            auto res = parse_usize_val(val_str)
            if res.is_err() {
                print_err("Invalid max-block-lines number")
                return 2
            }
            auto parsed_val = res.unwrap()
            if parsed_val == 0 {
                print_err("Invalid max-block-lines number")
                return 2
            }
            max_block_lines = parsed_val
            i = i + 1
            continue
        }

        if view.starts_with("-") {
            auto err# = string::from("Unknown option '")
            err#.push_str(view)
            err#.push_str("'")
            print_err(err.as_str())
            return 2
        }

        // Positional argument: path or path:line or line
        if path_opt.is_none() {
            auto colon_opt = find_last_colon(view)
            if colon_opt.is_some() {
                auto c_idx = colon_opt.unwrap()
                auto p_slice = view.substr(0, c_idx)
                auto l_slice = view.substr(c_idx + 1, view.len - c_idx - 1)
                auto l_res = parse_usize_val(l_slice)
                if l_res.is_ok() {
                    path_opt = Option<string>::Some(string::from(p_slice))
                    line_opt = Option<usize>::Some(l_res.unwrap())
                    i = i + 1
                    continue
                }
            }
            path_opt = Option<string>::Some(string::from(view))
            i = i + 1
            continue
        } else if line_opt.is_none() && lines_range.is_none() {
            auto l_res = parse_usize_val(view)
            if l_res.is_ok() {
                line_opt = Option<usize>::Some(l_res.unwrap())
                i = i + 1
                continue
            }
        }

        auto err# = string::from("Unexpected argument '")
        err#.push_str(view)
        err#.push_str("'")
        print_err(err.as_str())
        return 2
    }

    if path_opt.is_none() {
        print_err("trg view: missing file path")
        return 2
    }

    auto parsed_symbol# = Option<string>::None
    auto parsed_scope# = Option<string>::None

    if scope_raw_opt.is_some() && symbol_raw_opt.is_none() {
        print_err("--scope cannot be used without --symbol")
        return 2
    }

    match symbol_raw_opt {
        auto Option<string>::Some(&sym_raw) => {
            auto sym_view = sym_raw.as_str().trim()
            if sym_view.len == 0 {
                print_err("Invalid symbol name: cannot be empty")
                return 2
            }

            if sym_view.starts_with("::") || sym_view.ends_with("::") {
                print_err("Invalid symbol specification: empty scope or symbol name")
                return 2
            }

            auto first_col = sym_view.index_of_str("::")
            if first_col.is_some() {
                auto pos1 = first_col.unwrap()
                auto rem = sym_view.substr(pos1 + 2:usize, sym_view.len - pos1 - 2:usize)
                if rem.index_of_str("::").is_some() {
                    print_err("Invalid symbol specification: nested scopes (e.g. A::B::C) are not supported")
                    return 2
                }
                auto scope_part = sym_view.substr(0, pos1).trim()
                auto name_part = rem.trim()
                if scope_part.len == 0 || name_part.len == 0 {
                    print_err("Invalid symbol specification: empty scope or symbol name")
                    return 2
                }
                match scope_raw_opt {
                    auto Option<string>::Some(&s_arg) => {
                        if s_arg.as_str().trim() != scope_part {
                            print_err("Conflicting scopes specified: --scope does not match symbol scope prefix")
                            return 2
                        }
                    }
                    auto Option<string>::None => {}
                }
                parsed_symbol = Option<string>::Some(string::from(name_part))
                parsed_scope = Option<string>::Some(string::from(scope_part))
            } else {
                parsed_symbol = Option<string>::Some(string::from(sym_view))
                match scope_raw_opt {
                    auto Option<string>::Some(&sr) => {
                        auto sr_trim = sr.as_str().trim()
                        if sr_trim.len == 0 {
                            print_err("Invalid scope name: cannot be empty")
                            return 2
                        }
                        parsed_scope = Option<string>::Some(string::from(sr_trim))
                    }
                    auto Option<string>::None => {}
                }
            }
        }
        auto Option<string>::None => {}
    }

    if parsed_symbol.is_some() {
        if context_passed {
            print_err("--symbol cannot be used with -C / --context")
            return 2
        }
        if block {
            print_err("--symbol cannot be used with --block")
            return 2
        }
        if lines_range.is_some() {
            print_err("--symbol cannot be used with --lines")
            return 2
        }
        if line_opt.is_some() {
            print_err("--symbol cannot be used with target line (<path>:<line>)")
            return 2
        }
    }

    if parsed_symbol.is_none() && line_opt.is_none() && lines_range.is_none() {
        print_err("trg view: viewing requires a target line number (e.g. <path>:<line>), --lines, or --symbol")
        return 2
    }

    auto raw_path = path_opt.unwrap()
    auto startup_cwd = normalize_cwd(env::current_dir().as_str())
    auto id_res = compute_identity_key(startup_cwd.as_str(), raw_path.as_str())
    if id_res.is_err() {
        auto err# = string::from("trg: ")
        err#.push_str(raw_path.as_str())
        err#.push_str(": Failed to resolve target path")
        print_err(err.as_str())
        return 2
    }
    auto final_file_path = id_res.unwrap()

    auto opts = ViewOptions(
        file_path = cede final_file_path,
        line = line_opt,
        context = context,
        block = block,
        lines_range = lines_range,
        symbol = cede parsed_symbol,
        symbol_scope = cede parsed_scope,
        max_lines = max_lines_opt,
        max_result_bytes = max_bytes_opt,
        max_columns = max_columns_opt,
        max_block_lines = max_block_lines
    )

    auto res = execute_view_operation(opts)
    if res.is_err() {
        print_err(res.unwrap_err().as_str())
        return 2
    }

    auto view_res = res.unwrap()
    if view_res.mode == "symbol" {
        if view_res.selection_status == "not_found" {
            print_err(view_res.text.as_str())
            return 1
        }
        if view_res.selection_status == "multiple_candidates" ||
           view_res.selection_status == "unsupported_syntax" ||
           view_res.selection_status == "scan_incomplete" ||
           view_res.selection_status == "io_error" {
            print_err(view_res.text.as_str())
            return 2
        }
    }

    if view_res.truncated && view_res.reason.len() > 0 {
        auto t_msg# = string::from("[trg_view: truncated=true, reason=")
        t_msg#.push_str(view_res.reason.as_str())
        t_msg#.push_str("]")
        print_err(t_msg.as_str())
    }
    auto write_res = posix_write_stdout(view_res.text.as_str())
    if write_res == 2 {
        return 2
    }
    return 0
}
