pub shape FileCapture (
    lines: Vec<string>,
    sha256_hex: string,
    size_exceeded: bool,
    read_err: bool,
    open_err: bool
)

pub shape ContinuationToken (
    version: usize,
    path: string,
    req_start: usize,
    req_end: usize,
    next_line: usize,
    end_line: usize,
    sha256_hex: string,
    mode: string,
    symbol: Option<string>,
    scope: Option<string>,
    range_status: string,
    max_columns: Option<usize>
)

impl ContinuationToken {
    pub fn clone(self) -> ContinuationToken {
        auto sym_clone# = Option<string>::None
        match self.symbol {
            auto Option<string>::Some(&s) => {
                sym_clone = Option<string>::Some(string::from(s.as_str()))
            }
            auto Option<string>::None => {}
        }
        auto sc_clone# = Option<string>::None
        match self.scope {
            auto Option<string>::Some(&sc) => {
                sc_clone = Option<string>::Some(string::from(sc.as_str()))
            }
            auto Option<string>::None => {}
        }
        return ContinuationToken(
            version = self.version,
            path = string::from(self.path.as_str()),
            req_start = self.req_start,
            req_end = self.req_end,
            next_line = self.next_line,
            end_line = self.end_line,
            sha256_hex = string::from(self.sha256_hex.as_str()),
            mode = string::from(self.mode.as_str()),
            symbol = cede sym_clone,
            scope = cede sc_clone,
            range_status = string::from(self.range_status.as_str()),
            max_columns = self.max_columns
        )
    }
}

pub shape ViewLineRecord (
    line_number: usize,
    kind: string,
    text: string
)

pub shape SymbolTargetInfo (
    name: string,
    kind: string,
    line: usize,
    range_start: usize,
    range_end: Option<usize>,
    range_status: string,
    scope: string,
    detail: string
)

impl SymbolTargetInfo {
    pub fn clone(self) -> SymbolTargetInfo {
        return SymbolTargetInfo(
            name = string::from(self.name.as_str()),
            kind = string::from(self.kind.as_str()),
            line = self.line,
            range_start = self.range_start,
            range_end = self.range_end,
            range_status = string::from(self.range_status.as_str()),
            scope = string::from(self.scope.as_str()),
            detail = string::from(self.detail.as_str())
        )
    }
}

pub shape SymbolCandidateInfo (
    name: string,
    kind: string,
    line: usize,
    range_start: usize,
    range_end: Option<usize>,
    range_status: string,
    scope: string,
    detail: string
)

impl SymbolCandidateInfo {
    pub fn clone(self) -> SymbolCandidateInfo {
        return SymbolCandidateInfo(
            name = string::from(self.name.as_str()),
            kind = string::from(self.kind.as_str()),
            line = self.line,
            range_start = self.range_start,
            range_end = self.range_end,
            range_status = string::from(self.range_status.as_str()),
            scope = string::from(self.scope.as_str()),
            detail = string::from(self.detail.as_str())
        )
    }
}

pub shape ViewOptions (
    file_path: string,
    line: Option<usize>,
    context: usize,
    block: bool,
    lines_range: Option<BlockRange>,
    symbol: Option<string>,
    symbol_scope: Option<string>,
    max_lines: Option<usize>,
    max_result_bytes: Option<usize>,
    max_columns: Option<usize>,
    max_block_lines: usize,
    continuation: bool,
    continuation_token: Option<string>,
    no_hints: bool
)

pub shape ViewResult (
    text: string,
    truncated: bool,
    reason: string,
    lines_emitted: usize,
    bytes_emitted: usize,
    mode: string,
    path: string,
    requested_line: Option<usize>,
    requested_range: Option<BlockRange>,
    detected_block_range: Option<BlockRange>,
    emitted_range: Option<BlockRange>,
    target_included: Option<bool>,
    content_omitted: bool,
    complete: bool,
    eof_reached: bool,
    records: Vec<ViewLineRecord>,
    selection_status: string,
    range_status: Option<string>,
    output_status: string,
    target_symbol: Vec<SymbolTargetInfo>,
    candidates: Vec<SymbolCandidateInfo>,
    candidates_truncated: bool,
    continuation_token: Option<string>,
    continuation_active: bool,
    sha256_hex: string
)

pub fn format_view_line_record_json(line_number: usize, kind: str, text: str) -> string {
    auto item# = string::from("{\"line_number\":")
    item#.push_str(u64_to_string(line_number as u64).as_str())
    item#.push_str(",\"kind\":\"")
    item#.push_str(kind)
    item#.push_str("\",\"text\":\"")
    item#.push_str(json_escape(text).as_str())
    item#.push_str("\"}")
    return cede item
}

impl ViewResult {
    pub fn format_structured(self#) -> string {
        auto resp# = string::from("{\"schema\":\"trg-mcp-view-result-v1\",\"mode\":\"")
        resp#.push_str(self.mode.as_str())
        resp#.push_str("\",\"path\":\"")
        resp#.push_str(json_escape(self.path.as_str()).as_str())
        resp#.push_str("\",\"requested_line\":")
        match self.requested_line {
            auto Option<usize>::Some(l) => {
                resp#.push_str(u64_to_string(l as u64).as_str())
            }
            auto Option<usize>::None => {
                resp#.push_str("null")
            }
        }
        resp#.push_str(",\"requested_range\":")
        match self.requested_range {
            auto Option<BlockRange>::Some(rr) => {
                resp#.push_str("[")
                resp#.push_str(u64_to_string(rr.start as u64).as_str())
                resp#.push_str(",")
                resp#.push_str(u64_to_string(rr.end as u64).as_str())
                resp#.push_str("]")
            }
            auto Option<BlockRange>::None => {
                resp#.push_str("null")
            }
        }
        resp#.push_str(",\"detected_block_range\":")
        match self.detected_block_range {
            auto Option<BlockRange>::Some(dbr) => {
                resp#.push_str("[")
                resp#.push_str(u64_to_string(dbr.start as u64).as_str())
                resp#.push_str(",")
                resp#.push_str(u64_to_string(dbr.end as u64).as_str())
                resp#.push_str("]")
            }
            auto Option<BlockRange>::None => {
                resp#.push_str("null")
            }
        }
        resp#.push_str(",\"emitted_range\":")
        match self.emitted_range {
            auto Option<BlockRange>::Some(er) => {
                resp#.push_str("[")
                resp#.push_str(u64_to_string(er.start as u64).as_str())
                resp#.push_str(",")
                resp#.push_str(u64_to_string(er.end as u64).as_str())
                resp#.push_str("]")
            }
            auto Option<BlockRange>::None => {
                resp#.push_str("null")
            }
        }
        resp#.push_str(",\"target_included\":")
        match self.target_included {
            auto Option<bool>::Some(ti) => {
                if ti {
                    resp#.push_str("true")
                } else {
                    resp#.push_str("false")
                }
            }
            auto Option<bool>::None => {
                resp#.push_str("null")
            }
        }
        resp#.push_str(",\"content_omitted\":")
        if self.content_omitted {
            resp#.push_str("true")
        } else {
            resp#.push_str("false")
        }
        resp#.push_str(",\"complete\":")
        if self.complete {
            resp#.push_str("true")
        } else {
            resp#.push_str("false")
        }
        resp#.push_str(",\"eof_reached\":")
        if self.eof_reached {
            resp#.push_str("true")
        } else {
            resp#.push_str("false")
        }
        resp#.push_str(",\"truncated\":")
        if self.truncated {
            resp#.push_str("true")
        } else {
            resp#.push_str("false")
        }
        resp#.push_str(",\"termination_reason\":\"")
        resp#.push_str(self.reason.as_str())
        resp#.push_str("\",\"lines_emitted\":")
        resp#.push_str(u64_to_string(self.lines_emitted as u64).as_str())
        resp#.push_str(",\"content_bytes_emitted\":")
        resp#.push_str(u64_to_string(self.bytes_emitted as u64).as_str())
        resp#.push_str(",\"records\":[")
        auto r_i# = 0:usize
        auto r_len = self.records.len()
        loop r_i < r_len {
            auto &r = self.records.borrow(r_i)
            if r_i > 0:usize {
                resp#.push_str(",")
            }
            auto r_json = format_view_line_record_json(r.line_number, r.kind.as_str(), r.text.as_str())
            resp#.push_str(r_json.as_str())
            r_i = r_i + 1:usize
        }
        resp#.push_str("]")
        if self.continuation_active {
            resp#.push_str(",\"continuation_token\":")
            match self.continuation_token {
                auto Option<string>::Some(&tok) => {
                    resp#.push_str("\"")
                    resp#.push_str(json_escape(tok.as_str()).as_str())
                    resp#.push_str("\"")
                }
                auto Option<string>::None => {
                    resp#.push_str("null")
                }
            }
        }
        if self.mode == "symbol" {
            auto sym_suffix = self#.format_symbol_suffix_str(self.truncated)
            resp#.push_str(sym_suffix.as_str())
        }
        resp#.push_str("}")
        return cede resp
    }

    pub fn format_symbol_suffix_str(self#, is_pruned: bool) -> string {
        auto resp# = string::from(",\"selection_status\":\"")
        resp#.push_str(self.selection_status.as_str())
        resp#.push_str("\",\"range_status\":")
        match self.range_status {
            auto Option<string>::Some(&rs) => {
                resp#.push_str("\"")
                resp#.push_str(rs.as_str())
                resp#.push_str("\"")
            }
            auto Option<string>::None => {
                resp#.push_str("null")
            }
        }
        resp#.push_str(",\"output_status\":\"")
        if is_pruned {
            resp#.push_str("budget_truncated")
        } else {
            resp#.push_str(self.output_status.as_str())
        }
        resp#.push_str("\",\"symbol\":")
        if self.target_symbol.len() > 0:usize {
            auto &sym = self.target_symbol.borrow(0)
            resp#.push_str("{\"name\":\"")
            resp#.push_str(json_escape(sym.name.as_str()).as_str())
            resp#.push_str("\",\"kind\":\"")
            resp#.push_str(sym.kind.as_str())
            resp#.push_str("\",\"line\":")
            resp#.push_str(u64_to_string(sym.line as u64).as_str())
            resp#.push_str(",\"range_start\":")
            resp#.push_str(u64_to_string(sym.range_start as u64).as_str())
            resp#.push_str(",\"range_end\":")
            match sym.range_end {
                auto Option<usize>::Some(re) => {
                    resp#.push_str(u64_to_string(re as u64).as_str())
                }
                auto Option<usize>::None => {
                    resp#.push_str("null")
                }
            }
            resp#.push_str(",\"range_status\":\"")
            resp#.push_str(sym.range_status.as_str())
            resp#.push_str("\",\"scope\":\"")
            resp#.push_str(json_escape(sym.scope.as_str()).as_str())
            resp#.push_str("\",\"detail\":\"")
            resp#.push_str(json_escape(sym.detail.as_str()).as_str())
            resp#.push_str("\"}")
        } else {
            resp#.push_str("null")
        }
        resp#.push_str(",\"candidates\":[")
        auto ci# = 0:usize
        loop ci < self.candidates.len() {
            if ci > 0:usize {
                resp#.push_str(",")
            }
            auto &c = self.candidates.borrow(ci)
            resp#.push_str("{\"name\":\"")
            resp#.push_str(json_escape(c.name.as_str()).as_str())
            resp#.push_str("\",\"kind\":\"")
            resp#.push_str(c.kind.as_str())
            resp#.push_str("\",\"line\":")
            resp#.push_str(u64_to_string(c.line as u64).as_str())
            resp#.push_str(",\"range_start\":")
            resp#.push_str(u64_to_string(c.range_start as u64).as_str())
            resp#.push_str(",\"range_end\":")
            match c.range_end {
                auto Option<usize>::Some(re) => {
                    resp#.push_str(u64_to_string(re as u64).as_str())
                }
                auto Option<usize>::None => {
                    resp#.push_str("null")
                }
            }
            resp#.push_str(",\"range_status\":\"")
            resp#.push_str(c.range_status.as_str())
            resp#.push_str("\",\"scope\":\"")
            resp#.push_str(json_escape(c.scope.as_str()).as_str())
            resp#.push_str("\",\"detail\":\"")
            resp#.push_str(json_escape(c.detail.as_str()).as_str())
            resp#.push_str("\"}")
            ci = ci + 1:usize
        }
        resp#.push_str("],\"candidates_truncated\":")
        if self.candidates_truncated {
            resp#.push_str("true")
        } else {
            resp#.push_str("false")
        }
        return cede resp
    }

    pub fn build_continuation_token(self#, next_line: usize, end_line: usize, req_start: usize, req_end: usize) -> Result<Option<string>, string> {
        if next_line > end_line {
            return Result<Option<string>, string>::Ok(Option<string>::None)
        }
        auto sym_name_opt# = Option<string>::None
        auto sym_scope_opt# = Option<string>::None
        if self.target_symbol.len() > 0:usize {
            auto &ts = self.target_symbol.borrow(0:usize)
            sym_name_opt = Option<string>::Some(string::from(ts.name.as_str()))
            if ts.scope.len() > 0:usize {
                sym_scope_opt = Option<string>::Some(string::from(ts.scope.as_str()))
            }
        }
        auto r_stat# = string::from("confirmed")
        match self.range_status {
            auto Option<string>::Some(&rs) => {
                r_stat = string::from(rs.as_str())
            }
            auto Option<string>::None => {}
        }
        auto max_cols_tok# = Option<usize>::None
        match self.continuation_token {
            auto Option<string>::Some(&ts) => {
                auto dec = decode_continuation_token(ts.as_str())
                if dec.is_ok() {
                    max_cols_tok = dec.unwrap().max_columns
                }
            }
            auto Option<string>::None => {}
        }
        auto m_str# = string::from(self.mode.as_str())
        if m_str == "lines" {
            m_str = string::from("range")
        }
        auto ct = ContinuationToken(
            version = 1:usize,
            path = string::from(self.path.as_str()),
            req_start = req_start,
            req_end = req_end,
            next_line = next_line,
            end_line = end_line,
            sha256_hex = string::from(self.sha256_hex.as_str()),
            mode = cede m_str,
            symbol = cede sym_name_opt,
            scope = cede sym_scope_opt,
            range_status = cede r_stat,
            max_columns = max_cols_tok
        )
        auto enc_opt = encode_continuation_token(ct)
        if enc_opt.is_none() {
            return Result<Option<string>, string>::Err(string::from("continuation_token_overflow: Continuation token exceeds maximum length limit (4096 bytes)"))
        }
        return Result<Option<string>, string>::Ok(Option<string>::Some(enc_opt.unwrap()))
    }

    // Computes metadata length upper-bound using limit digit count as a conservative
    // bound, followed by final exact convergence in converge_structured.
    pub fn compute_candidate_meta_len(
        self#,
        start_idx: usize,
        end_idx: usize,
        is_pruned: bool,
        limit: usize
    ) -> usize {
        auto lines_emitted# = 0:usize
        if end_idx >= start_idx {
            lines_emitted = end_idx - start_idx + 1:usize
        }

        auto s_schema = "{\"schema\":\"trg-mcp-view-result-v1\",\"mode\":\""
        auto l_schema = s_schema.len
        auto l_mode = self.mode.len()
        auto s_path_tag = "\",\"path\":\""
        auto l_path_tag = s_path_tag.len
        auto l_path = json_escape(self.path.as_str()).len()
        auto s_req_line_tag = "\",\"requested_line\":"
        auto l_req_line_tag = s_req_line_tag.len
        auto l_req_line# = 4:usize // "null"
        match self.requested_line {
            auto Option<usize>::Some(l) => {
                l_req_line = u64_to_string(l as u64).len()
            }
            _ => {}
        }
        auto s_req_range_tag = ",\"requested_range\":"
        auto l_req_range_tag = s_req_range_tag.len
        auto l_req_range# = 4:usize // "null"
        match self.requested_range {
            auto Option<BlockRange>::Some(rr) => {
                l_req_range = 3:usize + u64_to_string(rr.start as u64).len() + u64_to_string(rr.end as u64).len()
            }
            _ => {}
        }
        auto s_det_range_tag = ",\"detected_block_range\":"
        auto l_det_range_tag = s_det_range_tag.len
        auto l_det_range# = 4:usize // "null"
        match self.detected_block_range {
            auto Option<BlockRange>::Some(dbr) => {
                l_det_range = 3:usize + u64_to_string(dbr.start as u64).len() + u64_to_string(dbr.end as u64).len()
            }
            _ => {}
        }
        auto s_emit_range_tag = ",\"emitted_range\":"
        auto l_emit_range_tag = s_emit_range_tag.len
        auto l_emit_range# = 4:usize // "null"
        if lines_emitted > 0:usize {
            auto s_num = self.records.borrow(start_idx).line_number
            auto e_num = self.records.borrow(end_idx).line_number
            l_emit_range = 3:usize + u64_to_string(s_num as u64).len() + u64_to_string(e_num as u64).len()
        }
        auto s_target_inc_tag = ",\"target_included\":"
        auto l_target_inc_tag = s_target_inc_tag.len
        auto l_target_inc# = 4:usize // "null"
        match self.target_included {
            auto Option<bool>::Some(ti) => {
                if lines_emitted > 0:usize && ti {
                    l_target_inc = 4:usize // "true"
                } else {
                    l_target_inc = 5:usize // "false"
                }
            }
            _ => {}
        }
        auto s_content_omitted_tag = ",\"content_omitted\":"
        auto l_content_omitted_tag = s_content_omitted_tag.len
        auto l_content_omitted# = 5:usize
        if self.content_omitted {
            l_content_omitted = 4:usize
        }
        auto s_complete_tag = ",\"complete\":"
        auto l_complete_tag = s_complete_tag.len
        auto cand_comp# = self.complete
        if is_pruned {
            cand_comp = false
        }
        auto l_complete# = 5:usize
        if cand_comp {
            l_complete = 4:usize
        }
        auto s_eof_tag = ",\"eof_reached\":"
        auto l_eof_tag = s_eof_tag.len
        auto l_eof# = 5:usize
        if self.eof_reached {
            l_eof = 4:usize
        }
        auto s_truncated_tag = ",\"truncated\":"
        auto l_truncated_tag = s_truncated_tag.len
        auto cand_trunc# = self.truncated
        if is_pruned {
            cand_trunc = true
        }
        auto l_truncated# = 5:usize
        if cand_trunc {
            l_truncated = 4:usize
        }
        auto s_reason_tag = ",\"termination_reason\":\""
        auto l_reason_tag = s_reason_tag.len
        auto l_reason# = self.reason.len()
        if is_pruned {
            auto s_trunc = "max_result_bytes"
            l_reason = s_trunc.len
        }
        auto s_lines_emitted_tag = "\",\"lines_emitted\":"
        auto l_lines_emitted_tag = s_lines_emitted_tag.len
        auto l_lines_emitted = u64_to_string(lines_emitted as u64).len()
        auto s_bytes_emitted_tag = ",\"content_bytes_emitted\":"
        auto l_bytes_emitted_tag = s_bytes_emitted_tag.len
        auto l_bytes_emitted = u64_to_string(limit as u64).len()
        auto s_records_open = ",\"records\":["
        auto l_records_open = s_records_open.len
        auto l_records_close# = 1:usize
        if self.continuation_active {
            auto s_tok_tag = ",\"continuation_token\":"
            auto l_tok# = 4:usize // "null"
            match self.continuation_token {
                auto Option<string>::Some(&tok) => {
                    l_tok = 2:usize + json_escape(tok.as_str()).len()
                }
                auto Option<string>::None => {}
            }
            l_records_close = l_records_close + s_tok_tag.len + l_tok
        }
        if self.mode == "symbol" {
            auto sym_suffix = self#.format_symbol_suffix_str(is_pruned)
            l_records_close = l_records_close + sym_suffix.len()
        }
        l_records_close = l_records_close + 1:usize

        return l_schema + l_mode + l_path_tag + l_path + l_req_line_tag + l_req_line +
               l_req_range_tag + l_req_range + l_det_range_tag + l_det_range +
               l_emit_range_tag + l_emit_range + l_target_inc_tag + l_target_inc +
               l_content_omitted_tag + l_content_omitted + l_complete_tag + l_complete +
               l_eof_tag + l_eof + l_truncated_tag + l_truncated + l_reason_tag + l_reason +
               l_lines_emitted_tag + l_lines_emitted + l_bytes_emitted_tag + l_bytes_emitted +
               l_records_open + l_records_close
    }

    pub fn converge_structured(self#) -> Result<string, string> {
        self.bytes_emitted = 0:usize
        auto cur_s# = self#.format_structured()
        self.bytes_emitted = cur_s.len()
        auto iter# = 0:usize
        loop iter < 10:usize {
            cur_s = self#.format_structured()
            if cur_s.len() == self.bytes_emitted {
                return Result<string, string>::Ok(cede cur_s)
            }
            self.bytes_emitted = cur_s.len()
            iter = iter + 1:usize
        }
        return Result<string, string>::Err(string::from("view_json_budget_convergence_failed: failed to converge bytes_emitted after 10 iterations"))
    }

    pub fn prune_to_json_budget(self#, limit: usize) -> Result<string, string> {
        auto n_recs = self.records.len()
        if n_recs == 0:usize {
            if self.candidates.len() > 1:usize {
                loop self.candidates.len() > 1:usize {
                    auto cur_meta_len = self#.compute_candidate_meta_len(1:usize, 0:usize, false, limit)
                    if cur_meta_len <= limit {
                        break
                    }
                    auto _ = self.candidates#.pop()
                    self.candidates_truncated = true
                }
            }
            auto meta_len = self#.compute_candidate_meta_len(1:usize, 0:usize, false, limit)
            if meta_len > limit {
                auto err# = string::from("target_exceeds_max_result_bytes: View result metadata (")
                err#.push_str(u64_to_string(meta_len as u64).as_str())
                err#.push_str(" bytes) exceeds max_result_bytes (")
                err#.push_str(u64_to_string(limit as u64).as_str())
                err#.push_str(" bytes)")
                return Result<string, string>::Err(cede err)
            }
            return self#.converge_structured()
        }

        // 1. Check if unpruned non-continuation result already converges within limit
        if !self.continuation_active {
            auto init_conv = self#.converge_structured()
            if init_conv.is_err() {
                return init_conv
            }
            auto init_json = init_conv.unwrap()
            if init_json.len() <= limit {
                return Result<string, string>::Ok(cede init_json)
            }
        }

        // 2. Precompute exact record JSON lengths: O(B)
        auto rec_lens# = Vec<usize>::new()
        auto i# = 0:usize
        auto total_recs_len# = 0:usize
        loop i < n_recs {
            auto &r = self.records.borrow(i)
            auto r_json = format_view_line_record_json(r.line_number, r.kind.as_str(), r.text.as_str())
            auto l = r_json.len()
            rec_lens#.push(l)
            total_recs_len = total_recs_len + l
            i = i + 1:usize
        }

        // 3. Select candidate window [w_start, w_end] in O(N)
        auto w_start# = 0:usize
        auto w_end# = n_recs - 1:usize
        auto cur_recs_len# = total_recs_len
        auto has_records# = true
        auto req_line_opt = self.requested_line

        if self.continuation_active {
            // Continuation mode: always sequential range-start paging!
            // Never drop lines from the start (w_start stays 0), only shrink w_end from the back.
            // Token overhead is strictly budgeted inside the candidate convergence loop.
            auto total_end# = 0:usize
            auto total_start# = 1:usize
            match self.detected_block_range {
                auto Option<BlockRange>::Some(dbr) => {
                    total_start = dbr.start
                    total_end = dbr.end
                }
                auto Option<BlockRange>::None => {
                    match self.requested_range {
                        auto Option<BlockRange>::Some(rr) => {
                            total_start = rr.start
                            total_end = rr.end
                        }
                        auto Option<BlockRange>::None => {}
                    }
                }
            }

            auto chosen_k# = Option<usize>::None
            auto cur_k# = n_recs
            loop cur_k >= 1:usize {
                auto last_line = self.records.borrow(cur_k - 1:usize).line_number
                auto cand_tok_res = self#.build_continuation_token(last_line + 1:usize, total_end, total_start, total_end)
                if cand_tok_res.is_err() {
                    return Result<string, string>::Err(cand_tok_res.unwrap_err())
                }
                self.continuation_token = cand_tok_res.unwrap()

                auto comma_len# = 0:usize
                if cur_k > 1:usize {
                    comma_len = cur_k - 1:usize
                }

                auto meta_len = self#.compute_candidate_meta_len(0:usize, cur_k - 1:usize, cur_k < n_recs || self.continuation_token.is_some(), limit)
                auto cand_total = meta_len + comma_len + cur_recs_len

                if cand_total <= limit {
                    chosen_k = Option<usize>::Some(cur_k)
                    break
                }

                cur_recs_len = cur_recs_len - rec_lens.get(cur_k - 1:usize)
                cur_k = cur_k - 1:usize
            }

            if chosen_k.is_none() {
                self.continuation_token = Option<string>::None
                auto err# = string::from("target_exceeds_max_result_bytes: Target line formatted record exceeds max_result_bytes (")
                err#.push_str(u64_to_string(limit as u64).as_str())
                err#.push_str(" bytes)")
                return Result<string, string>::Err(cede err)
            }

            auto final_k = chosen_k.unwrap()
            auto new_records# = Vec<ViewLineRecord>::new()
            auto ki# = 0:usize
            loop ki < final_k {
                auto &r = self.records.borrow(ki)
                new_records#.push(ViewLineRecord(
                    line_number = r.line_number,
                    kind = r.kind.clone(),
                    text = r.text.clone()
                ))
                ki = ki + 1:usize
            }
            self.records = cede new_records
            if final_k < n_recs || self.continuation_token.is_some() {
                self.truncated = true
                self.reason = string::from("max_result_bytes")
                self.output_status = string::from("budget_truncated")
                self.complete = false
            }
            self.lines_emitted = final_k
            self.emitted_range = Option<BlockRange>::Some(BlockRange(
                start = self.records.borrow(0:usize).line_number,
                end = self.records.borrow(final_k - 1:usize).line_number
            ))

            return self#.converge_structured()
        } else if req_line_opt.is_some() {
            auto target_line_num = req_line_opt.unwrap()
            // Point or Block mode: target line must be preserved
            auto target_idx_opt# = Option<usize>::None
            auto ti# = 0:usize
            loop ti < n_recs {
                if self.records.borrow(ti).line_number == target_line_num && self.records.borrow(ti).kind.as_str() == "target" {
                    target_idx_opt = Option<usize>::Some(ti)
                    break
                }
                ti = ti + 1:usize
            }

            if target_idx_opt.is_none() {
                return Result<string, string>::Err(string::from("target_not_found: Target record not found in view records"))
            }
            auto target_idx = target_idx_opt.unwrap()

            // Check if single target line fits
            auto single_records# = Vec<ViewLineRecord>::new()
            single_records#.push(ViewLineRecord(
                line_number = self.records.borrow(target_idx).line_number,
                kind = string::from(self.records.borrow(target_idx).kind.as_str()),
                text = string::from(self.records.borrow(target_idx).text.as_str())
            ))
            auto target_sym_clone# = Vec<SymbolTargetInfo>::new()
            if self.target_symbol.len() > 0:usize {
                auto &ts = self.target_symbol.borrow(0)
                target_sym_clone#.push(SymbolTargetInfo(
                    name = string::from(ts.name.as_str()),
                    kind = string::from(ts.kind.as_str()),
                    line = ts.line,
                    range_start = ts.range_start,
                    range_end = ts.range_end,
                    range_status = string::from(ts.range_status.as_str()),
                    scope = string::from(ts.scope.as_str()),
                    detail = string::from(ts.detail.as_str())
                ))
            }
            auto target_range_status_clone# = Option<string>::None
            match self.range_status {
                auto Option<string>::Some(&rs) => {
                    target_range_status_clone = Option<string>::Some(string::from(rs.as_str()))
                }
                auto Option<string>::None => {}
            }
            auto target_only_vr# = ViewResult(
                text = string::new(),
                truncated = true,
                reason = string::from("max_result_bytes"),
                lines_emitted = 1:usize,
                bytes_emitted = 0:usize,
                mode = string::from(self.mode.as_str()),
                path = string::from(self.path.as_str()),
                requested_line = self.requested_line,
                requested_range = self.requested_range,
                detected_block_range = self.detected_block_range,
                emitted_range = Option<BlockRange>::Some(BlockRange(start = target_line_num, end = target_line_num)),
                target_included = self.target_included,
                content_omitted = self.content_omitted,
                complete = false,
                eof_reached = self.eof_reached,
                records = cede single_records,
                selection_status = string::from(self.selection_status.as_str()),
                range_status = cede target_range_status_clone,
                output_status = string::from("budget_truncated"),
                target_symbol = cede target_sym_clone,
                candidates = Vec<SymbolCandidateInfo>::new(),
                candidates_truncated = false,
                continuation_token = Option<string>::None,
                continuation_active = false,
                sha256_hex = string::new()
            )
            auto to_conv = target_only_vr#.converge_structured()
            if to_conv.is_err() {
                return to_conv
            }
            auto to_json = to_conv.unwrap()
            if to_json.len() > limit {
                auto err# = string::from("target_exceeds_max_result_bytes: Target line formatted record (")
                err#.push_str(u64_to_string(to_json.len() as u64).as_str())
                err#.push_str(" bytes) exceeds max_result_bytes (")
                err#.push_str(u64_to_string(limit as u64).as_str())
                err#.push_str(" bytes)")
                return Result<string, string>::Err(cede err)
            }

            // Shrink window around target_idx until cand_total <= limit
            loop true {
                auto num_lines = w_end - w_start + 1:usize
                auto comma_len# = 0:usize
                if num_lines > 1:usize {
                    comma_len = num_lines - 1:usize
                }
                auto meta_len = self#.compute_candidate_meta_len(w_start, w_end, true, limit)
                auto cand_total = meta_len + comma_len + cur_recs_len
                if cand_total <= limit {
                    break
                }
                if w_start == target_idx && w_end == target_idx {
                    break
                }

                auto can_remove_start = w_start < target_idx
                auto can_remove_end = w_end > target_idx

                auto remove_last# = false
                if can_remove_end && !can_remove_start {
                    remove_last = true
                } else if can_remove_start && !can_remove_end {
                    remove_last = false
                } else {
                    auto dist_before = target_line_num - self.records.borrow(w_start).line_number
                    auto dist_after = self.records.borrow(w_end).line_number - target_line_num
                    if dist_after >= dist_before {
                        remove_last = true
                    } else {
                        remove_last = false
                    }
                }

                if remove_last {
                    cur_recs_len = cur_recs_len - rec_lens.get(w_end)
                    w_end = w_end - 1:usize
                } else {
                    cur_recs_len = cur_recs_len - rec_lens.get(w_start)
                    w_start = w_start + 1:usize
                }
            }
        } else {
            // Range mode without continuation: prune from end, or 0 records if needed
            loop true {
                auto num_lines = w_end - w_start + 1:usize
                auto comma_len# = 0:usize
                if num_lines > 1:usize {
                    comma_len = num_lines - 1:usize
                }
                auto meta_len = self#.compute_candidate_meta_len(w_start, w_end, true, limit)
                auto cand_total = meta_len + comma_len + cur_recs_len
                if cand_total <= limit {
                    break
                }
                if w_end > w_start {
                    cur_recs_len = cur_recs_len - rec_lens.get(w_end)
                    w_end = w_end - 1:usize
                } else {
                    // Even 1 line cannot fit, check if 0 records can fit
                    has_records = false
                    auto zero_meta = self#.compute_candidate_meta_len(1:usize, 0:usize, true, limit)
                    if zero_meta > limit {
                        auto err# = string::from("target_exceeds_max_result_bytes: View result metadata (")
                        err#.push_str(u64_to_string(zero_meta as u64).as_str())
                        err#.push_str(" bytes) exceeds max_result_bytes (")
                        err#.push_str(u64_to_string(limit as u64).as_str())
                        err#.push_str(" bytes)")
                        return Result<string, string>::Err(cede err)
                    }
                    break
                }
            }
        }

        // 4. Slice records once and apply pruned metadata
        auto new_records# = Vec<ViewLineRecord>::new()
        if has_records {
            auto k# = w_start
            loop k <= w_end {
                new_records#.push(ViewLineRecord(
                    line_number = self.records.borrow(k).line_number,
                    kind = self.records.borrow(k).kind.clone(),
                    text = self.records.borrow(k).text.clone()
                ))
                k = k + 1:usize
            }
        }
        self.records = cede new_records
        self.truncated = true
        self.reason = string::from("max_result_bytes")
        self.output_status = string::from("budget_truncated")
        self.complete = false
        self.lines_emitted = self.records.len()
        if self.lines_emitted > 0:usize {
            self.emitted_range = Option<BlockRange>::Some(BlockRange(
                start = self.records.borrow(0:usize).line_number,
                end = self.records.borrow(self.records.len() - 1:usize).line_number
            ))
            self.continuation_token = Option<string>::None
        } else {
            self.emitted_range = Option<BlockRange>::None
            self.continuation_token = Option<string>::None
        }

        // 5. Converge byte count and final assertion
        auto conv_res = self#.converge_structured()
        if conv_res.is_err() {
            return conv_res
        }
        auto final_json = conv_res.unwrap()
        if final_json.len() > limit {
            auto err = string::from("target_exceeds_max_result_bytes: Formatted record exceeds max_result_bytes")
            return Result<string, string>::Err(cede err)
        }
        return Result<string, string>::Ok(cede final_json)
    }

    pub fn print_cli_truncation_notice(self#, max_lines_opt: Option<usize>, max_bytes_opt: Option<usize>, no_hints: bool, hint_slot#: HintSlot) {
        if self.truncated && self.reason.len() > 0 {
            posix_write_stderr("trg: [trg_view: truncated=true, reason=")
            posix_write_stderr(self.reason.as_str())
            posix_write_stderr("]\n")

            match self.continuation_token {
                auto Option<string>::Some(&tok) => {
                    if hint_slot#.can_emit(no_hints) {
                        auto out# = string::from("hint: continue reading: trg view --continue ")
                        out#.push_str(tok.as_str())
                        match max_lines_opt {
                            auto Option<usize>::Some(ml) => {
                                out#.push_str(" --max-lines ")
                                out#.push_str(u64_to_string(ml as u64).as_str())
                            }
                            _ => {}
                        }
                        match max_bytes_opt {
                            auto Option<usize>::Some(mb) => {
                                out#.push_str(" --max-bytes ")
                                out#.push_str(u64_to_string(mb as u64).as_str())
                            }
                            _ => {}
                        }
                        out#.push_str("\n")
                        posix_write_stderr(out.as_str())
                        hint_slot.emitted = true
                    }
                }
                auto Option<string>::None => {}
            }
        }
    }
}

impl ViewOptions {
    pub fn new(file_path: string) -> ViewOptions {
        return ViewOptions(
            file_path = file_path.clone(),
            line = Option<usize>::None,
            context = 10:usize,
            block = false,
            lines_range = Option<BlockRange>::None,
            symbol = Option<string>::None,
            symbol_scope = Option<string>::None,
            max_lines = Option<usize>::None,
            max_result_bytes = Option<usize>::None,
            max_columns = Option<usize>::None,
            max_block_lines = 80:usize,
            continuation = false,
            continuation_token = Option<string>::None,
            no_hints = false
        )
    }
}

pub fn encode_continuation_token(token: ContinuationToken) -> Option<string> {
    auto json# = string::from("{\"version\":1,\"path\":\"")
    json#.push_str(json_escape(token.path.as_str()).as_str())
    json#.push_str("\",\"req_start\":")
    json#.push_str(u64_to_string(token.req_start as u64).as_str())
    json#.push_str(",\"req_end\":")
    json#.push_str(u64_to_string(token.req_end as u64).as_str())
    json#.push_str(",\"next_line\":")
    json#.push_str(u64_to_string(token.next_line as u64).as_str())
    json#.push_str(",\"end_line\":")
    json#.push_str(u64_to_string(token.end_line as u64).as_str())
    json#.push_str(",\"sha256\":\"")
    json#.push_str(token.sha256_hex.as_str())
    json#.push_str("\",\"mode\":\"")
    json#.push_str(token.mode.as_str())
    json#.push_str("\"")

    match token.symbol {
        auto Option<string>::Some(&s) => {
            json#.push_str(",\"symbol\":\"")
            json#.push_str(json_escape(s.as_str()).as_str())
            json#.push_str("\"")
        }
        auto Option<string>::None => {}
    }

    match token.scope {
        auto Option<string>::Some(&sc) => {
            json#.push_str(",\"scope\":\"")
            json#.push_str(json_escape(sc.as_str()).as_str())
            json#.push_str("\"")
        }
        auto Option<string>::None => {}
    }

    json#.push_str(",\"range_status\":\"")
    json#.push_str(token.range_status.as_str())
    json#.push_str("\"")

    match token.max_columns {
        auto Option<usize>::Some(mc) => {
            json#.push_str(",\"max_columns\":")
            json#.push_str(u64_to_string(mc as u64).as_str())
        }
        auto Option<usize>::None => {}
    }

    json#.push_str("}")

    auto b64 = encode_url_safe_b64(json.as_str())
    auto out# = string::from("trg-cont-v1.")
    out#.push_str(b64.as_str())
    if out.len() > 4096:usize {
        return Option<string>::None
    }
    return Option<string>::Some(cede out)
}

fn base64_url_char(val: u8) -> u8 {
    if val < 26:u8 { return ('A' as u8) + val }
    if val < 52:u8 { return ('a' as u8) + (val - 26:u8) }
    if val < 62:u8 { return ('0' as u8) + (val - 52:u8) }
    if val == 62:u8 { return ('-' as u8) }
    return ('_' as u8)
}

fn encode_url_safe_b64(input: str) -> string {
    auto encoded# = string::new()
    auto index# = 0:usize
    loop index < input.len {
        auto remaining = input.len - index
        auto first = input.byte_at(index) as u32
        auto second# = 0:u32
        auto third# = 0:u32
        if remaining > 1:usize { second = input.byte_at(index + 1:usize) as u32 }
        if remaining > 2:usize { third = input.byte_at(index + 2:usize) as u32 }
        auto triple = (first << 16:u32) | (second << 8:u32) | third
        encoded#.push_byte_raw(base64_url_char(((triple >> 18:u32) & 63:u32) as u8))
        encoded#.push_byte_raw(base64_url_char(((triple >> 12:u32) & 63:u32) as u8))
        if remaining > 1:usize {
            encoded#.push_byte_raw(base64_url_char(((triple >> 6:u32) & 63:u32) as u8))
        }
        if remaining > 2:usize {
            encoded#.push_byte_raw(base64_url_char((triple & 63:u32) as u8))
        }
        index = index + 3:usize
    }
    return cede encoded
}

fn is_hex_char(c: char) -> bool {
    if c >= ('0' as char) && c <= ('9' as char) {
        return true
    }
    if c >= ('a' as char) && c <= ('f' as char) {
        return true
    }
    if c >= ('A' as char) && c <= ('F' as char) {
        return true
    }
    return false
}

fn parse_token_positive_int(node: JsonNode) -> Option<usize> {
    match node {
        auto JsonNode::NumNode(n) => {
            if is_finite(n) && n == floor(n) && n >= 1.0 && n <= 9007199254740991.0 {
                return Option<usize>::Some(n as usize)
            }
            return Option<usize>::None
        }
        _ => {
            return Option<usize>::None
        }
    }
}

fn parse_token_non_neg_int(node: JsonNode) -> Option<usize> {
    match node {
        auto JsonNode::NumNode(n) => {
            if is_finite(n) && n == floor(n) && n >= 0.0 && n <= 9007199254740991.0 {
                return Option<usize>::Some(n as usize)
            }
            return Option<usize>::None
        }
        _ => {
            return Option<usize>::None
        }
    }
}

pub fn decode_continuation_token(token_str: str) -> Result<ContinuationToken, string> {
    if token_str.len > 4096:usize {
        return Result<ContinuationToken, string>::Err(string::from("Invalid continuation token: token exceeds maximum length limit (4096 bytes)"))
    }
    if !token_str.starts_with("trg-cont-v1.") {
        return Result<ContinuationToken, string>::Err(string::from("Invalid continuation token: unrecognized format or version prefix"))
    }
    auto payload_view = token_str.substr(12:usize, token_str.len - 12:usize)
    if payload_view.len == 0:usize {
        return Result<ContinuationToken, string>::Err(string::from("Invalid continuation token: empty payload"))
    }

    // Convert URL-safe base64 characters to standard base64 and pad
    auto std_b64# = string::new()
    auto pi# = 0:usize
    loop pi < payload_view.len {
        auto c = payload_view.byte_at(pi)
        if c == ('-' as char) {
            std_b64#.push_byte_raw('+' as u8)
        } else if c == ('_' as char) {
            std_b64#.push_byte_raw('/' as u8)
        } else {
            std_b64#.push_byte_raw(c as u8)
        }
        pi = pi + 1:usize
    }
    loop std_b64.len() % 4:usize != 0:usize {
        std_b64#.push_byte_raw('=' as u8)
    }

    auto decode_res = base64::decode(std_b64.as_str())
    if decode_res.is_err() {
        return Result<ContinuationToken, string>::Err(string::from("Invalid continuation token: malformed base64 payload"))
    }
    auto bytes_vec = decode_res.unwrap()

    auto json_raw# = string::new()
    auto bi# = 0:usize
    loop bi < bytes_vec.len() {
        json_raw#.push_byte_raw(bytes_vec.get(bi))
        bi = bi + 1:usize
    }

    auto root# = JsonNode::NullNode(0):JsonNode
    auto parse_res = root#.parse_json(json_raw.as_str().trim())
    if parse_res.is_err() {
        return Result<ContinuationToken, string>::Err(string::from("Invalid continuation token: malformed JSON payload"))
    }

    match root {
        auto JsonNode::ObjectNode(&map) => {
            // Check version
            auto v_opt# = map.try_borrow(string::from("version"))
            if v_opt.is_none() {
                v_opt = map.try_borrow(string::from("v"))
            }
            match v_opt {
                auto Option<&JsonNode>::Some(&v_node) => {
                    match v_node {
                        auto JsonNode::NumNode(n) => {
                            if n != 1.0 {
                                return Result<ContinuationToken, string>::Err(string::from("Unsupported continuation token version"))
                            }
                        }
                        _ => {
                            return Result<ContinuationToken, string>::Err(string::from("Invalid version in continuation token"))
                        }
                    }
                }
                auto Option<&JsonNode>::None => {
                    return Result<ContinuationToken, string>::Err(string::from("Missing version in continuation token"))
                }
            }

            // Path
            auto path_val# = string::new()
            auto p_opt# = map.try_borrow(string::from("path"))
            if p_opt.is_none() {
                p_opt = map.try_borrow(string::from("p"))
            }
            match p_opt {
                auto Option<&JsonNode>::Some(&p_node) => {
                    match p_node {
                        auto JsonNode::StrNode(&s) => {
                            if s.len() == 0:usize {
                                return Result<ContinuationToken, string>::Err(string::from("Empty path in continuation token"))
                            }
                            auto s_view = s.as_str()
                            auto is_abs# = s_view.starts_with("/")
                            if !is_abs && s_view.len >= 3:usize && s_view.byte_at(1) == (':' as char) && (s_view.byte_at(2) == ('/' as char) || s_view.byte_at(2) == ('\\' as char)) {
                                is_abs = true
                            }
                            if !is_abs {
                                return Result<ContinuationToken, string>::Err(string::from("Continuation token path must be absolute"))
                            }
                            if resolves_to_root("/", s_view) {
                                return Result<ContinuationToken, string>::Err(string::from("Continuation token path cannot be filesystem root"))
                            }
                            path_val = s.clone()
                        }
                        _ => {
                            return Result<ContinuationToken, string>::Err(string::from("Invalid path in continuation token"))
                        }
                    }
                }
                auto Option<&JsonNode>::None => {
                    return Result<ContinuationToken, string>::Err(string::from("Missing path in continuation token"))
                }
            }

            // req_start
            auto rs_val# = 0:usize
            auto rs_opt# = map.try_borrow(string::from("req_start"))
            if rs_opt.is_none() {
                rs_opt = map.try_borrow(string::from("rs"))
            }
            match rs_opt {
                auto Option<&JsonNode>::Some(&n_node) => {
                    auto parsed = parse_token_positive_int(n_node)
                    if parsed.is_none() {
                        return Result<ContinuationToken, string>::Err(string::from("Invalid req_start in continuation token: must be positive integer"))
                    }
                    rs_val = parsed.unwrap()
                }
                auto Option<&JsonNode>::None => {
                    return Result<ContinuationToken, string>::Err(string::from("Missing req_start in continuation token"))
                }
            }

            // req_end
            auto re_val# = 0:usize
            auto re_opt# = map.try_borrow(string::from("req_end"))
            if re_opt.is_none() {
                re_opt = map.try_borrow(string::from("re"))
            }
            match re_opt {
                auto Option<&JsonNode>::Some(&n_node) => {
                    auto parsed = parse_token_positive_int(n_node)
                    if parsed.is_none() {
                        return Result<ContinuationToken, string>::Err(string::from("Invalid req_end in continuation token: must be positive integer"))
                    }
                    re_val = parsed.unwrap()
                }
                auto Option<&JsonNode>::None => {
                    return Result<ContinuationToken, string>::Err(string::from("Missing req_end in continuation token"))
                }
            }

            // next_line
            auto nl_val# = 0:usize
            auto nl_opt# = map.try_borrow(string::from("next_line"))
            if nl_opt.is_none() {
                nl_opt = map.try_borrow(string::from("nl"))
            }
            match nl_opt {
                auto Option<&JsonNode>::Some(&n_node) => {
                    auto parsed = parse_token_positive_int(n_node)
                    if parsed.is_none() {
                        return Result<ContinuationToken, string>::Err(string::from("Invalid next_line in continuation token: must be positive integer"))
                    }
                    nl_val = parsed.unwrap()
                }
                auto Option<&JsonNode>::None => {
                    return Result<ContinuationToken, string>::Err(string::from("Missing next_line in continuation token"))
                }
            }

            // end_line
            auto el_val# = 0:usize
            auto el_opt# = map.try_borrow(string::from("end_line"))
            if el_opt.is_none() {
                el_opt = map.try_borrow(string::from("el"))
            }
            match el_opt {
                auto Option<&JsonNode>::Some(&n_node) => {
                    auto parsed = parse_token_positive_int(n_node)
                    if parsed.is_none() {
                        return Result<ContinuationToken, string>::Err(string::from("Invalid end_line in continuation token: must be positive integer"))
                    }
                    el_val = parsed.unwrap()
                }
                auto Option<&JsonNode>::None => {
                    return Result<ContinuationToken, string>::Err(string::from("Missing end_line in continuation token"))
                }
            }

            if re_val < rs_val {
                return Result<ContinuationToken, string>::Err(string::from("Invalid continuation token: req_end < req_start"))
            }
            if nl_val < rs_val {
                return Result<ContinuationToken, string>::Err(string::from("Invalid continuation token: next_line < req_start"))
            }
            if el_val < nl_val {
                return Result<ContinuationToken, string>::Err(string::from("Invalid continuation token: end_line < next_line"))
            }
            if el_val > re_val {
                return Result<ContinuationToken, string>::Err(string::from("Invalid continuation token: end_line > req_end"))
            }

            // sha256 hex
            auto h_val# = string::new()
            auto h_opt# = map.try_borrow(string::from("sha256"))
            if h_opt.is_none() {
                h_opt = map.try_borrow(string::from("h"))
            }
            match h_opt {
                auto Option<&JsonNode>::Some(&h_node) => {
                    match h_node {
                        auto JsonNode::StrNode(&s) => {
                            if s.len() != 64:usize {
                                return Result<ContinuationToken, string>::Err(string::from("Invalid sha256 length in continuation token"))
                            }
                            auto hi# = 0:usize
                            loop hi < 64:usize {
                                auto c = s.as_str().byte_at(hi)
                                if !is_hex_char(c) {
                                    return Result<ContinuationToken, string>::Err(string::from("Invalid hex character in sha256"))
                                }
                                hi = hi + 1:usize
                            }
                            h_val = s.clone()
                        }
                        _ => { return Result<ContinuationToken, string>::Err(string::from("Invalid sha256 in continuation token")) }
                    }
                }
                auto Option<&JsonNode>::None => { return Result<ContinuationToken, string>::Err(string::from("Missing sha256 in continuation token")) }
            }

            // mode
            auto m_val# = string::new()
            auto m_opt# = map.try_borrow(string::from("mode"))
            if m_opt.is_none() {
                m_opt = map.try_borrow(string::from("m"))
            }
            match m_opt {
                auto Option<&JsonNode>::Some(&m_node) => {
                    match m_node {
                        auto JsonNode::StrNode(&s) => {
                            if s.as_str() != "symbol" && s.as_str() != "lines" && s.as_str() != "block" && s.as_str() != "point" && s.as_str() != "range" {
                                return Result<ContinuationToken, string>::Err(string::from("Invalid mode in continuation token"))
                            }
                            if s.as_str() == "lines" {
                                m_val = string::from("range")
                            } else {
                                m_val = s.clone()
                            }
                        }
                        _ => { return Result<ContinuationToken, string>::Err(string::from("Invalid mode in continuation token")) }
                    }
                }
                auto Option<&JsonNode>::None => { return Result<ContinuationToken, string>::Err(string::from("Missing mode in continuation token")) }
            }

            // range_status
            auto st_val# = string::from("confirmed")
            auto st_opt# = map.try_borrow(string::from("range_status"))
            if st_opt.is_none() {
                st_opt = map.try_borrow(string::from("st"))
            }
            match st_opt {
                auto Option<&JsonNode>::Some(&st_node) => {
                    match st_node {
                        auto JsonNode::StrNode(&s) => {
                            if s.as_str() != "confirmed" && s.as_str() != "unknown" {
                                return Result<ContinuationToken, string>::Err(string::from("Invalid range_status in continuation token"))
                            }
                            st_val = s.clone()
                        }
                        _ => {
                            return Result<ContinuationToken, string>::Err(string::from("Invalid range_status in continuation token: must be string"))
                        }
                    }
                }
                auto Option<&JsonNode>::None => {
                    return Result<ContinuationToken, string>::Err(string::from("Missing range_status in continuation token"))
                }
            }

            // symbol
            auto s_val# = Option<string>::None
            auto s_opt# = map.try_borrow(string::from("symbol"))
            if s_opt.is_none() {
                s_opt = map.try_borrow(string::from("s"))
            }
            match s_opt {
                auto Option<&JsonNode>::Some(&s_node) => {
                    match s_node {
                        auto JsonNode::StrNode(&s) => { s_val = Option<string>::Some(s.clone()) }
                        _ => {
                            return Result<ContinuationToken, string>::Err(string::from("Invalid symbol in continuation token: must be string"))
                        }
                    }
                }
                auto Option<&JsonNode>::None => {}
            }

            // scope
            auto c_val# = Option<string>::None
            auto c_opt# = map.try_borrow(string::from("scope"))
            if c_opt.is_none() {
                c_opt = map.try_borrow(string::from("c"))
            }
            match c_opt {
                auto Option<&JsonNode>::Some(&c_node) => {
                    match c_node {
                        auto JsonNode::StrNode(&c) => { c_val = Option<string>::Some(c.clone()) }
                        _ => {
                            return Result<ContinuationToken, string>::Err(string::from("Invalid scope in continuation token: must be string"))
                        }
                    }
                }
                auto Option<&JsonNode>::None => {}
            }

            // max_columns
            auto mc_val# = Option<usize>::None
            auto mc_opt# = map.try_borrow(string::from("max_columns"))
            if mc_opt.is_none() {
                mc_opt = map.try_borrow(string::from("mc"))
            }
            match mc_opt {
                auto Option<&JsonNode>::Some(&mc_node) => {
                    auto parsed_mc = parse_token_non_neg_int(mc_node)
                    if parsed_mc.is_none() {
                        return Result<ContinuationToken, string>::Err(string::from("Invalid max_columns in continuation token: must be non-negative integer"))
                    }
                    mc_val = parsed_mc
                }
                auto Option<&JsonNode>::None => {}
            }

            return Result<ContinuationToken, string>::Ok(ContinuationToken(
                version = 1:usize,
                path = cede path_val,
                req_start = rs_val,
                req_end = re_val,
                next_line = nl_val,
                end_line = el_val,
                sha256_hex = cede h_val,
                mode = cede m_val,
                symbol = cede s_val,
                scope = cede c_val,
                range_status = cede st_val,
                max_columns = mc_val
            ))
        }
        _ => {
            return Result<ContinuationToken, string>::Err(string::from("Invalid continuation token: expected JSON object"))
        }
    }
}

pub fn capture_file_bounded(path: str, max_bytes: usize) -> FileCapture {
    auto path_str = string::from(path)
    auto mode_buf# = [0:char; 4]
    mode_buf[0] = 'r' as char
    mode_buf[1] = 'b' as char
    mode_buf[2] = 0 as char

    auto lines# = Vec<string>::new()
    auto read_err# = false
    auto size_exceeded# = false
    auto open_err# = false
    auto bytes_read_accum# = 0:usize

    unsafe {
        auto *mode_ptr = &mode_buf[0] as *char
        auto *path_c = path_str.c_str()
        auto nul *fp = libc_fopen(*path_c, *mode_ptr)
        if *fp == null {
            return FileCapture(
                lines = cede lines,
                sha256_hex = string::new(),
                size_exceeded = false,
                read_err = false,
                open_err = true
            )
        }
        auto *file = fp.unwrap()
        auto nul *raw_buf = libc_malloc(65536:usize)
        if *raw_buf == null {
            libc_fclose(*file)
            return FileCapture(
                lines = cede lines,
                sha256_hex = string::new(),
                size_exceeded = false,
                read_err = true,
                open_err = false
            )
        }
        auto *buf = raw_buf.unwrap()
        auto line_buf# = string::new()
        auto hasher# = Sha256::new()

        loop true {
            auto n = libc_fread(*buf, 1:usize, 65536:usize, *file)
            if n == 0 {
                if posix_ferror((*file) as Addr) {
                    read_err = true
                }
                break
            }

            bytes_read_accum = bytes_read_accum + n
            if bytes_read_accum > max_bytes {
                size_exceeded = true
                break
            }

            auto *c_ptr = ((*buf) as Addr) as *char
            auto chunk_str = string::from_with_len(*c_ptr, n)
            hasher#.update(chunk_str.as_str())

            auto chunk_view = chunk_str.as_str()
            auto cursor# = 0:usize

            loop cursor < chunk_view.len {
                auto rem = chunk_view.substr(cursor, chunk_view.len - cursor)
                auto nl_opt = rem.index_of('\n' as char)
                if nl_opt.is_none() {
                    line_buf#.push_str(rem)
                    break
                }
                auto nl_pos = nl_opt.unwrap()
                auto chunk_slice = rem.substr(0, nl_pos)
                line_buf#.push_str(chunk_slice)
                {
                    auto full_view = line_buf.as_str()
                    auto pat_text# = full_view
                    if full_view.len > 0 && full_view.byte_at(full_view.len - 1) == ('\r' as char) {
                        pat_text = full_view.substr(0, full_view.len - 1)
                    }
                    lines#.push(string::from(pat_text))
                }
                line_buf#.clear()
                cursor = cursor + nl_pos + 1:usize
            }
        }

        if !read_err && !size_exceeded && line_buf.len() > 0 {
            {
                auto full_view = line_buf.as_str()
                auto pat_text# = full_view
                if full_view.len > 0 && full_view.byte_at(full_view.len - 1) == ('\r' as char) {
                    pat_text = full_view.substr(0, full_view.len - 1)
                }
                lines#.push(string::from(pat_text))
            }
            line_buf#.clear()
        }

        libc_free(*buf)
        libc_fclose(*file)

        auto hex_digest# = string::new()
        if !read_err && !size_exceeded {
            hex_digest = hasher#.finalize_hex()
        }

        return FileCapture(
            lines = cede lines,
            sha256_hex = cede hex_digest,
            size_exceeded = size_exceeded,
            read_err = read_err,
            open_err = false
        )
    }
}

pub fn read_file_lines(path: str) -> Result<Vec<string>, string> {
    auto path_str = string::from(path)
    auto mode_buf# = [0:char; 4]
    mode_buf[0] = 'r' as char
    mode_buf[1] = 'b' as char
    mode_buf[2] = 0 as char

    auto lines# = Vec<string>::new()

    unsafe {
        auto *mode_ptr = &mode_buf[0] as *char
        auto *path_c = path_str.c_str()
        auto nul *fp = libc_fopen(*path_c, *mode_ptr)
        if *fp == null {
            auto err# = string::from("Failed to open file '")
            err#.push_str(path)
            err#.push_str("': No such file or directory or permission denied")
            return Result<Vec<string>, string>::Err(cede err)
        }
        auto *file = fp.unwrap()
        auto nul *raw_buf = libc_malloc(65536:usize)
        if *raw_buf == null {
            libc_fclose(*file)
            return Result<Vec<string>, string>::Err(string::from("Out of memory reading file"))
        }
        auto *buf = raw_buf.unwrap()
        auto line_buf# = string::new()
        auto read_err# = false

        loop true {
            auto n = libc_fread(*buf, 1:usize, 65536:usize, *file)
            if n == 0 {
                if posix_ferror((*file) as Addr) {
                    read_err = true
                }
                break
            }

            auto *c_ptr = ((*buf) as Addr) as *char
            auto chunk_str = string::from_with_len(*c_ptr, n)
            auto chunk_view = chunk_str.as_str()
            auto cursor# = 0:usize

            loop cursor < chunk_view.len {
                auto rem = chunk_view.substr(cursor, chunk_view.len - cursor)
                auto nl_opt = rem.index_of('\n' as char)
                if nl_opt.is_none() {
                    line_buf#.push_str(rem)
                    break
                }
                auto nl_pos = nl_opt.unwrap()
                auto chunk_slice = rem.substr(0, nl_pos)
                line_buf#.push_str(chunk_slice)
                {
                    auto full_view = line_buf.as_str()
                    auto pat_text# = full_view
                    if full_view.len > 0 && full_view.byte_at(full_view.len - 1) == ('\r' as char) {
                        pat_text = full_view.substr(0, full_view.len - 1)
                    }
                    lines#.push(string::from(pat_text))
                }
                line_buf#.clear()
                cursor = cursor + nl_pos + 1
            }
        }

        if !read_err && line_buf.len() > 0 {
            {
                auto full_view = line_buf.as_str()
                auto pat_text# = full_view
                if full_view.len > 0 && full_view.byte_at(full_view.len - 1) == ('\r' as char) {
                    pat_text = full_view.substr(0, full_view.len - 1)
                }
                lines#.push(string::from(pat_text))
            }
            line_buf#.clear()
        }

        libc_free(*buf)
        libc_fclose(*file)

        if read_err {
            auto err# = string::from("Error reading file '")
            err#.push_str(path)
            err#.push_str("'")
            return Result<Vec<string>, string>::Err(cede err)
        }
    }

    return Result<Vec<string>, string>::Ok(cede lines)
}

pub fn parse_usize_val(s: str) -> Result<usize, string> {
    if s.len == 0 {
        return Result<usize, string>::Err(string::from("Expected positive integer"))
    }
    auto val# = 0:usize
    auto i# = 0:usize
    loop i < s.len {
        auto ch = s.byte_at(i)
        if ch < ('0' as char) || ch > ('9' as char) {
            return Result<usize, string>::Err(string::from("Expected integer digits"))
        }
        auto digit = (ch as usize) - ('0' as usize)
        if val > (9223372036854775807:usize - digit) / 10:usize {
            return Result<usize, string>::Err(string::from("Integer value exceeds maximum limit"))
        }
        val = val * 10:usize + digit
        i = i + 1
    }
    return Result<usize, string>::Ok(val)
}

pub fn parse_range_spec(s: str) -> Result<BlockRange, string> {
    auto dash_opt = s.index_of('-' as char)
    if dash_opt.is_none() {
        return Result<BlockRange, string>::Err(string::from("Invalid line range: expected '<start>-<end>'"))
    }
    auto dash_idx = dash_opt.unwrap()
    auto start_str = s.substr(0, dash_idx)
    auto end_str = s.substr(dash_idx + 1, s.len - dash_idx - 1)
    auto s_res = parse_usize_val(start_str)
    if s_res.is_err() { return Result<BlockRange, string>::Err(s_res.unwrap_err()) }
    auto e_res = parse_usize_val(end_str)
    if e_res.is_err() { return Result<BlockRange, string>::Err(e_res.unwrap_err()) }
    auto start = s_res.unwrap()
    auto end = e_res.unwrap()
    if start == 0:usize || end < start {
        return Result<BlockRange, string>::Err(string::from("Invalid line range: start must be >= 1 and <= end"))
    }
    return Result<BlockRange, string>::Ok(BlockRange(start = start, end = end))
}

fn find_last_colon(s: str) -> Option<usize> {
    auto i# = s.len
    loop i > 0 {
        i = i - 1
        if s.byte_at(i) == (':' as char) {
            return Option<usize>::Some(i)
        }
    }
    return Option<usize>::None
}

fn execute_view_continuation_lines(
    opts: ViewOptions,
    start_req: usize,
    end_req: usize
) -> Result<ViewResult, string> {
    auto max_lines_val# = 0:usize
    auto has_max_lines# = false
    match opts.max_lines {
        auto Option<usize>::Some(v) => {
            max_lines_val = v
            has_max_lines = true
        }
        _ => {}
    }

    auto max_bytes_val# = 0:usize
    auto has_max_bytes# = false
    match opts.max_result_bytes {
        auto Option<usize>::Some(v) => {
            max_bytes_val = v
            has_max_bytes = true
        }
        _ => {}
    }

    auto max_cols_val# = 0:usize
    auto has_max_cols# = false
    match opts.max_columns {
        auto Option<usize>::Some(v) => {
            max_cols_val = v
            has_max_cols = true
        }
        _ => {}
    }

    if has_max_lines && max_lines_val < 1:usize {
        return Result<ViewResult, string>::Err(string::from("target_exceeds_max_lines: Target line cannot fit within max_lines 0"))
    }

    auto capture = capture_file_bounded(opts.file_path.as_str(), 10485760:usize)
    if capture.open_err || capture.read_err {
        auto err# = string::from("Error reading file '")
        err#.push_str(opts.file_path.as_str())
        err#.push_str("'")
        return Result<ViewResult, string>::Err(cede err)
    }

    if capture.size_exceeded {
        return Result<ViewResult, string>::Err(string::from("scan_incomplete: file too large, exceeds 10MiB input read limit"))
    }

    auto lines = cede capture.lines
    auto sha256_hex = cede capture.sha256_hex
    auto total_lines = lines.len()

    if total_lines == 0:usize {
        return Result<ViewResult, string>::Err(string::from("File is empty"))
    }
    if start_req > total_lines {
        auto err# = string::from("Line range start out of bounds: file has ")
        err#.push_str(u64_to_string(total_lines as u64).as_str())
        err#.push_str(" lines, requested start ")
        err#.push_str(u64_to_string(start_req as u64).as_str())
        return Result<ViewResult, string>::Err(cede err)
    }

    auto end_actual# = end_req
    if end_actual > total_lines {
        end_actual = total_lines
    }

    auto header# = string::new()
    if opts.continuation {
        header#.push_str("[file: ")
        header#.push_str(opts.file_path.as_str())
        header#.push_str(", lines: L")
        header#.push_str(u64_to_string(start_req as u64).as_str())
        header#.push_str("-L")
        header#.push_str(u64_to_string(end_actual as u64).as_str())
        header#.push_str("]\n")
    }

    auto cur_line# = start_req
    auto lines_emitted# = 0:usize
    auto bytes_emitted# = header.len()
    auto truncated# = false
    auto trunc_reason# = string::from("completed")
    auto records# = Vec<ViewLineRecord>::new()
    auto out# = string::new()
    out#.push_str(header.as_str())
    auto content_omitted# = false

    loop cur_line <= end_actual {
        if has_max_lines && lines_emitted >= max_lines_val {
            truncated = true
            trunc_reason = string::from("max_lines")
            break
        }

        auto raw = lines.borrow(cur_line - 1:usize).as_str()
        auto clean_l# = raw
        if raw.len > 0 && raw.byte_at(raw.len - 1) == ('\r' as char) {
            clean_l = raw.substr(0, raw.len - 1)
        }
        auto disp# = clean_l
        if has_max_cols && max_cols_val > 0 && clean_l.len > max_cols_val {
            disp = "[omitted]"
            content_omitted = true
        }

        auto line_entry# = string::new()
        line_entry#.push_str(u64_to_string(cur_line as u64).as_str())
        line_entry#.push_str(":")
        line_entry#.push_str(disp)
        line_entry#.push_str("\n")

        if has_max_bytes && bytes_emitted + line_entry.len() > max_bytes_val {
            truncated = true
            trunc_reason = string::from("max_result_bytes")
            break
        }

        bytes_emitted = bytes_emitted + line_entry.len()
        out#.push_str(line_entry.as_str())
        records#.push(ViewLineRecord(
            line_number = cur_line,
            kind = string::from("context"),
            text = string::from(disp)
        ))
        lines_emitted = lines_emitted + 1:usize
        cur_line = cur_line + 1:usize
    }

    if lines_emitted == 0:usize {
        auto err# = string::from("target_exceeds_max_result_bytes: Target line formatted record exceeds max_result_bytes (")
        if has_max_bytes {
            err#.push_str(u64_to_string(max_bytes_val as u64).as_str())
        }
        err#.push_str(" bytes)")
        return Result<ViewResult, string>::Err(cede err)
    }

    auto continuation_tok# = Option<string>::None
    if truncated && cur_line <= end_actual {
        auto ct = ContinuationToken(
            version = 1:usize,
            path = string::from(opts.file_path.as_str()),
            req_start = start_req,
            req_end = end_actual,
            next_line = cur_line,
            end_line = end_actual,
            sha256_hex = string::from(sha256_hex.as_str()),
            mode = string::from("range"),
            symbol = Option<string>::None,
            scope = Option<string>::None,
            range_status = string::from("confirmed"),
            max_columns = opts.max_columns
        )
        continuation_tok = encode_continuation_token(ct)
        if continuation_tok.is_none() {
            return Result<ViewResult, string>::Err(string::from("continuation_token_overflow: Continuation token exceeds maximum length limit (4096 bytes)"))
        }
    }

    auto emitted_range# = Option<BlockRange>::None
    if lines_emitted > 0:usize {
        emitted_range = Option<BlockRange>::Some(BlockRange(
            start = start_req,
            end = cur_line - 1:usize
        ))
    }

    auto term_reason# = string::from("completed")
    if truncated {
        term_reason = trunc_reason.clone()
    }
    auto out_stat# = string::from("complete")
    if truncated {
        out_stat = string::from("budget_truncated")
    }

    return Result<ViewResult, string>::Ok(ViewResult(
        text = cede out,
        truncated = truncated,
        reason = cede term_reason,
        lines_emitted = lines_emitted,
        bytes_emitted = bytes_emitted,
        mode = string::from("range"),
        path = string::from(opts.file_path.as_str()),
        requested_line = Option<usize>::None,
        requested_range = Option<BlockRange>::Some(BlockRange(start = start_req, end = end_actual)),
        detected_block_range = Option<BlockRange>::Some(BlockRange(start = start_req, end = end_actual)),
        emitted_range = emitted_range,
        target_included = Option<bool>::Some(false),
        content_omitted = content_omitted,
        complete = !truncated && (cur_line > end_actual),
        eof_reached = !truncated && (end_actual == total_lines),
        records = cede records,
        selection_status = string::from("found"),
        range_status = Option<string>::Some(string::from("confirmed")),
        output_status = cede out_stat,
        target_symbol = Vec<SymbolTargetInfo>::new(),
        candidates = Vec<SymbolCandidateInfo>::new(),
        candidates_truncated = false,
        continuation_token = cede continuation_tok,
        continuation_active = true,
        sha256_hex = string::from(sha256_hex.as_str())
    ))
}

fn execute_view_stream_lines(
    opts: ViewOptions,
    start_req: usize,
    end_req: usize
) -> Result<ViewResult, string> {
    if opts.continuation {
        return execute_view_continuation_lines(opts, start_req, end_req)
    }
    auto path_str = string::from(opts.file_path.as_str())
    auto mode_buf# = [0:char; 4]
    mode_buf[0] = 'r' as char
    mode_buf[1] = 'b' as char
    mode_buf[2] = 0 as char

    auto max_lines_val# = 0:usize
    auto has_max_lines# = false
    match opts.max_lines {
        auto Option<usize>::Some(v) => {
            max_lines_val = v
            has_max_lines = true
        }
        _ => {}
    }

    auto max_bytes_val# = 0:usize
    auto has_max_bytes# = false
    match opts.max_result_bytes {
        auto Option<usize>::Some(v) => {
            max_bytes_val = v
            has_max_bytes = true
        }
        _ => {}
    }

    auto max_cols_val# = 0:usize
    auto has_max_cols# = false
    match opts.max_columns {
        auto Option<usize>::Some(v) => {
            max_cols_val = v
            has_max_cols = true
        }
        _ => {}
    }

    auto out# = string::new()
    auto lines_emitted# = 0:usize
    auto bytes_emitted# = 0:usize
    auto truncated# = false
    auto trunc_reason# = string::new()
    auto total_lines# = 0:usize
    auto read_err# = false
    auto early_stop# = false
    auto eof_reached# = false
    auto content_omitted# = false
    auto records# = Vec<ViewLineRecord>::new()

    unsafe {
        auto *mode_ptr = &mode_buf[0] as *char
        auto *path_c = path_str.c_str()
        auto nul *fp = libc_fopen(*path_c, *mode_ptr)
        if *fp == null {
            auto err# = string::from("Failed to open file '")
            err#.push_str(opts.file_path.as_str())
            err#.push_str("': No such file or directory or permission denied")
            return Result<ViewResult, string>::Err(cede err)
        }
        auto *file = fp.unwrap()
        auto nul *raw_buf = libc_malloc(65536:usize)
        if *raw_buf == null {
            libc_fclose(*file)
            return Result<ViewResult, string>::Err(string::from("Out of memory reading file"))
        }
        auto *buf = raw_buf.unwrap()
        auto line_buf# = string::new()
        auto cur_line# = 1:usize

        loop true {
            auto n = libc_fread(*buf, 1:usize, 65536:usize, *file)
            if n == 0 {
                if posix_ferror((*file) as Addr) {
                    read_err = true
                }
                eof_reached = true
                break
            }

            auto *c_ptr = ((*buf) as Addr) as *char
            auto chunk_str = string::from_with_len(*c_ptr, n)
            auto chunk_view = chunk_str.as_str()
            auto cursor# = 0:usize

            loop cursor < chunk_view.len {
                auto rem = chunk_view.substr(cursor, chunk_view.len - cursor)
                auto nl_opt = rem.index_of('\n' as char)
                if nl_opt.is_none() {
                    if cur_line >= start_req {
                        line_buf#.push_str(rem)
                    }
                    break
                }

                auto nl_pos = nl_opt.unwrap()
                if cur_line >= start_req {
                    auto chunk_slice = rem.substr(0, nl_pos)
                    line_buf#.push_str(chunk_slice)

                    auto line_str = line_buf.clone()
                    line_buf#.clear()

                    auto full_view = line_str.as_str()
                    auto pat_text# = full_view
                    if full_view.len > 0 && full_view.byte_at(full_view.len - 1) == ('\r' as char) {
                        pat_text = full_view.substr(0, full_view.len - 1)
                    }

                    auto display_text# = pat_text
                    if has_max_cols && max_cols_val > 0 && pat_text.len > max_cols_val {
                        display_text = "[omitted]"
                        content_omitted = true
                    }

                    auto line_entry# = string::new()
                    line_entry#.push_str(u64_to_string(cur_line as u64).as_str())
                    line_entry#.push_str(":")
                    line_entry#.push_str(display_text)
                    line_entry#.push_str("\n")

                    if has_max_lines && lines_emitted >= max_lines_val {
                        truncated = true
                        trunc_reason = string::from("max_lines")
                        early_stop = true
                        cursor = cursor + nl_pos + 1
                        cur_line = cur_line + 1
                        break
                    }

                    if has_max_bytes && bytes_emitted + line_entry.len() > max_bytes_val {
                        truncated = true
                        trunc_reason = string::from("max_result_bytes")
                        early_stop = true
                        cursor = cursor + nl_pos + 1
                        cur_line = cur_line + 1
                        break
                    }

                    bytes_emitted = bytes_emitted + line_entry.len()
                    lines_emitted = lines_emitted + 1
                    out#.push_str(line_entry.as_str())
                    records#.push(ViewLineRecord(
                        line_number = cur_line,
                        kind = string::from("context"),
                        text = string::from(display_text)
                    ))

                    if cur_line == end_req {
                        early_stop = true
                        cursor = cursor + nl_pos + 1
                        cur_line = cur_line + 1
                        break
                    }
                }

                cur_line = cur_line + 1
                cursor = cursor + nl_pos + 1
            }

            if early_stop {
                break
            }
        }

        if !read_err && !early_stop && line_buf.len() > 0 {
            if cur_line >= start_req {
                auto line_str = line_buf.clone()
                auto full_view = line_str.as_str()
                auto pat_text# = full_view
                if full_view.len > 0 && full_view.byte_at(full_view.len - 1) == ('\r' as char) {
                    pat_text = full_view.substr(0, full_view.len - 1)
                }

                auto display_text# = pat_text
                if has_max_cols && max_cols_val > 0 && pat_text.len > max_cols_val {
                    display_text = "[omitted]"
                    content_omitted = true
                }

                auto line_entry# = string::new()
                line_entry#.push_str(u64_to_string(cur_line as u64).as_str())
                line_entry#.push_str(":")
                line_entry#.push_str(display_text)
                line_entry#.push_str("\n")

                auto can_emit# = true
                if has_max_lines && lines_emitted >= max_lines_val {
                    truncated = true
                    trunc_reason = string::from("max_lines")
                    can_emit = false
                }
                if can_emit && has_max_bytes && bytes_emitted + line_entry.len() > max_bytes_val {
                    truncated = true
                    trunc_reason = string::from("max_result_bytes")
                    can_emit = false
                }
                if can_emit {
                    bytes_emitted = bytes_emitted + line_entry.len()
                    lines_emitted = lines_emitted + 1
                    out#.push_str(line_entry.as_str())
                    records#.push(ViewLineRecord(
                        line_number = cur_line,
                        kind = string::from("context"),
                        text = string::from(display_text)
                    ))
                }
            }
            total_lines = cur_line
            line_buf#.clear()
        } else if !early_stop {
            total_lines = cur_line - 1
        }

        libc_free(*buf)
        libc_fclose(*file)

        if read_err {
            auto err# = string::from("Error reading file '")
            err#.push_str(opts.file_path.as_str())
            err#.push_str("'")
            return Result<ViewResult, string>::Err(cede err)
        }
    }

    if !early_stop {
        if total_lines == 0:usize {
            return Result<ViewResult, string>::Err(string::from("File is empty"))
        }
        if start_req > total_lines {
            auto err# = string::from("Line range start out of bounds: file has ")
            err#.push_str(u64_to_string(total_lines as u64).as_str())
            err#.push_str(" lines, requested start ")
            err#.push_str(u64_to_string(start_req as u64).as_str())
            return Result<ViewResult, string>::Err(cede err)
        }
    }

    auto emitted_range# = Option<BlockRange>::None
    if lines_emitted > 0:usize {
        emitted_range = Option<BlockRange>::Some(BlockRange(start = start_req, end = start_req + lines_emitted - 1:usize))
    }

    auto complete# = false
    if !truncated {
        complete = true
    }

    auto term_reason# = string::from("completed")
    if truncated {
        term_reason = trunc_reason.clone()
    }
    auto out_stat# = string::from("complete")
    if truncated {
        out_stat = string::from("budget_truncated")
    }

    return Result<ViewResult, string>::Ok(ViewResult(
        text = cede out,
        truncated = truncated,
        reason = cede term_reason,
        lines_emitted = lines_emitted,
        bytes_emitted = bytes_emitted,
        mode = string::from("range"),
        path = opts.file_path.clone(),
        requested_line = Option<usize>::None,
        requested_range = Option<BlockRange>::Some(BlockRange(start = start_req, end = end_req)),
        detected_block_range = Option<BlockRange>::None,
        emitted_range = emitted_range,
        target_included = Option<bool>::None,
        content_omitted = content_omitted,
        complete = complete,
        eof_reached = eof_reached,
        records = cede records,
        selection_status = string::from("found"),
        range_status = Option<string>::None,
        output_status = cede out_stat,
        target_symbol = Vec<SymbolTargetInfo>::new(),
        candidates = Vec<SymbolCandidateInfo>::new(),
        candidates_truncated = false,
        continuation_token = Option<string>::None,
        continuation_active = false,
        sha256_hex = string::new()
    ))
}

fn execute_view_stream_point(
    opts: ViewOptions,
    target_line: usize
) -> Result<ViewResult, string> {
    auto path_str = string::from(opts.file_path.as_str())
    auto mode_buf# = [0:char; 4]
    mode_buf[0] = 'r' as char
    mode_buf[1] = 'b' as char
    mode_buf[2] = 0 as char

    auto max_lines_val# = 0:usize
    auto has_max_lines# = false
    match opts.max_lines {
        auto Option<usize>::Some(v) => {
            max_lines_val = v
            has_max_lines = true
        }
        _ => {}
    }

    auto max_bytes_val# = 0:usize
    auto has_max_bytes# = false
    match opts.max_result_bytes {
        auto Option<usize>::Some(v) => {
            max_bytes_val = v
            has_max_bytes = true
        }
        _ => {}
    }

    auto max_cols_val# = 0:usize
    auto has_max_cols# = false
    match opts.max_columns {
        auto Option<usize>::Some(v) => {
            max_cols_val = v
            has_max_cols = true
        }
        _ => {}
    }

    auto before_lines# = Vec<string>::new()
    auto after_lines# = Vec<string>::new()
    auto target_text# = string::new()
    auto target_found# = false
    auto read_err# = false
    auto eof_reached# = false
    auto total_lines# = 0:usize

    auto start_req# = 1:usize
    if target_line > opts.context {
        start_req = target_line - opts.context
    }
    auto end_req = target_line + opts.context

    unsafe {
        auto *mode_ptr = &mode_buf[0] as *char
        auto *path_c = path_str.c_str()
        auto nul *fp = libc_fopen(*path_c, *mode_ptr)
        if *fp == null {
            auto err# = string::from("Failed to open file '")
            err#.push_str(opts.file_path.as_str())
            err#.push_str("': No such file or directory or permission denied")
            return Result<ViewResult, string>::Err(cede err)
        }
        auto *file = fp.unwrap()
        auto nul *raw_buf = libc_malloc(65536:usize)
        if *raw_buf == null {
            libc_fclose(*file)
            return Result<ViewResult, string>::Err(string::from("Out of memory reading file"))
        }
        auto *buf = raw_buf.unwrap()
        auto line_buf# = string::new()
        auto cur_line# = 1:usize
        auto stop_reading# = false

        loop true {
            auto n = libc_fread(*buf, 1:usize, 65536:usize, *file)
            if n == 0 {
                if posix_ferror((*file) as Addr) {
                    read_err = true
                }
                eof_reached = true
                break
            }

            auto *c_ptr = ((*buf) as Addr) as *char
            auto chunk_str = string::from_with_len(*c_ptr, n)
            auto chunk_view = chunk_str.as_str()
            auto cursor# = 0:usize

            loop cursor < chunk_view.len {
                auto rem = chunk_view.substr(cursor, chunk_view.len - cursor)
                auto nl_opt = rem.index_of('\n' as char)
                if nl_opt.is_none() {
                    line_buf#.push_str(rem)
                    break
                }

                auto nl_pos = nl_opt.unwrap()
                auto chunk_slice = rem.substr(0, nl_pos)
                line_buf#.push_str(chunk_slice)

                auto line_str = line_buf.clone()
                line_buf#.clear()

                auto full_view = line_str.as_str()
                auto pat_text# = full_view
                if full_view.len > 0 && full_view.byte_at(full_view.len - 1) == ('\r' as char) {
                    pat_text = full_view.substr(0, full_view.len - 1)
                }

                if cur_line >= start_req && cur_line < target_line {
                    before_lines#.push(string::from(pat_text))
                } else if cur_line == target_line {
                    target_text = string::from(pat_text)
                    target_found = true
                } else if cur_line > target_line && cur_line <= end_req {
                    after_lines#.push(string::from(pat_text))
                    if cur_line == end_req {
                        stop_reading = true
                        cursor = cursor + nl_pos + 1
                        cur_line = cur_line + 1
                        break
                    }
                }

                cur_line = cur_line + 1
                cursor = cursor + nl_pos + 1
            }

            if stop_reading {
                break
            }
        }

        if !read_err && !stop_reading && line_buf.len() > 0 {
            auto line_str = line_buf.clone()
            auto full_view = line_str.as_str()
            auto pat_text# = full_view
            if full_view.len > 0 && full_view.byte_at(full_view.len - 1) == ('\r' as char) {
                pat_text = full_view.substr(0, full_view.len - 1)
            }
            if cur_line >= start_req && cur_line < target_line {
                before_lines#.push(string::from(pat_text))
            } else if cur_line == target_line {
                target_text = string::from(pat_text)
                target_found = true
            } else if cur_line > target_line && cur_line <= end_req {
                after_lines#.push(string::from(pat_text))
            }
            total_lines = cur_line
            line_buf#.clear()
        } else if !stop_reading {
            total_lines = cur_line - 1
        }

        libc_free(*buf)
        libc_fclose(*file)

        if read_err {
            auto err# = string::from("Error reading file '")
            err#.push_str(opts.file_path.as_str())
            err#.push_str("'")
            return Result<ViewResult, string>::Err(cede err)
        }
    }

    if !target_found {
        if total_lines == 0:usize {
            return Result<ViewResult, string>::Err(string::from("File is empty"))
        }
        auto err# = string::from("Line number out of bounds: file has ")
        err#.push_str(u64_to_string(total_lines as u64).as_str())
        err#.push_str(" lines, requested line ")
        err#.push_str(u64_to_string(target_line as u64).as_str())
        return Result<ViewResult, string>::Err(cede err)
    }

    auto content_omitted# = false
    auto target_display# = target_text.as_str()
    if has_max_cols && max_cols_val > 0 && target_text.len() > max_cols_val {
        target_display = "[omitted]"
        content_omitted = true
    }

    auto target_entry# = string::new()
    target_entry#.push_str(u64_to_string(target_line as u64).as_str())
    target_entry#.push_str(":")
    target_entry#.push_str(target_display)
    target_entry#.push_str("\n")

    if has_max_bytes && target_entry.len() > max_bytes_val {
        auto err# = string::from("target_exceeds_max_result_bytes: Target line formatted record (")
        err#.push_str(u64_to_string(target_entry.len() as u64).as_str())
        err#.push_str(" bytes) exceeds max_result_bytes (")
        err#.push_str(u64_to_string(max_bytes_val as u64).as_str())
        err#.push_str(" bytes)")
        return Result<ViewResult, string>::Err(cede err)
    }

    if has_max_lines && max_lines_val < 1:usize {
        return Result<ViewResult, string>::Err(string::from("target_exceeds_max_lines: Target line cannot fit within max_lines 0"))
    }

    auto avail_before = before_lines.len()
    auto avail_after = after_lines.len()

    auto rem_lines# = avail_before + avail_after
    if has_max_lines {
        if max_lines_val > 1:usize {
            rem_lines = max_lines_val - 1:usize
        } else {
            rem_lines = 0:usize
        }
    }

    auto rem_bytes# = 18446744073709551615:usize
    if has_max_bytes {
        rem_bytes = max_bytes_val - target_entry.len()
    }

    auto b_take# = 0:usize
    auto a_take# = 0:usize
    auto truncated# = false
    auto trunc_reason# = string::new()

    loop b_take + a_take < rem_lines {
        auto can_b = b_take < avail_before
        auto can_a = a_take < avail_after
        if !can_b && !can_a {
            break
        }

        if can_b && (b_take <= a_take || !can_a) {
            auto b_line_num = target_line - 1:usize - b_take
            auto b_raw = before_lines.borrow(avail_before - 1:usize - b_take).as_str()
            auto b_disp# = b_raw
            if has_max_cols && max_cols_val > 0 && b_raw.len > max_cols_val {
                b_disp = "[omitted]"
                content_omitted = true
            }
            auto b_len = u64_to_string(b_line_num as u64).len() + 1:usize + b_disp.len + 1:usize
            if has_max_bytes && b_len > rem_bytes {
                truncated = true
                trunc_reason = string::from("max_result_bytes")
                break
            }
            if has_max_bytes {
                rem_bytes = rem_bytes - b_len
            }
            b_take = b_take + 1:usize
        }

        if b_take + a_take >= rem_lines {
            break
        }

        if can_a && (a_take < b_take || !can_b) {
            auto a_line_num = target_line + 1:usize + a_take
            auto a_raw = after_lines.borrow(a_take).as_str()
            auto a_disp# = a_raw
            if has_max_cols && max_cols_val > 0 && a_raw.len > max_cols_val {
                a_disp = "[omitted]"
                content_omitted = true
            }
            auto a_len = u64_to_string(a_line_num as u64).len() + 1:usize + a_disp.len + 1:usize
            if has_max_bytes && a_len > rem_bytes {
                truncated = true
                trunc_reason = string::from("max_result_bytes")
                break
            }
            if has_max_bytes {
                rem_bytes = rem_bytes - a_len
            }
            a_take = a_take + 1:usize
        }
    }

    if !truncated && (b_take + a_take < avail_before + avail_after) {
        truncated = true
        trunc_reason = string::from("max_lines")
    }

    auto out# = string::new()
    auto records# = Vec<ViewLineRecord>::new()

    // 1. Before lines in ascending order
    if b_take > 0:usize {
        auto idx# = b_take
        loop idx > 0:usize {
            auto b_line_num = target_line - idx
            auto b_raw = before_lines.borrow(avail_before - idx).as_str()
            auto b_disp# = b_raw
            if has_max_cols && max_cols_val > 0 && b_raw.len > max_cols_val {
                b_disp = "[omitted]"
            }
            out#.push_str(u64_to_string(b_line_num as u64).as_str())
            out#.push_str("-")
            out#.push_str(b_disp)
            out#.push_str("\n")
            records#.push(ViewLineRecord(
                line_number = b_line_num,
                kind = string::from("context"),
                text = string::from(b_disp)
            ))
            idx = idx - 1:usize
        }
    }

    // 2. Target line
    out#.push_str(target_entry.as_str())
    records#.push(ViewLineRecord(
        line_number = target_line,
        kind = string::from("target"),
        text = string::from(target_display)
    ))

    // 3. After lines in ascending order
    auto a_idx# = 0:usize
    loop a_idx < a_take {
        auto a_line_num = target_line + 1:usize + a_idx
        auto a_raw = after_lines.borrow(a_idx).as_str()
        auto a_disp# = a_raw
        if has_max_cols && max_cols_val > 0 && a_raw.len > max_cols_val {
            a_disp = "[omitted]"
        }
        out#.push_str(u64_to_string(a_line_num as u64).as_str())
        out#.push_str("-")
        out#.push_str(a_disp)
        out#.push_str("\n")
        records#.push(ViewLineRecord(
            line_number = a_line_num,
            kind = string::from("context"),
            text = string::from(a_disp)
        ))
        a_idx = a_idx + 1:usize
    }

    auto first_line = target_line - b_take
    auto last_line = target_line + a_take
    auto lines_emitted = 1:usize + b_take + a_take
    auto bytes_emitted = out.len()

    auto term_reason# = string::from("completed")
    if truncated {
        term_reason = trunc_reason.clone()
    }
    auto out_stat# = string::from("complete")
    if truncated {
        out_stat = string::from("budget_truncated")
    }

    return Result<ViewResult, string>::Ok(ViewResult(
        text = cede out,
        truncated = truncated,
        reason = cede term_reason,
        lines_emitted = lines_emitted,
        bytes_emitted = bytes_emitted,
        mode = string::from("point"),
        path = opts.file_path.clone(),
        requested_line = Option<usize>::Some(target_line),
        requested_range = Option<BlockRange>::None,
        detected_block_range = Option<BlockRange>::None,
        emitted_range = Option<BlockRange>::Some(BlockRange(start = first_line, end = last_line)),
        target_included = Option<bool>::Some(true),
        content_omitted = content_omitted,
        complete = !truncated,
        eof_reached = eof_reached,
        records = cede records,
        selection_status = string::from("found"),
        range_status = Option<string>::None,
        output_status = cede out_stat,
        target_symbol = Vec<SymbolTargetInfo>::new(),
        candidates = Vec<SymbolCandidateInfo>::new(),
        candidates_truncated = false,
        continuation_token = Option<string>::None,
        continuation_active = false,
        sha256_hex = string::new()
    ))
}

shape BlockStackFrame (
    line_number: usize,
    delimiter: BlockDelimiter,
    depth: usize
)

shape IndentStackFrame (
    line_number: usize,
    indent: usize
)

fn snap_block_start_decorators(
    initial_start: usize,
    first_stored_line: usize,
    before_ring: Vec<string>
) -> usize {
    auto cur_snap# = initial_start
    loop cur_snap > first_stored_line {
        auto check_line_no = cur_snap - 1:usize
        auto idx = check_line_no - first_stored_line
        if idx >= before_ring.len() {
            break
        }
        auto &raw_line = before_ring.borrow(idx)
        auto trimmed = raw_line.as_str().trim()
        if trimmed.len == 0 {
            break
        }
        if trimmed.starts_with("@") || trimmed.starts_with("#[") {
            cur_snap = check_line_no
            continue
        }
        if trimmed.ends_with(")") || trimmed.ends_with("]") {
            auto p_depth# = 0:i32
            auto found_opener# = false
            auto scan_up# = check_line_no
            loop scan_up >= first_stored_line {
                auto up_idx = scan_up - first_stored_line
                if up_idx >= before_ring.len() {
                    break
                }
                auto &up_line = before_ring.borrow(up_idx)
                auto up_trimmed = up_line.as_str().trim()
                if up_trimmed.len == 0 {
                    break
                }
                auto c_i# = up_trimmed.len
                loop c_i > 0 {
                    c_i = c_i - 1
                    auto ch = up_trimmed.byte_at(c_i)
                    if ch == (')' as char) || ch == (']' as char) {
                        p_depth = p_depth + 1
                    } else if ch == ('(' as char) || ch == ('[' as char) {
                        p_depth = p_depth - 1
                    }
                }
                if p_depth <= 0 && (up_trimmed.starts_with("@") || up_trimmed.starts_with("#[")) {
                    found_opener = true
                    cur_snap = scan_up
                    break
                }
                if scan_up == first_stored_line {
                    break
                }
                scan_up = scan_up - 1
            }
            if found_opener {
                continue
            }
        }
        break
    }
    return cur_snap
}

shape BlockDetectionResult (
    block_start: usize,
    block_end: usize,
    block_closed: bool
)

fn snap_block_start_decorators_lines(
    initial_start: usize,
    lines: Vec<string>
) -> usize {
    auto cur_snap# = initial_start
    loop cur_snap > 1:usize {
        auto check_line_no = cur_snap - 1:usize
        auto idx = check_line_no - 1:usize
        if idx >= lines.len() {
            break
        }
        auto &raw_line = lines.borrow(idx)
        auto trimmed = raw_line.as_str().trim()
        if trimmed.len == 0 {
            break
        }
        if trimmed.starts_with("@") || trimmed.starts_with("#[") {
            cur_snap = check_line_no
            continue
        }
        if trimmed.ends_with(")") || trimmed.ends_with("]") {
            auto p_depth# = 0:i32
            auto found_opener# = false
            auto scan_up# = check_line_no
            loop scan_up >= 1:usize {
                auto up_idx = scan_up - 1:usize
                if up_idx >= lines.len() {
                    break
                }
                auto &up_line = lines.borrow(up_idx)
                auto up_trimmed = up_line.as_str().trim()
                if up_trimmed.len == 0 {
                    break
                }
                auto c_i# = up_trimmed.len
                loop c_i > 0 {
                    c_i = c_i - 1
                    auto ch = up_trimmed.byte_at(c_i)
                    if ch == (')' as char) || ch == (']' as char) {
                        p_depth = p_depth + 1
                    } else if ch == ('(' as char) || ch == ('[' as char) {
                        p_depth = p_depth - 1
                        if p_depth <= 0 {
                            if up_trimmed.starts_with("@") || up_trimmed.starts_with("#[") {
                                found_opener = true
                            }
                            break
                        }
                    }
                }
                if found_opener {
                    cur_snap = scan_up
                    break
                }
                if p_depth <= 0 {
                    break
                }
                if scan_up <= 1:usize {
                    break
                }
                scan_up = scan_up - 1:usize
            }
            if found_opener {
                continue
            }
        }
        break
    }
    return cur_snap
}

fn detect_block_range_for_lines(
    lines: Vec<string>,
    target_line: usize,
    family: SyntaxFamily,
    dialect: LexicalDialect
) -> BlockDetectionResult {
    auto total_lines = lines.len()
    if total_lines == 0:usize || target_line < 1:usize || target_line > total_lines {
        return BlockDetectionResult(block_start = target_line, block_end = target_line, block_closed = false)
    }

    auto block_start# = target_line
    auto block_end# = target_line
    auto block_closed# = false
    auto target_depth# = 0:usize
    auto target_indent# = 0:usize
    auto delim# = BlockDelimiter::Brace

    auto depths# = DelimiterDepths::new()

    auto block_stack# = Vec<BlockStackFrame>::new()
    auto indent_stack# = Vec<IndentStackFrame>::new()

    auto cur_line# = 1:usize
    loop cur_line <= total_lines {
        auto raw_l = lines.borrow(cur_line - 1:usize).as_str()
        auto clean_l# = raw_l
        if raw_l.len > 0 && raw_l.byte_at(raw_l.len - 1) == ('\r' as char) {
            clean_l = raw_l.substr(0, raw_l.len - 1)
        }

        auto lex = scan_line_lexical(clean_l, depths#, dialect)

        if cur_line < target_line {
            match family {
                auto SyntaxFamily::Brace => {
                    if lex.starts_block || lex.depth_after_brace > lex.depth_before_brace || lex.depth_after_paren > lex.depth_before_paren {
                        auto d_type = lex.delimiter
                        auto depth_val# = lex.depth_before_paren
                        if d_type == BlockDelimiter::Brace {
                            depth_val = lex.depth_before_brace
                        }
                        block_stack#.push(BlockStackFrame(
                            line_number = cur_line,
                            delimiter = d_type,
                            depth = depth_val
                        ))
                    }

                    loop block_stack.len() > 0:usize {
                        auto top_idx = block_stack.len() - 1:usize
                        auto should_pop# = false
                        {
                            auto &top_f = block_stack.borrow(top_idx)
                            if top_f.delimiter == BlockDelimiter::Brace && lex.depth_after_brace <= top_f.depth {
                                should_pop = true
                            } else if top_f.delimiter == BlockDelimiter::Paren && lex.depth_after_paren <= top_f.depth {
                                should_pop = true
                            }
                        }
                        if should_pop {
                            block_stack#.pop()
                        } else {
                            break
                        }
                    }
                }
                auto SyntaxFamily::Indent => {
                    if lex.participates_in_indent {
                        auto is_header = lex.code_text.as_str().trim().ends_with(":") || lex.starts_block
                        if is_header {
                            auto indent = lex.statement_indent
                            loop indent_stack.len() > 0:usize {
                                auto top_idx = indent_stack.len() - 1:usize
                                if indent_stack.borrow(top_idx).indent >= indent {
                                    indent_stack#.pop()
                                } else {
                                    break
                                }
                            }
                            indent_stack#.push(IndentStackFrame(line_number = cur_line, indent = indent))
                        } else {
                            loop indent_stack.len() > 0:usize {
                                auto top_idx = indent_stack.len() - 1:usize
                                if indent_stack.borrow(top_idx).indent >= lex.statement_indent {
                                    indent_stack#.pop()
                                } else {
                                    break
                                }
                            }
                        }
                    }
                }
            }
        } else if cur_line == target_line {
            match family {
                auto SyntaxFamily::Brace => {
                    if lex.starts_block {
                        block_start = target_line
                        delim = lex.delimiter
                        if delim == BlockDelimiter::Brace {
                            target_depth = lex.depth_before_brace
                        } else {
                            target_depth = lex.depth_before_paren
                        }
                    } else if block_stack.len() > 0:usize {
                        auto top_idx = block_stack.len() - 1:usize
                        auto &top_f = block_stack.borrow(top_idx)
                        block_start = top_f.line_number
                        delim = top_f.delimiter
                        target_depth = top_f.depth
                    } else {
                        block_start = target_line
                        delim = BlockDelimiter::Brace
                        target_depth = 0:usize
                    }

                    if block_start == target_line && check_is_self_closed_structured(delim, lex.depth_after_brace, lex.depth_after_paren, target_depth, lex.has_code_brace_closer, lex.has_code_paren_closer) {
                        block_end = target_line
                        block_closed = true
                    } else if block_start < target_line {
                        if delim == BlockDelimiter::Brace && lex.depth_before_brace > target_depth && lex.depth_after_brace <= target_depth && lex.has_code_brace_closer {
                            block_end = target_line
                            block_closed = true
                        } else if delim == BlockDelimiter::Paren && lex.depth_before_paren > target_depth && lex.depth_after_paren <= target_depth && lex.has_code_paren_closer {
                            block_end = target_line
                            block_closed = true
                        }
                    }
                }
                auto SyntaxFamily::Indent => {
                    auto is_header = lex.participates_in_indent && (lex.code_text.as_str().trim().ends_with(":") || lex.starts_block)
                    if is_header {
                        target_indent = lex.statement_indent
                        block_start = target_line
                    } else if lex.participates_in_indent {
                        loop indent_stack.len() > 0:usize {
                            auto top_idx = indent_stack.len() - 1:usize
                            if indent_stack.borrow(top_idx).indent >= lex.statement_indent {
                                indent_stack#.pop()
                            } else {
                                break
                            }
                        }
                        if indent_stack.len() > 0:usize {
                            auto top_idx = indent_stack.len() - 1:usize
                            auto &top_f = indent_stack.borrow(top_idx)
                            block_start = top_f.line_number
                            target_indent = top_f.indent
                        } else {
                            target_indent = lex.statement_indent
                            block_start = target_line
                        }
                    } else {
                        if indent_stack.len() > 0:usize {
                            auto top_idx = indent_stack.len() - 1:usize
                            auto &top_f = indent_stack.borrow(top_idx)
                            block_start = top_f.line_number
                            target_indent = top_f.indent
                        } else {
                            target_indent = 0:usize
                            block_start = target_line
                        }
                    }
                }
            }
            block_start = snap_block_start_decorators_lines(block_start, lines)
            if block_closed {
                break
            }
        } else {
            // cur_line > target_line
            match family {
                auto SyntaxFamily::Brace => {
                    if check_is_runaway_definition_structured(lex.is_scope_decl, lex.depth_before_brace, delim, target_depth) {
                        break
                    }
                    match delim {
                        auto BlockDelimiter::Paren => {
                            if lex.depth_before_paren > target_depth && lex.depth_after_paren <= target_depth && lex.has_code_paren_closer {
                                block_end = cur_line
                                block_closed = true
                                break
                            }
                        }
                        auto BlockDelimiter::Brace => {
                            if lex.depth_before_brace > target_depth && lex.depth_after_brace <= target_depth && lex.has_code_brace_closer {
                                block_end = cur_line
                                block_closed = true
                                break
                            }
                        }
                    }
                }
                auto SyntaxFamily::Indent => {
                    if lex.participates_in_indent && lex.statement_indent <= target_indent {
                        block_end = cur_line - 1:usize
                        block_closed = true
                        break
                    }
                }
            }
        }
        cur_line = cur_line + 1:usize
    }

    if !block_closed && family == SyntaxFamily::Indent {
        block_end = total_lines
        block_closed = true
    }

    if block_end < target_line {
        block_end = target_line
    }

    return BlockDetectionResult(
        block_start = block_start,
        block_end = block_end,
        block_closed = block_closed
    )
}

fn execute_view_continuation_block(
    opts: ViewOptions,
    target_line: usize
) -> Result<ViewResult, string> {
    auto max_lines_val# = 0:usize
    auto has_max_lines# = false
    match opts.max_lines {
        auto Option<usize>::Some(v) => {
            max_lines_val = v
            has_max_lines = true
        }
        _ => {}
    }

    auto max_bytes_val# = 0:usize
    auto has_max_bytes# = false
    match opts.max_result_bytes {
        auto Option<usize>::Some(v) => {
            max_bytes_val = v
            has_max_bytes = true
        }
        _ => {}
    }

    auto max_cols_val# = 0:usize
    auto has_max_cols# = false
    match opts.max_columns {
        auto Option<usize>::Some(v) => {
            max_cols_val = v
            has_max_cols = true
        }
        _ => {}
    }

    if has_max_lines && max_lines_val < 1:usize {
        return Result<ViewResult, string>::Err(string::from("target_exceeds_max_lines: Target line cannot fit within max_lines 0"))
    }

    auto capture = capture_file_bounded(opts.file_path.as_str(), 10485760:usize)
    if capture.open_err || capture.read_err {
        auto err# = string::from("Error reading file '")
        err#.push_str(opts.file_path.as_str())
        err#.push_str("'")
        return Result<ViewResult, string>::Err(cede err)
    }

    if capture.size_exceeded {
        return Result<ViewResult, string>::Err(string::from("scan_incomplete: file too large, exceeds 10MiB input read limit"))
    }

    auto lines = cede capture.lines
    auto sha256_hex = cede capture.sha256_hex
    auto total_lines = lines.len()

    if total_lines == 0:usize {
        return Result<ViewResult, string>::Err(string::from("File is empty"))
    }
    if target_line > total_lines {
        auto err# = string::from("Line out of bounds: file has ")
        err#.push_str(u64_to_string(total_lines as u64).as_str())
        err#.push_str(" lines, requested line ")
        err#.push_str(u64_to_string(target_line as u64).as_str())
        return Result<ViewResult, string>::Err(cede err)
    }

    auto family = detect_syntax_family(opts.file_path.as_str())
    auto dialect = detect_lexical_dialect(opts.file_path.as_str())

    auto det = detect_block_range_for_lines(lines, target_line, family, dialect)

    auto range_status# = string::from("confirmed")
    auto block_start = det.block_start
    auto block_end# = det.block_end
    if !det.block_closed {
        range_status = string::from("unknown")
        block_end = block_start + 40:usize
        if block_end > total_lines {
            block_end = total_lines
        }
    }

    auto header# = string::new()
    if opts.continuation {
        header#.push_str("[file: ")
        header#.push_str(opts.file_path.as_str())
        if range_status == "confirmed" {
            header#.push_str(", lines: L")
            header#.push_str(u64_to_string(block_start as u64).as_str())
            header#.push_str("-L")
            header#.push_str(u64_to_string(block_end as u64).as_str())
            header#.push_str("]\n")
        } else {
            header#.push_str(", preview: L")
            header#.push_str(u64_to_string(block_start as u64).as_str())
            header#.push_str("-L")
            header#.push_str(u64_to_string(block_end as u64).as_str())
            header#.push_str(" (unclosed structure)]\n")
        }
    }

    auto cur_line# = block_start
    auto lines_emitted# = 0:usize
    auto bytes_emitted# = header.len()
    auto truncated# = false
    auto trunc_reason# = string::from("completed")
    auto records# = Vec<ViewLineRecord>::new()
    auto out# = string::new()
    out#.push_str(header.as_str())
    auto content_omitted# = false
    auto target_seen# = false

    loop cur_line <= block_end {
        if has_max_lines && lines_emitted >= max_lines_val {
            truncated = true
            trunc_reason = string::from("max_lines")
            break
        }

        auto raw = lines.borrow(cur_line - 1:usize).as_str()
        auto clean_l# = raw
        if raw.len > 0 && raw.byte_at(raw.len - 1) == ('\r' as char) {
            clean_l = raw.substr(0, raw.len - 1)
        }
        auto disp# = clean_l
        if has_max_cols && max_cols_val > 0 && clean_l.len > max_cols_val {
            disp = "[omitted]"
            content_omitted = true
        }

        auto is_target = (cur_line == target_line)
        if is_target {
            target_seen = true
        }

        auto line_entry# = string::new()
        line_entry#.push_str(u64_to_string(cur_line as u64).as_str())
        if is_target {
            line_entry#.push_str(":")
        } else {
            line_entry#.push_str("-")
        }
        line_entry#.push_str(disp)
        line_entry#.push_str("\n")

        if has_max_bytes && bytes_emitted + line_entry.len() > max_bytes_val {
            truncated = true
            trunc_reason = string::from("max_result_bytes")
            break
        }

        auto rec_kind# = string::from("context")
        if is_target {
            rec_kind = string::from("target")
        }

        bytes_emitted = bytes_emitted + line_entry.len()
        out#.push_str(line_entry.as_str())
        records#.push(ViewLineRecord(
            line_number = cur_line,
            kind = cede rec_kind,
            text = string::from(disp)
        ))
        lines_emitted = lines_emitted + 1:usize
        cur_line = cur_line + 1:usize
    }

    if lines_emitted == 0:usize {
        auto err# = string::from("target_exceeds_max_result_bytes: Target line formatted record exceeds max_result_bytes (")
        if has_max_bytes {
            err#.push_str(u64_to_string(max_bytes_val as u64).as_str())
        }
        err#.push_str(" bytes)")
        return Result<ViewResult, string>::Err(cede err)
    }

    auto continuation_tok# = Option<string>::None
    if truncated && cur_line <= block_end {
        auto ct = ContinuationToken(
            version = 1:usize,
            path = string::from(opts.file_path.as_str()),
            req_start = block_start,
            req_end = block_end,
            next_line = cur_line,
            end_line = block_end,
            sha256_hex = string::from(sha256_hex.as_str()),
            mode = string::from("block"),
            symbol = Option<string>::None,
            scope = Option<string>::None,
            range_status = string::from(range_status.as_str()),
            max_columns = opts.max_columns
        )
        continuation_tok = encode_continuation_token(ct)
        if continuation_tok.is_none() {
            return Result<ViewResult, string>::Err(string::from("continuation_token_overflow: Continuation token exceeds maximum length limit (4096 bytes)"))
        }
    }

    auto emitted_range# = Option<BlockRange>::None
    if lines_emitted > 0:usize {
        emitted_range = Option<BlockRange>::Some(BlockRange(
            start = block_start,
            end = cur_line - 1:usize
        ))
    }

    auto detected_block = BlockRange(start = block_start, end = block_end)
    auto requested_block# = Option<BlockRange>::None
    if range_status == "confirmed" {
        requested_block = Option<BlockRange>::Some(detected_block.clone())
    }

    auto term_reason# = string::from("completed")
    if truncated {
        term_reason = trunc_reason.clone()
    }
    auto out_stat# = string::from("complete")
    if truncated {
        out_stat = string::from("budget_truncated")
    }

    return Result<ViewResult, string>::Ok(ViewResult(
        text = cede out,
        truncated = truncated,
        reason = cede term_reason,
        lines_emitted = lines_emitted,
        bytes_emitted = bytes_emitted,
        mode = string::from("block"),
        path = string::from(opts.file_path.as_str()),
        requested_line = Option<usize>::Some(target_line),
        requested_range = requested_block,
        detected_block_range = Option<BlockRange>::Some(detected_block),
        emitted_range = emitted_range,
        target_included = Option<bool>::Some(target_seen),
        content_omitted = content_omitted,
        complete = !truncated && (cur_line > block_end),
        eof_reached = !truncated && (block_end == total_lines),
        records = cede records,
        selection_status = string::from("found"),
        range_status = Option<string>::Some(cede range_status),
        output_status = cede out_stat,
        target_symbol = Vec<SymbolTargetInfo>::new(),
        candidates = Vec<SymbolCandidateInfo>::new(),
        candidates_truncated = false,
        continuation_token = cede continuation_tok,
        continuation_active = true,
        sha256_hex = string::from(sha256_hex.as_str())
    ))
}

fn execute_view_stream_block(
    opts: ViewOptions,
    target_line: usize
) -> Result<ViewResult, string> {
    if opts.continuation {
        return execute_view_continuation_block(opts, target_line)
    }
    auto path_str = string::from(opts.file_path.as_str())
    auto mode_buf# = [0:char; 4]
    mode_buf[0] = 'r' as char
    mode_buf[1] = 'b' as char
    mode_buf[2] = 0 as char

    auto max_lines_val# = 0:usize
    auto has_max_lines# = false
    match opts.max_lines {
        auto Option<usize>::Some(v) => {
            max_lines_val = v
            has_max_lines = true
        }
        _ => {}
    }

    auto max_bytes_val# = 0:usize
    auto has_max_bytes# = false
    match opts.max_result_bytes {
        auto Option<usize>::Some(v) => {
            max_bytes_val = v
            has_max_bytes = true
        }
        _ => {}
    }

    auto max_cols_val# = 0:usize
    auto has_max_cols# = false
    match opts.max_columns {
        auto Option<usize>::Some(v) => {
            max_cols_val = v
            has_max_cols = true
        }
        _ => {}
    }

    if has_max_lines && max_lines_val < 1:usize {
        return Result<ViewResult, string>::Err(string::from("target_exceeds_max_lines: Target line cannot fit within max_lines 0"))
    }

    auto family = detect_syntax_family(opts.file_path.as_str())
    auto dialect = detect_lexical_dialect(opts.file_path.as_str())
    auto max_block_cap# = opts.max_block_lines
    if has_max_lines && max_lines_val < max_block_cap {
        max_block_cap = max_lines_val
    }

    auto before_ring# = Vec<string>::new()
    auto after_lines# = Vec<string>::new()
    auto target_text# = string::new()
    auto target_found# = false

    auto block_start# = target_line
    auto block_end# = target_line
    auto block_closed# = false
    auto read_err# = false
    auto early_stop# = false
    auto eof_reached# = false
    auto total_lines# = 0:usize

    // For Brace syntax
    auto d# = DelimiterDepths::new()
    auto block_stack# = Vec<BlockStackFrame>::new()
    auto delim# = BlockDelimiter::Brace
    auto target_depth# = 0:usize

    // For Indent syntax
    auto indent_stack# = Vec<IndentStackFrame>::new()
    auto target_indent# = 0:usize

    // First line stored in before_ring
    auto first_stored_line# = 1:usize
    if target_line > max_block_cap {
        first_stored_line = target_line - max_block_cap
    }

    unsafe {
        auto *mode_ptr = &mode_buf[0] as *char
        auto *path_c = path_str.c_str()
        auto nul *fp = libc_fopen(*path_c, *mode_ptr)
        if *fp == null {
            auto err# = string::from("Failed to open file '")
            err#.push_str(opts.file_path.as_str())
            err#.push_str("': No such file or directory or permission denied")
            return Result<ViewResult, string>::Err(cede err)
        }
        auto *file = fp.unwrap()
        auto nul *raw_buf = libc_malloc(65536:usize)
        if *raw_buf == null {
            libc_fclose(*file)
            return Result<ViewResult, string>::Err(string::from("Out of memory reading file"))
        }
        auto *buf = raw_buf.unwrap()
        auto line_buf# = string::new()
        auto cur_line# = 1:usize

        loop true {
            auto n = libc_fread(*buf, 1:usize, 65536:usize, *file)
            if n == 0 {
                if posix_ferror((*file) as Addr) {
                    read_err = true
                }
                eof_reached = true
                break
            }

            auto *c_ptr = ((*buf) as Addr) as *char
            auto chunk_str = string::from_with_len(*c_ptr, n)
            auto chunk_view = chunk_str.as_str()
            auto cursor# = 0:usize

            loop cursor < chunk_view.len {
                auto rem = chunk_view.substr(cursor, chunk_view.len - cursor)
                auto nl_opt = rem.index_of('\n' as char)
                if nl_opt.is_none() {
                    line_buf#.push_str(rem)
                    break
                }

                auto nl_pos = nl_opt.unwrap()
                auto chunk_slice = rem.substr(0, nl_pos)
                line_buf#.push_str(chunk_slice)

                auto line_str = line_buf.clone()
                line_buf#.clear()

                auto full_view = line_str.as_str()
                auto pat_text# = full_view
                if full_view.len > 0 && full_view.byte_at(full_view.len - 1) == ('\r' as char) {
                    pat_text = full_view.substr(0, full_view.len - 1)
                }

                auto lex = scan_line_lexical(pat_text, d#, dialect)

                if cur_line < target_line {
                    match family {
                        auto SyntaxFamily::Brace => {
                            if lex.starts_block || lex.depth_after_brace > lex.depth_before_brace || lex.depth_after_paren > lex.depth_before_paren {
                                auto d_type = lex.delimiter
                                auto depth_val# = lex.depth_before_paren
                                if d_type == BlockDelimiter::Brace {
                                    depth_val = lex.depth_before_brace
                                }
                                block_stack#.push(BlockStackFrame(
                                    line_number = cur_line,
                                    delimiter = d_type,
                                    depth = depth_val
                                ))
                            }

                            loop block_stack.len() > 0:usize {
                                auto top_idx = block_stack.len() - 1:usize
                                auto should_pop# = false
                                {
                                    auto &top_f = block_stack.borrow(top_idx)
                                    if top_f.delimiter == BlockDelimiter::Brace && lex.depth_after_brace <= top_f.depth {
                                        should_pop = true
                                    } else if top_f.delimiter == BlockDelimiter::Paren && lex.depth_after_paren <= top_f.depth {
                                        should_pop = true
                                    }
                                }
                                if should_pop {
                                    block_stack#.pop()
                                } else {
                                    break
                                }
                            }

                            if cur_line >= first_stored_line {
                                before_ring#.push(string::from(pat_text))
                            }
                        }
                        auto SyntaxFamily::Indent => {
                            if lex.participates_in_indent {
                                auto is_header = lex.code_text.as_str().trim().ends_with(":") || lex.starts_block
                                if is_header {
                                    auto indent = lex.statement_indent
                                    loop indent_stack.len() > 0:usize {
                                        auto top_idx = indent_stack.len() - 1:usize
                                        if indent_stack.borrow(top_idx).indent >= indent {
                                            indent_stack#.pop()
                                        } else {
                                            break
                                        }
                                    }
                                    indent_stack#.push(IndentStackFrame(line_number = cur_line, indent = indent))
                                } else {
                                    loop indent_stack.len() > 0:usize {
                                        auto top_idx = indent_stack.len() - 1:usize
                                        if indent_stack.borrow(top_idx).indent >= lex.statement_indent {
                                            indent_stack#.pop()
                                        } else {
                                            break
                                        }
                                    }
                                }
                            }

                            if cur_line >= first_stored_line {
                                before_ring#.push(string::from(pat_text))
                            }
                        }
                    }
                } else if cur_line == target_line {
                    target_text = string::from(pat_text)
                    target_found = true
                    match family {
                        auto SyntaxFamily::Brace => {
                            if lex.starts_block {
                                block_start = target_line
                                delim = lex.delimiter
                                if delim == BlockDelimiter::Brace {
                                    target_depth = lex.depth_before_brace
                                } else {
                                    target_depth = lex.depth_before_paren
                                }
                            } else if block_stack.len() > 0:usize {
                                // Target line is inside or at the end of an existing block: preserve opener!
                                auto top_idx = block_stack.len() - 1:usize
                                auto &top_f = block_stack.borrow(top_idx)
                                block_start = top_f.line_number
                                delim = top_f.delimiter
                                target_depth = top_f.depth
                            } else {
                                block_start = target_line
                                delim = BlockDelimiter::Brace
                                target_depth = 0:usize
                            }

                            if block_start == target_line && check_is_self_closed_structured(delim, lex.depth_after_brace, lex.depth_after_paren, target_depth, lex.has_code_brace_closer, lex.has_code_paren_closer) {
                                block_end = target_line
                                block_closed = true
                            } else if block_start < target_line {
                                // Target line is the closer for this enclosing block!
                                if delim == BlockDelimiter::Brace && lex.depth_before_brace > target_depth && lex.depth_after_brace <= target_depth && lex.has_code_brace_closer {
                                    block_end = target_line
                                    block_closed = true
                                } else if delim == BlockDelimiter::Paren && lex.depth_before_paren > target_depth && lex.depth_after_paren <= target_depth && lex.has_code_paren_closer {
                                    block_end = target_line
                                    block_closed = true
                                }
                            }
                        }
                        auto SyntaxFamily::Indent => {
                            auto is_header = lex.participates_in_indent && (lex.code_text.as_str().trim().ends_with(":") || lex.starts_block)
                            if is_header {
                                target_indent = lex.statement_indent
                                block_start = target_line
                            } else if lex.participates_in_indent {
                                loop indent_stack.len() > 0:usize {
                                    auto top_idx = indent_stack.len() - 1:usize
                                    if indent_stack.borrow(top_idx).indent >= lex.statement_indent {
                                        indent_stack#.pop()
                                    } else {
                                        break
                                    }
                                }
                                if indent_stack.len() > 0:usize {
                                    auto top_idx = indent_stack.len() - 1:usize
                                    auto &top_f = indent_stack.borrow(top_idx)
                                    block_start = top_f.line_number
                                    target_indent = top_f.indent
                                } else {
                                    target_indent = lex.statement_indent
                                    block_start = target_line
                                }
                            } else {
                                // Target line does NOT participate in indent (inside multiline string / comment):
                                // Do NOT pop indent stack! Inherit enclosing block from top of stack.
                                if indent_stack.len() > 0:usize {
                                    auto top_idx = indent_stack.len() - 1:usize
                                    auto &top_f = indent_stack.borrow(top_idx)
                                    block_start = top_f.line_number
                                    target_indent = top_f.indent
                                } else {
                                    target_indent = 0:usize
                                    block_start = target_line
                                }
                            }
                        }
                    }
                    block_start = snap_block_start_decorators(block_start, first_stored_line, before_ring)
                } else {
                    // cur_line > target_line: scan forward to find block_end
                    if cur_line <= target_line + max_block_cap {
                        after_lines#.push(string::from(pat_text))
                    }

                    match family {
                        auto SyntaxFamily::Brace => {
                            if check_is_runaway_definition_structured(lex.is_scope_decl, lex.depth_before_brace, delim, target_depth) {
                                early_stop = true
                                cursor = cursor + nl_pos + 1
                                cur_line = cur_line + 1
                                break
                            }

                            match delim {
                                auto BlockDelimiter::Paren => {
                                    if lex.depth_before_paren > target_depth && lex.depth_after_paren <= target_depth && lex.has_code_paren_closer {
                                        block_end = cur_line
                                        block_closed = true
                                        early_stop = true
                                        cursor = cursor + nl_pos + 1
                                        cur_line = cur_line + 1
                                        break
                                    }
                                }
                                auto BlockDelimiter::Brace => {
                                    if lex.depth_before_brace > target_depth && lex.depth_after_brace <= target_depth && lex.has_code_brace_closer {
                                        block_end = cur_line
                                        block_closed = true
                                        early_stop = true
                                        cursor = cursor + nl_pos + 1
                                        cur_line = cur_line + 1
                                        break
                                    }
                                }
                            }
                        }
                        auto SyntaxFamily::Indent => {
                            if lex.participates_in_indent && lex.statement_indent <= target_indent {
                                block_end = cur_line - 1:usize
                                block_closed = true
                                early_stop = true
                                cursor = cursor + nl_pos + 1
                                cur_line = cur_line + 1
                                break
                            }
                        }
                    }
                }

                cur_line = cur_line + 1
                cursor = cursor + nl_pos + 1
            }

            if early_stop {
                break
            }
        }

        if !read_err && !early_stop && line_buf.len() > 0 {
            auto line_str = line_buf.clone()
            auto full_view = line_str.as_str()
            auto pat_text# = full_view
            if full_view.len > 0 && full_view.byte_at(full_view.len - 1) == ('\r' as char) {
                pat_text = full_view.substr(0, full_view.len - 1)
            }

            auto lex = scan_line_lexical(pat_text, d#, dialect)

            if cur_line < target_line {
                match family {
                    auto SyntaxFamily::Brace => {
                        if lex.starts_block || lex.depth_after_brace > lex.depth_before_brace || lex.depth_after_paren > lex.depth_before_paren {
                            auto d_type = lex.delimiter
                            auto depth_val# = lex.depth_before_paren
                            if d_type == BlockDelimiter::Brace { depth_val = lex.depth_before_brace }
                            block_stack#.push(BlockStackFrame(line_number = cur_line, delimiter = d_type, depth = depth_val))
                        }
                        loop block_stack.len() > 0:usize {
                            auto top_idx = block_stack.len() - 1:usize
                            auto should_pop# = false
                            {
                                auto &top_f = block_stack.borrow(top_idx)
                                if top_f.delimiter == BlockDelimiter::Brace && lex.depth_after_brace <= top_f.depth { should_pop = true }
                                else if top_f.delimiter == BlockDelimiter::Paren && lex.depth_after_paren <= top_f.depth { should_pop = true }
                            }
                            if should_pop { block_stack#.pop() } else { break }
                        }
                        if cur_line >= first_stored_line {
                            before_ring#.push(string::from(pat_text))
                        }
                    }
                    auto SyntaxFamily::Indent => {
                        if lex.participates_in_indent {
                            auto is_header = lex.code_text.as_str().trim().ends_with(":") || lex.starts_block
                            if is_header {
                                auto indent = lex.statement_indent
                                loop indent_stack.len() > 0:usize {
                                    auto top_idx = indent_stack.len() - 1:usize
                                    if indent_stack.borrow(top_idx).indent >= indent {
                                        indent_stack#.pop()
                                    } else {
                                        break
                                    }
                                }
                                indent_stack#.push(IndentStackFrame(line_number = cur_line, indent = indent))
                            }
                        }
                        if cur_line >= first_stored_line {
                            before_ring#.push(string::from(pat_text))
                        }
                    }
                }
            } else if cur_line == target_line {
                target_text = string::from(pat_text)
                target_found = true
                match family {
                    auto SyntaxFamily::Brace => {
                        if lex.starts_block {
                            block_start = target_line
                            delim = lex.delimiter
                            if delim == BlockDelimiter::Brace {
                                target_depth = lex.depth_before_brace
                            } else {
                                target_depth = lex.depth_before_paren
                            }
                        } else if block_stack.len() > 0:usize {
                            // Target line is inside or at the end of an existing block: preserve opener!
                            auto top_idx = block_stack.len() - 1:usize
                            auto &top_f = block_stack.borrow(top_idx)
                            block_start = top_f.line_number
                            delim = top_f.delimiter
                            target_depth = top_f.depth
                        } else {
                            block_start = target_line
                            delim = BlockDelimiter::Brace
                            target_depth = 0:usize
                        }

                        if block_start == target_line && check_is_self_closed_structured(delim, lex.depth_after_brace, lex.depth_after_paren, target_depth, lex.has_code_brace_closer, lex.has_code_paren_closer) {
                            block_end = target_line
                            block_closed = true
                        } else if block_start < target_line {
                            // Target line is the closer for this enclosing block!
                            if delim == BlockDelimiter::Brace && lex.depth_before_brace > target_depth && lex.depth_after_brace <= target_depth && lex.has_code_brace_closer {
                                block_end = target_line
                                block_closed = true
                            } else if delim == BlockDelimiter::Paren && lex.depth_before_paren > target_depth && lex.depth_after_paren <= target_depth && lex.has_code_paren_closer {
                                block_end = target_line
                                block_closed = true
                            }
                        }
                    }
                    auto SyntaxFamily::Indent => {
                        auto is_header = lex.participates_in_indent && (lex.code_text.as_str().trim().ends_with(":") || lex.starts_block)
                        if is_header {
                            target_indent = lex.statement_indent
                            block_start = target_line
                        } else if lex.participates_in_indent {
                            loop indent_stack.len() > 0:usize {
                                auto top_idx = indent_stack.len() - 1:usize
                                if indent_stack.borrow(top_idx).indent >= lex.statement_indent {
                                    indent_stack#.pop()
                                } else {
                                    break
                                }
                            }
                            if indent_stack.len() > 0:usize {
                                auto top_idx = indent_stack.len() - 1:usize
                                auto &top_f = indent_stack.borrow(top_idx)
                                block_start = top_f.line_number
                                target_indent = top_f.indent
                            } else {
                                target_indent = lex.statement_indent
                                block_start = target_line
                            }
                        } else {
                            // Target line does NOT participate in indent (inside multiline string / comment):
                            // Do NOT pop indent stack! Inherit enclosing block from top of stack.
                            if indent_stack.len() > 0:usize {
                                auto top_idx = indent_stack.len() - 1:usize
                                auto &top_f = indent_stack.borrow(top_idx)
                                block_start = top_f.line_number
                                target_indent = top_f.indent
                            } else {
                                target_indent = 0:usize
                                block_start = target_line
                            }
                        }
                    }
                }
                block_start = snap_block_start_decorators(block_start, first_stored_line, before_ring)
            } else if cur_line > target_line {
                if cur_line <= target_line + max_block_cap {
                    after_lines#.push(string::from(pat_text))
                }
                match family {
                    auto SyntaxFamily::Brace => {
                        if check_is_runaway_definition_structured(lex.is_scope_decl, lex.depth_before_brace, delim, target_depth) {
                            early_stop = true
                        } else {
                            match delim {
                                auto BlockDelimiter::Paren => {
                                    if lex.depth_before_paren > target_depth && lex.depth_after_paren <= target_depth && lex.has_code_paren_closer {
                                        block_end = cur_line
                                        block_closed = true
                                    }
                                }
                                auto BlockDelimiter::Brace => {
                                    if lex.depth_before_brace > target_depth && lex.depth_after_brace <= target_depth && lex.has_code_brace_closer {
                                        block_end = cur_line
                                        block_closed = true
                                    }
                                }
                            }
                        }
                    }
                    auto SyntaxFamily::Indent => {
                        if lex.participates_in_indent && lex.statement_indent <= target_indent {
                            block_end = cur_line - 1:usize
                            block_closed = true
                        }
                    }
                }
            }
            total_lines = cur_line
            line_buf#.clear()
        } else if !early_stop {
            total_lines = cur_line - 1:usize
        }

        libc_free(*buf)
        libc_fclose(*file)

        if read_err {
            auto err# = string::from("Error reading file '")
            err#.push_str(opts.file_path.as_str())
            err#.push_str("'")
            return Result<ViewResult, string>::Err(cede err)
        }
    }

    if !target_found {
        if total_lines == 0:usize {
            return Result<ViewResult, string>::Err(string::from("File is empty"))
        }
        auto err# = string::from("Line number out of bounds: file has ")
        err#.push_str(u64_to_string(total_lines as u64).as_str())
        err#.push_str(" lines, requested line ")
        err#.push_str(u64_to_string(target_line as u64).as_str())
        return Result<ViewResult, string>::Err(cede err)
    }

    // Indent blocks close at EOF gracefully
    if !block_closed && family == SyntaxFamily::Indent {
        block_end = total_lines
        block_closed = true
    }

    if !block_closed {
        return Result<ViewResult, string>::Err(string::from("Unclosed code block: block could not be deterministically closed (fail-closed)"))
    }

    if block_end < target_line {
        block_end = target_line
    }

    auto block_len = block_end - block_start + 1:usize
    auto is_block_truncated = block_len > max_block_cap

    auto avail_before = target_line - block_start
    auto avail_after = block_end - target_line
    auto win_lines# = block_len
    if is_block_truncated {
        win_lines = max_block_cap
    }

    auto take_before# = 0:usize
    auto take_after# = 0:usize
    if win_lines > 1:usize {
        auto half_before = (win_lines - 1:usize) / 2:usize
        auto half_after = (win_lines - 1:usize) - half_before
        if avail_before < half_before {
            take_before = avail_before
            take_after = win_lines - 1:usize - take_before
            if take_after > avail_after {
                take_after = avail_after
            }
        } else if avail_after < half_after {
            take_after = avail_after
            take_before = win_lines - 1:usize - take_after
            if take_before > avail_before {
                take_before = avail_before
            }
        } else {
            take_before = half_before
            take_after = half_after
        }
    }

    auto win_start = target_line - take_before
    auto win_end = target_line + take_after

    auto content_omitted# = false
    auto target_display# = target_text.as_str()
    if has_max_cols && max_cols_val > 0 && target_text.len() > max_cols_val {
        target_display = "[omitted]"
        content_omitted = true
    }

    auto target_entry# = string::new()
    target_entry#.push_str(u64_to_string(target_line as u64).as_str())
    target_entry#.push_str(":")
    target_entry#.push_str(target_display)
    target_entry#.push_str("\n")

    auto header# = string::new()
    header#.push_str("[block: L")
    header#.push_str(u64_to_string(block_start as u64).as_str())
    header#.push_str("-L")
    header#.push_str(u64_to_string(block_end as u64).as_str())
    header#.push_str("]\n")

    auto base_bytes = header.len() + target_entry.len()
    if has_max_bytes && base_bytes > max_bytes_val {
        auto err# = string::from("target_exceeds_max_result_bytes: Target line formatted record (")
        err#.push_str(u64_to_string(base_bytes as u64).as_str())
        err#.push_str(" bytes) exceeds max_result_bytes (")
        err#.push_str(u64_to_string(max_bytes_val as u64).as_str())
        err#.push_str(" bytes)")
        return Result<ViewResult, string>::Err(cede err)
    }

    auto rem_bytes# = 18446744073709551615:usize
    if has_max_bytes {
        rem_bytes = max_bytes_val - base_bytes
    }

    auto b_take_actual# = 0:usize
    auto a_take_actual# = 0:usize
    auto byte_truncated# = false

    loop b_take_actual < take_before || a_take_actual < take_after {
        auto can_b = b_take_actual < take_before
        auto can_a = a_take_actual < take_after
        if !can_b && !can_a {
            break
        }

        if can_b && (b_take_actual <= a_take_actual || !can_a) {
            auto b_line_num = target_line - 1:usize - b_take_actual
            auto ring_idx = b_line_num - first_stored_line
            auto b_raw = before_ring.borrow(ring_idx).as_str()
            auto b_disp# = b_raw
            if has_max_cols && max_cols_val > 0 && b_raw.len > max_cols_val {
                b_disp = "[omitted]"
                content_omitted = true
            }
            auto b_len = u64_to_string(b_line_num as u64).len() + 1:usize + b_disp.len + 1:usize
            if has_max_bytes && b_len > rem_bytes {
                byte_truncated = true
                break
            }
            if has_max_bytes {
                rem_bytes = rem_bytes - b_len
            }
            b_take_actual = b_take_actual + 1:usize
        }

        if can_a && (a_take_actual < b_take_actual || !can_b) {
            auto a_line_num = target_line + 1:usize + a_take_actual
            auto after_idx = a_take_actual
            auto a_raw = after_lines.borrow(after_idx).as_str()
            auto a_disp# = a_raw
            if has_max_cols && max_cols_val > 0 && a_raw.len > max_cols_val {
                a_disp = "[omitted]"
                content_omitted = true
            }
            auto a_len = u64_to_string(a_line_num as u64).len() + 1:usize + a_disp.len + 1:usize
            if has_max_bytes && a_len > rem_bytes {
                byte_truncated = true
                break
            }
            if has_max_bytes {
                rem_bytes = rem_bytes - a_len
            }
            a_take_actual = a_take_actual + 1:usize
        }
    }

    auto truncated# = false
    auto trunc_reason# = string::from("completed")
    if byte_truncated {
        truncated = true
        trunc_reason = string::from("max_result_bytes")
    } else if is_block_truncated {
        truncated = true
        if has_max_lines && max_lines_val <= opts.max_block_lines {
            trunc_reason = string::from("max_lines")
        } else {
            trunc_reason = string::from("max_block_lines")
        }
    }

    auto out# = string::new()
    out#.push_str(header.as_str())

    auto records# = Vec<ViewLineRecord>::new()

    // 1. Before lines
    if b_take_actual > 0:usize {
        auto idx# = b_take_actual
        loop idx > 0:usize {
            auto b_line_num = target_line - idx
            auto ring_idx = b_line_num - first_stored_line
            auto b_raw = before_ring.borrow(ring_idx).as_str()
            auto b_disp# = b_raw
            if has_max_cols && max_cols_val > 0 && b_raw.len > max_cols_val {
                b_disp = "[omitted]"
            }
            out#.push_str(u64_to_string(b_line_num as u64).as_str())
            out#.push_str("-")
            out#.push_str(b_disp)
            out#.push_str("\n")
            records#.push(ViewLineRecord(
                line_number = b_line_num,
                kind = string::from("context"),
                text = string::from(b_disp)
            ))
            idx = idx - 1:usize
        }
    }

    // 2. Target line
    out#.push_str(target_entry.as_str())
    records#.push(ViewLineRecord(
        line_number = target_line,
        kind = string::from("target"),
        text = string::from(target_display)
    ))

    // 3. After lines
    auto a_idx# = 0:usize
    loop a_idx < a_take_actual {
        auto a_line_num = target_line + 1:usize + a_idx
        auto a_raw = after_lines.borrow(a_idx).as_str()
        auto a_disp# = a_raw
        if has_max_cols && max_cols_val > 0 && a_raw.len > max_cols_val {
            a_disp = "[omitted]"
        }
        out#.push_str(u64_to_string(a_line_num as u64).as_str())
        out#.push_str("-")
        out#.push_str(a_disp)
        out#.push_str("\n")
        records#.push(ViewLineRecord(
            line_number = a_line_num,
            kind = string::from("context"),
            text = string::from(a_disp)
        ))
        a_idx = a_idx + 1:usize
    }

    auto first_line = target_line - b_take_actual
    auto last_line = target_line + a_take_actual
    auto lines_emitted = 1:usize + b_take_actual + a_take_actual
    auto bytes_emitted = out.len()
    auto out_stat# = string::from("complete")
    if truncated {
        out_stat = string::from("budget_truncated")
    }

    return Result<ViewResult, string>::Ok(ViewResult(
        text = cede out,
        truncated = truncated,
        reason = cede trunc_reason,
        lines_emitted = lines_emitted,
        bytes_emitted = bytes_emitted,
        mode = string::from("block"),
        path = opts.file_path.clone(),
        requested_line = Option<usize>::Some(target_line),
        requested_range = Option<BlockRange>::None,
        detected_block_range = Option<BlockRange>::Some(BlockRange(start = block_start, end = block_end)),
        emitted_range = Option<BlockRange>::Some(BlockRange(start = first_line, end = last_line)),
        target_included = Option<bool>::Some(true),
        content_omitted = content_omitted,
        complete = !truncated,
        eof_reached = eof_reached,
        records = cede records,
        selection_status = string::from("found"),
        range_status = Option<string>::None,
        output_status = cede out_stat,
        target_symbol = Vec<SymbolTargetInfo>::new(),
        candidates = Vec<SymbolCandidateInfo>::new(),
        candidates_truncated = false,
        continuation_token = Option<string>::None,
        continuation_active = false,
        sha256_hex = string::new()
    ))
}

fn execute_view_stream_symbol(opts: ViewOptions) -> Result<ViewResult, string> {
    auto target_name# = string::new()
    match opts.symbol {
        auto Option<string>::Some(&s) => {
            target_name = string::from(s.as_str())
        }
        auto Option<string>::None => {}
    }
    auto target_has_scope# = false
    auto target_scope# = string::new()
    match opts.symbol_scope {
        auto Option<string>::Some(&sc) => {
            target_has_scope = true
            target_scope = string::from(sc.as_str())
        }
        auto Option<string>::None => {}
    }

    // 1. Syntax check
    if !is_symbol_view_supported(opts.file_path.as_str()) {
        auto msg# = string::from("trg view: file '")
        msg#.push_str(opts.file_path.as_str())
        msg#.push_str("' has unsupported syntax for symbol view")
        return Result<ViewResult, string>::Ok(ViewResult(
            text = cede msg,
            truncated = false,
            reason = string::from("unsupported_syntax"),
            lines_emitted = 0:usize,
            bytes_emitted = 0:usize,
            mode = string::from("symbol"),
            path = string::from(opts.file_path.as_str()),
            requested_line = Option<usize>::None,
            requested_range = Option<BlockRange>::None,
            detected_block_range = Option<BlockRange>::None,
            emitted_range = Option<BlockRange>::None,
            target_included = Option<bool>::None,
            content_omitted = false,
            complete = false,
            eof_reached = false,
            records = Vec<ViewLineRecord>::new(),
            selection_status = string::from("unsupported_syntax"),
            range_status = Option<string>::None,
            output_status = string::from("complete"),
            target_symbol = Vec<SymbolTargetInfo>::new(),
            candidates = Vec<SymbolCandidateInfo>::new(),
            candidates_truncated = false,
            continuation_token = Option<string>::None,
            continuation_active = false,
            sha256_hex = string::new()
        ))
    }

    // 2. Single bounded capture into memory (10MB ceiling)
    auto capture = capture_file_bounded(opts.file_path.as_str(), 10485760:usize)
    if capture.open_err || capture.read_err {
        auto msg# = string::from("trg view: error reading '")
        msg#.push_str(opts.file_path.as_str())
        msg#.push_str("'")
        return Result<ViewResult, string>::Ok(ViewResult(
            text = cede msg,
            truncated = false,
            reason = string::from("io_error"),
            lines_emitted = 0:usize,
            bytes_emitted = 0:usize,
            mode = string::from("symbol"),
            path = string::from(opts.file_path.as_str()),
            requested_line = Option<usize>::None,
            requested_range = Option<BlockRange>::None,
            detected_block_range = Option<BlockRange>::None,
            emitted_range = Option<BlockRange>::None,
            target_included = Option<bool>::None,
            content_omitted = false,
            complete = false,
            eof_reached = false,
            records = Vec<ViewLineRecord>::new(),
            selection_status = string::from("io_error"),
            range_status = Option<string>::None,
            output_status = string::from("complete"),
            target_symbol = Vec<SymbolTargetInfo>::new(),
            candidates = Vec<SymbolCandidateInfo>::new(),
            candidates_truncated = false,
            continuation_token = Option<string>::None,
            continuation_active = false,
            sha256_hex = string::new()
        ))
    }

    if capture.size_exceeded {
        auto msg# = string::from("trg view: symbol scan incomplete for '")
        msg#.push_str(opts.file_path.as_str())
        msg#.push_str("' (file too large, exceeds 10MiB input read limit)")
        return Result<ViewResult, string>::Ok(ViewResult(
            text = cede msg,
            truncated = true,
            reason = string::from("scan_incomplete"),
            lines_emitted = 0:usize,
            bytes_emitted = 0:usize,
            mode = string::from("symbol"),
            path = string::from(opts.file_path.as_str()),
            requested_line = Option<usize>::None,
            requested_range = Option<BlockRange>::None,
            detected_block_range = Option<BlockRange>::None,
            emitted_range = Option<BlockRange>::None,
            target_included = Option<bool>::None,
            content_omitted = false,
            complete = false,
            eof_reached = false,
            records = Vec<ViewLineRecord>::new(),
            selection_status = string::from("scan_incomplete"),
            range_status = Option<string>::None,
            output_status = string::from("complete"),
            target_symbol = Vec<SymbolTargetInfo>::new(),
            candidates = Vec<SymbolCandidateInfo>::new(),
            candidates_truncated = false,
            continuation_token = Option<string>::None,
            continuation_active = false,
            sha256_hex = string::new()
        ))
    }

    auto lines = cede capture.lines
    auto sha256_hex = cede capture.sha256_hex

    // 3. Scan symbols from in-memory lines
    auto sym_res = outline_symbols_lines(lines, opts.file_path.as_str(), Option<Vec<string>>::None, Option<usize>::Some(5000:usize), Option<usize>::None)
    if sym_res.is_err() {
        auto msg# = string::from("trg view: error scanning symbols for '")
        msg#.push_str(opts.file_path.as_str())
        msg#.push_str("'")
        return Result<ViewResult, string>::Ok(ViewResult(
            text = cede msg,
            truncated = false,
            reason = string::from("io_error"),
            lines_emitted = 0:usize,
            bytes_emitted = 0:usize,
            mode = string::from("symbol"),
            path = string::from(opts.file_path.as_str()),
            requested_line = Option<usize>::None,
            requested_range = Option<BlockRange>::None,
            detected_block_range = Option<BlockRange>::None,
            emitted_range = Option<BlockRange>::None,
            target_included = Option<bool>::None,
            content_omitted = false,
            complete = false,
            eof_reached = false,
            records = Vec<ViewLineRecord>::new(),
            selection_status = string::from("io_error"),
            range_status = Option<string>::None,
            output_status = string::from("complete"),
            target_symbol = Vec<SymbolTargetInfo>::new(),
            candidates = Vec<SymbolCandidateInfo>::new(),
            candidates_truncated = false,
            continuation_token = Option<string>::None,
            continuation_active = false,
            sha256_hex = string::new()
        ))
    }

    auto sym_data = sym_res.unwrap()
    if sym_data.truncated {
        auto msg# = string::from("trg view: symbol scan incomplete for '")
        msg#.push_str(opts.file_path.as_str())
        msg#.push_str("' (internal symbol limit 5000 exceeded)")
        return Result<ViewResult, string>::Ok(ViewResult(
            text = cede msg,
            truncated = true,
            reason = string::from("scan_incomplete"),
            lines_emitted = 0:usize,
            bytes_emitted = 0:usize,
            mode = string::from("symbol"),
            path = string::from(opts.file_path.as_str()),
            requested_line = Option<usize>::None,
            requested_range = Option<BlockRange>::None,
            detected_block_range = Option<BlockRange>::None,
            emitted_range = Option<BlockRange>::None,
            target_included = Option<bool>::None,
            content_omitted = false,
            complete = false,
            eof_reached = false,
            records = Vec<ViewLineRecord>::new(),
            selection_status = string::from("scan_incomplete"),
            range_status = Option<string>::None,
            output_status = string::from("complete"),
            target_symbol = Vec<SymbolTargetInfo>::new(),
            candidates = Vec<SymbolCandidateInfo>::new(),
            candidates_truncated = false,
            continuation_token = Option<string>::None,
            continuation_active = false,
            sha256_hex = string::new()
        ))
    }

    // 4. Candidate matching
    auto matched_indices# = Vec<usize>::new()
    auto si# = 0:usize
    loop si < sym_data.symbols.len() {
        auto &s = sym_data.symbols.borrow(si)
        if s.name.as_str() == target_name.as_str() {
            auto scope_matches# = true
            if target_has_scope {
                if s.scope.as_str() != target_scope.as_str() {
                    scope_matches = false
                }
            }
            if scope_matches {
                matched_indices#.push(si)
            }
        }
        si = si + 1:usize
    }

    if matched_indices.len() == 0:usize {
        auto msg# = string::from("trg view: symbol '")
        msg#.push_str(target_name.as_str())
        if target_has_scope {
            msg#.push_str("' in scope '")
            msg#.push_str(target_scope.as_str())
        }
        msg#.push_str("' not found in ")
        msg#.push_str(opts.file_path.as_str())

        return Result<ViewResult, string>::Ok(ViewResult(
            text = cede msg,
            truncated = false,
            reason = string::from("completed"),
            lines_emitted = 0:usize,
            bytes_emitted = 0:usize,
            mode = string::from("symbol"),
            path = string::from(opts.file_path.as_str()),
            requested_line = Option<usize>::None,
            requested_range = Option<BlockRange>::None,
            detected_block_range = Option<BlockRange>::None,
            emitted_range = Option<BlockRange>::None,
            target_included = Option<bool>::None,
            content_omitted = false,
            complete = true,
            eof_reached = true,
            records = Vec<ViewLineRecord>::new(),
            selection_status = string::from("not_found"),
            range_status = Option<string>::None,
            output_status = string::from("complete"),
            target_symbol = Vec<SymbolTargetInfo>::new(),
            candidates = Vec<SymbolCandidateInfo>::new(),
            candidates_truncated = false,
            continuation_token = Option<string>::None,
            continuation_active = false,
            sha256_hex = string::new()
        ))
    }

    auto max_lines_val# = 0:usize
    auto has_max_lines# = false
    match opts.max_lines {
        auto Option<usize>::Some(ml) => {
            max_lines_val = ml
            has_max_lines = true
        }
        auto Option<usize>::None => {}
    }

    auto max_bytes_val# = 0:usize
    auto has_max_bytes# = false
    match opts.max_result_bytes {
        auto Option<usize>::Some(mb) => {
            max_bytes_val = mb
            has_max_bytes = true
        }
        auto Option<usize>::None => {}
    }

    auto max_cols_val# = 0:usize
    auto has_max_cols# = false
    match opts.max_columns {
        auto Option<usize>::Some(mc) => {
            max_cols_val = mc
            has_max_cols = true
        }
        auto Option<usize>::None => {}
    }

    if matched_indices.len() > 1:usize {
        auto total_matched = matched_indices.len()
        auto same_scope# = true
        auto first_idx = matched_indices.get(0)
        auto first_scope = string::from(sym_data.symbols.borrow(first_idx).scope.as_str())

        auto all_cands# = Vec<SymbolCandidateInfo>::new()
        auto cand_lines# = Vec<string>::new()

        auto mi# = 0:usize
        loop mi < total_matched {
            auto cand_idx = matched_indices.get(mi)
            auto &cand_sym = sym_data.symbols.borrow(cand_idx)
            if cand_sym.scope.as_str() != first_scope.as_str() {
                same_scope = false
            }
            auto cand_r_status# = string::from("confirmed")
            if cand_sym.range_reliability == "eof_fallback" || cand_sym.range_end.is_none() {
                cand_r_status = string::from("unknown")
            }

            auto cline# = string::new()
            cline#.push_str("  line ")
            cline#.push_str(u64_to_string(cand_sym.line as u64).as_str())
            cline#.push_str(": ")
            cline#.push_str(cand_sym.kind.as_str())
            cline#.push_str(" ")
            cline#.push_str(cand_sym.name.as_str())
            if cand_sym.scope.len() > 0:usize {
                cline#.push_str(" (scope: ")
                cline#.push_str(cand_sym.scope.as_str())
                cline#.push_str(")")
            }
            cline#.push_str(" - ")
            cline#.push_str(cand_sym.detail.as_str())
            cline#.push_str("\n")
            cand_lines#.push(cede cline)

            all_cands#.push(SymbolCandidateInfo(
                name = string::from(cand_sym.name.as_str()),
                kind = string::from(cand_sym.kind.as_str()),
                line = cand_sym.line,
                range_start = cand_sym.range_start,
                range_end = cand_sym.range_end,
                range_status = cede cand_r_status,
                scope = string::from(cand_sym.scope.as_str()),
                detail = string::from(cand_sym.detail.as_str())
            ))
            mi = mi + 1:usize
        }

        auto diag_head# = string::new()
        diag_head#.push_str("Multiple candidates found for symbol '")
        diag_head#.push_str(target_name.as_str())
        diag_head#.push_str("':\n")

        auto hint# = string::new()
        if !opts.no_hints {
            if same_scope {
                hint#.push_str("Hint: use 'trg view <path>:<line>' to select by line number\n")
            } else {
                hint#.push_str("Hint: specify enclosing scope with --scope <SCOPE> or --symbol '<SCOPE>::<NAME>'\n")
            }
        }

        // Check minimum diagnostic byte budget (header + candidate 0 + omission + hint)
        auto min_bytes# = diag_head.len() + cand_lines.borrow(0).len() + hint.len()
        if total_matched > 1:usize {
            auto min_om# = string::from("  [and ")
            min_om#.push_str(u64_to_string((total_matched - 1:usize) as u64).as_str())
            min_om#.push_str(" more candidates omitted]\n")
            min_bytes = min_bytes + min_om.len()
        }
        if has_max_bytes && min_bytes > max_bytes_val {
            auto err# = string::from("target_exceeds_max_result_bytes: Multiple candidates diagnostic (")
            err#.push_str(u64_to_string(min_bytes as u64).as_str())
            err#.push_str(" bytes) exceeds max_result_bytes (")
            err#.push_str(u64_to_string(max_bytes_val as u64).as_str())
            err#.push_str(" bytes)")
            return Result<ViewResult, string>::Err(cede err)
        }

        auto max_k# = total_matched
        if max_k > 20:usize {
            max_k = 20:usize
        }

        auto chosen_k# = 1:usize
        auto k# = max_k
        loop k >= 1:usize {
            auto cand_bytes# = 0:usize
            auto ci# = 0:usize
            loop ci < k {
                cand_bytes = cand_bytes + cand_lines.borrow(ci).len()
                ci = ci + 1:usize
            }
            auto om_bytes# = 0:usize
            if k < total_matched {
                auto om# = string::from("  [and ")
                om#.push_str(u64_to_string((total_matched - k) as u64).as_str())
                om#.push_str(" more candidates omitted]\n")
                om_bytes = om.len()
            }
            auto total_d_bytes = diag_head.len() + cand_bytes + om_bytes + hint.len()
            if !has_max_bytes || total_d_bytes <= max_bytes_val {
                chosen_k = k
                break
            }
            k = k - 1:usize
        }

        auto diag# = string::new()
        diag#.push_str(diag_head.as_str())
        auto ci# = 0:usize
        loop ci < chosen_k {
            diag#.push_str(cand_lines.borrow(ci).as_str())
            ci = ci + 1:usize
        }
        auto is_cands_truncated = chosen_k < total_matched
        if is_cands_truncated {
            diag#.push_str("  [and ")
            diag#.push_str(u64_to_string((total_matched - chosen_k) as u64).as_str())
            diag#.push_str(" more candidates omitted]\n")
        }
        diag#.push_str(hint.as_str())

        auto final_cands# = Vec<SymbolCandidateInfo>::new()
        auto fci# = 0:usize
        loop fci < chosen_k {
            auto &c = all_cands.borrow(fci)
            final_cands#.push(SymbolCandidateInfo(
                name = string::from(c.name.as_str()),
                kind = string::from(c.kind.as_str()),
                line = c.line,
                range_start = c.range_start,
                range_end = c.range_end,
                range_status = string::from(c.range_status.as_str()),
                scope = string::from(c.scope.as_str()),
                detail = string::from(c.detail.as_str())
            ))
            fci = fci + 1:usize
        }

        auto diag_len = diag.len()
        auto is_budget_truncated = has_max_bytes && is_cands_truncated
        auto reason_str# = string::from("completed")
        auto output_status_str# = string::from("complete")
        if is_budget_truncated {
            reason_str = string::from("max_result_bytes")
            output_status_str = string::from("budget_truncated")
        }

        return Result<ViewResult, string>::Ok(ViewResult(
            text = cede diag,
            truncated = is_budget_truncated,
            reason = cede reason_str,
            lines_emitted = 0:usize,
            bytes_emitted = diag_len,
            mode = string::from("symbol"),
            path = string::from(opts.file_path.as_str()),
            requested_line = Option<usize>::None,
            requested_range = Option<BlockRange>::None,
            detected_block_range = Option<BlockRange>::None,
            emitted_range = Option<BlockRange>::None,
            target_included = Option<bool>::None,
            content_omitted = false,
            complete = !is_budget_truncated,
            eof_reached = true,
            records = Vec<ViewLineRecord>::new(),
            selection_status = string::from("multiple_candidates"),
            range_status = Option<string>::None,
            output_status = cede output_status_str,
            target_symbol = Vec<SymbolTargetInfo>::new(),
            candidates = cede final_cands,
            candidates_truncated = is_cands_truncated,
            continuation_token = Option<string>::None,
            continuation_active = false,
            sha256_hex = string::new()
        ))
    }

    auto target_sym_idx = matched_indices.get(0)
    auto &target_sym = sym_data.symbols.borrow(target_sym_idx)

    auto range_status_str# = string::from("confirmed")
    if target_sym.range_reliability == "eof_fallback" || target_sym.range_end.is_none() {
        range_status_str = string::from("unknown")
    }

    auto total_file_lines = lines.len()
    auto sym_start# = target_sym.range_start + 0:usize
    auto sym_end# = target_sym.line + 0:usize
    match target_sym.range_end {
        auto Option<usize>::Some(re) => {
            sym_end = re + 0:usize
        }
        auto Option<usize>::None => {}
    }
    if range_status_str == "unknown" {
        sym_end = sym_start + opts.max_block_lines - 1:usize
        if sym_end > total_file_lines {
            sym_end = total_file_lines
        }
    }
    if sym_end > total_file_lines {
        sym_end = total_file_lines
    }
    if sym_start > sym_end {
        sym_start = sym_end
    }

    auto header# = string::new()
    if opts.continuation {
        if range_status_str == "confirmed" {
            header#.push_str("[file: ")
            header#.push_str(opts.file_path.as_str())
            header#.push_str(", symbol: ")
            header#.push_str(target_sym.name.as_str())
            if target_sym.scope.len() > 0:usize {
                header#.push_str(", scope: ")
                header#.push_str(target_sym.scope.as_str())
            }
            header#.push_str(", lines: L")
            header#.push_str(u64_to_string(sym_start as u64).as_str())
            header#.push_str("-L")
            header#.push_str(u64_to_string(sym_end as u64).as_str())
            header#.push_str("]\n")
        } else {
            header#.push_str("[file: ")
            header#.push_str(opts.file_path.as_str())
            header#.push_str(", symbol: ")
            header#.push_str(target_sym.name.as_str())
            if target_sym.scope.len() > 0:usize {
                header#.push_str(", scope: ")
                header#.push_str(target_sym.scope.as_str())
            }
            header#.push_str(", preview: L")
            header#.push_str(u64_to_string(sym_start as u64).as_str())
            header#.push_str("-L")
            header#.push_str(u64_to_string(sym_end as u64).as_str())
            header#.push_str(" (unclosed structure)]\n")
        }
    } else {
        if range_status_str == "confirmed" {
            header#.push_str("[symbol: ")
            header#.push_str(target_sym.name.as_str())
            if target_sym.scope.len() > 0:usize {
                header#.push_str(", scope: ")
                header#.push_str(target_sym.scope.as_str())
            }
            header#.push_str(", lines: L")
            header#.push_str(u64_to_string(sym_start as u64).as_str())
            header#.push_str("-L")
            header#.push_str(u64_to_string(sym_end as u64).as_str())
            header#.push_str("]\n")
        } else {
            header#.push_str("[symbol: ")
            header#.push_str(target_sym.name.as_str())
            if target_sym.scope.len() > 0:usize {
                header#.push_str(", scope: ")
                header#.push_str(target_sym.scope.as_str())
            }
            header#.push_str(", preview: L")
            header#.push_str(u64_to_string(sym_start as u64).as_str())
            header#.push_str("-L")
            header#.push_str(u64_to_string(sym_end as u64).as_str())
            header#.push_str(" (unclosed structure)]\n")
        }
    }

    if opts.continuation {
        if has_max_lines && max_lines_val < 1:usize {
            return Result<ViewResult, string>::Err(string::from("target_exceeds_max_lines: Target line cannot fit within max_lines 0"))
        }

        auto cur_line# = sym_start
        auto lines_emitted# = 0:usize
        auto bytes_emitted# = header.len()
        auto truncated# = false
        auto trunc_reason# = string::from("completed")
        auto records# = Vec<ViewLineRecord>::new()
        auto out# = string::new()
        out#.push_str(header.as_str())
        auto content_omitted# = false
        auto target_seen# = false

        loop cur_line <= sym_end {
            if has_max_lines && lines_emitted >= max_lines_val {
                truncated = true
                trunc_reason = string::from("max_lines")
                break
            }

            auto raw = lines.borrow(cur_line - 1:usize).as_str()
            auto clean_l# = raw
            if raw.len > 0 && raw.byte_at(raw.len - 1) == ('\r' as char) {
                clean_l = raw.substr(0, raw.len - 1)
            }
            auto disp# = clean_l
            if has_max_cols && max_cols_val > 0 && clean_l.len > max_cols_val {
                disp = "[omitted]"
                content_omitted = true
            }

            auto is_target = (cur_line == target_sym.line)
            if is_target {
                target_seen = true
            }

            auto line_entry# = string::new()
            line_entry#.push_str(u64_to_string(cur_line as u64).as_str())
            if is_target {
                line_entry#.push_str(":")
            } else {
                line_entry#.push_str("-")
            }
            line_entry#.push_str(disp)
            line_entry#.push_str("\n")

            if has_max_bytes && bytes_emitted + line_entry.len() > max_bytes_val {
                truncated = true
                trunc_reason = string::from("max_result_bytes")
                break
            }

            auto rec_kind# = string::from("context")
            if is_target {
                rec_kind = string::from("target")
            }

            bytes_emitted = bytes_emitted + line_entry.len()
            out#.push_str(line_entry.as_str())
            records#.push(ViewLineRecord(
                line_number = cur_line,
                kind = cede rec_kind,
                text = string::from(disp)
            ))
            lines_emitted = lines_emitted + 1:usize
            cur_line = cur_line + 1:usize
        }

        if lines_emitted == 0:usize {
            auto err# = string::from("target_exceeds_max_result_bytes: Target line formatted record exceeds max_result_bytes (")
            if has_max_bytes {
                err#.push_str(u64_to_string(max_bytes_val as u64).as_str())
            }
            err#.push_str(" bytes)")
            return Result<ViewResult, string>::Err(cede err)
        }

        auto continuation_tok# = Option<string>::None
        if truncated && cur_line <= sym_end {
            auto sc_opt# = Option<string>::None
            if target_sym.scope.len() > 0:usize {
                sc_opt = Option<string>::Some(string::from(target_sym.scope.as_str()))
            }
            auto ct = ContinuationToken(
                version = 1:usize,
                path = string::from(opts.file_path.as_str()),
                req_start = sym_start,
                req_end = sym_end,
                next_line = cur_line,
                end_line = sym_end,
                sha256_hex = string::from(sha256_hex.as_str()),
                mode = string::from("symbol"),
                symbol = Option<string>::Some(string::from(target_sym.name.as_str())),
                scope = cede sc_opt,
                range_status = string::from(range_status_str.as_str()),
                max_columns = opts.max_columns
            )
            continuation_tok = encode_continuation_token(ct)
            if continuation_tok.is_none() {
                return Result<ViewResult, string>::Err(string::from("continuation_token_overflow: Continuation token exceeds maximum length limit (4096 bytes)"))
            }
        }

        auto emitted_range = Option<BlockRange>::Some(BlockRange(
            start = sym_start,
            end = cur_line - 1:usize
        ))
        auto target_included = Option<bool>::Some(target_seen)

        auto target_info = SymbolTargetInfo(
            name = string::from(target_sym.name.as_str()),
            kind = string::from(target_sym.kind.as_str()),
            line = target_sym.line,
            range_start = target_sym.range_start,
            range_end = target_sym.range_end,
            range_status = string::from(range_status_str.as_str()),
            scope = string::from(target_sym.scope.as_str()),
            detail = string::from(target_sym.detail.as_str())
        )

        auto detected_block = BlockRange(start = sym_start, end = sym_end)
        auto requested_block# = Option<BlockRange>::None
        if range_status_str == "confirmed" {
            requested_block = Option<BlockRange>::Some(detected_block.clone())
        }

        auto output_status_str# = string::from("complete")
        if truncated {
            output_status_str = string::from("budget_truncated")
        }

        auto target_vec# = Vec<SymbolTargetInfo>::new()
        target_vec#.push(target_info)

        return Result<ViewResult, string>::Ok(ViewResult(
            text = cede out,
            truncated = truncated,
            reason = cede trunc_reason,
            lines_emitted = lines_emitted,
            bytes_emitted = bytes_emitted,
            mode = string::from("symbol"),
            path = string::from(opts.file_path.as_str()),
            requested_line = Option<usize>::Some(target_sym.line),
            requested_range = requested_block,
            detected_block_range = Option<BlockRange>::Some(detected_block),
            emitted_range = emitted_range,
            target_included = target_included,
            content_omitted = content_omitted,
            complete = !truncated,
            eof_reached = !truncated && (sym_end == total_file_lines),
            records = cede records,
            selection_status = string::from("found"),
            range_status = Option<string>::Some(cede range_status_str),
            output_status = cede output_status_str,
            target_symbol = cede target_vec,
            candidates = Vec<SymbolCandidateInfo>::new(),
            candidates_truncated = false,
            continuation_token = cede continuation_tok,
            continuation_active = true,
            sha256_hex = string::from(sha256_hex.as_str())
        ))
    }

    if has_max_lines && max_lines_val < 1:usize {
        return Result<ViewResult, string>::Err(string::from("target_exceeds_max_lines: Target line cannot fit within max_lines 0"))
    }

    auto target_line_no = target_sym.line
    auto target_raw_text# = ""
    if target_line_no >= 1:usize && target_line_no <= total_file_lines {
        target_raw_text = lines.borrow(target_line_no - 1:usize).as_str()
        if target_raw_text.len > 0 && target_raw_text.byte_at(target_raw_text.len - 1) == ('\r' as char) {
            target_raw_text = target_raw_text.substr(0, target_raw_text.len - 1)
        }
    }
    auto content_omitted# = false
    auto target_disp# = target_raw_text
    if has_max_cols && max_cols_val > 0 && target_raw_text.len > max_cols_val {
        target_disp = "[omitted]"
        content_omitted = true
    }
    auto target_entry# = string::new()
    target_entry#.push_str(u64_to_string(target_line_no as u64).as_str())
    target_entry#.push_str(":")
    target_entry#.push_str(target_disp)
    target_entry#.push_str("\n")

    auto base_bytes = header.len() + target_entry.len()
    if has_max_bytes && base_bytes > max_bytes_val {
        auto err# = string::from("target_exceeds_max_result_bytes: Target line formatted record (")
        err#.push_str(u64_to_string(base_bytes as u64).as_str())
        err#.push_str(" bytes) exceeds max_result_bytes (")
        err#.push_str(u64_to_string(max_bytes_val as u64).as_str())
        err#.push_str(" bytes)")
        return Result<ViewResult, string>::Err(cede err)
    }

    auto avail_before = target_line_no - sym_start
    auto avail_after = sym_end - target_line_no
    auto block_len = sym_end - sym_start + 1:usize

    auto win_lines# = block_len
    if has_max_lines && win_lines > max_lines_val {
        win_lines = max_lines_val
    }

    auto take_before# = 0:usize
    auto take_after# = 0:usize
    if win_lines > 1:usize {
        auto half_before = (win_lines - 1:usize) / 2:usize
        auto half_after = (win_lines - 1:usize) - half_before
        if avail_before < half_before {
            take_before = avail_before
            take_after = win_lines - 1:usize - take_before
            if take_after > avail_after {
                take_after = avail_after
            }
        } else if avail_after < half_after {
            take_after = avail_after
            take_before = win_lines - 1:usize - take_after
            if take_before > avail_before {
                take_before = avail_before
            }
        } else {
            take_before = half_before
            take_after = half_after
        }
    }

    auto rem_bytes# = 18446744073709551615:usize
    if has_max_bytes {
        rem_bytes = max_bytes_val - base_bytes
    }

    auto b_take_actual# = 0:usize
    auto a_take_actual# = 0:usize
    auto byte_truncated# = false

    loop b_take_actual < take_before || a_take_actual < take_after {
        auto can_b = b_take_actual < take_before
        auto can_a = a_take_actual < take_after
        if !can_b && !can_a {
            break
        }

        if can_b && (b_take_actual <= a_take_actual || !can_a) {
            auto b_line_num = target_line_no - 1:usize - b_take_actual
            auto b_raw = lines.borrow(b_line_num - 1:usize).as_str()
            auto clean_b# = b_raw
            if b_raw.len > 0 && b_raw.byte_at(b_raw.len - 1) == ('\r' as char) {
                clean_b = b_raw.substr(0, b_raw.len - 1)
            }
            auto b_disp# = clean_b
            if has_max_cols && max_cols_val > 0 && clean_b.len > max_cols_val {
                b_disp = "[omitted]"
                content_omitted = true
            }
            auto b_len = u64_to_string(b_line_num as u64).len() + 1:usize + b_disp.len + 1:usize
            if has_max_bytes && b_len > rem_bytes {
                byte_truncated = true
                break
            }
            if has_max_bytes {
                rem_bytes = rem_bytes - b_len
            }
            b_take_actual = b_take_actual + 1:usize
        }

        if can_a && (a_take_actual < b_take_actual || !can_b) {
            auto a_line_num = target_line_no + 1:usize + a_take_actual
            auto a_raw = lines.borrow(a_line_num - 1:usize).as_str()
            auto clean_a# = a_raw
            if a_raw.len > 0 && a_raw.byte_at(a_raw.len - 1) == ('\r' as char) {
                clean_a = a_raw.substr(0, a_raw.len - 1)
            }
            auto a_disp# = clean_a
            if has_max_cols && max_cols_val > 0 && clean_a.len > max_cols_val {
                a_disp = "[omitted]"
                content_omitted = true
            }
            auto a_len = u64_to_string(a_line_num as u64).len() + 1:usize + a_disp.len + 1:usize
            if has_max_bytes && a_len > rem_bytes {
                byte_truncated = true
                break
            }
            if has_max_bytes {
                rem_bytes = rem_bytes - a_len
            }
            a_take_actual = a_take_actual + 1:usize
        }
    }

    auto truncated# = false
    auto trunc_reason# = string::from("completed")
    if byte_truncated {
        truncated = true
        trunc_reason = string::from("max_result_bytes")
    } else if has_max_lines && (1:usize + b_take_actual + a_take_actual < block_len) {
        truncated = true
        trunc_reason = string::from("max_lines")
    }

    auto out# = string::new()
    out#.push_str(header.as_str())

    auto records# = Vec<ViewLineRecord>::new()
    auto bytes_emitted# = header.len()
    auto lines_emitted = 1:usize + b_take_actual + a_take_actual

    // 1. Lines before target
    if b_take_actual > 0:usize {
        auto idx# = b_take_actual
        loop idx > 0:usize {
            auto l_num = target_line_no - idx
            auto raw = lines.borrow(l_num - 1:usize).as_str()
            auto clean_l# = raw
            if raw.len > 0 && raw.byte_at(raw.len - 1) == ('\r' as char) {
                clean_l = raw.substr(0, raw.len - 1)
            }
            auto disp# = clean_l
            if has_max_cols && max_cols_val > 0 && clean_l.len > max_cols_val {
                disp = "[omitted]"
            }
            auto line_entry# = string::new()
            line_entry#.push_str(u64_to_string(l_num as u64).as_str())
            line_entry#.push_str("-")
            line_entry#.push_str(disp)
            line_entry#.push_str("\n")
            bytes_emitted = bytes_emitted + line_entry.len()
            out#.push_str(line_entry.as_str())
            records#.push(ViewLineRecord(
                line_number = l_num,
                kind = string::from("context"),
                text = string::from(disp)
            ))
            idx = idx - 1:usize
        }
    }

    // 2. Target line
    bytes_emitted = bytes_emitted + target_entry.len()
    out#.push_str(target_entry.as_str())
    records#.push(ViewLineRecord(
        line_number = target_line_no,
        kind = string::from("target"),
        text = string::from(target_disp)
    ))

    // 3. Lines after target
    if a_take_actual > 0:usize {
        auto idx# = 1:usize
        loop idx <= a_take_actual {
            auto l_num = target_line_no + idx
            auto raw = lines.borrow(l_num - 1:usize).as_str()
            auto clean_l# = raw
            if raw.len > 0 && raw.byte_at(raw.len - 1) == ('\r' as char) {
                clean_l = raw.substr(0, raw.len - 1)
            }
            auto disp# = clean_l
            if has_max_cols && max_cols_val > 0 && clean_l.len > max_cols_val {
                disp = "[omitted]"
            }
            auto line_entry# = string::new()
            line_entry#.push_str(u64_to_string(l_num as u64).as_str())
            line_entry#.push_str("-")
            line_entry#.push_str(disp)
            line_entry#.push_str("\n")
            bytes_emitted = bytes_emitted + line_entry.len()
            out#.push_str(line_entry.as_str())
            records#.push(ViewLineRecord(
                line_number = l_num,
                kind = string::from("context"),
                text = string::from(disp)
            ))
            idx = idx + 1:usize
        }
    }

    auto emitted_range = Option<BlockRange>::Some(BlockRange(
        start = target_line_no - b_take_actual,
        end = target_line_no + a_take_actual
    ))

    auto target_included = Option<bool>::Some(true)

    auto target_info = SymbolTargetInfo(
        name = string::from(target_sym.name.as_str()),
        kind = string::from(target_sym.kind.as_str()),
        line = target_sym.line,
        range_start = target_sym.range_start,
        range_end = target_sym.range_end,
        range_status = string::from(range_status_str.as_str()),
        scope = string::from(target_sym.scope.as_str()),
        detail = string::from(target_sym.detail.as_str())
    )

    auto detected_block = BlockRange(start = sym_start, end = sym_end)
    auto requested_block# = Option<BlockRange>::None
    if range_status_str == "confirmed" {
        requested_block = Option<BlockRange>::Some(detected_block.clone())
    }

    auto output_status_str# = string::from("complete")
    if truncated {
        output_status_str = string::from("budget_truncated")
    }

    auto target_vec# = Vec<SymbolTargetInfo>::new()
    target_vec#.push(target_info)

    return Result<ViewResult, string>::Ok(ViewResult(
        text = cede out,
        truncated = truncated,
        reason = cede trunc_reason,
        lines_emitted = lines_emitted,
        bytes_emitted = bytes_emitted,
        mode = string::from("symbol"),
        path = string::from(opts.file_path.as_str()),
        requested_line = Option<usize>::Some(target_line_no),
        requested_range = requested_block,
        detected_block_range = Option<BlockRange>::Some(detected_block),
        emitted_range = emitted_range,
        target_included = target_included,
        content_omitted = content_omitted,
        complete = !truncated,
        eof_reached = !truncated && (sym_end == total_file_lines),
        records = cede records,
        selection_status = string::from("found"),
        range_status = Option<string>::Some(cede range_status_str),
        output_status = cede output_status_str,
        target_symbol = cede target_vec,
        candidates = Vec<SymbolCandidateInfo>::new(),
        candidates_truncated = false,
        continuation_token = Option<string>::None,
        continuation_active = false,
        sha256_hex = string::new()
    ))
}

pub fn execute_view_continuation(opts: ViewOptions) -> Result<ViewResult, string> {
    auto tok_str# = string::new()
    match opts.continuation_token {
        auto Option<string>::Some(&ts) => {
            tok_str = string::from(ts.as_str())
        }
        auto Option<string>::None => {
            return Result<ViewResult, string>::Err(string::from("Missing continuation token"))
        }
    }

    auto dec_res = decode_continuation_token(tok_str.as_str())
    if dec_res.is_err() {
        return Result<ViewResult, string>::Err(dec_res.unwrap_err())
    }
    auto token = dec_res.unwrap()

    if token.end_line < token.next_line {
        return Result<ViewResult, string>::Err(string::from("Invalid continuation token: end_line < next_line"))
    }
    if token.req_end < token.req_start {
        return Result<ViewResult, string>::Err(string::from("Invalid continuation token: req_end < req_start"))
    }

    // 1. Capture file into memory (< 10MB)
    auto capture = capture_file_bounded(token.path.as_str(), 10485760:usize)
    if capture.open_err || capture.read_err {
        return Result<ViewResult, string>::Err(string::from("io_error: Failed to read file"))
    }
    if capture.size_exceeded {
        return Result<ViewResult, string>::Err(string::from("scan_incomplete: file too large, exceeds 10MiB input read limit"))
    }

    // 2. Anti-torn-read cryptographic verification
    if capture.sha256_hex != token.sha256_hex {
        return Result<ViewResult, string>::Err(string::from("file_modified_since_last_read: File content modified since token generation"))
    }

    auto lines = cede capture.lines
    auto sha256_hex = cede capture.sha256_hex
    auto total_file_lines = lines.len()

    // 3. Header formatting
    auto header# = string::new()
    header#.push_str("[file: ")
    header#.push_str(token.path.as_str())
    match token.symbol {
        auto Option<string>::Some(&s_name) => {
            header#.push_str(", symbol: ")
            header#.push_str(s_name.as_str())
        }
        auto Option<string>::None => {}
    }
    match token.scope {
        auto Option<string>::Some(&sc_name) => {
            header#.push_str(", scope: ")
            header#.push_str(sc_name.as_str())
        }
        auto Option<string>::None => {}
    }
    if token.range_status == "confirmed" {
        header#.push_str(", lines: L")
        header#.push_str(u64_to_string(token.next_line as u64).as_str())
        header#.push_str("-L")
        header#.push_str(u64_to_string(token.end_line as u64).as_str())
        header#.push_str(" (continuation)]\n")
    } else {
        header#.push_str(", preview: L")
        header#.push_str(u64_to_string(token.next_line as u64).as_str())
        header#.push_str("-L")
        header#.push_str(u64_to_string(token.end_line as u64).as_str())
        header#.push_str(" (unclosed structure continuation)]\n")
    }

    auto has_max_lines = opts.max_lines.is_some()
    auto max_lines_val# = 0:usize
    match opts.max_lines {
        auto Option<usize>::Some(v) => { max_lines_val = v }
        auto Option<usize>::None => {}
    }
    auto has_max_bytes = opts.max_result_bytes.is_some()
    auto max_bytes_val# = 0:usize
    match opts.max_result_bytes {
        auto Option<usize>::Some(v) => { max_bytes_val = v }
        auto Option<usize>::None => {}
    }
    auto has_max_cols# = false
    auto max_cols_val# = 0:usize
    match opts.max_columns {
        auto Option<usize>::Some(v) => {
            has_max_cols = true
            max_cols_val = v
        }
        auto Option<usize>::None => {
            match token.max_columns {
                auto Option<usize>::Some(tv) => {
                    has_max_cols = true
                    max_cols_val = tv
                }
                auto Option<usize>::None => {}
            }
        }
    }

    if has_max_lines && max_lines_val < 1:usize {
        return Result<ViewResult, string>::Err(string::from("target_exceeds_max_lines: Target line cannot fit within max_lines 0"))
    }

    // 4. Sequential emission from token.next_line to token.end_line
    auto cur_line# = token.next_line
    auto lines_emitted# = 0:usize
    auto bytes_emitted# = header.len()
    auto truncated# = false
    auto trunc_reason# = string::from("completed")
    auto records# = Vec<ViewLineRecord>::new()
    auto out# = string::new()
    out#.push_str(header.as_str())
    auto content_omitted# = false

    loop cur_line <= token.end_line {
        if has_max_lines && lines_emitted >= max_lines_val {
            truncated = true
            trunc_reason = string::from("max_lines")
            break
        }

        if cur_line > total_file_lines {
            break
        }

        auto raw = lines.borrow(cur_line - 1:usize).as_str()
        auto clean_l# = raw
        if raw.len > 0 && raw.byte_at(raw.len - 1) == ('\r' as char) {
            clean_l = raw.substr(0, raw.len - 1)
        }
        auto disp# = clean_l
        if has_max_cols && max_cols_val > 0 && clean_l.len > max_cols_val {
            disp = "[omitted]"
            content_omitted = true
        }

        auto line_entry# = string::new()
        line_entry#.push_str(u64_to_string(cur_line as u64).as_str())
        if token.mode == "lines" || token.mode == "range" {
            line_entry#.push_str(":")
        } else {
            line_entry#.push_str("-")
        }
        line_entry#.push_str(disp)
        line_entry#.push_str("\n")

        if has_max_bytes && bytes_emitted + line_entry.len() > max_bytes_val {
            truncated = true
            trunc_reason = string::from("max_result_bytes")
            break
        }

        auto rec_kind# = string::from("context")
        if token.mode == "lines" || token.mode == "range" {
            rec_kind = string::from("target")
        }

        bytes_emitted = bytes_emitted + line_entry.len()
        out#.push_str(line_entry.as_str())
        records#.push(ViewLineRecord(
            line_number = cur_line,
            kind = cede rec_kind,
            text = string::from(disp)
        ))
        lines_emitted = lines_emitted + 1:usize
        cur_line = cur_line + 1:usize
    }

    if lines_emitted == 0:usize {
        auto err# = string::from("target_exceeds_max_result_bytes: Target line formatted record exceeds max_result_bytes (")
        if has_max_bytes {
            err#.push_str(u64_to_string(max_bytes_val as u64).as_str())
        }
        err#.push_str(" bytes)")
        return Result<ViewResult, string>::Err(cede err)
    }

    auto next_token# = Option<string>::None
    if truncated && cur_line <= token.end_line {
        auto sym_copy# = Option<string>::None
        match token.symbol {
            auto Option<string>::Some(&s) => {
                sym_copy = Option<string>::Some(string::from(s.as_str()))
            }
            auto Option<string>::None => {}
        }
        auto sc_copy# = Option<string>::None
        match token.scope {
            auto Option<string>::Some(&sc) => {
                sc_copy = Option<string>::Some(string::from(sc.as_str()))
            }
            auto Option<string>::None => {}
        }
        auto tok_mode# = string::from(token.mode.as_str())
        if tok_mode == "lines" {
            tok_mode = string::from("range")
        }
        auto next_tok_data = ContinuationToken(
            version = token.version,
            path = string::from(token.path.as_str()),
            req_start = token.req_start,
            req_end = token.req_end,
            next_line = cur_line,
            end_line = token.end_line,
            sha256_hex = string::from(token.sha256_hex.as_str()),
            mode = cede tok_mode,
            symbol = cede sym_copy,
            scope = cede sc_copy,
            range_status = string::from(token.range_status.as_str()),
            max_columns = token.max_columns
        )
        next_token = encode_continuation_token(next_tok_data)
        if next_token.is_none() {
            return Result<ViewResult, string>::Err(string::from("continuation_token_overflow: Continuation token exceeds maximum length limit (4096 bytes)"))
        }
    }

    auto emitted_range# = Option<BlockRange>::None
    if lines_emitted > 0:usize {
        emitted_range = Option<BlockRange>::Some(BlockRange(
            start = token.next_line,
            end = cur_line - 1:usize
        ))
    }

    auto detected_block = BlockRange(start = token.req_start, end = token.req_end)
    auto requested_block# = Option<BlockRange>::None
    if token.range_status == "confirmed" {
        requested_block = Option<BlockRange>::Some(detected_block.clone())
    }

    auto output_status_str# = string::from("complete")
    if truncated {
        output_status_str = string::from("budget_truncated")
    }

    auto target_vec# = Vec<SymbolTargetInfo>::new()
    match token.symbol {
        auto Option<string>::Some(&s_name) => {
            auto scope_str# = string::new()
            match token.scope {
                auto Option<string>::Some(&sc) => {
                    scope_str = string::from(sc.as_str())
                }
                auto Option<string>::None => {}
            }
            target_vec#.push(SymbolTargetInfo(
                name = string::from(s_name.as_str()),
                kind = string::from("symbol"),
                line = token.req_start,
                range_start = token.req_start,
                range_end = Option<usize>::Some(token.req_end),
                range_status = string::from(token.range_status.as_str()),
                scope = cede scope_str,
                detail = string::new()
            ))
        }
        auto Option<string>::None => {}
    }

    auto vr_mode# = string::from(token.mode.as_str())
    if vr_mode == "lines" {
        vr_mode = string::from("range")
    }

    return Result<ViewResult, string>::Ok(ViewResult(
        text = cede out,
        truncated = truncated,
        reason = cede trunc_reason,
        lines_emitted = lines_emitted,
        bytes_emitted = bytes_emitted,
        mode = cede vr_mode,
        path = string::from(token.path.as_str()),
        requested_line = Option<usize>::None,
        requested_range = requested_block,
        detected_block_range = Option<BlockRange>::Some(detected_block),
        emitted_range = emitted_range,
        target_included = Option<bool>::Some(false),
        content_omitted = content_omitted,
        complete = !truncated && (cur_line > token.end_line),
        eof_reached = !truncated && (token.end_line == total_file_lines),
        records = cede records,
        selection_status = string::from("found"),
        range_status = Option<string>::Some(string::from(token.range_status.as_str())),
        output_status = cede output_status_str,
        target_symbol = cede target_vec,
        candidates = Vec<SymbolCandidateInfo>::new(),
        candidates_truncated = false,
        continuation_token = cede next_token,
        continuation_active = true,
        sha256_hex = string::from(token.sha256_hex.as_str())
    ))
}

pub fn execute_view_operation(opts: ViewOptions) -> Result<ViewResult, string> {
    if opts.continuation_token.is_some() {
        return execute_view_continuation(opts)
    }
    if opts.symbol.is_some() {
        if opts.line.is_some() {
            return Result<ViewResult, string>::Err(string::from("Cannot specify both 'symbol' and target line"))
        }
        if opts.lines_range.is_some() {
            return Result<ViewResult, string>::Err(string::from("Cannot specify both 'symbol' and 'lines'"))
        }
        if opts.block {
            return Result<ViewResult, string>::Err(string::from("Cannot specify both 'symbol' and 'block'"))
        }
        return execute_view_stream_symbol(opts)
    }

    if opts.symbol_scope.is_some() {
        return Result<ViewResult, string>::Err(string::from("Cannot specify 'scope' without 'symbol'"))
    }

    if opts.lines_range.is_some() && opts.line.is_some() {
        return Result<ViewResult, string>::Err(string::from("Cannot specify both 'line' and 'lines'"))
    }
    if opts.block && opts.lines_range.is_some() {
        return Result<ViewResult, string>::Err(string::from("'block' cannot be used with explicit 'lines' range"))
    }

    match opts.lines_range {
        auto Option<BlockRange>::Some(range) => {
            return execute_view_stream_lines(opts, range.start, range.end)
        }
        auto Option<BlockRange>::None => {}
    }

    auto target_line# = 0:usize
    match opts.line {
        auto Option<usize>::Some(l) => {
            target_line = l
        }
        auto Option<usize>::None => {
            return Result<ViewResult, string>::Err(string::from("Viewing requires a target line number (e.g. <path>:<line>)"))
        }
    }

    if target_line == 0:usize {
        return Result<ViewResult, string>::Err(string::from("Line number must be >= 1"))
    }

    if opts.block {
        return execute_view_stream_block(opts, target_line)
    }

    return execute_view_stream_point(opts, target_line)
}

pub shape CliSymbolPreviewProjection (
    text: string,
    shown_start: usize,
    shown_end: usize,
    has_front_omitted: bool,
    front_omitted_start: usize,
    front_omitted_end: usize,
    has_rear_omitted: bool,
    rear_omitted_start: usize,
    rear_omitted_end: usize,
    lines_emitted: usize,
    bytes_emitted: usize
)

fn build_preview_header(
    file_path: str,
    sym_name: str,
    sym_scope: str,
    is_confirmed: bool,
    sym_start: usize,
    sym_end: usize,
    shown_start: usize,
    shown_end: usize,
    reason: str
) -> string {
    auto h# = string::new()
    h#.push_str("[file: ")
    h#.push_str(file_path)
    h#.push_str(", symbol: ")
    h#.push_str(sym_name)
    if sym_scope.len > 0:usize {
        h#.push_str(", scope: ")
        h#.push_str(sym_scope)
    }
    if is_confirmed {
        h#.push_str(", range: L")
        h#.push_str(u64_to_string(sym_start as u64).as_str())
        h#.push_str("-L")
        h#.push_str(u64_to_string(sym_end as u64).as_str())
    } else {
        h#.push_str(", preview: L")
        h#.push_str(u64_to_string(sym_start as u64).as_str())
        h#.push_str("-L")
        h#.push_str(u64_to_string(sym_end as u64).as_str())
        h#.push_str(" (unclosed structure), range_status: unknown")
    }
    h#.push_str(", shown: L")
    h#.push_str(u64_to_string(shown_start as u64).as_str())
    h#.push_str("-L")
    h#.push_str(u64_to_string(shown_end as u64).as_str())
    h#.push_str(", truncated: ")
    h#.push_str(reason)
    h#.push_str("]\n")
    return cede h
}

impl ViewResult {
    pub fn format_cli_symbol_preview(
        self#,
        max_lines_opt: Option<usize>,
        max_bytes_opt: Option<usize>
    ) -> Result<CliSymbolPreviewProjection, string> {
        if self.records.len() == 0:usize {
            return Result<CliSymbolPreviewProjection, string>::Err(string::from("view_preview: no records available"))
        }
        if self.target_symbol.len() == 0:usize {
            return Result<CliSymbolPreviewProjection, string>::Err(string::from("view_preview: no target symbol available"))
        }

        auto &target_sym = self.target_symbol.borrow(0)
        auto target_line = target_sym.line + 0:usize
        auto sym_start = target_sym.range_start + 0:usize
        auto sym_end# = target_sym.line + 0:usize
        match target_sym.range_end {
            auto Option<usize>::Some(re) => {
                sym_end = re + 0:usize
            }
            auto Option<usize>::None => {}
        }

        auto is_confirmed = (target_sym.range_status == "confirmed")
        if !is_confirmed {
            match self.detected_block_range {
                auto Option<BlockRange>::Some(&dr) => {
                    sym_end = dr.end + 0:usize
                }
                auto Option<BlockRange>::None => {}
            }
        }
        if sym_end < sym_start {
            sym_end = sym_start + 0:usize
        }

        auto num_recs = self.records.len()
        auto target_idx# = 0:usize
        auto found_target# = false
        auto ti# = 0:usize
        loop ti < num_recs {
            auto &r = self.records.borrow(ti)
            if r.kind == "target" || r.line_number == target_line {
                target_idx = ti
                found_target = true
                break
            }
            ti = ti + 1:usize
        }
        if !found_target {
            target_idx = 0:usize
        }

        auto start_idx# = 0:usize
        auto end_idx# = num_recs - 1:usize

        match max_lines_opt {
            auto Option<usize>::Some(ml) => {
                if ml < 1:usize {
                    return Result<CliSymbolPreviewProjection, string>::Err(string::from("target_exceeds_max_lines: Target line cannot fit within max_lines 0"))
                }
                loop true {
                    auto cur_lines = end_idx - start_idx + 1:usize
                    if cur_lines <= ml {
                        break
                    }
                    auto lines_before = target_idx - start_idx
                    auto lines_after = end_idx - target_idx
                    if lines_after > lines_before {
                        end_idx = end_idx - 1:usize
                    } else if lines_before > lines_after {
                        start_idx = start_idx + 1:usize
                    } else if lines_after > 0:usize {
                        end_idx = end_idx - 1:usize
                    } else if lines_before > 0:usize {
                        start_idx = start_idx + 1:usize
                    } else {
                        break
                    }
                }
            }
            auto Option<usize>::None => {}
        }

        auto line_texts# = Vec<string>::new()
        auto prefix_sums# = Vec<usize>::new()
        prefix_sums#.push(0:usize)

        auto ri# = 0:usize
        loop ri < num_recs {
            auto &r = self.records.borrow(ri)
            auto l_str# = string::new()
            l_str#.push_str(u64_to_string(r.line_number as u64).as_str())
            if r.kind == "target" {
                l_str#.push_str(":")
            } else {
                l_str#.push_str("-")
            }
            l_str#.push_str(r.text.as_str())
            l_str#.push_str("\n")

            auto l_len = l_str.len()
            auto cur_sum = prefix_sums.get(ri) + l_len
            prefix_sums#.push(cur_sum)
            line_texts#.push(cede l_str)
            ri = ri + 1:usize
        }

        match max_bytes_opt {
            auto Option<usize>::Some(max_b) => {
                auto target_line_no = self.records.borrow(target_idx).line_number
                auto min_hdr = build_preview_header(
                    self.path.as_str(),
                    target_sym.name.as_str(),
                    target_sym.scope.as_str(),
                    is_confirmed,
                    sym_start,
                    sym_end,
                    target_line_no,
                    target_line_no,
                    "max_result_bytes"
                )
                auto min_bytes# = min_hdr.len()
                if target_line_no > sym_start {
                    auto min_front# = string::from("[omitted: L")
                    min_front#.push_str(u64_to_string(sym_start as u64).as_str())
                    min_front#.push_str("-L")
                    min_front#.push_str(u64_to_string((target_line_no - 1:usize) as u64).as_str())
                    min_front#.push_str("]\n")
                    min_bytes = min_bytes + min_front.len()
                }
                min_bytes = min_bytes + (prefix_sums.get(target_idx + 1:usize) - prefix_sums.get(target_idx))
                if target_line_no < sym_end {
                    auto min_rear# = string::from("[omitted: L")
                    min_rear#.push_str(u64_to_string((target_line_no + 1:usize) as u64).as_str())
                    min_rear#.push_str("-L")
                    min_rear#.push_str(u64_to_string(sym_end as u64).as_str())
                    min_rear#.push_str("]\n")
                    min_bytes = min_bytes + min_rear.len()
                }

                if min_bytes > max_b {
                    auto err# = string::from("target_exceeds_max_result_bytes: Target line formatted record (")
                    err#.push_str(u64_to_string(min_bytes as u64).as_str())
                    err#.push_str(" bytes) exceeds max_result_bytes (")
                    err#.push_str(u64_to_string(max_b as u64).as_str())
                    err#.push_str(" bytes)")
                    return Result<CliSymbolPreviewProjection, string>::Err(cede err)
                }

                loop true {
                    auto s_line = self.records.borrow(start_idx).line_number
                    auto e_line = self.records.borrow(end_idx).line_number
                    auto cur_reason# = "max_lines"
                    if self.reason == "max_result_bytes" || start_idx > 0:usize || end_idx < (num_recs - 1:usize) {
                        cur_reason = "max_result_bytes"
                    }
                    auto chdr = build_preview_header(
                        self.path.as_str(),
                        target_sym.name.as_str(),
                        target_sym.scope.as_str(),
                        is_confirmed,
                        sym_start,
                        sym_end,
                        s_line,
                        e_line,
                        cur_reason
                    )
                    auto cur_bytes# = chdr.len()
                    if s_line > sym_start {
                        auto f_om# = string::from("[omitted: L")
                        f_om#.push_str(u64_to_string(sym_start as u64).as_str())
                        f_om#.push_str("-L")
                        f_om#.push_str(u64_to_string((s_line - 1:usize) as u64).as_str())
                        f_om#.push_str("]\n")
                        cur_bytes = cur_bytes + f_om.len()
                    }
                    cur_bytes = cur_bytes + (prefix_sums.get(end_idx + 1:usize) - prefix_sums.get(start_idx))
                    if e_line < sym_end {
                        auto r_om# = string::from("[omitted: L")
                        r_om#.push_str(u64_to_string((e_line + 1:usize) as u64).as_str())
                        r_om#.push_str("-L")
                        r_om#.push_str(u64_to_string(sym_end as u64).as_str())
                        r_om#.push_str("]\n")
                        cur_bytes = cur_bytes + r_om.len()
                    }

                    if cur_bytes <= max_b {
                        break
                    }
                    auto lines_before = target_idx - start_idx
                    auto lines_after = end_idx - target_idx
                    if lines_after > lines_before {
                        end_idx = end_idx - 1:usize
                    } else if lines_before > lines_after {
                        start_idx = start_idx + 1:usize
                    } else if lines_after > 0:usize {
                        end_idx = end_idx - 1:usize
                    } else if lines_before > 0:usize {
                        start_idx = start_idx + 1:usize
                    } else {
                        break
                    }
                }
            }
            auto Option<usize>::None => {}
        }

        auto final_s_line = self.records.borrow(start_idx).line_number
        auto final_e_line = self.records.borrow(end_idx).line_number
        auto final_reason# = "max_lines"
        if self.reason == "max_result_bytes" || (max_bytes_opt.is_some() && (start_idx > 0:usize || end_idx < (num_recs - 1:usize))) {
            final_reason = "max_result_bytes"
        }

        auto final_text# = string::new()
        auto hdr = build_preview_header(
            self.path.as_str(),
            target_sym.name.as_str(),
            target_sym.scope.as_str(),
            is_confirmed,
            sym_start,
            sym_end,
            final_s_line,
            final_e_line,
            final_reason
        )
        final_text#.push_str(hdr.as_str())

        auto has_front# = false
        auto front_s# = 0:usize
        auto front_e# = 0:usize
        if final_s_line > sym_start {
            has_front = true
            front_s = sym_start
            front_e = final_s_line - 1:usize
            final_text#.push_str("[omitted: L")
            final_text#.push_str(u64_to_string(front_s as u64).as_str())
            final_text#.push_str("-L")
            final_text#.push_str(u64_to_string(front_e as u64).as_str())
            final_text#.push_str("]\n")
        }

        auto out_i# = start_idx
        loop out_i <= end_idx {
            final_text#.push_str(line_texts.borrow(out_i).as_str())
            out_i = out_i + 1:usize
        }

        auto has_rear# = false
        auto rear_s# = 0:usize
        auto rear_e# = 0:usize
        if final_e_line < sym_end {
            has_rear = true
            rear_s = final_e_line + 1:usize
            rear_e = sym_end
            final_text#.push_str("[omitted: L")
            final_text#.push_str(u64_to_string(rear_s as u64).as_str())
            final_text#.push_str("-L")
            final_text#.push_str(u64_to_string(rear_e as u64).as_str())
            final_text#.push_str("]\n")
        }

        auto lines_count = end_idx - start_idx + 1:usize
        auto bytes_count = final_text.len()

        return Result<CliSymbolPreviewProjection, string>::Ok(CliSymbolPreviewProjection(
            text = cede final_text,
            shown_start = final_s_line,
            shown_end = final_e_line,
            has_front_omitted = has_front,
            front_omitted_start = front_s,
            front_omitted_end = front_e,
            has_rear_omitted = has_rear,
            rear_omitted_start = rear_s,
            rear_omitted_end = rear_e,
            lines_emitted = lines_count,
            bytes_emitted = bytes_count
        ))
    }
}

pub fn execute_view_cli(args: Vec<string>) -> i32 {
    auto num_args = args.len()
    if num_args < 3:usize {
        print_err("Usage: trg view <path>:<line> [-C N] [--block] | trg view <path> --lines <start>-<end> | trg view <path> --symbol <SPEC> [--scope <SCOPE>]")
        return 2
    }

    auto path_opt# = Option<string>::None
    auto line_opt# = Option<usize>::None
    auto context# = 10:usize
    auto context_passed# = false
    auto block# = false
    auto lines_range# = Option<BlockRange>::None
    auto symbol_raw_opt# = Option<string>::None
    auto scope_raw_opt# = Option<string>::None
    auto max_lines_opt# = Option<usize>::None
    auto max_bytes_opt# = Option<usize>::None
    auto max_columns_opt# = Option<usize>::None
    auto max_block_lines# = 80:usize
    auto continuation_flag# = false
    auto continue_token_opt# = Option<string>::None
    auto no_hints# = false
    auto hint_slot# = HintSlot::new()

    auto i# = 2:usize
    loop i < num_args {
        auto &arg = args.borrow(i)
        auto view = arg.as_str()

        if view == "-h" || view == "--help" {
            println("Usage: trg view <path>:<line> [-C N] [--block] | trg view <path> --lines <start>-<end> | trg view <path> --symbol <SPEC> [--scope <SCOPE>] [--continuation] | trg view --continue <TOKEN>")
            println("")
            println("Options:")
            println("  -C, --context <NUM>       Lines of context around target line (default: 10)")
            println("      --block               Expand enclosing syntactic block context")
            println("      --lines <M-N>         Extract explicit physical line range M to N")
            println("      --symbol <NAME>       Extract enclosing code range for target symbol (e.g. 'fn_name' or 'Scope::name')")
            println("      --scope <SCOPE>       Optional enclosing scope to disambiguate target symbol (for block context, use --block)")
            println("      --continuation        Enable sequential range paging and emit continuation token on truncation")
            println("      --continue <TOKEN>    Resume hydration from previous continuation token")
            println("      --max-lines <NUM>     Maximum lines of output before truncating")
            println("      --max-bytes <SIZE>    Maximum hydrated output bytes (alias: --max-result-bytes; counts formatted view lines; default: unlimited; 0 stops hydration immediately)")
            println("      --max-columns <NUM>   Omit lines exceeding NUM characters with [omitted]")
            println("      --max-block-lines <NUM> Maximum lines per expanded block context or unknown symbol preview (default: 80)")
            println("      --no-hints            Suppress lightweight action hints on stderr")
            return 0
        }

        if view == "--continuation" {
            continuation_flag = true
            i = i + 1
            continue
        }

        if view == "--continue" {
            if i + 1 >= num_args {
                print_err("Option requires an argument: --continue")
                return 2
            }
            i = i + 1
            auto &val_arg = args.borrow(i)
            continue_token_opt = Option<string>::Some(string::from(val_arg.as_str()))
            i = i + 1
            continue
        }

        if view.starts_with("--continue=") {
            auto val_str = view.substr(11:usize, view.len - 11:usize)
            continue_token_opt = Option<string>::Some(string::from(val_str))
            i = i + 1
            continue
        }

        if view == "--block" {
            block = true
            i = i + 1
            continue
        }

        if view == "--symbol" {
            if i + 1 >= num_args {
                print_err("Option requires an argument: --symbol")
                return 2
            }
            i = i + 1
            auto &val_arg = args.borrow(i)
            symbol_raw_opt = Option<string>::Some(string::from(val_arg.as_str()))
            i = i + 1
            continue
        }

        if view.starts_with("--symbol=") {
            auto val_str = view.substr(9:usize, view.len - 9:usize)
            symbol_raw_opt = Option<string>::Some(string::from(val_str))
            i = i + 1
            continue
        }

        if view == "--scope" {
            if i + 1 >= num_args {
                print_err("view --scope requires a symbol scope name; use --block to expand the enclosing block.")
                return 2
            }
            auto &next_arg = args.borrow(i + 1)
            if next_arg.as_str().starts_with("-") {
                print_err("view --scope requires a symbol scope name; use --block to expand the enclosing block.")
                return 2
            }
            i = i + 1
            auto &val_arg = args.borrow(i)
            scope_raw_opt = Option<string>::Some(string::from(val_arg.as_str()))
            i = i + 1
            continue
        }

        if view.starts_with("--scope=") {
            auto val_str = view.substr(8:usize, view.len - 8:usize)
            if val_str.len == 0 {
                print_err("Invalid scope name: cannot be empty")
                return 2
            }
            scope_raw_opt = Option<string>::Some(string::from(val_str))
            i = i + 1
            continue
        }

        if view == "-C" || view == "--context" {
            if i + 1 >= num_args {
                print_err("Option requires an argument: -C / --context")
                return 2
            }
            i = i + 1
            auto &val_arg = args.borrow(i)
            auto c_res = parse_usize_val(val_arg.as_str())
            if c_res.is_err() {
                print_err("Invalid context number")
                return 2
            }
            context = c_res.unwrap()
            context_passed = true
            i = i + 1
            continue
        }

        if view.starts_with("-C") && view.len > 2:usize {
            auto val_str = view.substr(2:usize, view.len - 2:usize)
            auto c_res = parse_usize_val(val_str)
            if c_res.is_err() {
                print_err("Invalid context number")
                return 2
            }
            context = c_res.unwrap()
            context_passed = true
            i = i + 1
            continue
        }

        if view.starts_with("--context=") {
            auto val_str = view.substr(10:usize, view.len - 10:usize)
            auto c_res = parse_usize_val(val_str)
            if c_res.is_err() {
                print_err("Invalid context number")
                return 2
            }
            context = c_res.unwrap()
            context_passed = true
            i = i + 1
            continue
        }

        if view == "--lines" {
            if i + 1 >= num_args {
                print_err("Option requires an argument: --lines")
                return 2
            }
            i = i + 1
            auto &val_arg = args.borrow(i)
            auto r_res = parse_range_spec(val_arg.as_str())
            if r_res.is_err() {
                print_err(r_res.unwrap_err().as_str())
                return 2
            }
            lines_range = Option<BlockRange>::Some(r_res.unwrap())
            i = i + 1
            continue
        }

        if view.starts_with("--lines=") {
            auto val_str = view.substr(8:usize, view.len - 8:usize)
            auto r_res = parse_range_spec(val_str)
            if r_res.is_err() {
                print_err(r_res.unwrap_err().as_str())
                return 2
            }
            lines_range = Option<BlockRange>::Some(r_res.unwrap())
            i = i + 1
            continue
        }

        if view == "--max-lines" {
            if i + 1 >= num_args {
                print_err("Option requires an argument: --max-lines")
                return 2
            }
            i = i + 1
            auto &val_arg = args.borrow(i)
            auto res = parse_usize_val(val_arg.as_str())
            if res.is_err() {
                print_err("Invalid max-lines number")
                return 2
            }
            max_lines_opt = Option<usize>::Some(res.unwrap())
            i = i + 1
            continue
        }

        if view.starts_with("--max-lines=") {
            auto val_str = view.substr(12:usize, view.len - 12:usize)
            auto res = parse_usize_val(val_str)
            if res.is_err() {
                print_err("Invalid max-lines number")
                return 2
            }
            max_lines_opt = Option<usize>::Some(res.unwrap())
            i = i + 1
            continue
        }

        if view == "--max-bytes" || view == "--max-result-bytes" {
            if i + 1 >= num_args {
                auto err_req# = string::from("Option requires an argument: ")
                err_req#.push_str(view)
                print_err(err_req.as_str())
                return 2
            }
            i = i + 1
            auto &val_arg = args.borrow(i)
            auto res = parse_size_bytes_strict(val_arg.as_str(), view)
            if res.is_err() {
                print_err(res.unwrap_err().as_str())
                return 2
            }
            max_bytes_opt = Option<usize>::Some(res.unwrap())
            i = i + 1
            continue
        }

        if view.starts_with("--max-bytes=") {
            auto val_str = view.substr(12:usize, view.len - 12:usize)
            auto res = parse_size_bytes_strict(val_str, "--max-bytes")
            if res.is_err() {
                print_err(res.unwrap_err().as_str())
                return 2
            }
            max_bytes_opt = Option<usize>::Some(res.unwrap())
            i = i + 1
            continue
        }

        if view.starts_with("--max-result-bytes=") {
            auto val_str = view.substr(19:usize, view.len - 19:usize)
            auto res = parse_size_bytes_strict(val_str, "--max-result-bytes")
            if res.is_err() {
                print_err(res.unwrap_err().as_str())
                return 2
            }
            max_bytes_opt = Option<usize>::Some(res.unwrap())
            i = i + 1
            continue
        }

        if view == "--max-columns" {
            if i + 1 >= num_args {
                print_err("Option requires an argument: --max-columns")
                return 2
            }
            i = i + 1
            auto &val_arg = args.borrow(i)
            auto res = parse_usize_val(val_arg.as_str())
            if res.is_err() {
                print_err("Invalid max-columns number")
                return 2
            }
            max_columns_opt = Option<usize>::Some(res.unwrap())
            i = i + 1
            continue
        }

        if view.starts_with("--max-columns=") {
            auto val_str = view.substr(14:usize, view.len - 14:usize)
            auto res = parse_usize_val(val_str)
            if res.is_err() {
                print_err("Invalid max-columns number")
                return 2
            }
            max_columns_opt = Option<usize>::Some(res.unwrap())
            i = i + 1
            continue
        }

        if view == "--max-block-lines" {
            if i + 1 >= num_args {
                print_err("Option requires an argument: --max-block-lines")
                return 2
            }
            i = i + 1
            auto &val_arg = args.borrow(i)
            auto res = parse_usize_val(val_arg.as_str())
            if res.is_err() {
                print_err("Invalid max-block-lines number")
                return 2
            }
            auto parsed_val = res.unwrap()
            if parsed_val == 0 {
                print_err("Invalid max-block-lines number")
                return 2
            }
            max_block_lines = parsed_val
            i = i + 1
            continue
        }

        if view.starts_with("--max-block-lines=") {
            auto val_str = view.substr(18:usize, view.len - 18:usize)
            auto res = parse_usize_val(val_str)
            if res.is_err() {
                print_err("Invalid max-block-lines number")
                return 2
            }
            auto parsed_val = res.unwrap()
            if parsed_val == 0 {
                print_err("Invalid max-block-lines number")
                return 2
            }
            max_block_lines = parsed_val
            i = i + 1
            continue
        }

        if view == "--no-hints" {
            no_hints = true
            i = i + 1
            continue
        }

        if view.starts_with("-") {
            auto err# = string::from("Unknown option '")
            err#.push_str(view)
            err#.push_str("'")
            print_err(err.as_str())
            return 2
        }

        // Positional argument: path or path:line or line
        if path_opt.is_none() {
            auto colon_opt = find_last_colon(view)
            if colon_opt.is_some() {
                auto c_idx = colon_opt.unwrap()
                auto p_slice = view.substr(0, c_idx)
                auto l_slice = view.substr(c_idx + 1, view.len - c_idx - 1)
                auto l_res = parse_usize_val(l_slice)
                if l_res.is_ok() {
                    path_opt = Option<string>::Some(string::from(p_slice))
                    line_opt = Option<usize>::Some(l_res.unwrap())
                    i = i + 1
                    continue
                }
            }
            path_opt = Option<string>::Some(string::from(view))
            i = i + 1
            continue
        } else if line_opt.is_none() && lines_range.is_none() {
            auto l_res = parse_usize_val(view)
            if l_res.is_ok() {
                line_opt = Option<usize>::Some(l_res.unwrap())
                i = i + 1
                continue
            }
        }

        auto err# = string::from("Unexpected argument '")
        err#.push_str(view)
        err#.push_str("'")
        print_err(err.as_str())
        return 2
    }

    if continue_token_opt.is_some() {
        if path_opt.is_some() || line_opt.is_some() || lines_range.is_some() || symbol_raw_opt.is_some() || scope_raw_opt.is_some() || block || context_passed || continuation_flag {
            print_err("Cannot specify target path or query options when using --continue")
            hint_slot#.try_emit(no_hints, "to resume reading, pass only the token: trg view --continue <TOKEN>", Option<str>::None)
            return 2
        }

        auto opts = ViewOptions(
            file_path = string::new(),
            line = Option<usize>::None,
            context = 0:usize,
            block = false,
            lines_range = Option<BlockRange>::None,
            symbol = Option<string>::None,
            symbol_scope = Option<string>::None,
            max_lines = max_lines_opt,
            max_result_bytes = max_bytes_opt,
            max_columns = max_columns_opt,
            max_block_lines = max_block_lines,
            continuation = true,
            continuation_token = cede continue_token_opt,
            no_hints = no_hints
        )

        auto res = execute_view_operation(opts)
        if res.is_err() {
            print_err(res.unwrap_err().as_str())
            return 2
        }

        auto view_res# = res.unwrap()
        view_res#.print_cli_truncation_notice(max_lines_opt, max_bytes_opt, no_hints, hint_slot#)
        auto write_res = posix_write_stdout(view_res.text.as_str())
        if write_res == 2 {
            return 2
        }
        return 0
    }

    if path_opt.is_none() {
        print_err("trg view: missing file path")
        return 2
    }

    auto parsed_symbol# = Option<string>::None
    auto parsed_scope# = Option<string>::None

    if scope_raw_opt.is_some() && symbol_raw_opt.is_none() {
        print_err("--scope cannot be used without --symbol")
        hint_slot#.try_emit(no_hints, "specify a target symbol with --symbol <NAME>", Option<str>::None)
        return 2
    }

    match symbol_raw_opt {
        auto Option<string>::Some(&sym_raw) => {
            auto sym_view = sym_raw.as_str().trim()
            if sym_view.len == 0 {
                print_err("Invalid symbol name: cannot be empty")
                return 2
            }

            if sym_view.starts_with("::") || sym_view.ends_with("::") {
                print_err("Invalid symbol specification: empty scope or symbol name")
                return 2
            }

            auto first_col = sym_view.index_of_str("::")
            if first_col.is_some() {
                auto pos1 = first_col.unwrap()
                auto rem = sym_view.substr(pos1 + 2:usize, sym_view.len - pos1 - 2:usize)
                if rem.index_of_str("::").is_some() {
                    print_err("Invalid symbol specification: nested scopes (e.g. A::B::C) are not supported")
                    return 2
                }
                auto scope_part = sym_view.substr(0, pos1).trim()
                auto name_part = rem.trim()
                if scope_part.len == 0 || name_part.len == 0 {
                    print_err("Invalid symbol specification: empty scope or symbol name")
                    return 2
                }
                match scope_raw_opt {
                    auto Option<string>::Some(&s_arg) => {
                        if s_arg.as_str().trim() != scope_part {
                            print_err("Conflicting scopes specified: --scope does not match symbol scope prefix")
                            hint_slot#.try_emit(no_hints, "specify matching --scope <SCOPE> or omit --scope when using '<SCOPE>::<NAME>'", Option<str>::None)
                            return 2
                        }
                    }
                    auto Option<string>::None => {}
                }
                parsed_symbol = Option<string>::Some(string::from(name_part))
                parsed_scope = Option<string>::Some(string::from(scope_part))
            } else {
                parsed_symbol = Option<string>::Some(string::from(sym_view))
                match scope_raw_opt {
                    auto Option<string>::Some(&sr) => {
                        auto sr_trim = sr.as_str().trim()
                        if sr_trim.len == 0 {
                            print_err("Invalid scope name: cannot be empty")
                            return 2
                        }
                        parsed_scope = Option<string>::Some(string::from(sr_trim))
                    }
                    auto Option<string>::None => {}
                }
            }
        }
        auto Option<string>::None => {}
    }

    if parsed_symbol.is_some() {
        if context_passed {
            print_err("--symbol cannot be used with -C / --context")
            hint_slot#.try_emit(no_hints, "use line-based view with context: trg view <path>:<line> -C <NUM>", Option<str>::None)
            return 2
        }
        if block {
            print_err("--symbol cannot be used with --block")
            hint_slot#.try_emit(no_hints, "use line-based block view: trg view <path>:<line> --block", Option<str>::None)
            return 2
        }
        if lines_range.is_some() {
            print_err("--symbol cannot be used with --lines")
            hint_slot#.try_emit(no_hints, "use explicit line range view: trg view <path> --lines <M-N>", Option<str>::None)
            return 2
        }
        if line_opt.is_some() {
            print_err("--symbol cannot be used with target line (<path>:<line>)")
            hint_slot#.try_emit(no_hints, "use either symbol view (trg view <path> --symbol <NAME>) or line view (trg view <path>:<line>)", Option<str>::None)
            return 2
        }
    }

    if parsed_symbol.is_none() && line_opt.is_none() && lines_range.is_none() {
        print_err("trg view: viewing requires a target line number (e.g. <path>:<line>), --lines, or --symbol")
        hint_slot#.try_emit(no_hints, "specify a target line (e.g. trg view path/to/file.tk:42) or --symbol <NAME>", Option<str>::None)
        return 2
    }

    auto raw_path = path_opt.unwrap()
    auto startup_cwd = normalize_cwd(env::current_dir().as_str())
    auto id_res = compute_identity_key(startup_cwd.as_str(), raw_path.as_str())
    if id_res.is_err() {
        auto err# = string::from("trg: ")
        err#.push_str(raw_path.as_str())
        err#.push_str(": Failed to resolve target path")
        print_err(err.as_str())
        return 2
    }
    auto final_file_path = id_res.unwrap()

    auto opts = ViewOptions(
        file_path = cede final_file_path,
        line = line_opt,
        context = context,
        block = block,
        lines_range = lines_range,
        symbol = cede parsed_symbol,
        symbol_scope = cede parsed_scope,
        max_lines = max_lines_opt,
        max_result_bytes = max_bytes_opt,
        max_columns = max_columns_opt,
        max_block_lines = max_block_lines,
        continuation = continuation_flag,
        continuation_token = Option<string>::None,
        no_hints = no_hints
    )

    auto res = execute_view_operation(opts)
    if res.is_err() {
        print_err(res.unwrap_err().as_str())
        return 2
    }

    auto view_res# = res.unwrap()
    if view_res.mode == "symbol" {
        if view_res.selection_status == "not_found" {
            print_err(view_res.text.as_str())
            return 1
        }
        if view_res.selection_status == "multiple_candidates" ||
           view_res.selection_status == "unsupported_syntax" ||
           view_res.selection_status == "scan_incomplete" ||
           view_res.selection_status == "io_error" {
            print_err(view_res.text.as_str())
            return 2
        }
    }

    auto is_explicit_budget = max_lines_opt.is_some() || max_bytes_opt.is_some()
    auto is_symbol_mode = (view_res.mode == "symbol") && (view_res.selection_status == "found")
    auto is_budget_truncated = view_res.truncated && ((view_res.reason == "max_lines") || (view_res.reason == "max_result_bytes"))
    auto use_bounded_preview = is_symbol_mode && is_explicit_budget && is_budget_truncated && !continuation_flag

    auto preview_proj_opt# = Option<CliSymbolPreviewProjection>::None
    if use_bounded_preview {
        auto prev_res = view_res#.format_cli_symbol_preview(max_lines_opt, max_bytes_opt)
        if prev_res.is_err() {
            print_err(prev_res.unwrap_err().as_str())
            return 2
        }
        preview_proj_opt = Option<CliSymbolPreviewProjection>::Some(prev_res.unwrap())
    }

    view_res#.print_cli_truncation_notice(max_lines_opt, max_bytes_opt, no_hints, hint_slot#)
    auto write_res# = 0
    match preview_proj_opt {
        auto Option<CliSymbolPreviewProjection>::Some(&proj) => {
            write_res = posix_write_stdout(proj.text.as_str())
        }
        auto Option<CliSymbolPreviewProjection>::None => {
            write_res = posix_write_stdout(view_res.text.as_str())
        }
    }
    if write_res == 2 {
        return 2
    }

    if use_bounded_preview && hint_slot#.can_emit(no_hints) {
        match preview_proj_opt {
            auto Option<CliSymbolPreviewProjection>::Some(&proj) => {
                auto sym_hint_opt# = Option<Hint>::None
                if proj.has_rear_omitted {
                    sym_hint_opt = build_symbol_preview_truncation_hint(
                        opts.file_path.as_str(),
                        proj.rear_omitted_start,
                        proj.rear_omitted_end,
                        max_lines_opt,
                        max_bytes_opt,
                        true
                    )
                } else if proj.has_front_omitted {
                    sym_hint_opt = build_symbol_preview_truncation_hint(
                        opts.file_path.as_str(),
                        proj.front_omitted_start,
                        proj.front_omitted_end,
                        max_lines_opt,
                        max_bytes_opt,
                        false
                    )
                }
                match sym_hint_opt {
                    auto Option<Hint>::Some(&h) => {
                        hint_slot#.try_emit(no_hints, h.message.as_str(), Option<str>::Some(h.command.as_str()))
                    }
                    auto Option<Hint>::None => {}
                }
            }
            auto Option<CliSymbolPreviewProjection>::None => {}
        }
    }
    return 0
}
