// Syntax and lexical analysis for trg: definitions, scopes, and delimiters.
import core/str::{str}
import std/vec::{Vec}
import src/types::{ScopeFrame, SyntaxFamily}
import src/matcher::{SearchPlan}
import src/file_types::{extract_file_extension}

pub fn utf8_truncate_len(s: str, max_bytes: usize) -> usize {
    if s.len <= max_bytes {
        return s.len
    }
    auto cut# = max_bytes
    loop cut > 0 && (((s.byte_at(cut) as u8) & 0xC0:u8) == 0x80:u8) {
        cut = cut - 1
    }
    return cut
}

pub fn detect_syntax_family(path: str) -> SyntaxFamily {
    auto ext = extract_file_extension(path)
    if ext == "py" || ext == "pyi" || ext == "yaml" || ext == "yml" || ext == "nim" {
        return SyntaxFamily::Indent
    }
    return SyntaxFamily::Brace
}

pub fn compute_line_indent(line: str) -> usize {
    auto indent# = 0:usize
    auto i# = 0:usize
    loop i < line.len {
        auto ch = line.byte_at(i)
        if ch == (' ' as char) {
            indent = indent + 1
        } else if ch == ('\t' as char) {
            indent = indent + 4
        } else {
            break
        }
        i = i + 1
    }
    return indent
}

pub fn update_brace_depth(line: str, depth#: usize) {
    auto in_str# = false
    auto str_char# = 0:char
    auto escape# = false
    auto i# = 0:usize

    loop i < line.len {
        auto ch = line.byte_at(i)

        if in_str {
            if escape {
                escape = false
            } else if ch == ('\\' as char) {
                escape = true
            } else if ch == str_char {
                in_str = false
            }
            i = i + 1
            continue
        }

        if ch == ('"' as char) || ch == ('\'' as char) || ch == ('`' as char) {
            in_str = true
            str_char = ch
            escape = false
            i = i + 1
            continue
        }

        if ch == ('/' as char) && i + 1 < line.len && line.byte_at(i + 1) == ('/' as char) {
            break
        }
        if ch == ('#' as char) {
            break
        }

        if ch == ('{' as char) {
            depth = depth + 1
        } else if ch == ('}' as char) {
            if depth > 0 {
                depth = depth - 1
            }
        }

        i = i + 1
    }
}

pub fn extract_declared_identifier(line: str) -> string {
    auto trimmed = line.trim()
    if trimmed.len == 0 || trimmed.starts_with("#") || trimmed.starts_with("//") {
        return string::from("")
    }
    auto s# = trimmed
    if s.starts_with("pub ") {
        s = s.substr(4:usize, s.len - 4:usize).trim()
    } else if s.starts_with("pub(") {
        auto close_paren = s.index_of(')' as char)
        if close_paren.is_some() {
            auto idx = close_paren.unwrap() + 1:usize
            s = s.substr(idx, s.len - idx).trim()
        }
    }
    if s.starts_with("export default ") {
        s = s.substr(15:usize, s.len - 15:usize).trim()
    } else if s.starts_with("export ") {
        s = s.substr(7:usize, s.len - 7:usize).trim()
    }
    if s.starts_with("async ") {
        s = s.substr(6:usize, s.len - 6:usize).trim()
    }
    if s.starts_with("inline ") {
        s = s.substr(7:usize, s.len - 7:usize).trim()
    }

    auto kw_len# = 0:usize
    auto is_impl# = false
    if s.starts_with("fn ") { kw_len = 3:usize }
    else if s.starts_with("def ") { kw_len = 4:usize }
    else if s.starts_with("func ") { kw_len = 5:usize }
    else if s.starts_with("function ") { kw_len = 9:usize }
    else if s.starts_with("class ") { kw_len = 6:usize }
    else if s.starts_with("struct ") { kw_len = 7:usize }
    else if s.starts_with("shape ") { kw_len = 6:usize }
    else if s.starts_with("interface ") { kw_len = 10:usize }
    else if s.starts_with("type ") { kw_len = 5:usize }
    else if s.starts_with("enum ") { kw_len = 5:usize }
    else if s.starts_with("trait ") { kw_len = 6:usize }
    else if s.starts_with("impl ") { kw_len = 5:usize; is_impl = true }
    else { return string::from("") }

    auto rem# = s.substr(kw_len, s.len - kw_len).trim()

    if rem.starts_with("<") {
        auto g_depth# = 0:usize
        auto g_idx# = 0:usize
        loop g_idx < rem.len {
            auto c = rem.byte_at(g_idx)
            if c == ('<' as char) {
                g_depth = g_depth + 1
            } else if c == ('>' as char) {
                if g_depth > 0 { g_depth = g_depth - 1 }
                if g_depth == 0 {
                    g_idx = g_idx + 1
                    break
                }
            }
            g_idx = g_idx + 1
        }
        rem = rem.substr(g_idx, rem.len - g_idx).trim()
    }

    if is_impl {
        auto for_opt = rem.index_of_str(" for ")
        if for_opt.is_some() {
            auto for_idx = for_opt.unwrap() + 5:usize
            rem = rem.substr(for_idx, rem.len - for_idx).trim()
        }
    }

    auto id_end# = 0:usize
    loop id_end < rem.len {
        auto c = rem.byte_at(id_end)
        auto is_valid_char = (c >= ('a' as char) && c <= ('z' as char)) ||
                             (c >= ('A' as char) && c <= ('Z' as char)) ||
                             (c >= ('0' as char) && c <= ('9' as char)) ||
                             c == ('_' as char)
        if !is_valid_char {
            break
        }
        id_end = id_end + 1
    }
    if id_end == 0 {
        return string::from("")
    }
    return string::from(rem.substr(0, id_end))
}

pub fn is_defining_symbol(line: str, plan: SearchPlan) -> bool {
    auto id = extract_declared_identifier(line)
    if id.len() == 0 {
        return false
    }
    return plan.is_match(id.as_str())
}

pub fn is_definition_line(line: str) -> bool {
    auto trimmed = line.trim()
    if trimmed.len == 0 || trimmed.starts_with("#") || trimmed.starts_with("//") {
        return false
    }
    auto s# = trimmed
    if s.starts_with("pub ") {
        s = s.substr(4:usize, s.len - 4:usize).trim()
    } else if s.starts_with("pub(") {
        auto close_paren = s.index_of(')' as char)
        if close_paren.is_some() {
            auto idx = close_paren.unwrap() + 1:usize
            s = s.substr(idx, s.len - idx).trim()
        }
    }
    if s.starts_with("async ") {
        s = s.substr(6:usize, s.len - 6:usize).trim()
    }

    if s.starts_with("fn ") || s.starts_with("def ") || s.starts_with("class ") ||
       s.starts_with("struct ") || s.starts_with("shape ") || s.starts_with("interface ") ||
       s.starts_with("type ") || s.starts_with("impl ") || s.starts_with("function ") {
        return true
    }
    return false
}

pub fn detect_declaration_scope(line: str) -> string {
    auto trimmed = line.trim()
    if !is_definition_line(trimmed) {
        return string::from("")
    }
    auto max_len# = trimmed.len
    auto paren_depth# = 0:usize
    auto i# = 0:usize
    loop i < trimmed.len {
        auto ch = trimmed.byte_at(i)
        if ch == ('(' as char) {
            paren_depth = paren_depth + 1
        } else if ch == (')' as char) {
            if paren_depth > 0 { paren_depth = paren_depth - 1 }
        } else if paren_depth == 0 {
            if ch == ('{' as char) {
                max_len = i
                break
            } else if ch == (':' as char) {
                max_len = i
                break
            }
        }
        i = i + 1
    }
    auto decl_sub# = trimmed.substr(0, max_len).trim()
    if decl_sub.len > 60 {
        auto cut = utf8_truncate_len(decl_sub, 60:usize)
        decl_sub = decl_sub.substr(0, cut).trim()
    }
    return string::from(decl_sub)
}

pub shape ScopeTracker (
    frames: Vec<ScopeFrame>
)

impl ScopeTracker {
    pub fn new() -> ScopeTracker {
        return ScopeTracker(frames = Vec<ScopeFrame>::new())
    }

    pub fn update(self#, line: str, brace_depth: usize, indent_level: usize, family: SyntaxFamily) {
        loop true {
            if self.frames.len() == 0 {
                break
            }
            auto top_idx = self.frames.len() - 1:usize
            auto top_depth = self.frames.borrow(top_idx).depth
            match family {
                auto SyntaxFamily::Indent => {
                    auto trimmed = line.trim()
                    if trimmed.len > 0 && !trimmed.starts_with("#") {
                        if indent_level <= top_depth {
                            self.frames#.pop()
                            continue
                        }
                    }
                }
                auto SyntaxFamily::Brace => {
                    if brace_depth < top_depth {
                        self.frames#.pop()
                        continue
                    }
                }
            }
            break
        }

        auto scope_decl = detect_declaration_scope(line)
        if scope_decl.len() > 0 {
            auto decl_depth# = brace_depth
            match family {
                auto SyntaxFamily::Indent => {
                    decl_depth = indent_level
                }
                auto SyntaxFamily::Brace => {}
            }
            self.frames#.push(ScopeFrame(name = cede scope_decl, depth = decl_depth))
        }
    }

    pub fn current_scope(self) -> string {
        if self.frames.len() == 0 {
            return string::from("")
        }
        auto top_idx = self.frames.len() - 1:usize
        return self.frames.borrow(top_idx).name.clone()
    }
}
