// KWIC snippet view and match window fusion for trg.
import core/str::{str}
import std/vec::{Vec}
import src/types::{SubMatch}

fn align_utf8_start(line: str, start: usize) -> usize {
    auto s# = start
    loop s > 0 && (((line.byte_at(s) as u8) & 0xC0:u8) == 0x80:u8) {
        s = s - 1
    }
    return s
}

fn align_utf8_end(line: str, end: usize) -> usize {
    auto e# = end
    loop e < line.len && (((line.byte_at(e) as u8) & 0xC0:u8) == 0x80:u8) {
        e = e + 1
    }
    return e
}

pub shape KwicSnippetResult (
    text: string,
    submatches: Vec<SubMatch>
)

pub fn compute_kwic_snippet(line: str, submatches: Vec<SubMatch>, snippet_chars: usize) -> KwicSnippetResult {
    if line.len == 0 {
        return KwicSnippetResult(text = string::from(""), submatches = Vec<SubMatch>::new())
    }
    if submatches.len() == 0 {
        return KwicSnippetResult(text = string::from(line), submatches = Vec<SubMatch>::new())
    }

    auto L = line.len
    auto raw_starts# = Vec<usize>::new()
    auto raw_ends# = Vec<usize>::new()

    auto i# = 0:usize
    loop i < submatches.len() {
        auto &sm = submatches.borrow(i)
        auto raw_start# = 0:usize
        if sm.start > snippet_chars {
            raw_start = sm.start - snippet_chars
        }
        auto raw_end# = L
        if sm.end + snippet_chars < L {
            raw_end = sm.end + snippet_chars
        }
        auto win_start = align_utf8_start(line, raw_start)
        auto win_end = align_utf8_end(line, raw_end)
        raw_starts#.push(win_start)
        raw_ends#.push(win_end)
        i = i + 1
    }

    if raw_starts.len() == 0 {
        auto empty_sms# = Vec<SubMatch>::new()
        auto smi# = 0:usize
        loop smi < submatches.len() {
            empty_sms#.push(submatches.borrow(smi).clone())
            smi = smi + 1
        }
        return KwicSnippetResult(text = string::from(line), submatches = cede empty_sms)
    }

    auto merged_starts# = Vec<usize>::new()
    auto merged_ends# = Vec<usize>::new()

    auto cur_start# = raw_starts.get(0)
    auto cur_end# = raw_ends.get(0)

    auto wi# = 1:usize
    loop wi < raw_starts.len() {
        auto n_start = raw_starts.get(wi)
        auto n_end = raw_ends.get(wi)
        if n_start <= cur_end + 10 {
            if n_end > cur_end {
                cur_end = n_end
            }
        } else {
            merged_starts#.push(cur_start)
            merged_ends#.push(cur_end)
            cur_start = n_start
            cur_end = n_end
        }
        wi = wi + 1
    }
    merged_starts#.push(cur_start)
    merged_ends#.push(cur_end)

    auto out# = string::from("")
    auto win_out_starts# = Vec<usize>::new()
    auto cur_out_offset# = 0:usize

    if merged_starts.get(0) > 0 {
        out#.push_str("...")
        cur_out_offset = 3:usize
    }

    auto mi# = 0:usize
    loop mi < merged_starts.len() {
        if mi > 0 {
            out#.push_str(" [...] ")
            cur_out_offset = cur_out_offset + 7:usize
        }
        auto w_start = merged_starts.get(mi)
        auto w_end = merged_ends.get(mi)
        win_out_starts#.push(cur_out_offset)
        auto slice = line.substr(w_start, w_end - w_start)
        out#.push_str(slice)
        cur_out_offset = cur_out_offset + (w_end - w_start)
        mi = mi + 1
    }

    auto last_end = merged_ends.get(merged_ends.len() - 1)
    if last_end < L {
        out#.push_str("...")
    }

    auto new_submatches# = Vec<SubMatch>::new()
    auto si# = 0:usize
    loop si < submatches.len() {
        auto &sm = submatches.borrow(si)
        auto w_idx# = 0:usize
        loop w_idx < merged_starts.len() {
            auto ms = merged_starts.get(w_idx)
            auto me = merged_ends.get(w_idx)
            if sm.start >= ms && sm.end <= me {
                auto win_out_start = win_out_starts.get(w_idx)
                auto new_start = win_out_start + (sm.start - ms)
                auto new_end = new_start + (sm.end - sm.start)
                new_submatches#.push(SubMatch(
                    match_text = sm.match_text.clone(),
                    start = new_start,
                    end = new_end
                ))
                break
            }
            w_idx = w_idx + 1:usize
        }
        si = si + 1:usize
    }

    return KwicSnippetResult(
        text = cede out,
        submatches = cede new_submatches
    )
}

pub fn format_kwic_snippet(line: str, submatches: Vec<SubMatch>, snippet_chars: usize) -> string {
    auto res = compute_kwic_snippet(line, submatches, snippet_chars)
    return res.text
}
