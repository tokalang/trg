// Unified Search Executor for trg.
import core/str::{str}
import core/option::{Option}
import std/vec::{Vec}
import std/env as env
import src/types::{
    CliOptions,
    BudgetState,
    FileRunState,
    SearchReport,
    GlobalStats,
    ScanPass,
    OutputFormat,
    SearchDiagnostic,
    TextLayout,
    PathStyle,
    OutputMode
}
import src/matcher::{SearchPlan}
import src/walker::{collect_search_targets}
import src/scanner::{scan_file_stream_with_pass}
import src/posix::{posix_isatty}
import src/path_norm::{resolve_path, normalize_cwd}
import src/printer::{
    OutputBudgetWriter,
    OutputBatch,
    FileFrameState,
    EmitOutcome,
    format_summary_json,
    format_summary_json_compact
}

pub fn execute_files_mode(
    opts: CliOptions,
    writer#: OutputBudgetWriter
) -> Result<SearchReport, SearchDiagnostic> {
    auto walk_res = collect_search_targets(opts)
    auto global_had_error# = walk_res.had_error
    auto files = cede walk_res.files
    auto num_files = files.len()
    auto all_diagnostics# = cede walk_res.diagnostics

    auto budget_state# = BudgetState::new(opts.budget_limits)
    budget_state.files_selected = num_files

    if opts.quiet {
        auto found = num_files > 0
        return Result<SearchReport, SearchDiagnostic>::Ok(SearchReport(
            found_result = found,
            had_error = global_had_error,
            is_broken_pipe = false,
            budget_state = cede budget_state,
            elapsed_nanos = 0:u64,
            diagnostics = cede all_diagnostics
        ))
    }

    auto startup_cwd = normalize_cwd(env::current_dir().as_str())
    auto f_idx# = 0:usize
    auto is_broken_pipe# = false
    loop f_idx < num_files {
        if budget_state.is_truncated { break }
        auto &path_str = files.borrow(f_idx)
        auto resolved = resolve_path(startup_cwd.as_str(), path_str.as_str(), opts.path_style)
        auto outcome = writer#.emit_files_mode_path(budget_state#, resolved.display_path.as_str())
        match outcome {
            EmitOutcome::Written => {}
            EmitOutcome::Truncated => { break }
            EmitOutcome::BrokenPipe => {
                is_broken_pipe = true
                break
            }
            EmitOutcome::FatalError => {
                global_had_error = true
                break
            }
        }
        f_idx = f_idx + 1
    }

    auto found = f_idx > 0
    return Result<SearchReport, SearchDiagnostic>::Ok(SearchReport(
        found_result = found,
        had_error = global_had_error,
        is_broken_pipe = is_broken_pipe,
        budget_state = cede budget_state,
        elapsed_nanos = 0:u64,
        diagnostics = cede all_diagnostics
    ))
}

pub fn execute_search(
    opts: CliOptions,
    writer#: OutputBudgetWriter
) -> Result<SearchReport, SearchDiagnostic> {
    if opts.files_mode {
        return execute_files_mode(opts, writer#)
    }

    // Fail-fast on regex/plan compilation before touching filesystem
    auto plan_res = SearchPlan::create(opts)
    if plan_res.is_err() {
        return Result<SearchReport, SearchDiagnostic>::Err(SearchDiagnostic::new(
            string::from("regex"),
            Option<string>::None,
            plan_res.unwrap_err(),
            Option<i32>::None
        ))
    }
    auto plan = plan_res.unwrap()

    auto walk_res = collect_search_targets(opts)
    auto global_had_error# = walk_res.had_error
    auto files = cede walk_res.files
    auto num_files = files.len()
    auto all_diagnostics# = cede walk_res.diagnostics

    auto budget_state# = BudgetState::new(opts.budget_limits)
    budget_state.files_selected = num_files

    auto multiple_files = num_files > 1 || opts.paths.len() > 1

    auto resolved_layout# = opts.text_layout
    match opts.text_layout {
        auto TextLayout::Auto => {
            if writer.mode == OutputMode::McpCollecting {
                resolved_layout = TextLayout::Grouped
            } else if posix_isatty(1:i32) && multiple_files {
                resolved_layout = TextLayout::Grouped
            } else {
                resolved_layout = TextLayout::Flat
            }
        }
        _ => {}
    }

    auto effective_with_filename# = false
    match opts.with_filename {
        auto Option<bool>::Some(wf) => {
            effective_with_filename = wf
        }
        _ => {
            if writer.mode == OutputMode::McpCollecting {
                effective_with_filename = true
            } else {
                effective_with_filename = multiple_files
            }
        }
    }
    writer#.set_effective_projection(resolved_layout, opts.path_style, effective_with_filename)

    if num_files == 0 {
        return Result<SearchReport, SearchDiagnostic>::Ok(SearchReport(
            found_result = false,
            had_error = global_had_error,
            is_broken_pipe = false,
            budget_state = cede budget_state,
            elapsed_nanos = 0:u64,
            diagnostics = cede all_diagnostics
        ))
    }
    auto broken_pipe_occurred# = false
    auto found_any_match# = false

    auto file_states# = Vec<FileRunState>::with_capacity(num_files)
    auto init_idx# = 0:usize
    loop init_idx < num_files {
        file_states#.push(FileRunState::new())
        init_idx = init_idx + 1
    }

    if opts.def_first {
        auto i# = 0:usize
        loop i < num_files {
            if budget_state.is_truncated {
                break
            }
            auto &target_file = files.borrow(i)
            auto is_stdin = target_file.as_str() == "-"
            auto cur_pass# = ScanPass::DefinitionsOnly
            if is_stdin {
                cur_pass = ScanPass::All
            }
            auto is_bp# = false
            auto had_err# = false
            auto has_m# = false
            {
                auto &f_state# = file_states#.borrow_mut(i)
                auto scan_res# = scan_file_stream_with_pass(target_file.clone(), opts, plan, multiple_files, writer#, budget_state#, cur_pass, f_state#)
                is_bp = scan_res.is_broken_pipe
                had_err = scan_res.had_error
                has_m = !scan_res.is_binary && !scan_res.had_error && scan_res.has_match
                auto num_diag = scan_res.diagnostics.len()
                auto di# = 0:usize
                loop di < num_diag {
                    auto d = scan_res.diagnostics#.pop().unwrap()
                    all_diagnostics#.push(cede d)
                    di = di + 1
                }
            }

            if had_err {
                global_had_error = true
            }
            if is_bp {
                broken_pipe_occurred = true
                break
            }
            if has_m {
                found_any_match = true
                if opts.quiet {
                    break
                }
            }

            i = i + 1
        }

        if !budget_state.is_truncated && !broken_pipe_occurred && !(opts.quiet && found_any_match) {
            writer#.reset_active_segment()
            auto j# = 0:usize
            loop j < num_files {
                if budget_state.is_truncated {
                    break
                }
                auto &target_file = files.borrow(j)
                auto is_stdin = target_file.as_str() == "-"
                if !is_stdin {
                    auto is_bp# = false
                    auto had_err# = false
                    auto has_m# = false
                    {
                        auto &f_state# = file_states#.borrow_mut(j)
                        auto scan_res# = scan_file_stream_with_pass(target_file.clone(), opts, plan, multiple_files, writer#, budget_state#, ScanPass::UsagesOnly, f_state#)
                        is_bp = scan_res.is_broken_pipe
                        had_err = scan_res.had_error
                        has_m = !scan_res.is_binary && !scan_res.had_error && scan_res.has_match
                        loop scan_res.diagnostics.len() > 0 {
                            auto d = scan_res.diagnostics#.pop().unwrap()
                            all_diagnostics#.push(cede d)
                        }
                    }

                    if had_err {
                        global_had_error = true
                    }
                    if is_bp {
                        broken_pipe_occurred = true
                        break
                    }
                    if has_m {
                        found_any_match = true
                        if opts.quiet {
                            break
                        }
                    }
                }

                j = j + 1
            }
        }
    } else {
        auto i# = 0:usize
        loop i < num_files {
            if budget_state.is_truncated {
                break
            }
            auto &target_file = files.borrow(i)
            auto is_bp# = false
            auto had_err# = false
            auto has_m# = false
            {
                auto &f_state# = file_states#.borrow_mut(i)
                auto scan_res# = scan_file_stream_with_pass(target_file.clone(), opts, plan, multiple_files, writer#, budget_state#, ScanPass::All, f_state#)
                is_bp = scan_res.is_broken_pipe
                had_err = scan_res.had_error
                has_m = !scan_res.is_binary && !scan_res.had_error && scan_res.has_match
                auto num_diag = scan_res.diagnostics.len()
                auto di# = 0:usize
                loop di < num_diag {
                    auto d = scan_res.diagnostics#.pop().unwrap()
                    all_diagnostics#.push(cede d)
                    di = di + 1
                }
            }

            if had_err {
                global_had_error = true
            }
            if is_bp {
                broken_pipe_occurred = true
                break
            }
            if has_m {
                found_any_match = true
                if opts.quiet {
                    break
                }
            }

            i = i + 1
        }
    }

    auto found = found_any_match || budget_state.matched_lines_observed > 0
    return Result<SearchReport, SearchDiagnostic>::Ok(SearchReport(
        found_result = found,
        had_error = global_had_error,
        is_broken_pipe = broken_pipe_occurred,
        budget_state = cede budget_state,
        elapsed_nanos = 0:u64,
        diagnostics = cede all_diagnostics
    ))
}

pub fn finalize_search(
    opts: CliOptions,
    writer#: OutputBudgetWriter,
    report: SearchReport
) -> EmitOutcome {
    if !opts.json_mode {
        return EmitOutcome::Written
    }
    auto legacy_files# = report.budget_state.files_with_match_emitted
    auto legacy_matches# = report.budget_state.matched_lines_emitted
    if opts.quiet {
        legacy_files = report.budget_state.files_with_match_observed
        legacy_matches = report.budget_state.matched_lines_observed
    }
    auto stats = GlobalStats(
        total_files = report.budget_state.files_selected,
        files_with_match = legacy_files,
        total_matches = legacy_matches,
        elapsed_nanos = report.elapsed_nanos
    )
    auto sum_str# = string::new()
    if opts.json_compact {
        sum_str = format_summary_json_compact(stats, report.budget_state, report.had_error)
    } else {
        sum_str = format_summary_json(stats, report.budget_state, report.had_error)
    }
    return writer#.write_raw(sum_str.as_str())
}
