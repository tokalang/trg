// Portable POSIX bridge for trg: portable readlink symlink detection, toka_stat, ferror, fallible readdir, and EPIPE/EINTR stdout.
import core/types::{usize, Addr, ADDR0, char}
import core/result::{Result}
import core/option::{Option}
import sys/os/fs as sys_fs
import sys/os/base as sys_base

extern fn toka_get_errno_impl() -> i32
extern fn toka_set_errno_impl(err: i32) -> void
extern fn toka_get_last_error() -> i32
extern fn toka_setmode(fd: i32, mode: i32) -> i32

extern fn isatty(fd: i32) -> i32
extern fn read(fd: i32, *buf: void, count: usize) -> isize
extern fn write(fd: i32, *buf: void, count: usize) -> isize
extern fn close(fd: i32) -> i32
extern fn signal(sig: i32, handler: usize) -> usize
extern fn readlink(*path: char, *buf: char, bufsiz: usize) -> isize
extern fn realpath(*path: char, *resolved_path: char) -> Addr
extern fn ferror(*stream: void) -> i32
extern fn trg_win_clear_last_error() -> void
extern fn trg_win_classify_reparse(*path: char) -> i32
extern fn trg_win_is_readable_stdin() -> i32


pub fn posix_close(fd: i32) -> i32 {
    unsafe {
        return close(fd)
    }
}

pub shape StatInfo (
    mode: u32,
    size: u64,
    mtime: i64,
    is_dir: bool,
    is_file: bool,
    is_symlink: bool
)

pub fn is_windows_target() -> bool {
    return sys_base::path_sep() == ('\\' as char)
}

pub fn posix_init_signals() {
    unsafe {
        // Set standard streams to binary mode on Windows (0x8000 = _O_BINARY), no-op on Unix
        toka_setmode(0:i32, 32768:i32)
        toka_setmode(1:i32, 32768:i32)
        toka_setmode(2:i32, 32768:i32)
        // Ignore SIGPIPE (13) on POSIX so that writing to a closed pipe returns EPIPE instead of crashing
        signal(13:i32, 1:usize)
    }
}

pub fn posix_ferror(stream: Addr) -> bool {
    unsafe {
        auto *fp = stream as *void
        return ferror(*fp) != 0
    }
}

// Retrieves CRT errno
pub fn posix_get_crt_errno() -> i32 {
    unsafe {
        return toka_get_errno_impl()
    }
}

pub fn posix_clear_crt_errno() {
    unsafe {
        toka_set_errno_impl(0:i32)
    }
}

// Retrieves target OS/system error (Win32 GetLastError on Windows, errno on Unix)
pub fn posix_get_system_error() -> i32 {
    unsafe {
        return toka_get_last_error()
    }
}

pub fn posix_clear_system_error() {
    unsafe {
        if is_windows_target() {
            trg_win_clear_last_error()
        } else {
            toka_set_errno_impl(0:i32)
        }
    }
}

pub fn posix_clear_errno() {
    posix_clear_crt_errno()
}

pub fn posix_get_errno() -> i32 {
    return posix_get_system_error()
}

pub fn posix_stat(path: string) -> Result<StatInfo, i32> {
    auto *cpath = path.c_str()
    unsafe {
        if is_windows_target() {
            auto reparse_cls = trg_win_classify_reparse(*cpath as Addr as *char)
            if reparse_cls == 1:i32 {
                // Symlink / junction / directory reparse point to skip
                return Result<StatInfo, i32>::Ok(StatInfo(
                    mode = 40960:u32, // S_IFLNK
                    size = 0:u64,
                    mtime = 0:i64,
                    is_dir = false,
                    is_file = false,
                    is_symlink = true
                ))
            } else if reparse_cls < 0:i32 {
                // Detection failure: do not treat as normal object!
                auto err# = toka_get_last_error()
                if err == 0:i32 {
                    if reparse_cls == -2:i32 {
                        err = 2:i32 // ERROR_FILE_NOT_FOUND
                    } else {
                        err = 5:i32 // ERROR_ACCESS_DENIED
                    }
                }
                return Result<StatInfo, i32>::Err(err)
            }
            // reparse_cls == 0: normal object, proceed to runtime stat
        } else {
            auto link_buf = [0:char; 1024]
            auto *buf_ptr = &link_buf[0] as *char
            auto link_len = readlink(*cpath, *buf_ptr, 1024:usize)
            if link_len > 0 {
                // Symlink confirmed via portable readlink()
                return Result<StatInfo, i32>::Ok(StatInfo(
                    mode = 40960:u32, // S_IFLNK
                    size = 0:u64,
                    mtime = 0:i64,
                    is_dir = false,
                    is_file = false,
                    is_symlink = true
                ))
            }
        }

        // Not a symlink: query target metadata via portable runtime stat
        posix_clear_system_error()
        auto stat_ptr = sys_fs::stat_impl(*cpath as Addr)
        if stat_ptr == ADDR0 {
            auto err# = posix_get_system_error()
            if err == 0:i32 { err = 2:i32 }
            return Result<StatInfo, i32>::Err(err)
        }

        auto mode = sys_fs::stat_get_mode_impl(stat_ptr)
        auto size = sys_fs::stat_get_size_impl(stat_ptr)
        auto mtime = sys_fs::stat_get_mtime_impl(stat_ptr)
        auto is_dir = sys_fs::stat_is_dir_impl(mode)
        auto is_file = sys_fs::stat_is_file_impl(mode)
        sys_fs::stat_free_impl(stat_ptr)

        return Result<StatInfo, i32>::Ok(StatInfo(
            mode = mode,
            size = size,
            mtime = mtime,
            is_dir = is_dir,
            is_file = is_file,
            is_symlink = false
        ))
    }
}

pub fn posix_opendir(path: string) -> Result<Addr, i32> {
    auto *cpath = path.c_str()
    unsafe {
        posix_clear_system_error()
        auto dir = sys_fs::opendir_impl(*cpath as Addr)
        if dir == ADDR0 {
            auto err# = posix_get_system_error()
            if err == 0:i32 { err = 2:i32 }
            return Result<Addr, i32>::Err(err)
        }
        return Result<Addr, i32>::Ok(dir)
    }
}

pub fn posix_readdir(dir: Addr) -> Result<Option<string>, i32> {
    unsafe {
        loop true {
            posix_clear_system_error()
            posix_clear_crt_errno()
            auto entry_opt = sys_fs::readdir_impl(dir)
            match cede entry_opt {
                auto Option<string>::Some('name) => {
                    if 'name.as_str() != "." && 'name.as_str() != ".." {
                        return Result<Option<string>, i32>::Ok(Option<string>::Some(cede 'name))
                    }
                }
                Option<string>::None => {
                    if is_windows_target() {
                        auto err = posix_get_system_error()
                        // On Windows, FindNextFileW returning FALSE sets GetLastError to ERROR_NO_MORE_FILES (18).
                        // 0 is also clean EOF. Any other code (including ERROR_ACCESS_DENIED, etc.) is a real error.
                        // We strictly check for 18, and do NOT swallow error 2 (ERROR_FILE_NOT_FOUND) or others!
                        if err != 0:i32 && err != 18:i32 {
                            return Result<Option<string>, i32>::Err(err)
                        }
                        return Result<Option<string>, i32>::Ok(Option<string>::None)
                    } else {
                        // On POSIX, readdir at EOF leaves errno unchanged (0).
                        // An error sets errno != 0.
                        auto err = posix_get_crt_errno()
                        if err != 0:i32 {
                            return Result<Option<string>, i32>::Err(err)
                        }
                        return Result<Option<string>, i32>::Ok(Option<string>::None)
                    }
                }
            }
        }
        return Result<Option<string>, i32>::Ok(Option<string>::None)
    }
}

pub fn posix_closedir(dir: Addr) {
    unsafe {
        sys_fs::closedir_impl(dir)
    }
}

pub fn posix_isatty(fd: i32) -> bool {
    unsafe {
        return isatty(fd) != 0
    }
}

pub fn posix_is_readable_stdin() -> bool {
    if is_windows_target() {
        unsafe {
            return trg_win_is_readable_stdin() != 0
        }
    }
    // POSIX path:
    // If it's a TTY, it is an interactive keyboard session, not a data pipe/redirected file.
    if posix_isatty(0:i32) {
        return false
    }
    // Query stdin (fd 0) stat via /dev/fd/0 (macOS/BSD) or /proc/self/fd/0 (Linux).
    // This allows distinguishing FIFO/pipe and regular files from character devices (e.g. /dev/null).
    auto p# = string::from("/dev/fd/0")
    auto *cp1 = p.c_str()
    auto stat_ptr# = sys_fs::stat_impl(*cp1 as Addr)
    if stat_ptr == ADDR0 {
        p = string::from("/proc/self/fd/0")
        auto *cp2 = p.c_str()
        stat_ptr = sys_fs::stat_impl(*cp2 as Addr)
    }
    if stat_ptr == ADDR0 {
        return false
    }
    auto mode = sys_fs::stat_get_mode_impl(stat_ptr)
    sys_fs::stat_free_impl(stat_ptr)
    auto is_fifo = (mode & 61440:u32) == 4096:u32   // S_IFIFO
    auto is_reg = (mode & 61440:u32) == 32768:u32  // S_IFREG
    return is_fifo || is_reg
}


// Returns: 0 = OK, 1 = BrokenPipe (EPIPE), 2 = WriteError
pub fn posix_write_stdout(s: str) -> i32 {
    if s.len == 0 { return 0 }
    unsafe {
        auto base_addr = s.raw_ptr() as Addr
        auto rem# = s.len
        auto offset# = 0:usize
        loop rem > 0 {
            auto *p = (base_addr + offset) as *void
            posix_clear_crt_errno()
            auto n = write(1:i32, *p, rem)
            if n < 0 {
                auto err = posix_get_crt_errno()
                if err == 4:i32 { // EINTR: retry
                    continue
                }
                if err == 32:i32 { // EPIPE strictly
                    return 1
                }
                return 2 // Fatal I/O write error
            }
            if n == 0 {
                return 2
            }
            offset = offset + (n as usize)
            rem = rem - (n as usize)
        }
        return 0
    }
}

pub fn posix_write_stderr(s: str) {
    if s.len == 0 { return }
    unsafe {
        auto base_addr = s.raw_ptr() as Addr
        auto rem# = s.len
        auto offset# = 0:usize
        loop rem > 0 {
            auto *p = (base_addr + offset) as *void
            auto n = write(2:i32, *p, rem)
            if n <= 0 {
                return
            }
            offset = offset + (n as usize)
            rem = rem - (n as usize)
        }
    }
}

pub fn print_err(msg: str) {
    posix_write_stderr("trg: ")
    posix_write_stderr(msg)
    posix_write_stderr("\n")
}

pub fn posix_read_stdin_line() -> Option<string> {
    auto line# = string::new()
    auto buf = [0:char; 1]
    unsafe {
        auto *ptr = &buf[0] as *void
        loop true {
            auto n = read(0:i32, *ptr, 1:usize)
            if n <= 0 {
                if line.len() > 0 {
                    return Option<string>::Some(cede line)
                }
                return Option<string>::None
            }
            auto ch = buf[0]
            if ch == ('\n' as char) {
                if line.len() > 0 && line.byte_at(line.len() - 1) == ('\r' as char) {
                    auto s = line.as_str()
                    auto trimmed = string::from(s.substr(0, s.len - 1))
                    return Option<string>::Some(cede trimmed)
                }
                return Option<string>::Some(cede line)
            }
            line#.push_char(ch)
        }
    }
    return Option<string>::None
}

pub fn posix_realpath(path: string) -> Option<string> {
    auto *cpath = path.c_str()
    auto buf = [0:char; 4096]
    unsafe {
        auto *buf_ptr = &buf[0] as *char
        auto res = realpath(*cpath, *buf_ptr)
        if res == ADDR0 {
            return Option<string>::None
        }
        auto len# = 0:usize
        loop len < 4096:usize && buf[len] != 0:char {
            len = len + 1
        }
        auto s# = string::new()
        auto i# = 0:usize
        loop i < len {
            s#.push_char(buf[i])
            i = i + 1
        }
        return Option<string>::Some(cede s)
    }
}

