// JSON Schemas and tools list for Model Context Protocol in trg.
import core/str::{str}

pub fn get_mcp_input_schema() -> string {
    return string::from("{\"type\":\"object\",\"oneOf\":[{\"required\":[\"pattern\"]},{\"required\":[\"patterns\"]}],\"properties\":{\"pattern\":{\"type\":\"string\",\"description\":\"Search pattern (literal substring by default, regex when mode='regex').\"},\"patterns\":{\"type\":\"array\",\"items\":{\"type\":\"string\"},\"minItems\":1,\"description\":\"Multiple search patterns evaluated with leftmost-first precedence. Mutually exclusive with 'pattern'.\"},\"mode\":{\"type\":\"string\",\"enum\":[\"literal\",\"regex\"],\"default\":\"literal\",\"description\":\"Pattern evaluation mode: 'literal' (default, fast fixed substring) or 'regex' (regular expression).\"},\"match_boundary\":{\"type\":\"string\",\"enum\":[\"substring\",\"word\",\"line\"],\"default\":\"substring\",\"description\":\"Match boundary rule: 'substring' (default), 'word' (equivalent to -w), or 'line' (equivalent to -x).\"},\"case_mode\":{\"type\":\"string\",\"enum\":[\"smart\",\"sensitive\",\"ignore\"],\"default\":\"sensitive\",\"description\":\"Case sensitivity: 'sensitive' (default), 'smart' (case-insensitive if lowercase, sensitive if uppercase present), or 'ignore' (case-insensitive).\"},\"paths\":{\"type\":\"array\",\"items\":{\"type\":\"string\"},\"minItems\":1,\"description\":\"Array of file or directory paths to search. Mutually exclusive with 'path'.\"},\"path\":{\"type\":\"string\",\"description\":\"Deprecated alias for paths=[path].\"},\"globs\":{\"type\":\"array\",\"items\":{\"type\":\"string\"},\"minItems\":1,\"description\":\"File glob patterns with last-match-wins ordering (e.g. ['*.tk', '!tests/**']).\"},\"types\":{\"type\":\"array\",\"items\":{\"type\":\"string\"},\"minItems\":1,\"description\":\"Array of file type filters (e.g. ['rust', 'tk', 'python']). Mutually exclusive with 'type'.\"},\"type\":{\"type\":\"string\",\"description\":\"Deprecated alias for types=[type].\"},\"sort\":{\"type\":\"string\",\"enum\":[\"path\",\"reverse_path\",\"none\"],\"default\":\"path\",\"description\":\"Traversal ordering. Default 'path' provides deterministic results for caching and regression testing.\"},\"context\":{\"type\":[\"integer\",\"null\"],\"minimum\":0,\"maximum\":1000,\"default\":null,\"description\":\"Number of context lines before and after each match (equivalent to -C).\"},\"def_first\":{\"type\":\"boolean\",\"default\":false,\"description\":\"Prioritize identifier definitions before usages using high-value lexical heuristics.\"},\"block\":{\"type\":\"boolean\",\"default\":false,\"description\":\"Syntactic block expansion (enclosing function, class, struct body) using brace/indentation heuristics.\"},\"max_block_lines\":{\"type\":[\"integer\",\"null\"],\"minimum\":1,\"maximum\":1000,\"default\":null,\"description\":\"Maximum lines per expanded block context (requires block=true). Default: 80.\"},\"scope\":{\"type\":\"boolean\",\"default\":false,\"description\":\"Show enclosing declaration header breadcrumb.\"},\"group_by_scope\":{\"type\":\"boolean\",\"default\":false,\"description\":\"Hierarchically group matching lines by their enclosing function/class/struct scope.\"},\"symbol_variants\":{\"type\":\"boolean\",\"default\":false,\"description\":\"Expand query across snake_case, camelCase, PascalCase, and SCREAMING_SNAKE_CASE conventions.\"},\"snippet\":{\"type\":\"boolean\",\"default\":false,\"description\":\"Extract centered KWIC snippet around matches with window fusion.\"},\"snippet_chars\":{\"type\":[\"integer\",\"null\"],\"minimum\":5,\"maximum\":500,\"default\":30,\"description\":\"Characters to preserve on each side of match in snippet mode (default: 30).\"},\"max_total_matches\":{\"type\":[\"integer\",\"null\"],\"minimum\":0,\"maximum\":9007199254740991,\"default\":50,\"description\":\"Maximum total matches across all files. Default: 50. Pass explicit null for unlimited.\"},\"max_matches\":{\"type\":[\"integer\",\"null\"],\"minimum\":0,\"maximum\":9007199254740991,\"description\":\"Deprecated alias for max_total_matches.\"},\"max_result_bytes\":{\"oneOf\":[{\"type\":\"string\"},{\"type\":\"integer\",\"minimum\":0,\"maximum\":9007199254740991},{\"type\":\"null\"}],\"default\":\"64K\",\"description\":\"Maximum canonical record bytes. Default: '64K' (65,536 bytes). Pass explicit null for unlimited.\"},\"max_bytes\":{\"oneOf\":[{\"type\":\"string\"},{\"type\":\"integer\",\"minimum\":0,\"maximum\":9007199254740991},{\"type\":\"null\"}],\"description\":\"Deprecated alias for max_result_bytes.\"},\"max_per_file\":{\"type\":[\"integer\",\"null\"],\"minimum\":0,\"maximum\":9007199254740991,\"default\":null,\"description\":\"Maximum matches per individual file (equivalent to -m / --max-count).\"},\"max_files_with_matches\":{\"type\":[\"integer\",\"null\"],\"minimum\":0,\"maximum\":9007199254740991,\"default\":null,\"description\":\"Maximum files with matches before terminating search.\"},\"path_style\":{\"type\":\"string\",\"enum\":[\"workspace_relative\",\"absolute\"],\"default\":\"workspace_relative\",\"description\":\"File path style for structured entries and text output.\"},\"text_layout\":{\"type\":\"string\",\"enum\":[\"grouped\",\"flat\"],\"default\":\"grouped\",\"description\":\"Text formatting layout: 'grouped' (heading-based) or 'flat' (path-prefixed lines).\"},\"args\":{\"type\":\"array\",\"items\":{\"type\":\"string\"},\"description\":\"Pass-through CLI search tuning flags (e.g. ['--no-ignore', '--hidden', '--max-columns=120']). Mode-altering flags are forbidden.\"}},\"additionalProperties\":false}")
}

pub fn get_mcp_output_schema() -> string {
    return string::from("{\"type\":\"object\",\"properties\":{\"schema\":{\"type\":\"string\",\"const\":\"trg-mcp-result-v2\"},\"complete\":{\"type\":\"boolean\"},\"truncated\":{\"type\":\"boolean\"},\"termination_reason\":{\"type\":\"string\",\"enum\":[\"completed\",\"max_total_matches\",\"max_result_bytes\",\"max_files_with_matches\",\"search_error\"]},\"effective_query\":{\"type\":\"object\",\"properties\":{\"patterns\":{\"type\":\"array\",\"items\":{\"type\":\"string\"}},\"mode\":{\"type\":\"string\",\"enum\":[\"literal\",\"regex\"]},\"match_boundary\":{\"type\":\"string\",\"enum\":[\"substring\",\"word\",\"line\"]},\"case_mode\":{\"type\":\"string\",\"enum\":[\"smart\",\"sensitive\",\"ignore\"]},\"paths\":{\"type\":\"array\",\"items\":{\"type\":\"string\"}},\"globs\":{\"type\":\"array\",\"items\":{\"type\":\"string\"}},\"types\":{\"type\":\"array\",\"items\":{\"type\":\"string\"}},\"exclude_types\":{\"type\":\"array\",\"items\":{\"type\":\"string\"}},\"ignore_enabled\":{\"type\":\"boolean\"},\"hidden_enabled\":{\"type\":\"boolean\"},\"no_prefilter\":{\"type\":\"boolean\"},\"invert_match\":{\"type\":\"boolean\"},\"max_columns\":{\"type\":[\"integer\",\"null\"]},\"symlink_policy\":{\"type\":\"string\",\"const\":\"skip\"},\"binary_policy\":{\"type\":\"string\",\"const\":\"skip\"},\"sort\":{\"type\":\"string\",\"enum\":[\"path\",\"reverse_path\",\"none\"]},\"context\":{\"type\":[\"integer\",\"null\"]},\"before_context\":{\"type\":\"integer\",\"minimum\":0},\"after_context\":{\"type\":\"integer\",\"minimum\":0},\"block\":{\"type\":\"boolean\"},\"max_block_lines\":{\"type\":[\"integer\",\"null\"],\"minimum\":1,\"maximum\":1000},\"scope\":{\"type\":\"boolean\"},\"def_first\":{\"type\":\"boolean\"},\"deduplicate_targets\":{\"type\":\"boolean\"},\"group_by_scope\":{\"type\":\"boolean\"},\"symbol_variants\":{\"type\":\"boolean\"},\"snippet\":{\"type\":\"boolean\"},\"snippet_chars\":{\"type\":\"integer\"}},\"required\":[\"patterns\",\"mode\",\"match_boundary\",\"case_mode\",\"paths\",\"globs\",\"types\",\"exclude_types\",\"ignore_enabled\",\"hidden_enabled\",\"no_prefilter\",\"invert_match\",\"max_columns\",\"symlink_policy\",\"binary_policy\",\"sort\",\"context\",\"before_context\",\"after_context\",\"block\",\"max_block_lines\",\"scope\",\"def_first\",\"deduplicate_targets\",\"group_by_scope\",\"symbol_variants\",\"snippet\",\"snippet_chars\"],\"additionalProperties\":false},\"projection\":{\"type\":\"object\",\"properties\":{\"path_style\":{\"type\":\"string\",\"enum\":[\"as_given\",\"workspace_relative\",\"absolute\"]},\"text_layout\":{\"type\":\"string\",\"enum\":[\"grouped\",\"flat\"]}},\"required\":[\"path_style\",\"text_layout\"],\"additionalProperties\":false},\"limits\":{\"type\":\"object\",\"properties\":{\"max_total_matches\":{\"type\":[\"integer\",\"null\"],\"minimum\":0,\"maximum\":9007199254740991},\"max_result_bytes\":{\"type\":[\"integer\",\"null\"],\"minimum\":0,\"maximum\":9007199254740991},\"max_per_file\":{\"type\":[\"integer\",\"null\"],\"minimum\":0,\"maximum\":9007199254740991},\"max_files_with_matches\":{\"type\":[\"integer\",\"null\"],\"minimum\":0,\"maximum\":9007199254740991}},\"required\":[\"max_total_matches\",\"max_result_bytes\",\"max_per_file\",\"max_files_with_matches\"],\"additionalProperties\":false},\"stats\":{\"type\":\"object\",\"properties\":{\"matches_emitted\":{\"type\":\"integer\",\"minimum\":0,\"maximum\":9007199254740991},\"matches_observed\":{\"type\":\"integer\",\"minimum\":0,\"maximum\":9007199254740991},\"files_scanned\":{\"type\":\"integer\",\"minimum\":0,\"maximum\":9007199254740991},\"files_with_match_observed\":{\"type\":\"integer\",\"minimum\":0,\"maximum\":9007199254740991},\"files_with_match_emitted\":{\"type\":\"integer\",\"minimum\":0,\"maximum\":9007199254740991},\"file_scan_passes\":{\"type\":\"integer\",\"minimum\":0,\"maximum\":9007199254740991},\"text_record_bytes_emitted\":{\"type\":\"integer\",\"minimum\":0,\"maximum\":9007199254740991},\"structured_record_bytes_emitted\":{\"type\":\"integer\",\"minimum\":0,\"maximum\":9007199254740991},\"budgeted_record_bytes_emitted\":{\"type\":\"integer\",\"minimum\":0,\"maximum\":9007199254740991}},\"required\":[\"matches_emitted\",\"matches_observed\",\"files_scanned\",\"files_with_match_observed\",\"files_with_match_emitted\",\"file_scan_passes\",\"text_record_bytes_emitted\",\"structured_record_bytes_emitted\",\"budgeted_record_bytes_emitted\"],\"additionalProperties\":false},\"path_base\":{\"type\":\"object\",\"properties\":{\"kind\":{\"type\":\"string\",\"enum\":[\"cwd\"]},\"path\":{\"type\":\"string\"}},\"required\":[\"kind\",\"path\"],\"additionalProperties\":false},\"files\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"id\":{\"type\":\"integer\",\"minimum\":0,\"maximum\":9007199254740991},\"path\":{\"type\":\"string\"},\"kind\":{\"type\":\"string\",\"enum\":[\"workspace_relative\",\"absolute\",\"stdin\"]}},\"required\":[\"id\",\"path\",\"kind\"],\"additionalProperties\":false}},\"segments\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"file_id\":{\"type\":\"integer\",\"minimum\":0,\"maximum\":9007199254740991},\"pass\":{\"type\":\"string\",\"enum\":[\"all\",\"definitions\",\"usages\"]},\"records\":{\"type\":\"array\",\"items\":{\"oneOf\":[{\"type\":\"object\",\"properties\":{\"kind\":{\"type\":\"string\",\"const\":\"match\"},\"group_id\":{\"type\":\"integer\",\"minimum\":0,\"maximum\":9007199254740991},\"line_number\":{\"type\":\"integer\",\"minimum\":1,\"maximum\":9007199254740991},\"absolute_offset\":{\"type\":\"integer\",\"minimum\":0,\"maximum\":9007199254740991},\"text\":{\"type\":\"string\"},\"submatches\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"match_text\":{\"type\":\"string\"},\"start\":{\"type\":\"integer\",\"minimum\":0,\"maximum\":9007199254740991},\"end\":{\"type\":\"integer\",\"minimum\":0,\"maximum\":9007199254740991}},\"required\":[\"match_text\",\"start\",\"end\"],\"additionalProperties\":false}},\"scope\":{\"type\":[\"string\",\"null\"]},\"block_truncated\":{\"type\":\"boolean\"},\"block_range\":{\"type\":\"array\",\"items\":{\"type\":\"integer\",\"minimum\":1,\"maximum\":9007199254740991},\"minItems\":2,\"maxItems\":2}},\"required\":[\"kind\",\"group_id\",\"line_number\",\"absolute_offset\",\"text\",\"submatches\"],\"additionalProperties\":false},{\"type\":\"object\",\"properties\":{\"kind\":{\"type\":\"string\",\"const\":\"context\"},\"group_id\":{\"type\":\"integer\",\"minimum\":0,\"maximum\":9007199254740991},\"line_number\":{\"type\":\"integer\",\"minimum\":1,\"maximum\":9007199254740991},\"absolute_offset\":{\"type\":\"integer\",\"minimum\":0,\"maximum\":9007199254740991},\"text\":{\"type\":\"string\"},\"block_truncated\":{\"type\":\"boolean\"}},\"required\":[\"kind\",\"group_id\",\"line_number\",\"absolute_offset\",\"text\"],\"additionalProperties\":false}]}}},\"required\":[\"file_id\",\"pass\",\"records\"],\"additionalProperties\":false}},\"errors\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"kind\":{\"type\":\"string\",\"enum\":[\"walk\",\"open\",\"read\",\"regex\"]},\"path\":{\"type\":[\"string\",\"null\"]},\"message\":{\"type\":\"string\"},\"errno\":{\"type\":[\"integer\",\"null\"],\"minimum\":0}},\"required\":[\"kind\",\"message\",\"errno\"],\"additionalProperties\":false}}},\"required\":[\"schema\",\"complete\",\"truncated\",\"termination_reason\",\"effective_query\",\"projection\",\"limits\",\"stats\",\"path_base\",\"files\",\"segments\",\"errors\"],\"additionalProperties\":false}")
}

pub fn get_mcp_view_input_schema() -> string {
    return string::from("{\"type\":\"object\",\"required\":[\"path\"],\"properties\":{\"path\":{\"type\":\"string\",\"description\":\"File path to inspect.\"},\"line\":{\"type\":[\"integer\",\"null\"],\"minimum\":1,\"default\":null,\"description\":\"Target 1-based line number for point hydration.\"},\"context\":{\"type\":[\"integer\",\"null\"],\"minimum\":0,\"default\":10,\"description\":\"Surrounding context lines before and after target line (default: 10).\"},\"block\":{\"type\":\"boolean\",\"default\":false,\"description\":\"Expand enclosing syntactic code block around target line.\"},\"lines\":{\"type\":[\"array\",\"null\"],\"items\":{\"type\":\"integer\",\"minimum\":1},\"minItems\":2,\"maxItems\":2,\"default\":null,\"description\":\"Explicit physical line range [start, end] (1-based, inclusive).\"}},\"additionalProperties\":false}")
}

pub fn format_tools_list_response(id_val: string, proto_version: str) -> string {
    auto res# = string::from("{\"jsonrpc\":\"2.0\",\"id\":")
    res#.push_str(id_val.as_str())
    res#.push_str(",\"result\":{\"tools\":[{\"name\":\"trg_search\",\"description\":\"Fast ripgrep-compatible code search with semantic block context, scopes, and budget control.\",\"inputSchema\":")
    res#.push_str(get_mcp_input_schema().as_str())
    if proto_version == "2025-11-25" {
        res#.push_str(",\"outputSchema\":")
        res#.push_str(get_mcp_output_schema().as_str())
        res#.push_str(",\"annotations\":{\"readOnlyHint\":true,\"destructiveHint\":false,\"idempotentHint\":true,\"openWorldHint\":false}")
    }
    res#.push_str("},{\"name\":\"trg_view\",\"description\":\"Stateless point hydration to inspect lines, code blocks, or ranges around a target line.\",\"inputSchema\":")
    res#.push_str(get_mcp_view_input_schema().as_str())
    if proto_version == "2025-11-25" {
        res#.push_str(",\"annotations\":{\"readOnlyHint\":true,\"destructiveHint\":false,\"idempotentHint\":true,\"openWorldHint\":false}")
    }
    res#.push_str("}]}}\n")
    return cede res
}
