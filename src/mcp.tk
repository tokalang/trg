pub shape JsonIdResult (
    has_id: bool,
    is_valid: bool,
    id_str: string
)

fn json_map_extract_id(document: Document, object: usize) -> JsonIdResult {
    auto node = document.find(object, "id")
    if node == 0:usize {
        return JsonIdResult(has_id = false, is_valid = true, id_str = string::from("null"))
    }
    auto kind = document.kind(node)
    if kind == 2:i32 {
        auto n = document.number(node).unwrap()
        if is_finite(n) && n == floor(n) && n >= -9007199254740991.0 && n <= 9007199254740991.0 {
            return JsonIdResult(has_id = true, is_valid = true, id_str = i64_to_string(n as i64))
        }
    } else if kind == 3:i32 {
        auto out# = string::from("\"")
        out#.push_str(json_escape(document.text(node)).as_str())
        out#.push_str("\"")
        return JsonIdResult(has_id = true, is_valid = true, id_str = cede out)
    } else if kind == 0:i32 {
        return JsonIdResult(has_id = true, is_valid = true, id_str = string::from("null"))
    }
    return JsonIdResult(has_id = true, is_valid = false, id_str = string::from("null"))
}

fn send_mcp_response(resp: str) -> bool {
    auto s# = string::from(resp)
    if !s.as_str().ends_with("\n") {
        s#.push_str("\n")
    }
    auto res = posix_write_stdout(s.as_str())
    return res == 0
}

fn send_error(id_str: str, code: i32, message: str) -> bool {
    auto resp# = string::from("{\"jsonrpc\":\"2.0\",\"id\":")
    resp#.push_str(id_str)
    resp#.push_str(",\"error\":{\"code\":")
    resp#.push_str(string::from_int(code).as_str())
    resp#.push_str(",\"message\":\"")
    resp#.push_str(json_escape(message).as_str())
    resp#.push_str("\"}}\n")
    return send_mcp_response(resp.as_str())
}

fn send_tool_error(id_str: str, message: str) -> bool {
    auto resp# = string::from("{\"jsonrpc\":\"2.0\",\"id\":")
    resp#.push_str(id_str)
    resp#.push_str(",\"result\":{\"content\":[{\"type\":\"text\",\"text\":\"")
    resp#.push_str(json_escape(message).as_str())
    resp#.push_str("\"}],\"isError\":true}}\n")
    return send_mcp_response(resp.as_str())
}

fn send_tool_error_json(id_str: str, message: str) -> bool {
    auto err_obj# = string::from("{\"error\":\"")
    err_obj#.push_str(json_escape(message).as_str())
    err_obj#.push_str("\"}")

    auto resp# = string::from("{\"jsonrpc\":\"2.0\",\"id\":")
    resp#.push_str(id_str)
    resp#.push_str(",\"result\":{\"content\":[{\"type\":\"text\",\"text\":\"")
    resp#.push_str(json_escape(err_obj.as_str()).as_str())
    resp#.push_str("\"}],\"isError\":true}}\n")
    return send_mcp_response(resp.as_str())
}

fn is_strict_hex_digit(c: char) -> bool {
    if c >= ('0' as char) && c <= ('9' as char) { return true }
    if c >= ('a' as char) && c <= ('f' as char) { return true }
    if c >= ('A' as char) && c <= ('F' as char) { return true }
    return false
}

fn is_non_null_arg(document: Document, node: usize) -> bool {
    return node != 0:usize && document.kind(node) != 0:i32
}

fn json_positive_usize(document: Document, node: usize) -> Option<usize> {
    if document.kind(node) != 2:i32 { return Option<usize>::None }
    auto n = document.number(node).unwrap()
    if is_finite(n) && n == floor(n) && n >= 1.0 && n <= 9007199254740991.0 {
        return Option<usize>::Some(n as usize)
    }
    return Option<usize>::None
}

fn hex_char_to_val(c: char) -> usize {
    if c >= ('0' as char) && c <= ('9' as char) {
        return (c as usize) - (('0' as char) as usize)
    }
    if c >= ('a' as char) && c <= ('f' as char) {
        return (c as usize) - (('a' as char) as usize) + 10:usize
    }
    if c >= ('A' as char) && c <= ('F' as char) {
        return (c as usize) - (('A' as char) as usize) + 10:usize
    }
    return 0:usize
}

fn skip_json_ws(s: str, pos#: usize) {
    loop pos < s.len {
        auto c = s.byte_at(pos)
        if c == (' ' as char) || c == ('\t' as char) || c == ('\n' as char) || c == ('\r' as char) {
            pos = pos + 1
        } else {
            break
        }
    }
}

fn parse_strict_json_string(s: str, pos#: usize) -> bool {
    if pos >= s.len || s.byte_at(pos) != ('"' as char) {
        return false
    }
    pos = pos + 1
    loop pos < s.len {
        auto sc = s.byte_at(pos)
        auto sc_val = (sc as u8) as usize
        if sc_val < 32 {
            return false
        }
        if sc == ('"' as char) {
            pos = pos + 1
            return true
        }
        if sc == ('\\' as char) {
            if pos + 1 >= s.len {
                return false
            }
            auto esc = s.byte_at(pos + 1)
            if esc == ('"' as char) || esc == ('\\' as char) || esc == ('/' as char) ||
               esc == ('b' as char) || esc == ('f' as char) || esc == ('n' as char) ||
               esc == ('r' as char) || esc == ('t' as char) {
                pos = pos + 2
                continue
            } else if esc == ('u' as char) {
                if pos + 5 >= s.len {
                    return false
                }
                if !is_strict_hex_digit(s.byte_at(pos + 2)) ||
                   !is_strict_hex_digit(s.byte_at(pos + 3)) ||
                   !is_strict_hex_digit(s.byte_at(pos + 4)) ||
                   !is_strict_hex_digit(s.byte_at(pos + 5)) {
                    return false
                }
                auto h1 = hex_char_to_val(s.byte_at(pos + 2))
                auto h2 = hex_char_to_val(s.byte_at(pos + 3))
                auto h3 = hex_char_to_val(s.byte_at(pos + 4))
                auto h4 = hex_char_to_val(s.byte_at(pos + 5))
                auto cp = (h1 << 12) | (h2 << 8) | (h3 << 4) | h4
                // UTF-16 surrogate checks:
                if cp >= 0xD800 && cp <= 0xDBFF {
                    // High surrogate: MUST be immediately followed by \uDC00..\uDFFF
                    if pos + 11 >= s.len {
                        return false
                    }
                    if s.byte_at(pos + 6) != ('\\' as char) || s.byte_at(pos + 7) != ('u' as char) {
                        return false
                    }
                    if !is_strict_hex_digit(s.byte_at(pos + 8)) ||
                       !is_strict_hex_digit(s.byte_at(pos + 9)) ||
                       !is_strict_hex_digit(s.byte_at(pos + 10)) ||
                       !is_strict_hex_digit(s.byte_at(pos + 11)) {
                        return false
                    }
                    auto l1 = hex_char_to_val(s.byte_at(pos + 8))
                    auto l2 = hex_char_to_val(s.byte_at(pos + 9))
                    auto l3 = hex_char_to_val(s.byte_at(pos + 10))
                    auto l4 = hex_char_to_val(s.byte_at(pos + 11))
                    auto low_cp = (l1 << 12) | (l2 << 8) | (l3 << 4) | l4
                    if low_cp < 0xDC00 || low_cp > 0xDFFF {
                        return false
                    }
                    pos = pos + 12
                    continue
                } else if cp >= 0xDC00 && cp <= 0xDFFF {
                    // Isolated low surrogate: invalid
                    return false
                }
                pos = pos + 6
                continue
            } else {
                return false
            }
        }
        pos = pos + 1
    }
    return false
}

fn parse_strict_json_number(s: str, pos#: usize) -> bool {
    if pos >= s.len {
        return false
    }
    if s.byte_at(pos) == ('-' as char) {
        pos = pos + 1
    }
    if pos >= s.len {
        return false
    }
    auto c = s.byte_at(pos)
    if c < ('0' as char) || c > ('9' as char) {
        return false
    }
    if c == ('0' as char) {
        pos = pos + 1
        if pos < s.len {
            auto nc = s.byte_at(pos)
            if nc >= ('0' as char) && nc <= ('9' as char) {
                return false
            }
        }
    } else {
        loop pos < s.len {
            auto dc = s.byte_at(pos)
            if dc >= ('0' as char) && dc <= ('9' as char) {
                pos = pos + 1
            } else {
                break
            }
        }
    }

    // Fraction
    if pos < s.len && s.byte_at(pos) == ('.' as char) {
        pos = pos + 1
        if pos >= s.len {
            return false
        }
        auto fc = s.byte_at(pos)
        if fc < ('0' as char) || fc > ('9' as char) {
            return false
        }
        loop pos < s.len {
            auto dc = s.byte_at(pos)
            if dc >= ('0' as char) && dc <= ('9' as char) {
                pos = pos + 1
            } else {
                break
            }
        }
    }

    // Exponent
    if pos < s.len && (s.byte_at(pos) == ('e' as char) || s.byte_at(pos) == ('E' as char)) {
        pos = pos + 1
        if pos < s.len && (s.byte_at(pos) == ('+' as char) || s.byte_at(pos) == ('-' as char)) {
            pos = pos + 1
        }
        if pos >= s.len {
            return false
        }
        auto ec = s.byte_at(pos)
        if ec < ('0' as char) || ec > ('9' as char) {
            return false
        }
        loop pos < s.len {
            auto dc = s.byte_at(pos)
            if dc >= ('0' as char) && dc <= ('9' as char) {
                pos = pos + 1
            } else {
                break
            }
        }
    }

    // Delimiter boundary check: character immediately after number MUST be whitespace, comma, bracket, brace, or EOF
    if pos < s.len {
        auto end_c = s.byte_at(pos)
        if end_c != (' ' as char) && end_c != ('\t' as char) && end_c != ('\r' as char) &&
           end_c != ('\n' as char) && end_c != (',' as char) && end_c != (']' as char) &&
           end_c != ('}' as char) {
            return false
        }
    }
    return true
}

fn parse_strict_json_value(s: str, pos#: usize, depth: usize) -> bool {
    if depth > 64 {
        return false
    }
    skip_json_ws(s, pos#)
    if pos >= s.len {
        return false
    }
    auto c = s.byte_at(pos)

    if c == ('"' as char) {
        return parse_strict_json_string(s, pos#)
    }

    if c == ('{' as char) {
        pos = pos + 1
        skip_json_ws(s, pos#)
        if pos < s.len && s.byte_at(pos) == ('}' as char) {
            pos = pos + 1
            return true
        }
        loop true {
            skip_json_ws(s, pos#)
            if pos >= s.len || s.byte_at(pos) != ('"' as char) {
                return false
            }
            if !parse_strict_json_string(s, pos#) {
                return false
            }
            skip_json_ws(s, pos#)
            if pos >= s.len || s.byte_at(pos) != (':' as char) {
                return false
            }
            pos = pos + 1
            skip_json_ws(s, pos#)
            if !parse_strict_json_value(s, pos#, depth + 1) {
                return false
            }
            skip_json_ws(s, pos#)
            if pos >= s.len {
                return false
            }
            auto sep = s.byte_at(pos)
            if sep == (',' as char) {
                pos = pos + 1
                skip_json_ws(s, pos#)
                if pos < s.len && s.byte_at(pos) == ('}' as char) {
                    return false
                }
            } else if sep == ('}' as char) {
                pos = pos + 1
                return true
            } else {
                return false
            }
        }
    }

    if c == ('[' as char) {
        pos = pos + 1
        skip_json_ws(s, pos#)
        if pos < s.len && s.byte_at(pos) == (']' as char) {
            pos = pos + 1
            return true
        }
        loop true {
            skip_json_ws(s, pos#)
            if !parse_strict_json_value(s, pos#, depth + 1) {
                return false
            }
            skip_json_ws(s, pos#)
            if pos >= s.len {
                return false
            }
            auto sep = s.byte_at(pos)
            if sep == (',' as char) {
                pos = pos + 1
                skip_json_ws(s, pos#)
                if pos < s.len && s.byte_at(pos) == (']' as char) {
                    return false
                }
            } else if sep == (']' as char) {
                pos = pos + 1
                return true
            } else {
                return false
            }
        }
    }

    if c == ('t' as char) {
        if pos + 3 < s.len && s.byte_at(pos + 1) == ('r' as char) &&
           s.byte_at(pos + 2) == ('u' as char) && s.byte_at(pos + 3) == ('e' as char) {
            pos = pos + 4
            if pos < s.len {
                auto nc = s.byte_at(pos)
                if nc != (' ' as char) && nc != ('\t' as char) && nc != ('\r' as char) &&
                   nc != ('\n' as char) && nc != (',' as char) && nc != (']' as char) &&
                   nc != ('}' as char) {
                    return false
                }
            }
            return true
        }
        return false
    }

    if c == ('f' as char) {
        if pos + 4 < s.len && s.byte_at(pos + 1) == ('a' as char) &&
           s.byte_at(pos + 2) == ('l' as char) && s.byte_at(pos + 3) == ('s' as char) &&
           s.byte_at(pos + 4) == ('e' as char) {
            pos = pos + 5
            if pos < s.len {
                auto nc = s.byte_at(pos)
                if nc != (' ' as char) && nc != ('\t' as char) && nc != ('\r' as char) &&
                   nc != ('\n' as char) && nc != (',' as char) && nc != (']' as char) &&
                   nc != ('}' as char) {
                    return false
                }
            }
            return true
        }
        return false
    }

    if c == ('n' as char) {
        if pos + 3 < s.len && s.byte_at(pos + 1) == ('u' as char) &&
           s.byte_at(pos + 2) == ('l' as char) && s.byte_at(pos + 3) == ('l' as char) {
            pos = pos + 4
            if pos < s.len {
                auto nc = s.byte_at(pos)
                if nc != (' ' as char) && nc != ('\t' as char) && nc != ('\r' as char) &&
                   nc != ('\n' as char) && nc != (',' as char) && nc != (']' as char) &&
                   nc != ('}' as char) {
                    return false
                }
            }
            return true
        }
        return false
    }

    auto is_digit = c >= ('0' as char) && c <= ('9' as char)
    if is_digit || c == ('-' as char) {
        return parse_strict_json_number(s, pos#)
    }

    return false
}

pub fn validate_strict_json(s: str) -> bool {
    if !is_valid_utf8(s) {
        return false
    }
    auto pos# = 0:usize
    skip_json_ws(s, pos#)
    if pos >= s.len {
        return false
    }
    if !parse_strict_json_value(s, pos#, 0:usize) {
        return false
    }
    skip_json_ws(s, pos#)
    if pos < s.len {
        return false
    }
    return true
}

pub fn run_mcp_server() -> i32 {
    auto server_state# = McpServerState::new()
    auto startup_cwd = normalize_cwd(env::current_dir().as_str())

    loop true {
        auto line_opt = posix_read_stdin_line()
        if line_opt.is_none() {
            break
        }
        auto line_str = line_opt.unwrap()
        auto trimmed = line_str.as_str().trim()
        if trimmed.len == 0 {
            continue
        }

        if !validate_strict_json(trimmed) {
            send_error("null", -32700, "Parse error")
            continue
        }

        auto parsed = parse_document(trimmed)
        if parsed.is_err() {
            send_error("null", -32700, "Parse error")
            continue
        }
        auto document = parsed.unwrap()
        if document.kind(1:usize) != 5:i32 {
            send_error("null", -32600, "Invalid Request")
            continue
        }

                auto id_res = json_map_extract_id(document, 1:usize)
                auto has_id = id_res.has_id
                auto id_str = id_res.id_str.clone()

                if has_id && !id_res.is_valid {
                    send_error("null", -32600, "Invalid Request: id must be a string, safe integer, or null")
                    continue
                }

                // Verify "jsonrpc" == "2.0"
                auto rpc_node = document.find(1:usize, "jsonrpc")
                auto valid_rpc = document.kind(rpc_node) == 3:i32 && document.text(rpc_node) == "2.0"
                if !valid_rpc {
                    send_error(id_str.as_str(), -32600, "Invalid Request")
                    continue
                }

                // Verify "method" is string
                auto m_node = document.find(1:usize, "method")
                if document.kind(m_node) != 3:i32 {
                    send_error(id_str.as_str(), -32600, "Invalid Request")
                    continue
                }
                auto method = string::from(document.text(m_node))

                // Notifications (no id) MUST NOT receive a response per JSON-RPC 2.0
                if !has_id {
                    if method.as_str() == "notifications/initialized" || method.as_str() == "initialized" {
                        server_state#.mark_ready()
                    }
                    continue
                }

                if method.as_str() == "initialize" {
                    if !server_state.is_uninitialized() {
                        send_error(id_str.as_str(), -32600, "Invalid Request: server already initialized")
                        continue
                    }
                    auto p_node = document.find(1:usize, "params")
                    auto v_node = document.find(p_node, "protocolVersion")
                    if document.kind(p_node) != 5:i32 || document.kind(v_node) != 3:i32 {
                        send_error(id_str.as_str(), -32602, "Invalid params: protocolVersion must be a string")
                        continue
                    }
                    auto req_ver = string::from(document.text(v_node))
                    auto negotiated = server_state#.handle_initialize(req_ver.as_str())
                    auto resp# = string::from("{\"jsonrpc\":\"2.0\",\"id\":")
                    resp#.push_str(id_str.as_str())
                    resp#.push_str(",\"result\":{\"protocolVersion\":\"")
                    resp#.push_str(negotiated.as_str())
                    resp#.push_str("\",\"capabilities\":{\"tools\":{}},\"serverInfo\":{\"name\":\"trg\",\"version\":\"0.19.4\"}}}\n")
                    send_mcp_response(resp.as_str())
                } else if method.as_str() == "ping" {
                    auto resp# = string::from("{\"jsonrpc\":\"2.0\",\"id\":")
                    resp#.push_str(id_str.as_str())
                    resp#.push_str(",\"result\":{}}\n")
                    send_mcp_response(resp.as_str())
                } else if method.as_str() == "tools/list" {
                    if server_state.is_uninitialized() {
                        send_error(id_str.as_str(), -32600, "Server not initialized: call 'initialize' first")
                        continue
                    }
                    if !server_state.is_ready() {
                        send_error(id_str.as_str(), -32600, "Server not ready: 'notifications/initialized' expected")
                        continue
                    }
                    auto resp = format_tools_list_response(id_str, server_state.negotiated_version.as_str())
                    send_mcp_response(resp.as_str())
                } else if method.as_str() == "tools/call" {
                    if server_state.is_uninitialized() {
                        send_error(id_str.as_str(), -32600, "Server not initialized: call 'initialize' first")
                        continue
                    }
                    if !server_state.is_ready() {
                        send_error(id_str.as_str(), -32600, "Server not ready: 'notifications/initialized' expected")
                        continue
                    }
                    auto p_map = document.find(1:usize, "params")
                    if document.kind(p_map) != 5:i32 {
                        send_error(id_str.as_str(), -32602, "Invalid params: params must be an object")
                        continue
                    }
                                    auto name_node = document.find(p_map, "name")
                                    if document.kind(name_node) != 3:i32 {
                                        send_error(id_str.as_str(), -32602, "Invalid params: 'name' must be a string")
                                        continue
                                    }
                                    auto tool_name = string::from(document.text(name_node))
                                    if tool_name.as_str() != "trg_search" && tool_name.as_str() != "trg_view" && tool_name.as_str() != "trg_symbols" {
                                        send_error(id_str.as_str(), -32602, "Invalid params: Unknown tool")
                                        continue
                                    }

                                    if tool_name.as_str() == "trg_view" {
                                        auto arg_map = document.find(p_map, "arguments")
                                        if document.kind(arg_map) != 5:i32 {
                                            send_error(id_str.as_str(), -32602, "Invalid params: arguments must be an object")
                                            continue
                                        }
                                                        auto arg_node# = document.first(arg_map)
                                                        auto unexp_opt# = Option<string>::None
                                                        loop arg_node != 0:usize {
                                                            auto k = document.key(arg_node)
                                                            if k != "path" && k != "line" && k != "context" && k != "block" && k != "lines" && k != "max_lines" && k != "max_result_bytes" && k != "max_bytes" && k != "max_columns" && k != "max_block_lines" && k != "format" && k != "symbol" && k != "scope" && k != "continuation" && k != "continuation_token" {
                                                                unexp_opt = Option<string>::Some(string::from(k))
                                                                break
                                                            }
                                                            arg_node = document.next(arg_node)
                                                        }
                                                        if unexp_opt.is_some() {
                                                            auto err# = string::from("Invalid params: unexpected property '")
                                                            err#.push_str(unexp_opt.unwrap().as_str())
                                                            err#.push_str("'")
                                                            send_error(id_str.as_str(), -32602, err.as_str())
                                                            continue
                                                        }

                                                        auto cont_token_str# = string::new()
                                                        auto has_cont_token# = false
                                                        auto ctn = document.find(arg_map, "continuation_token")
                                                        if ctn != 0:usize {
                                                            auto kind = document.kind(ctn)
                                                            if kind == 3:i32 {
                                                                auto cts = document.text(ctn)
                                                                if cts.len > 0:usize {
                                                                    cont_token_str = string::from(cts)
                                                                    has_cont_token = true
                                                                }
                                                            } else if kind != 0:i32 {
                                                                send_error(id_str.as_str(), -32602, "Invalid params: 'continuation_token' must be a string or null")
                                                                continue
                                                            }
                                                        }

                                                        if has_cont_token {
                                                            auto conflict = is_non_null_arg(document, document.find(arg_map, "path")) ||
                                                                            is_non_null_arg(document, document.find(arg_map, "line")) ||
                                                                            is_non_null_arg(document, document.find(arg_map, "lines")) ||
                                                                            is_non_null_arg(document, document.find(arg_map, "symbol")) ||
                                                                            is_non_null_arg(document, document.find(arg_map, "scope")) ||
                                                                            is_non_null_arg(document, document.find(arg_map, "block")) ||
                                                                            is_non_null_arg(document, document.find(arg_map, "context")) ||
                                                                            is_non_null_arg(document, document.find(arg_map, "continuation"))
                                                            if conflict {
                                                                send_error(id_str.as_str(), -32602, "Invalid params: 'continuation_token' cannot be used with path, line, lines, symbol, scope, block, context, or continuation")
                                                                continue
                                                            }
                                                        }

                                                        auto path_str# = string::new()
                                                        auto has_path# = false
                                                        auto pn = document.find(arg_map, "path")
                                                        if document.kind(pn) == 3:i32 {
                                                            auto ps = document.text(pn)
                                                            if ps.len > 0:usize {
                                                                path_str = string::from(ps)
                                                                has_path = true
                                                            }
                                                        }
                                                        if !has_cont_token {
                                                            if !has_path {
                                                                send_error(id_str.as_str(), -32602, "Invalid params: 'path' is required and must be a non-empty string")
                                                                continue
                                                            }

                                                            if startup_cwd.as_str() == "/" && !path_str.as_str().starts_with("/") {
                                                                send_error(id_str.as_str(), -32602, "Invalid params: relative path cannot be safely resolved when MCP server working directory is root ('/'); please provide an absolute path")
                                                                continue
                                                            }
                                                            if resolves_to_root(startup_cwd.as_str(), path_str.as_str()) {
                                                                send_error(id_str.as_str(), -32602, "Invalid params: target path resolves to filesystem root ('/'); viewing root is not allowed in MCP mode")
                                                                continue
                                                            }
                                                        }

                                                        auto line_opt# = Option<usize>::None
                                                        auto line_err# = false
                                                        auto ln = document.find(arg_map, "line")
                                                        if ln != 0:usize {
                                                            auto kind = document.kind(ln)
                                                            if kind == 2:i32 {
                                                                auto n = document.number(ln).unwrap()
                                                                if is_finite(n) && n == floor(n) && n >= 1.0 && n <= 9007199254740991.0 {
                                                                    line_opt = Option<usize>::Some(n as usize)
                                                                } else { line_err = true }
                                                            } else if kind != 0:i32 { line_err = true }
                                                        }
                                                        if line_err {
                                                            send_error(id_str.as_str(), -32602, "Invalid params: 'line' must be an integer >= 1 or null")
                                                            continue
                                                        }

                                                        auto context_val# = 10:usize
                                                        auto context_err# = false
                                                        auto cn = document.find(arg_map, "context")
                                                        if cn != 0:usize {
                                                            auto kind = document.kind(cn)
                                                            if kind == 2:i32 {
                                                                auto n = document.number(cn).unwrap()
                                                                if is_finite(n) && n == floor(n) && n >= 0.0 && n <= 1000.0 {
                                                                    context_val = n as usize
                                                                } else { context_err = true }
                                                            } else if kind != 0:i32 { context_err = true }
                                                        }
                                                        if context_err {
                                                            send_error(id_str.as_str(), -32602, "Invalid params: 'context' must be an integer between 0 and 1000")
                                                            continue
                                                        }

                                                        auto block_val# = false
                                                        auto block_err# = false
                                                        auto bn = document.find(arg_map, "block")
                                                        if bn != 0:usize {
                                                            if document.kind(bn) == 1:i32 { block_val = document.boolean(bn).unwrap() }
                                                            else { block_err = true }
                                                        }
                                                        if block_err {
                                                            send_error(id_str.as_str(), -32602, "Invalid params: 'block' must be a boolean")
                                                            continue
                                                        }

                                                        auto continuation_val# = false
                                                        auto continuation_err# = false
                                                        auto continuation_node = document.find(arg_map, "continuation")
                                                        if continuation_node != 0:usize {
                                                            if document.kind(continuation_node) == 1:i32 { continuation_val = document.boolean(continuation_node).unwrap() }
                                                            else { continuation_err = true }
                                                        }
                                                        if continuation_err {
                                                            send_error(id_str.as_str(), -32602, "Invalid params: 'continuation' must be a boolean")
                                                            continue
                                                        }

                                                        auto lines_range_opt# = Option<BlockRange>::None
                                                        auto lines_err# = false
                                                        auto lines_order_err# = false
                                                        auto lsn = document.find(arg_map, "lines")
                                                        if lsn != 0:usize {
                                                            auto kind = document.kind(lsn)
                                                            if kind == 4:i32 {
                                                                auto item0 = document.first(lsn)
                                                                auto item1 = document.next(item0)
                                                                if item0 == 0:usize || item1 == 0:usize || document.next(item1) != 0:usize {
                                                                    lines_err = true
                                                                } else {
                                                                    auto start_num = json_positive_usize(document, item0)
                                                                    auto end_num = json_positive_usize(document, item1)
                                                                    if start_num.is_none() || end_num.is_none() { lines_err = true }
                                                                    else {
                                                                        auto s_num = start_num.unwrap()
                                                                        auto e_num = end_num.unwrap()
                                                                        if s_num > e_num { lines_order_err = true }
                                                                        else { lines_range_opt = Option<BlockRange>::Some(BlockRange(start = s_num, end = e_num)) }
                                                                    }
                                                                }
                                                            } else if kind == 3:i32 {
                                                                auto pr = parse_range_spec(document.text(lsn))
                                                                if pr.is_ok() { lines_range_opt = Option<BlockRange>::Some(pr.unwrap()) }
                                                                else { lines_err = true }
                                                            } else if kind != 0:i32 { lines_err = true }
                                                        }
                                                        if lines_err {
                                                            send_error(id_str.as_str(), -32602, "Invalid params: 'lines' must be an array of two positive integers [start, end] or a range string '<start>-<end>'")
                                                            continue
                                                        }
                                                        if lines_order_err {
                                                            send_error(id_str.as_str(), -32602, "Invalid params: start line must be less than or equal to end line in 'lines'")
                                                            continue
                                                        }

                                                        auto symbol_raw_opt# = Option<string>::None
                                                        auto symbol_err# = false
                                                        auto sn = document.find(arg_map, "symbol")
                                                        if sn != 0:usize {
                                                            auto kind = document.kind(sn)
                                                            if kind == 3:i32 {
                                                                auto s = document.text(sn)
                                                                if s.len > 0:usize { symbol_raw_opt = Option<string>::Some(string::from(s)) }
                                                                else { symbol_err = true }
                                                            } else if kind != 0:i32 { symbol_err = true }
                                                        }
                                                        if symbol_err {
                                                            send_error(id_str.as_str(), -32602, "Invalid params: 'symbol' must be a non-empty string or null")
                                                            continue
                                                        }

                                                        auto scope_raw_opt# = Option<string>::None
                                                        auto scope_err# = false
                                                        auto scn = document.find(arg_map, "scope")
                                                        if scn != 0:usize {
                                                            auto kind = document.kind(scn)
                                                            if kind == 3:i32 {
                                                                auto scs = document.text(scn)
                                                                if scs.len > 0:usize { scope_raw_opt = Option<string>::Some(string::from(scs)) }
                                                                else { scope_err = true }
                                                            } else if kind != 0:i32 { scope_err = true }
                                                        }
                                                        if scope_err {
                                                            send_error(id_str.as_str(), -32602, "Invalid params: 'scope' must be a non-empty string or null")
                                                            continue
                                                        }

                                                        if scope_raw_opt.is_some() && symbol_raw_opt.is_none() {
                                                            send_error(id_str.as_str(), -32602, "Invalid params: 'scope' cannot be specified without 'symbol'")
                                                            continue
                                                        }

                                                        auto parsed_symbol# = Option<string>::None
                                                        auto parsed_scope# = Option<string>::None
                                                        if symbol_raw_opt.is_some() {
                                                            auto sym_raw_str# = string::new()
                                                            match symbol_raw_opt {
                                                                auto Option<string>::Some(&s) => { sym_raw_str = string::from(s.as_str()) }
                                                                auto Option<string>::None => {}
                                                            }
                                                            auto sym_view = sym_raw_str.as_str().trim()
                                                            if sym_view.len == 0 {
                                                                send_error(id_str.as_str(), -32602, "Invalid params: 'symbol' cannot be empty")
                                                                continue
                                                            }
                                                            if sym_view.starts_with("::") || sym_view.ends_with("::") {
                                                                send_error(id_str.as_str(), -32602, "Invalid params: empty scope or symbol name in 'symbol'")
                                                                continue
                                                            }
                                                            auto first_col = sym_view.index_of_str("::")
                                                            if first_col.is_some() {
                                                                auto pos1 = first_col.unwrap()
                                                                auto rem = sym_view.substr(pos1 + 2:usize, sym_view.len - pos1 - 2:usize)
                                                                if rem.index_of_str("::").is_some() {
                                                                    send_error(id_str.as_str(), -32602, "Invalid params: nested scopes (e.g. A::B::C) are not supported")
                                                                    continue
                                                                }
                                                                auto scope_part = sym_view.substr(0, pos1).trim()
                                                                auto name_part = rem.trim()
                                                                if scope_part.len == 0 || name_part.len == 0 {
                                                                    send_error(id_str.as_str(), -32602, "Invalid params: empty scope or symbol name in 'symbol'")
                                                                    continue
                                                                }
                                                                if scope_raw_opt.is_some() {
                                                                    auto s_arg# = string::new()
                                                                    match scope_raw_opt {
                                                                        auto Option<string>::Some(&sa) => { s_arg = string::from(sa.as_str()) }
                                                                        auto Option<string>::None => {}
                                                                    }
                                                                    if s_arg.as_str().trim() != scope_part {
                                                                        send_error(id_str.as_str(), -32602, "Invalid params: conflicting scopes specified: 'scope' does not match symbol scope prefix")
                                                                        continue
                                                                    }
                                                                }
                                                                parsed_symbol = Option<string>::Some(string::from(name_part))
                                                                parsed_scope = Option<string>::Some(string::from(scope_part))
                                                            } else {
                                                                parsed_symbol = Option<string>::Some(string::from(sym_view))
                                                                match scope_raw_opt {
                                                                    auto Option<string>::Some(&sr) => {
                                                                        auto sr_trim = sr.as_str().trim()
                                                                        if sr_trim.len == 0 {
                                                                            send_error(id_str.as_str(), -32602, "Invalid params: 'scope' cannot be empty")
                                                                            continue
                                                                        }
                                                                        parsed_scope = Option<string>::Some(string::from(sr_trim))
                                                                    }
                                                                    auto Option<string>::None => {}
                                                                }
                                                            }
                                                        }

                                                        auto has_explicit_context = document.find(arg_map, "context") != 0:usize

                                                        if !has_cont_token {
                                                            if parsed_symbol.is_some() {
                                                                if line_opt.is_some() || lines_range_opt.is_some() {
                                                                    send_error(id_str.as_str(), -32602, "Invalid params: 'symbol' is mutually exclusive with 'line' and 'lines'")
                                                                    continue
                                                                }
                                                                if block_val {
                                                                    send_error(id_str.as_str(), -32602, "Invalid params: 'block' cannot be used with 'symbol'")
                                                                    continue
                                                                }
                                                                if has_explicit_context {
                                                                    send_error(id_str.as_str(), -32602, "Invalid params: 'context' cannot be used with 'symbol'")
                                                                    continue
                                                                }
                                                            } else {
                                                                if line_opt.is_none() && lines_range_opt.is_none() {
                                                                    send_error(id_str.as_str(), -32602, "Invalid params: viewing requires either 'line', 'lines', or 'symbol'")
                                                                    continue
                                                                }
                                                                if line_opt.is_some() && lines_range_opt.is_some() {
                                                                    send_error(id_str.as_str(), -32602, "Invalid params: cannot specify both 'line' and 'lines'")
                                                                    continue
                                                                }
                                                                if block_val && lines_range_opt.is_some() {
                                                                    send_error(id_str.as_str(), -32602, "Invalid params: 'block' cannot be used with explicit 'lines' range")
                                                                    continue
                                                                }
                                                            }
                                                        }

                                                        auto max_lines_opt# = Option<usize>::Some(200:usize)
                                                        auto max_lines_err# = false
                                                        auto mln = document.find(arg_map, "max_lines")
                                                        if mln != 0:usize {
                                                            auto kind = document.kind(mln)
                                                            if kind == 2:i32 {
                                                                auto n = document.number(mln).unwrap()
                                                                if is_finite(n) && n == floor(n) && n >= 1.0 && n <= 10000.0 {
                                                                    max_lines_opt = Option<usize>::Some(n as usize)
                                                                } else { max_lines_err = true }
                                                            } else if kind == 0:i32 { max_lines_opt = Option<usize>::None }
                                                            else { max_lines_err = true }
                                                        }
                                                        if max_lines_err {
                                                            send_error(id_str.as_str(), -32602, "Invalid params: 'max_lines' must be an integer between 1 and 10000 or null")
                                                            continue
                                                        }

                                                        auto has_mrb = document.find(arg_map, "max_result_bytes") != 0:usize
                                                        auto has_mb = document.find(arg_map, "max_bytes") != 0:usize
                                                        if has_mrb && has_mb {
                                                            send_error(id_str.as_str(), -32602, "Invalid params: Cannot provide both 'max_bytes' and 'max_result_bytes'")
                                                            continue
                                                        }

                                                        auto max_bytes_opt# = Option<usize>::Some(65536:usize)
                                                        auto max_bytes_err# = false
                                                        auto max_bytes_err_msg# = string::from("Invalid params: 'max_result_bytes' must be a size string (e.g. '64K'), non-negative integer, or null")

                                                        auto check_bytes_node# = 0:usize
                                                        auto key_used# = "max_result_bytes"
                                                        if has_mrb {
                                                            check_bytes_node = document.find(arg_map, "max_result_bytes")
                                                        } else if has_mb {
                                                            check_bytes_node = document.find(arg_map, "max_bytes")
                                                            key_used = "max_bytes"
                                                        }

                                                        if check_bytes_node != 0:usize {
                                                            auto kind = document.kind(check_bytes_node)
                                                            if kind == 2:i32 {
                                                                auto n = document.number(check_bytes_node).unwrap()
                                                                if is_finite(n) && n == floor(n) && n >= 0.0 && n <= 9007199254740991.0 {
                                                                    max_bytes_opt = Option<usize>::Some(n as usize)
                                                                } else { max_bytes_err = true }
                                                            } else if kind == 3:i32 {
                                                                auto p_res = parse_size_bytes_strict(document.text(check_bytes_node), key_used)
                                                                if p_res.is_ok() { max_bytes_opt = Option<usize>::Some(p_res.unwrap()) }
                                                                else {
                                                                    max_bytes_err = true
                                                                    max_bytes_err_msg = string::from("Invalid params: ")
                                                                    max_bytes_err_msg#.push_str(p_res.unwrap_err().as_str())
                                                                }
                                                            } else if kind == 0:i32 { max_bytes_opt = Option<usize>::None }
                                                            else { max_bytes_err = true }
                                                        }
                                                        if max_bytes_err {
                                                            send_error(id_str.as_str(), -32602, max_bytes_err_msg.as_str())
                                                            continue
                                                        }

                                                        auto max_columns_opt# = Option<usize>::None
                                                        auto max_columns_err# = false
                                                        auto mcn = document.find(arg_map, "max_columns")
                                                        if mcn != 0:usize {
                                                            auto kind = document.kind(mcn)
                                                            if kind == 2:i32 {
                                                                auto n = document.number(mcn).unwrap()
                                                                if is_finite(n) && n == floor(n) && n >= 0.0 && n <= 9007199254740991.0 {
                                                                    max_columns_opt = Option<usize>::Some(n as usize)
                                                                } else { max_columns_err = true }
                                                            } else if kind != 0:i32 { max_columns_err = true }
                                                        }
                                                        if max_columns_err {
                                                            send_error(id_str.as_str(), -32602, "Invalid params: 'max_columns' must be a non-negative integer or null")
                                                            continue
                                                        }

                                                        auto max_block_lines_val# = 80:usize
                                                        auto max_block_lines_err# = false
                                                        auto mbln = document.find(arg_map, "max_block_lines")
                                                        if mbln != 0:usize {
                                                            auto kind = document.kind(mbln)
                                                            if kind == 2:i32 {
                                                                auto n = document.number(mbln).unwrap()
                                                                if is_finite(n) && n == floor(n) && n >= 1.0 && n <= 1000.0 {
                                                                    max_block_lines_val = n as usize
                                                                } else { max_block_lines_err = true }
                                                            } else if kind != 0:i32 { max_block_lines_err = true }
                                                        }
                                                        if max_block_lines_err {
                                                            send_error(id_str.as_str(), -32602, "Invalid params: 'max_block_lines' must be an integer between 1 and 1000 or null")
                                                            continue
                                                        }

                                                        auto format_is_json# = false
                                                        auto format_err# = false
                                                        auto fmn = document.find(arg_map, "format")
                                                        if fmn != 0:usize {
                                                            if document.kind(fmn) == 3:i32 {
                                                                auto fms = document.text(fmn)
                                                                if fms == "json" { format_is_json = true }
                                                                else if fms != "text" { format_err = true }
                                                            } else { format_err = true }
                                                        }
                                                        if format_err {
                                                            send_error(id_str.as_str(), -32602, "Invalid params: 'format' must be one of [\"text\", \"json\"]")
                                                            continue
                                                        }

                                                        auto target_path# = string::new()
                                                        if !has_cont_token {
                                                            auto target_res = compute_identity_key(startup_cwd.as_str(), path_str.as_str())
                                                            if target_res.is_err() {
                                                                if format_is_json {
                                                                    send_tool_error_json(id_str.as_str(), "Failed to resolve target path")
                                                                } else {
                                                                    send_tool_error(id_str.as_str(), "Failed to resolve target path")
                                                                }
                                                                continue
                                                            }
                                                            target_path = target_res.unwrap()
                                                        }
                                                        auto exec_max_bytes = max_bytes_opt
                                                        auto cont_token_opt# = Option<string>::None
                                                        if has_cont_token {
                                                            cont_token_opt = Option<string>::Some(cont_token_str.clone())
                                                        }
                                                        auto view_opts = ViewOptions(
                                                            file_path = cede target_path,
                                                            line = line_opt,
                                                            context = context_val,
                                                            block = block_val,
                                                            lines_range = lines_range_opt,
                                                            max_lines = max_lines_opt,
                                                            max_result_bytes = exec_max_bytes,
                                                            max_columns = max_columns_opt,
                                                            max_block_lines = max_block_lines_val,
                                                            symbol = cede parsed_symbol,
                                                            symbol_scope = cede parsed_scope,
                                                            continuation = continuation_val || has_cont_token,
                                                            continuation_token = cede cont_token_opt,
                                                            no_hints = true
                                                        )
                                                        auto view_res = execute_view_operation(view_opts)
                                                        if view_res.is_err() {
                                                            if format_is_json {
                                                                send_tool_error_json(id_str.as_str(), view_res.unwrap_err().as_str())
                                                            } else {
                                                                send_tool_error(id_str.as_str(), view_res.unwrap_err().as_str())
                                                            }
                                                            continue
                                                        }
                                                        auto vr# = view_res.unwrap()

                                                        auto is_tool_err# = false
                                                        if vr.selection_status == "multiple_candidates" || vr.selection_status == "unsupported_syntax" || vr.selection_status == "scan_incomplete" || vr.selection_status == "io_error" {
                                                            is_tool_err = true
                                                        }

                                                        if format_is_json {
                                                            auto json_str# = string::new()
                                                            if max_bytes_opt.is_some() {
                                                                auto prune_res = vr#.prune_to_json_budget(max_bytes_opt.unwrap())
                                                                if prune_res.is_err() {
                                                                    send_tool_error_json(id_str.as_str(), prune_res.unwrap_err().as_str())
                                                                    continue
                                                                }
                                                                json_str = prune_res.unwrap()
                                                            } else {
                                                                auto conv_res = vr#.converge_structured()
                                                                if conv_res.is_err() {
                                                                    send_tool_error_json(id_str.as_str(), conv_res.unwrap_err().as_str())
                                                                    continue
                                                                }
                                                                json_str = conv_res.unwrap()
                                                            }

                                                            auto resp# = string::from("{\"jsonrpc\":\"2.0\",\"id\":")
                                                            resp#.push_str(id_str.as_str())
                                                            resp#.push_str(",\"result\":{\"content\":[{\"type\":\"text\",\"text\":\"")
                                                            resp#.push_str(json_escape(json_str.as_str()).as_str())
                                                            resp#.push_str("\"}]")
                                                            if is_tool_err {
                                                                resp#.push_str(",\"isError\":true")
                                                            }

                                                            if server_state.negotiated_version.as_str() == "2025-11-25" {
                                                                resp#.push_str(",\"structuredContent\":")
                                                                resp#.push_str(json_str.as_str())
                                                            }

                                                            resp#.push_str(",\"_meta\":{\"truncated\":")
                                                            if vr.truncated {
                                                                resp#.push_str("true,\"reason\":\"")
                                                                if vr.reason.len() > 0 {
                                                                    resp#.push_str(vr.reason.as_str())
                                                                } else {
                                                                    resp#.push_str("truncated")
                                                                }
                                                                resp#.push_str("\"")
                                                            } else {
                                                                resp#.push_str("false,\"reason\":null")
                                                            }
                                                            resp#.push_str(",\"lines\":")
                                                            resp#.push_str(u64_to_string(vr.lines_emitted as u64).as_str())
                                                            resp#.push_str(",\"bytes\":")
                                                            resp#.push_str(u64_to_string(vr.bytes_emitted as u64).as_str())
                                                            if vr.continuation_active {
                                                                resp#.push_str(",\"continuation_token\":")
                                                                match vr.continuation_token {
                                                                    auto Option<string>::Some(&t) => {
                                                                        resp#.push_str("\"")
                                                                        resp#.push_str(json_escape(t.as_str()).as_str())
                                                                        resp#.push_str("\"")
                                                                    }
                                                                    auto Option<string>::None => {
                                                                        resp#.push_str("null")
                                                                    }
                                                                }
                                                            }
                                                            resp#.push_str(",\"summary\":{\"complete\":")
                                                            if vr.truncated {
                                                                resp#.push_str("false,\"truncated\":true,\"termination_reason\":\"")
                                                                if vr.reason.len() > 0 {
                                                                    resp#.push_str(vr.reason.as_str())
                                                                } else {
                                                                    resp#.push_str("truncated")
                                                                }
                                                                resp#.push_str("\"")
                                                            } else {
                                                                resp#.push_str("true,\"truncated\":false,\"termination_reason\":\"completed\"")
                                                            }
                                                            resp#.push_str("}}}}")
                                                            resp#.push_str("\n")
                                                            send_mcp_response(resp.as_str())
                                                            continue
                                                        }

                                                        auto resp# = string::from("{\"jsonrpc\":\"2.0\",\"id\":")
                                                        resp#.push_str(id_str.as_str())
                                                        resp#.push_str(",\"result\":{\"content\":[{\"type\":\"text\",\"text\":\"")
                                                        resp#.push_str(json_escape(vr.text.as_str()).as_str())
                                                        resp#.push_str("\"}],\"isError\":")
                                                        if is_tool_err {
                                                            resp#.push_str("true")
                                                        } else {
                                                            resp#.push_str("false")
                                                        }

                                                        if server_state.negotiated_version.as_str() == "2025-11-25" {
                                                            resp#.push_str(",\"structuredContent\":")
                                                            resp#.push_str(vr#.format_structured().as_str())
                                                        }

                                                        resp#.push_str(",\"_meta\":{\"truncated\":")
                                                        if vr.truncated {
                                                            resp#.push_str("true,\"reason\":\"")
                                                            if vr.reason.len() > 0 {
                                                                resp#.push_str(vr.reason.as_str())
                                                            } else {
                                                                resp#.push_str("truncated")
                                                            }
                                                            resp#.push_str("\"")
                                                        } else {
                                                            resp#.push_str("false,\"reason\":null")
                                                        }
                                                        resp#.push_str(",\"lines\":")
                                                        resp#.push_str(u64_to_string(vr.lines_emitted as u64).as_str())
                                                        resp#.push_str(",\"bytes\":")
                                                        resp#.push_str(u64_to_string(vr.bytes_emitted as u64).as_str())
                                                        if vr.continuation_active {
                                                            resp#.push_str(",\"continuation_token\":")
                                                            match vr.continuation_token {
                                                                auto Option<string>::Some(&t) => {
                                                                    resp#.push_str("\"")
                                                                    resp#.push_str(json_escape(t.as_str()).as_str())
                                                                    resp#.push_str("\"")
                                                                }
                                                                auto Option<string>::None => {
                                                                    resp#.push_str("null")
                                                                }
                                                            }
                                                        }
                                                        resp#.push_str(",\"summary\":{\"complete\":")
                                                        if vr.truncated {
                                                            resp#.push_str("false,\"truncated\":true,\"termination_reason\":\"")
                                                            if vr.reason.len() > 0 {
                                                                resp#.push_str(vr.reason.as_str())
                                                            } else {
                                                                resp#.push_str("truncated")
                                                            }
                                                            resp#.push_str("\"")
                                                        } else {
                                                            resp#.push_str("true,\"truncated\":false,\"termination_reason\":\"completed\"")
                                                        }
                                                        resp#.push_str("}}}}")
                                                        resp#.push_str("\n")
                                                        send_mcp_response(resp.as_str())
                                                        continue
                                    }

                                    if tool_name.as_str() == "trg_symbols" {
                                        auto arg_map = document.find(p_map, "arguments")
                                        if document.kind(arg_map) != 5:i32 {
                                            send_error(id_str.as_str(), -32602, "Invalid params: arguments must be an object")
                                            continue
                                        }
                                                        auto arg_node# = document.first(arg_map)
                                                        auto unexp_opt# = Option<string>::None
                                                        loop arg_node != 0:usize {
                                                            auto k = document.key(arg_node)
                                                            if k != "path" && k != "kinds" && k != "max_symbols" && k != "max_result_bytes" && k != "max_bytes" && k != "format" {
                                                                unexp_opt = Option<string>::Some(string::from(k))
                                                                break
                                                            }
                                                            arg_node = document.next(arg_node)
                                                        }
                                                        if unexp_opt.is_some() {
                                                            auto err# = string::from("Invalid params: unexpected property '")
                                                            err#.push_str(unexp_opt.unwrap().as_str())
                                                            err#.push_str("'")
                                                            send_error(id_str.as_str(), -32602, err.as_str())
                                                            continue
                                                        }

                                                        auto path_str# = string::new()
                                                        auto has_path# = false
                                                        auto pn = document.find(arg_map, "path")
                                                        if document.kind(pn) == 3:i32 {
                                                            auto ps = document.text(pn)
                                                            if ps.len > 0:usize {
                                                                path_str = string::from(ps)
                                                                has_path = true
                                                            }
                                                        }
                                                        if !has_path {
                                                            send_error(id_str.as_str(), -32602, "Invalid params: 'path' is required and must be a non-empty string")
                                                            continue
                                                        }

                                                        if startup_cwd.as_str() == "/" && !path_str.as_str().starts_with("/") {
                                                            send_error(id_str.as_str(), -32602, "Invalid params: relative path cannot be safely resolved when MCP server working directory is root ('/'); please provide an absolute path")
                                                            continue
                                                        }
                                                        if resolves_to_root(startup_cwd.as_str(), path_str.as_str()) {
                                                            send_error(id_str.as_str(), -32602, "Invalid params: target path resolves to filesystem root ('/'); outlining symbols on root is not allowed in MCP mode")
                                                            continue
                                                        }

                                                        auto kinds_opt# = Option<Vec<string>>::None
                                                        auto kinds_err# = false
                                                        auto kn = document.find(arg_map, "kinds")
                                                        if kn != 0:usize {
                                                            auto kind = document.kind(kn)
                                                            if kind == 4:i32 {
                                                                auto elem# = document.first(kn)
                                                                if elem == 0:usize { kinds_err = true }
                                                                else {
                                                                    auto k_vec# = Vec<string>::new()
                                                                    loop elem != 0:usize {
                                                                        if document.kind(elem) != 3:i32 {
                                                                            kinds_err = true
                                                                            break
                                                                        }
                                                                        k_vec#.push(string::from(document.text(elem)))
                                                                        elem = document.next(elem)
                                                                    }
                                                                    if !kinds_err { kinds_opt = Option<Vec<string>>::Some(cede k_vec) }
                                                                }
                                                            } else if kind != 0:i32 { kinds_err = true }
                                                        }
                                                        if kinds_err {
                                                            send_error(id_str.as_str(), -32602, "Invalid params: 'kinds' must be a non-empty array of strings or null")
                                                            continue
                                                        }

                                                        auto max_symbols_opt# = Option<usize>::None
                                                        auto max_symbols_err# = false
                                                        auto ms_node = document.find(arg_map, "max_symbols")
                                                        if ms_node != 0:usize {
                                                            auto kind = document.kind(ms_node)
                                                            if kind == 2:i32 {
                                                                auto n = document.number(ms_node).unwrap()
                                                                if is_finite(n) && n == floor(n) && n >= 1.0 && n <= 10000.0 {
                                                                    max_symbols_opt = Option<usize>::Some(n as usize)
                                                                } else { max_symbols_err = true }
                                                            } else if kind != 0:i32 { max_symbols_err = true }
                                                        }
                                                        if max_symbols_err {
                                                            send_error(id_str.as_str(), -32602, "Invalid params: 'max_symbols' must be an integer between 1 and 10000 or null")
                                                            continue
                                                        }

                                                        auto has_mrb = document.find(arg_map, "max_result_bytes") != 0:usize
                                                        auto has_mb = document.find(arg_map, "max_bytes") != 0:usize
                                                        if has_mrb && has_mb {
                                                            send_error(id_str.as_str(), -32602, "Invalid params: Cannot provide both 'max_bytes' and 'max_result_bytes'")
                                                            continue
                                                        }

                                                        auto max_bytes_opt# = Option<usize>::Some(65536:usize)
                                                        auto max_bytes_err# = false
                                                        auto max_bytes_err_msg# = string::from("Invalid params: 'max_result_bytes' must be a size string (e.g. '64K'), non-negative integer, or null")

                                                        auto check_bytes_node# = 0:usize
                                                        auto key_used# = "max_result_bytes"
                                                        if has_mrb {
                                                            check_bytes_node = document.find(arg_map, "max_result_bytes")
                                                        } else if has_mb {
                                                            check_bytes_node = document.find(arg_map, "max_bytes")
                                                            key_used = "max_bytes"
                                                        }

                                                        if check_bytes_node != 0:usize {
                                                            auto kind = document.kind(check_bytes_node)
                                                            if kind == 2:i32 {
                                                                auto n = document.number(check_bytes_node).unwrap()
                                                                if is_finite(n) && n == floor(n) && n >= 0.0 && n <= 9007199254740991.0 {
                                                                    max_bytes_opt = Option<usize>::Some(n as usize)
                                                                } else { max_bytes_err = true }
                                                            } else if kind == 3:i32 {
                                                                auto p_res = parse_size_bytes_strict(document.text(check_bytes_node), key_used)
                                                                if p_res.is_ok() { max_bytes_opt = Option<usize>::Some(p_res.unwrap()) }
                                                                else {
                                                                    max_bytes_err = true
                                                                    max_bytes_err_msg = string::from("Invalid params: ")
                                                                    max_bytes_err_msg#.push_str(p_res.unwrap_err().as_str())
                                                                }
                                                            } else if kind == 0:i32 { max_bytes_opt = Option<usize>::None }
                                                            else { max_bytes_err = true }
                                                        }
                                                        if max_bytes_err {
                                                            send_error(id_str.as_str(), -32602, max_bytes_err_msg.as_str())
                                                            continue
                                                        }

                                                        auto format_is_json# = false
                                                        auto format_err# = false
                                                        auto fmn = document.find(arg_map, "format")
                                                        if fmn != 0:usize {
                                                            if document.kind(fmn) == 3:i32 {
                                                                auto fms = document.text(fmn)
                                                                if fms == "json" { format_is_json = true }
                                                                else if fms != "text" { format_err = true }
                                                            } else { format_err = true }
                                                        }
                                                        if format_err {
                                                            send_error(id_str.as_str(), -32602, "Invalid params: 'format' must be one of [\"text\", \"json\"]")
                                                            continue
                                                        }

                                                        auto target_res = compute_identity_key(startup_cwd.as_str(), path_str.as_str())
                                                        if target_res.is_err() {
                                                            if format_is_json {
                                                                send_tool_error_json(id_str.as_str(), "Failed to resolve target path")
                                                            } else {
                                                                send_tool_error(id_str.as_str(), "Failed to resolve target path")
                                                            }
                                                            continue
                                                        }
                                                        auto target_path = target_res.unwrap()

                                                        auto sym_opts = SymbolsOptions(
                                                            file_path = cede target_path,
                                                            kinds = cede kinds_opt,
                                                            max_input_bytes = Option<usize>::None,
                                                            max_symbols = max_symbols_opt,
                                                            max_result_bytes = max_bytes_opt,
                                                            json_output = format_is_json
                                                        )
                                                        auto sym_res = outline_symbols_file(sym_opts)
                                                        if sym_res.is_err() {
                                                            if format_is_json {
                                                                send_tool_error_json(id_str.as_str(), sym_res.unwrap_err().as_str())
                                                            } else {
                                                                send_tool_error(id_str.as_str(), sym_res.unwrap_err().as_str())
                                                            }
                                                            continue
                                                        }
                                                        auto sr = sym_res.unwrap()

                                                        auto text_content# = string::new()
                                                        if format_is_json {
                                                            text_content = format_symbols_structured(sr)
                                                        } else {
                                                            text_content = format_symbols_text_tree(sr)
                                                        }

                                                        auto resp# = string::from("{\"jsonrpc\":\"2.0\",\"id\":")
                                                        resp#.push_str(id_str.as_str())
                                                        resp#.push_str(",\"result\":{\"content\":[{\"type\":\"text\",\"text\":\"")
                                                        resp#.push_str(json_escape(text_content.as_str()).as_str())
                                                        resp#.push_str("\"}],\"isError\":false")

                                                        if server_state.negotiated_version.as_str() == "2025-11-25" {
                                                            resp#.push_str(",\"structuredContent\":")
                                                            resp#.push_str(format_symbols_structured(sr).as_str())
                                                        }

                                                        resp#.push_str(",\"_meta\":{\"truncated\":")
                                                        if sr.truncated {
                                                            resp#.push_str("true,\"reason\":\"")
                                                            if sr.termination_reason.len() > 0 {
                                                                resp#.push_str(sr.termination_reason.as_str())
                                                            } else {
                                                                resp#.push_str("truncated")
                                                            }
                                                            resp#.push_str("\"")
                                                        } else {
                                                            resp#.push_str("false,\"reason\":null")
                                                        }
                                                        resp#.push_str(",\"total_symbols\":")
                                                        resp#.push_str(u64_to_string(sr.total_symbols as u64).as_str())
                                                        resp#.push_str(",\"summary\":{\"complete\":")
                                                        if sr.truncated {
                                                            resp#.push_str("false,\"truncated\":true,\"termination_reason\":\"")
                                                            if sr.termination_reason.len() > 0 {
                                                                resp#.push_str(sr.termination_reason.as_str())
                                                            } else {
                                                                resp#.push_str("truncated")
                                                            }
                                                            resp#.push_str("\"")
                                                        } else {
                                                            resp#.push_str("true,\"truncated\":false,\"termination_reason\":\"completed\"")
                                                        }
                                                        resp#.push_str("}}}}")
                                                        resp#.push_str("\n")
                                                        send_mcp_response(resp.as_str())
                                                        continue
                                    }

                                    auto arg_map = document.find(p_map, "arguments")
                                    if document.kind(arg_map) != 5:i32 {
                                        send_error(id_str.as_str(), -32602, "Invalid params: arguments must be an object")
                                        continue
                                    }
                                    auto format_node = document.find(arg_map, "format")
                                    auto is_format_json = document.kind(format_node) == 3:i32 && document.text(format_node) == "json"
                                            auto build_res = build_mcp_cli_args(document, arg_map, startup_cwd.as_str())
                                            if build_res.is_err() {
                                                send_error(id_str.as_str(), -32602, build_res.unwrap_err().as_str())
                                                continue
                                            }
                                                    auto argv = build_res.unwrap()
                                                    auto opts_res = parse_cli_args_from_vec(argv)
                                                    if opts_res.is_err() {
                                                        send_error(id_str.as_str(), -32602, opts_res.unwrap_err().as_str())
                                                        continue
                                                    }
                                                    auto search_opts = opts_res.unwrap()
                                                    auto val_res = validate_mcp_cli_options(search_opts, startup_cwd.as_str())
                                                    if val_res.is_err() {
                                                        send_error(id_str.as_str(), -32602, val_res.unwrap_err().as_str())
                                                        continue
                                                    }
                                                    auto fmt_cfg = FormatConfig::from_options(&search_opts)
                                                    auto writer# = OutputBudgetWriter::new_mcp(
                                                        startup_cwd.clone(),
                                                        search_opts.text_layout,
                                                        search_opts.path_style,
                                                        fmt_cfg
                                                    )
                                                    auto search_res = execute_search(search_opts, writer#)
                                                    auto report# = SearchReport(
                                                        found_result = false,
                                                        had_error = false,
                                                        is_broken_pipe = false,
                                                        budget_state = BudgetState::new(search_opts.budget_limits),
                                                        elapsed_nanos = 0:u64,
                                                        diagnostics = Vec<SearchDiagnostic>::new()
                                                    )
                                                    if search_res.is_err() {
                                                        auto diag = search_res.unwrap_err()
                                                        auto all_diag# = Vec<SearchDiagnostic>::new()
                                                        all_diag#.push(diag)
                                                        auto bstate = BudgetState::new(search_opts.budget_limits)
                                                        report = SearchReport(
                                                            found_result = false,
                                                            had_error = true,
                                                            is_broken_pipe = false,
                                                            budget_state = cede bstate,
                                                            elapsed_nanos = 0:u64,
                                                            diagnostics = cede all_diag
                                                        )
                                                    } else {
                                                        report = search_res.unwrap()
                                                        finalize_search(search_opts, writer#, report)
                                                    }
                                                    auto resp = format_tool_call_response(id_str, report, search_opts, writer, server_state.negotiated_version.as_str(), is_format_json)
                                                    send_mcp_response(resp.as_str())
                } else {
                    send_error(id_str.as_str(), -32601, "Method not found")
                }
    }
    return 0
}
