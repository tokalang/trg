// Native stdio JSON-RPC 2.0 MCP (Model Context Protocol) server for trg.
import core/str::{str}
import core/option::{Option}
import core/result::{Result}
import std/vec::{Vec}
import std/hashmap::{HashMap}
import stdx/serde/json::{JsonNode}
import std/math::{is_finite, floor}
import src/types::{CliOptions, OutputFormat}
import src/posix::{posix_write_stdout, posix_read_stdin_line}
import src/cli::{parse_cli_args_from_vec}
import src/parse::{parse_usize_strict, parse_size_bytes_strict}
import src/printer::{
    OutputBudgetWriter,
    EmitOutcome,
    u64_to_string,
    i64_to_string,
    json_escape
}
import src/executor::{execute_search, finalize_search}

pub shape McpParamError (
    message: string
)

fn get_string_param(map: HashMap<string, JsonNode>, key: str) -> Result<Option<string>, McpParamError> {
    match map.try_borrow(string::from(key)) {
        auto Option<&JsonNode>::Some(&node) => {
            match node {
                auto JsonNode::StrNode(&s) => {
                    return Result<Option<string>, McpParamError>::Ok(Option<string>::Some(s.clone()))
                }
                _ => {
                    auto err# = string::from("Invalid params: '")
                    err#.push_str(key)
                    err#.push_str("' must be a string")
                    return Result<Option<string>, McpParamError>::Err(McpParamError(message = cede err))
                }
            }
        }
        _ => {
            return Result<Option<string>, McpParamError>::Ok(Option<string>::None)
        }
    }
}

fn get_bool_param(map: HashMap<string, JsonNode>, key: str) -> Result<Option<bool>, McpParamError> {
    match map.try_borrow(string::from(key)) {
        auto Option<&JsonNode>::Some(&node) => {
            match node {
                auto JsonNode::BoolNode(b) => {
                    return Result<Option<bool>, McpParamError>::Ok(Option<bool>::Some(b))
                }
                _ => {
                    auto err# = string::from("Invalid params: '")
                    err#.push_str(key)
                    err#.push_str("' must be a boolean")
                    return Result<Option<bool>, McpParamError>::Err(McpParamError(message = cede err))
                }
            }
        }
        _ => {
            return Result<Option<bool>, McpParamError>::Ok(Option<bool>::None)
        }
    }
}

fn get_usize_param(map: HashMap<string, JsonNode>, key: str) -> Result<Option<usize>, McpParamError> {
    match map.try_borrow(string::from(key)) {
        auto Option<&JsonNode>::Some(&node) => {
            match node {
                auto JsonNode::NumNode(f) => {
                    if is_finite(f) && f >= 0.0 && f == floor(f) && f <= 9007199254740991.0 {
                        return Result<Option<usize>, McpParamError>::Ok(Option<usize>::Some(f as usize))
                    }
                    auto err# = string::from("Invalid params: '")
                    err#.push_str(key)
                    err#.push_str("' must be a non-negative integer <= 2^53-1")
                    return Result<Option<usize>, McpParamError>::Err(McpParamError(message = cede err))
                }
                auto JsonNode::StrNode(&s) => {
                    auto p_res = parse_usize_strict(s.as_str(), key)
                    if p_res.is_ok() {
                        auto val = p_res.unwrap()
                        if val <= 9007199254740991:usize {
                            return Result<Option<usize>, McpParamError>::Ok(Option<usize>::Some(val))
                        }
                    }
                    auto err# = string::from("Invalid params: '")
                    err#.push_str(key)
                    err#.push_str("' must be a non-negative integer <= 2^53-1")
                    return Result<Option<usize>, McpParamError>::Err(McpParamError(message = cede err))
                }
                _ => {
                    auto err# = string::from("Invalid params: '")
                    err#.push_str(key)
                    err#.push_str("' must be an integer")
                    return Result<Option<usize>, McpParamError>::Err(McpParamError(message = cede err))
                }
            }
        }
        _ => {
            return Result<Option<usize>, McpParamError>::Ok(Option<usize>::None)
        }
    }
}

fn get_size_param(map: HashMap<string, JsonNode>, key: str) -> Result<Option<string>, McpParamError> {
    match map.try_borrow(string::from(key)) {
        auto Option<&JsonNode>::Some(&node) => {
            match node {
                auto JsonNode::StrNode(&s) => {
                    auto p_res = parse_size_bytes_strict(s.as_str(), key)
                    if p_res.is_err() {
                        auto err# = string::from("Invalid params: ")
                        err#.push_str(p_res.unwrap_err().as_str())
                        return Result<Option<string>, McpParamError>::Err(McpParamError(message = cede err))
                    }
                    return Result<Option<string>, McpParamError>::Ok(Option<string>::Some(s.clone()))
                }
                auto JsonNode::NumNode(f) => {
                    if is_finite(f) && f >= 0.0 && f == floor(f) && f <= 9007199254740991.0 {
                        return Result<Option<string>, McpParamError>::Ok(Option<string>::Some(u64_to_string(f as u64)))
                    }
                    auto err# = string::from("Invalid params: '")
                    err#.push_str(key)
                    err#.push_str("' must be a non-negative integer or valid size string")
                    return Result<Option<string>, McpParamError>::Err(McpParamError(message = cede err))
                }
                _ => {
                    auto err# = string::from("Invalid params: '")
                    err#.push_str(key)
                    err#.push_str("' must be a string or integer")
                    return Result<Option<string>, McpParamError>::Err(McpParamError(message = cede err))
                }
            }
        }
        _ => {
            return Result<Option<string>, McpParamError>::Ok(Option<string>::None)
        }
    }
}

fn get_string_array_param(map: HashMap<string, JsonNode>, key: str) -> Result<Option<Vec<string>>, McpParamError> {
    match map.try_borrow(string::from(key)) {
        auto Option<&JsonNode>::Some(&node) => {
            match node {
                auto JsonNode::ArrayNode(&arr) => {
                    auto res# = Vec<string>::new()
                    auto i# = 0:usize
                    loop i < arr.len() {
                        auto &item = arr.borrow(i)
                        match item {
                            auto JsonNode::StrNode(&s) => {
                                res#.push(s.clone())
                            }
                            _ => {
                                auto err# = string::from("Invalid params: '")
                                err#.push_str(key)
                                err#.push_str("' items must be strings")
                                return Result<Option<Vec<string>>, McpParamError>::Err(McpParamError(message = cede err))
                            }
                        }
                        i = i + 1
                    }
                    return Result<Option<Vec<string>>, McpParamError>::Ok(Option<Vec<string>>::Some(cede res))
                }
                _ => {
                    auto err# = string::from("Invalid params: '")
                    err#.push_str(key)
                    err#.push_str("' must be an array of strings")
                    return Result<Option<Vec<string>>, McpParamError>::Err(McpParamError(message = cede err))
                }
            }
        }
        _ => {
            return Result<Option<Vec<string>>, McpParamError>::Ok(Option<Vec<string>>::None)
        }
    }
}

fn check_args_conflict(prop: str, flag: str, args: Vec<string>) -> Option<string> {
    auto flag_prefix# = string::from(flag)
    flag_prefix#.push_str("=")
    auto i# = 0:usize
    loop i < args.len() {
        auto &a = args.borrow(i)
        auto a_str = a.as_str()
        if a_str == flag || a_str.starts_with(flag_prefix.as_str()) {
            auto msg# = string::from("Invalid params: typed property '")
            msg#.push_str(prop)
            msg#.push_str("' conflicts with args option '")
            msg#.push_str(a_str)
            msg#.push_str("'")
            return Option<string>::Some(cede msg)
        }
        i = i + 1
    }
    return Option<string>::None
}

pub shape JsonIdResult (
    has_id: bool,
    is_valid: bool,
    id_str: string
)

fn json_map_extract_id(map: HashMap<string, JsonNode>) -> JsonIdResult {
    match map.try_borrow(string::from("id")) {
        auto Option<&JsonNode>::Some(&node) => {
            match node {
                auto JsonNode::NumNode(n) => {
                    if is_finite(n) && n == floor(n) && n >= -9007199254740991.0 && n <= 9007199254740991.0 {
                        return JsonIdResult(has_id = true, is_valid = true, id_str = i64_to_string(n as i64))
                    }
                    return JsonIdResult(has_id = true, is_valid = false, id_str = string::from("null"))
                }
                auto JsonNode::StrNode(&s) => {
                    auto out# = string::from("\"")
                    out#.push_str(json_escape(s.as_str()).as_str())
                    out#.push_str("\"")
                    return JsonIdResult(has_id = true, is_valid = true, id_str = cede out)
                }
                auto JsonNode::NullNode(_) => {
                    return JsonIdResult(has_id = true, is_valid = true, id_str = string::from("null"))
                }
                _ => {
                    return JsonIdResult(has_id = true, is_valid = false, id_str = string::from("null"))
                }
            }
        }
        _ => {
            return JsonIdResult(has_id = false, is_valid = true, id_str = string::from("null"))
        }
    }
}

pub shape McpSearchResult (
    output_text: string,
    complete: bool,
    truncated: bool,
    termination_reason: string,
    matches_emitted: usize,
    files_scanned: usize,
    file_scan_passes: usize
)

pub fn run_search_to_memory(opts: CliOptions) -> Result<McpSearchResult, string> {
    auto format = OutputFormat::from_cli_options(opts)
    auto writer = OutputBudgetWriter::new_memory(format)
    auto search_res = execute_search(opts, writer)
    if search_res.is_err() {
        return Result<McpSearchResult, string>::Err(search_res.unwrap_err())
    }
    auto report = search_res.unwrap()

    auto fin_outcome = finalize_search(opts, writer, report)
    match fin_outcome {
        EmitOutcome::FatalError => {
            return Result<McpSearchResult, string>::Err(string::from("Write error"))
        }
        _ => {}
    }

    auto is_trunc = report.budget_state.is_truncated
    auto is_comp = !is_trunc && !report.had_error
    auto term_reason# = string::from("completed")
    if is_trunc {
        term_reason = report.budget_state.truncation_reason.clone()
    } else if report.had_error {
        term_reason = string::from("search_error")
    }

    auto emitted# = report.budget_state.matched_lines_emitted
    if opts.files_mode {
        emitted = report.budget_state.files_scanned
    }

    return Result<McpSearchResult, string>::Ok(McpSearchResult(
        output_text = writer.take_output(),
        complete = is_comp,
        truncated = is_trunc,
        termination_reason = cede term_reason,
        matches_emitted = emitted,
        files_scanned = report.budget_state.files_scanned,
        file_scan_passes = report.budget_state.file_scan_passes
    ))
}

fn send_mcp_response(resp: str) -> bool {
    auto s# = string::from(resp)
    s#.push_str("\n")
    auto res = posix_write_stdout(s.as_str())
    return res == 0
}

fn send_error(id_str: str, code: i32, message: str) -> bool {
    auto resp# = string::from("{\"jsonrpc\":\"2.0\",\"id\":")
    resp#.push_str(id_str)
    resp#.push_str(",\"error\":{\"code\":")
    resp#.push_str(string::from_int(code).as_str())
    resp#.push_str(",\"message\":\"")
    resp#.push_str(json_escape(message).as_str())
    resp#.push_str("\"}}")
    return send_mcp_response(resp.as_str())
}

fn send_tool_error(id_str: str, message: str) -> bool {
    auto resp# = string::from("{\"jsonrpc\":\"2.0\",\"id\":")
    resp#.push_str(id_str)
    resp#.push_str(",\"result\":{\"content\":[{\"type\":\"text\",\"text\":\"")
    resp#.push_str(json_escape(message).as_str())
    resp#.push_str("\"}],\"isError\":true}}")
    return send_mcp_response(resp.as_str())
}

pub fn run_mcp_server() -> i32 {
    loop true {
        auto line_opt = posix_read_stdin_line()
        if line_opt.is_none() {
            break
        }
        auto line_str = line_opt.unwrap()
        auto trimmed = line_str.as_str().trim()
        if trimmed.len == 0 {
            continue
        }

        auto root# = JsonNode::NullNode(0):JsonNode
        auto parse_err# = false
        match root#.parse_json(trimmed) {
            auto Result<str, str>::Ok('rem) => {
                if 'rem.trim().len > 0 {
                    parse_err = true
                }
            }
            auto Result<str, str>::Err('e) => {
                parse_err = true
            }
        }
        if parse_err {
            send_error("null", -32700, "Parse error")
            continue
        }

        match root {
            auto JsonNode::ObjectNode(&map) => {
                auto id_res = json_map_extract_id(map)
                auto has_id = id_res.has_id
                auto id_str = id_res.id_str.clone()

                if has_id && !id_res.is_valid {
                    send_error("null", -32600, "Invalid Request: id must be a string, safe integer, or null")
                    continue
                }

                // Verify "jsonrpc" == "2.0"
                auto valid_rpc# = false
                match map.try_borrow(string::from("jsonrpc")) {
                    auto Option<&JsonNode>::Some(&rpc_node) => {
                        match rpc_node {
                            auto JsonNode::StrNode(&rpc_s) => {
                                if rpc_s.as_str() == "2.0" {
                                    valid_rpc = true
                                }
                            }
                            _ => {}
                        }
                    }
                    _ => {}
                }
                if !valid_rpc {
                    send_error(id_str.as_str(), -32600, "Invalid Request")
                    continue
                }

                // Verify "method" is string
                auto method_res = get_string_param(map, "method")
                auto method# = string::new()
                match method_res {
                    auto Result::Ok(m_opt) => {
                        match m_opt {
                            auto Option::Some(&m_str) => {
                                method = m_str.clone()
                            }
                            auto Option::None => {
                                send_error(id_str.as_str(), -32600, "Invalid Request")
                                continue
                            }
                        }
                    }
                    auto Result::Err(_) => {
                        send_error(id_str.as_str(), -32600, "Invalid Request")
                        continue
                    }
                }

                // Notifications (no id) MUST NOT receive a response per JSON-RPC 2.0
                if !has_id {
                    continue
                }

                if method.as_str() == "initialize" {
                    auto resp# = string::from("{\"jsonrpc\":\"2.0\",\"id\":")
                    resp#.push_str(id_str.as_str())
                    resp#.push_str(",\"result\":{\"protocolVersion\":\"2024-11-05\",\"capabilities\":{\"tools\":{}},\"serverInfo\":{\"name\":\"trg\",\"version\":\"0.9.2\"}}}")
                    send_mcp_response(resp.as_str())
                } else if method.as_str() == "ping" {
                    auto resp# = string::from("{\"jsonrpc\":\"2.0\",\"id\":")
                    resp#.push_str(id_str.as_str())
                    resp#.push_str(",\"result\":{}}")
                    send_mcp_response(resp.as_str())
                } else if method.as_str() == "tools/list" {
                    auto resp# = string::from("{\"jsonrpc\":\"2.0\",\"id\":")
                    resp#.push_str(id_str.as_str())
                    resp#.push_str(",\"result\":{\"tools\":[{\"name\":\"trg_search\",\"description\":\"Fast ripgrep-compatible code search with semantic block context, scopes, and budget control.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"pattern\":{\"type\":\"string\",\"description\":\"Search pattern (literal or regex with -E)\"},\"path\":{\"type\":\"string\",\"description\":\"Path or directory to search\"},\"block\":{\"type\":\"boolean\",\"description\":\"Include enclosing code block context\"},\"scope\":{\"type\":\"boolean\",\"description\":\"Show enclosing class/function header for matches\"},\"def_first\":{\"type\":\"boolean\",\"description\":\"Prioritize definitions before usages\"},\"max_matches\":{\"type\":\"integer\",\"description\":\"Limit total matches returned (integer >= 0)\"},\"max_bytes\":{\"description\":\"Limit total result bytes emitted (e.g. \\\"4K\\\", \\\"1M\\\", or integer bytes)\",\"oneOf\":[{\"type\":\"string\"},{\"type\":\"integer\"}]},\"type\":{\"type\":\"string\",\"description\":\"Filter by file type (e.g. rust, py, tk)\"},\"args\":{\"type\":\"array\",\"items\":{\"type\":\"string\"},\"description\":\"Additional CLI arguments, e.g. [\\\"--json=compact\\\"]\"}},\"required\":[\"pattern\"]}}]}}")
                    send_mcp_response(resp.as_str())
                } else if method.as_str() == "tools/call" {
                    match map.try_borrow(string::from("params")) {
                        auto Option<&JsonNode>::Some(&p_val) => {
                            match p_val {
                                auto JsonNode::ObjectNode(&p_map) => {
                                    auto tool_name_res = get_string_param(p_map, "name")
                                    auto tool_name# = string::new()
                                    match tool_name_res {
                                        auto Result::Ok(t_opt) => {
                                            match t_opt {
                                                auto Option::Some(&t_str) => {
                                                    tool_name = t_str.clone()
                                                }
                                                auto Option::None => {
                                                    send_error(id_str.as_str(), -32602, "Invalid params: 'name' must be a string")
                                                    continue
                                                }
                                            }
                                        }
                                        auto Result::Err(_) => {
                                            send_error(id_str.as_str(), -32602, "Invalid params: 'name' must be a string")
                                            continue
                                        }
                                    }
                                    if tool_name.as_str() != "trg_search" {
                                        send_error(id_str.as_str(), -32602, "Invalid params: Unknown tool")
                                        continue
                                    }

                                    match p_map.try_borrow(string::from("arguments")) {
                                        auto Option<&JsonNode>::Some(&a_val) => {
                                            match a_val {
                                                auto JsonNode::ObjectNode(&a_map) => {
                                                    // 1. Validate required "pattern"
                                                    auto pat_res = get_string_param(a_map, "pattern")
                                                    if pat_res.is_err() {
                                                        send_error(id_str.as_str(), -32602, pat_res.unwrap_err().message.as_str())
                                                        continue
                                                    }
                                                    auto pat_opt = pat_res.unwrap()
                                                    if pat_opt.is_none() {
                                                        send_error(id_str.as_str(), -32602, "Invalid params: 'pattern' is required and must be a string")
                                                        continue
                                                    }
                                                    auto pattern = pat_opt.unwrap()

                                                    // 2. Validate "path"
                                                    auto path_res = get_string_param(a_map, "path")
                                                    if path_res.is_err() {
                                                        send_error(id_str.as_str(), -32602, path_res.unwrap_err().message.as_str())
                                                        continue
                                                    }
                                                    auto path_opt = path_res.unwrap()

                                                    // 3. Validate "block"
                                                    auto block_res = get_bool_param(a_map, "block")
                                                    if block_res.is_err() {
                                                        send_error(id_str.as_str(), -32602, block_res.unwrap_err().message.as_str())
                                                        continue
                                                    }
                                                    auto block_opt = block_res.unwrap()

                                                    // 4. Validate "scope"
                                                    auto scope_res = get_bool_param(a_map, "scope")
                                                    if scope_res.is_err() {
                                                        send_error(id_str.as_str(), -32602, scope_res.unwrap_err().message.as_str())
                                                        continue
                                                    }
                                                    auto scope_opt = scope_res.unwrap()

                                                    // 5. Validate "def_first"
                                                    auto def_first_res = get_bool_param(a_map, "def_first")
                                                    if def_first_res.is_err() {
                                                        send_error(id_str.as_str(), -32602, def_first_res.unwrap_err().message.as_str())
                                                        continue
                                                    }
                                                    auto def_first_opt = def_first_res.unwrap()

                                                    // 6. Validate "max_matches"
                                                    auto max_matches_res = get_usize_param(a_map, "max_matches")
                                                    if max_matches_res.is_err() {
                                                        send_error(id_str.as_str(), -32602, max_matches_res.unwrap_err().message.as_str())
                                                        continue
                                                    }
                                                    auto max_matches_opt = max_matches_res.unwrap()

                                                    // 7. Validate "max_bytes"
                                                    auto max_bytes_res = get_size_param(a_map, "max_bytes")
                                                    if max_bytes_res.is_err() {
                                                        send_error(id_str.as_str(), -32602, max_bytes_res.unwrap_err().message.as_str())
                                                        continue
                                                    }
                                                    auto max_bytes_opt = max_bytes_res.unwrap()

                                                    // 8. Validate "type"
                                                    auto type_res = get_string_param(a_map, "type")
                                                    if type_res.is_err() {
                                                        send_error(id_str.as_str(), -32602, type_res.unwrap_err().message.as_str())
                                                        continue
                                                    }
                                                    auto type_opt = type_res.unwrap()

                                                    // 9. Validate "args"
                                                    auto extra_args# = Vec<string>::new()
                                                    if a_map.contains_key(string::from("args")) {
                                                        auto arr_res = get_string_array_param(a_map, "args")
                                                        if arr_res.is_err() {
                                                            send_error(id_str.as_str(), -32602, arr_res.unwrap_err().message.as_str())
                                                            continue
                                                        }
                                                        extra_args = arr_res.unwrap().unwrap()
                                                    }

                                                    // 10. Check conflicts between typed properties and args
                                                    auto conflict_found# = false
                                                    auto conflict_msg# = string::new()

                                                    if block_opt.is_some() {
                                                        auto c1 = check_args_conflict("block", "--block", extra_args)
                                                        auto c2 = check_args_conflict("block", "--context-block", extra_args)
                                                        auto c3 = check_args_conflict("block", "--no-block", extra_args)
                                                        if c1.is_some() { conflict_found = true; conflict_msg = c1.unwrap(); }
                                                        else if c2.is_some() { conflict_found = true; conflict_msg = c2.unwrap(); }
                                                        else if c3.is_some() { conflict_found = true; conflict_msg = c3.unwrap(); }
                                                    }
                                                    if !conflict_found && scope_opt.is_some() {
                                                        auto c1 = check_args_conflict("scope", "--scope", extra_args)
                                                        auto c2 = check_args_conflict("scope", "--no-scope", extra_args)
                                                        if c1.is_some() { conflict_found = true; conflict_msg = c1.unwrap(); }
                                                        else if c2.is_some() { conflict_found = true; conflict_msg = c2.unwrap(); }
                                                    }
                                                    if !conflict_found && def_first_opt.is_some() {
                                                        auto c1 = check_args_conflict("def_first", "--def-first", extra_args)
                                                        auto c2 = check_args_conflict("def_first", "--no-def-first", extra_args)
                                                        if c1.is_some() { conflict_found = true; conflict_msg = c1.unwrap(); }
                                                        else if c2.is_some() { conflict_found = true; conflict_msg = c2.unwrap(); }
                                                    }
                                                    if !conflict_found && max_matches_opt.is_some() {
                                                        auto c1 = check_args_conflict("max_matches", "-m", extra_args)
                                                        auto c2 = check_args_conflict("max_matches", "--max-count", extra_args)
                                                        auto c3 = check_args_conflict("max_matches", "--max-total-matches", extra_args)
                                                        if c1.is_some() { conflict_found = true; conflict_msg = c1.unwrap(); }
                                                        else if c2.is_some() { conflict_found = true; conflict_msg = c2.unwrap(); }
                                                        else if c3.is_some() { conflict_found = true; conflict_msg = c3.unwrap(); }
                                                    }
                                                    if !conflict_found && max_bytes_opt.is_some() {
                                                        auto c1 = check_args_conflict("max_bytes", "--max-result-bytes", extra_args)
                                                        if c1.is_some() { conflict_found = true; conflict_msg = c1.unwrap(); }
                                                    }
                                                    if !conflict_found && type_opt.is_some() {
                                                        auto c1 = check_args_conflict("type", "-t", extra_args)
                                                        auto c2 = check_args_conflict("type", "--type", extra_args)
                                                        if c1.is_some() { conflict_found = true; conflict_msg = c1.unwrap(); }
                                                        else if c2.is_some() { conflict_found = true; conflict_msg = c2.unwrap(); }
                                                    }

                                                    if conflict_found {
                                                        send_error(id_str.as_str(), -32602, conflict_msg.as_str())
                                                        continue
                                                    }

                                                    auto argv# = Vec<string>::new()
                                                    argv#.push(string::from("trg"))
                                                    argv#.push(pattern)
                                                    auto has_path = path_opt.is_some()
                                                    if has_path {
                                                        argv#.push(path_opt.unwrap())
                                                    }
                                                    if block_opt.is_some() {
                                                        auto b = block_opt.unwrap()
                                                        if b {
                                                            argv#.push(string::from("--block"))
                                                        }
                                                    }
                                                    if scope_opt.is_some() {
                                                        auto s = scope_opt.unwrap()
                                                        if s {
                                                            argv#.push(string::from("--scope"))
                                                        }
                                                    }
                                                    if def_first_opt.is_some() {
                                                        auto d = def_first_opt.unwrap()
                                                        if d {
                                                            argv#.push(string::from("--def-first"))
                                                        }
                                                    }
                                                    if max_matches_opt.is_some() {
                                                        argv#.push(string::from("--max-total-matches"))
                                                        argv#.push(u64_to_string(max_matches_opt.unwrap() as u64))
                                                    }
                                                    if max_bytes_opt.is_some() {
                                                        argv#.push(string::from("--max-result-bytes"))
                                                        argv#.push(max_bytes_opt.unwrap())
                                                    }
                                                    if type_opt.is_some() {
                                                        argv#.push(string::from("-t"))
                                                        argv#.push(type_opt.unwrap())
                                                    }
                                                    auto a_idx# = 0:usize
                                                    auto a_len = extra_args.len()
                                                    loop a_idx < a_len {
                                                        argv#.push(extra_args.borrow(a_idx).clone())
                                                        a_idx = a_idx + 1
                                                    }

                                                    auto opts_res = parse_cli_args_from_vec(argv)
                                                    if opts_res.is_err() {
                                                        send_tool_error(id_str.as_str(), opts_res.unwrap_err().as_str())
                                                        continue
                                                    }

                                                    auto search_opts = opts_res.unwrap()
                                                    if has_path && search_opts.paths.len() > 1 {
                                                        auto msg# = string::from("Invalid params: typed property 'path' conflicts with positional arg '")
                                                        msg#.push_str(search_opts.paths.borrow(1).as_str())
                                                        msg#.push_str("'")
                                                        send_error(id_str.as_str(), -32602, msg.as_str())
                                                        continue
                                                    }
                                                    auto search_res = run_search_to_memory(search_opts)
                                                    if search_res.is_err() {
                                                        send_tool_error(id_str.as_str(), search_res.unwrap_err().as_str())
                                                        continue
                                                    }

                                                    auto mcp_res = search_res.unwrap()
                                                    auto text_out# = mcp_res.output_text.clone()

                                                    if !search_opts.json_mode {
                                                        if text_out.len() > 0 && !text_out.as_str().ends_with("\n") {
                                                            text_out#.push_str("\n")
                                                        }
                                                        text_out#.push_str("[trg: complete=")
                                                        if mcp_res.complete { text_out#.push_str("true") } else { text_out#.push_str("false") }
                                                        text_out#.push_str(", truncated=")
                                                        if mcp_res.truncated { text_out#.push_str("true") } else { text_out#.push_str("false") }
                                                        text_out#.push_str(", reason=")
                                                        text_out#.push_str(mcp_res.termination_reason.as_str())
                                                        text_out#.push_str(", matches=")
                                                        text_out#.push_str(u64_to_string(mcp_res.matches_emitted as u64).as_str())
                                                        text_out#.push_str(", scanned=")
                                                        text_out#.push_str(u64_to_string(mcp_res.files_scanned as u64).as_str())
                                                        text_out#.push_str(", passes=")
                                                        text_out#.push_str(u64_to_string(mcp_res.file_scan_passes as u64).as_str())
                                                        text_out#.push_str("]\n")
                                                    }

                                                    auto esc_output = json_escape(text_out.as_str())
                                                    auto esc_reason = json_escape(mcp_res.termination_reason.as_str())

                                                    auto resp# = string::from("{\"jsonrpc\":\"2.0\",\"id\":")
                                                    resp#.push_str(id_str.as_str())
                                                    resp#.push_str(",\"result\":{\"content\":[{\"type\":\"text\",\"text\":\"")
                                                    resp#.push_str(esc_output.as_str())
                                                    resp#.push_str("\"}],\"_meta\":{\"summary\":{\"complete\":")
                                                    if mcp_res.complete { resp#.push_str("true") } else { resp#.push_str("false") }
                                                    resp#.push_str(",\"truncated\":")
                                                    if mcp_res.truncated { resp#.push_str("true") } else { resp#.push_str("false") }
                                                    resp#.push_str(",\"termination_reason\":\"")
                                                    resp#.push_str(esc_reason.as_str())
                                                    resp#.push_str("\",\"matches_emitted\":")
                                                    resp#.push_str(u64_to_string(mcp_res.matches_emitted as u64).as_str())
                                                    resp#.push_str(",\"files_scanned\":")
                                                    resp#.push_str(u64_to_string(mcp_res.files_scanned as u64).as_str())
                                                    resp#.push_str(",\"file_scan_passes\":")
                                                    resp#.push_str(u64_to_string(mcp_res.file_scan_passes as u64).as_str())
                                                    resp#.push_str("}}}}")
                                                    send_mcp_response(resp.as_str())
                                                }
                                                _ => {
                                                    send_error(id_str.as_str(), -32602, "Invalid params: arguments must be an object")
                                                }
                                            }
                                        }
                                        _ => {
                                            send_error(id_str.as_str(), -32602, "Invalid params: arguments must be an object")
                                        }
                                    }
                                }
                                _ => {
                                    send_error(id_str.as_str(), -32602, "Invalid params: params must be an object")
                                }
                            }
                        }
                        _ => {
                            send_error(id_str.as_str(), -32602, "Invalid params: params must be an object")
                        }
                    }
                } else {
                    send_error(id_str.as_str(), -32601, "Method not found")
                }
            }
            _ => {
                send_error("null", -32600, "Invalid Request")
            }
        }
    }
    return 0
}
