// Native stdio JSON-RPC 2.0 MCP (Model Context Protocol) server for trg.
import core/str::{str}
import std/vec::{Vec}
import std/hashmap::{HashMap}
import stdx/serde/json::{JsonNode}
import std/math::{is_finite, floor}
import src/types::{CliOptions, OutputFormat, SearchReport, SearchDiagnostic, BudgetState}
import src/posix::{posix_write_stdout, posix_read_stdin_line}
import src/cli::{parse_cli_args_from_vec}
import src/printer::{
    OutputBudgetWriter,
    u64_to_string,
    i64_to_string,
    json_escape
}
import src/executor::{execute_search, finalize_search}
import src/mcp_protocol::{McpServerState}
import src/mcp_schema::{format_tools_list_response}
import src/mcp_params::{build_mcp_cli_args, validate_mcp_cli_options}
import src/mcp_result::{format_tool_call_response}

pub shape JsonIdResult (
    has_id: bool,
    is_valid: bool,
    id_str: string
)

fn json_map_extract_id(map: HashMap<string, JsonNode>) -> JsonIdResult {
    match map.try_borrow(string::from("id")) {
        auto Option<&JsonNode>::Some(&node) => {
            match node {
                auto JsonNode::NumNode(n) => {
                    if is_finite(n) && n == floor(n) && n >= -9007199254740991.0 && n <= 9007199254740991.0 {
                        return JsonIdResult(has_id = true, is_valid = true, id_str = i64_to_string(n as i64))
                    }
                    return JsonIdResult(has_id = true, is_valid = false, id_str = string::from("null"))
                }
                auto JsonNode::StrNode(&s) => {
                    auto out# = string::from("\"")
                    out#.push_str(json_escape(s.as_str()).as_str())
                    out#.push_str("\"")
                    return JsonIdResult(has_id = true, is_valid = true, id_str = cede out)
                }
                auto JsonNode::NullNode(_) => {
                    return JsonIdResult(has_id = true, is_valid = true, id_str = string::from("null"))
                }
                _ => {
                    return JsonIdResult(has_id = true, is_valid = false, id_str = string::from("null"))
                }
            }
        }
        _ => {
            return JsonIdResult(has_id = false, is_valid = true, id_str = string::from("null"))
        }
    }
}

fn send_mcp_response(resp: str) -> bool {
    auto s# = string::from(resp)
    if !s.as_str().ends_with("\n") {
        s#.push_str("\n")
    }
    auto res = posix_write_stdout(s.as_str())
    return res == 0
}

fn send_error(id_str: str, code: i32, message: str) -> bool {
    auto resp# = string::from("{\"jsonrpc\":\"2.0\",\"id\":")
    resp#.push_str(id_str)
    resp#.push_str(",\"error\":{\"code\":")
    resp#.push_str(string::from_int(code).as_str())
    resp#.push_str(",\"message\":\"")
    resp#.push_str(json_escape(message).as_str())
    resp#.push_str("\"}}\n")
    return send_mcp_response(resp.as_str())
}

fn send_tool_error(id_str: str, message: str) -> bool {
    auto resp# = string::from("{\"jsonrpc\":\"2.0\",\"id\":")
    resp#.push_str(id_str)
    resp#.push_str(",\"result\":{\"content\":[{\"type\":\"text\",\"text\":\"")
    resp#.push_str(json_escape(message).as_str())
    resp#.push_str("\"}],\"isError\":true}}\n")
    return send_mcp_response(resp.as_str())
}

pub fn run_mcp_server() -> i32 {
    auto server_state# = McpServerState::new()

    loop true {
        auto line_opt = posix_read_stdin_line()
        if line_opt.is_none() {
            break
        }
        auto line_str = line_opt.unwrap()
        auto trimmed = line_str.as_str().trim()
        if trimmed.len == 0 {
            continue
        }

        auto root# = JsonNode::NullNode(0):JsonNode
        auto parse_err# = false
        match root#.parse_json(trimmed) {
            auto Result<str, str>::Ok('rem) => {
                if 'rem.trim().len > 0 {
                    parse_err = true
                }
            }
            auto Result<str, str>::Err('e) => {
                parse_err = true
            }
        }
        if parse_err {
            send_error("null", -32700, "Parse error")
            continue
        }

        match root {
            auto JsonNode::ObjectNode(&map) => {
                auto id_res = json_map_extract_id(map)
                auto has_id = id_res.has_id
                auto id_str = id_res.id_str.clone()

                if has_id && !id_res.is_valid {
                    send_error("null", -32600, "Invalid Request: id must be a string, safe integer, or null")
                    continue
                }

                // Verify "jsonrpc" == "2.0"
                auto valid_rpc# = false
                match map.try_borrow(string::from("jsonrpc")) {
                    auto Option<&JsonNode>::Some(&rpc_node) => {
                        match rpc_node {
                            auto JsonNode::StrNode(&rpc_s) => {
                                if rpc_s.as_str() == "2.0" {
                                    valid_rpc = true
                                }
                            }
                            _ => {}
                        }
                    }
                    _ => {}
                }
                if !valid_rpc {
                    send_error(id_str.as_str(), -32600, "Invalid Request")
                    continue
                }

                // Verify "method" is string
                auto method# = string::new()
                match map.try_borrow(string::from("method")) {
                    auto Option<&JsonNode>::Some(&m_node) => {
                        match m_node {
                            auto JsonNode::StrNode(&m_s) => {
                                method = m_s.clone()
                            }
                            _ => {
                                send_error(id_str.as_str(), -32600, "Invalid Request")
                                continue
                            }
                        }
                    }
                    _ => {
                        send_error(id_str.as_str(), -32600, "Invalid Request")
                        continue
                    }
                }

                // Notifications (no id) MUST NOT receive a response per JSON-RPC 2.0
                if !has_id {
                    if method.as_str() == "notifications/initialized" || method.as_str() == "initialized" {
                        server_state#.mark_ready()
                    }
                    continue
                }

                if method.as_str() == "initialize" {
                    if !server_state.is_uninitialized() {
                        send_error(id_str.as_str(), -32600, "Invalid Request: server already initialized")
                        continue
                    }
                    auto req_ver# = string::new()
                    auto valid_params# = false
                    match map.try_borrow(string::from("params")) {
                        auto Option<&JsonNode>::Some(&p_node) => {
                            match p_node {
                                auto JsonNode::ObjectNode(&p_map) => {
                                    match p_map.try_borrow(string::from("protocolVersion")) {
                                        auto Option<&JsonNode>::Some(&v_node) => {
                                            match v_node {
                                                auto JsonNode::StrNode(&v_s) => {
                                                    req_ver = v_s.clone()
                                                    valid_params = true
                                                }
                                                _ => {}
                                            }
                                        }
                                        _ => {}
                                    }
                                }
                                _ => {}
                            }
                        }
                        _ => {}
                    }
                    if !valid_params {
                        send_error(id_str.as_str(), -32602, "Invalid params: protocolVersion must be a string")
                        continue
                    }
                    auto negotiated = server_state#.handle_initialize(req_ver.as_str())
                    auto resp# = string::from("{\"jsonrpc\":\"2.0\",\"id\":")
                    resp#.push_str(id_str.as_str())
                    resp#.push_str(",\"result\":{\"protocolVersion\":\"")
                    resp#.push_str(negotiated.as_str())
                    resp#.push_str("\",\"capabilities\":{\"tools\":{}},\"serverInfo\":{\"name\":\"trg\",\"version\":\"0.10.0\"}}}\n")
                    send_mcp_response(resp.as_str())
                } else if method.as_str() == "ping" {
                    auto resp# = string::from("{\"jsonrpc\":\"2.0\",\"id\":")
                    resp#.push_str(id_str.as_str())
                    resp#.push_str(",\"result\":{}}\n")
                    send_mcp_response(resp.as_str())
                } else if method.as_str() == "tools/list" {
                    if server_state.is_uninitialized() {
                        send_error(id_str.as_str(), -32600, "Server not initialized: call 'initialize' first")
                        continue
                    }
                    if !server_state.is_ready() {
                        send_error(id_str.as_str(), -32600, "Server not ready: 'notifications/initialized' expected")
                        continue
                    }
                    auto resp = format_tools_list_response(id_str, server_state.negotiated_version.as_str())
                    send_mcp_response(resp.as_str())
                } else if method.as_str() == "tools/call" {
                    if server_state.is_uninitialized() {
                        send_error(id_str.as_str(), -32600, "Server not initialized: call 'initialize' first")
                        continue
                    }
                    if !server_state.is_ready() {
                        send_error(id_str.as_str(), -32600, "Server not ready: 'notifications/initialized' expected")
                        continue
                    }
                    match map.try_borrow(string::from("params")) {
                        auto Option<&JsonNode>::Some(&p_val) => {
                            match p_val {
                                auto JsonNode::ObjectNode(&p_map) => {
                                    auto tool_name# = string::new()
                                    match p_map.try_borrow(string::from("name")) {
                                        auto Option<&JsonNode>::Some(&name_node) => {
                                            match name_node {
                                                auto JsonNode::StrNode(&n_s) => {
                                                    tool_name = n_s.clone()
                                                }
                                                _ => {
                                                    send_error(id_str.as_str(), -32602, "Invalid params: 'name' must be a string")
                                                    continue
                                                }
                                            }
                                        }
                                        _ => {
                                            send_error(id_str.as_str(), -32602, "Invalid params: 'name' must be a string")
                                            continue
                                        }
                                    }
                                    if tool_name.as_str() != "trg_search" {
                                        send_error(id_str.as_str(), -32602, "Invalid params: Unknown tool")
                                        continue
                                    }

                                    match p_map.try_borrow(string::from("arguments")) {
                                        auto Option<&JsonNode>::Some(&a_val) => {
                                            auto build_res = build_mcp_cli_args(a_val)
                                            if build_res.is_err() {
                                                send_error(id_str.as_str(), -32602, build_res.unwrap_err().as_str())
                                                continue
                                            }
                                                    auto argv = build_res.unwrap()
                                                    auto opts_res = parse_cli_args_from_vec(argv)
                                                    if opts_res.is_err() {
                                                        send_error(id_str.as_str(), -32602, opts_res.unwrap_err().as_str())
                                                        continue
                                                    }
                                                    auto search_opts = opts_res.unwrap()
                                                    auto val_res = validate_mcp_cli_options(search_opts)
                                                    if val_res.is_err() {
                                                        send_error(id_str.as_str(), -32602, val_res.unwrap_err().as_str())
                                                        continue
                                                    }
                                                    auto writer = OutputBudgetWriter::new_mcp()
                                                    auto search_res = execute_search(search_opts, writer)
                                                    auto report# = SearchReport(
                                                        found_result = false,
                                                        had_error = false,
                                                        is_broken_pipe = false,
                                                        budget_state = BudgetState::new(search_opts.budget_limits),
                                                        elapsed_nanos = 0:u64,
                                                        diagnostics = Vec<SearchDiagnostic>::new()
                                                    )
                                                    if search_res.is_err() {
                                                        auto diag = search_res.unwrap_err()
                                                        auto all_diag# = Vec<SearchDiagnostic>::new()
                                                        all_diag#.push(diag)
                                                        auto bstate = BudgetState::new(search_opts.budget_limits)
                                                        report = SearchReport(
                                                            found_result = false,
                                                            had_error = true,
                                                            is_broken_pipe = false,
                                                            budget_state = cede bstate,
                                                            elapsed_nanos = 0:u64,
                                                            diagnostics = cede all_diag
                                                        )
                                                    } else {
                                                        report = search_res.unwrap()
                                                        finalize_search(search_opts, writer, report)
                                                    }
                                            auto resp = format_tool_call_response(id_str, report, search_opts, writer, server_state.negotiated_version.as_str())
                                            send_mcp_response(resp.as_str())
                                        }
                                        _ => {
                                            send_error(id_str.as_str(), -32602, "Invalid params: arguments must be an object")
                                        }
                                    }
                                }
                                _ => {
                                    send_error(id_str.as_str(), -32602, "Invalid params: params must be an object")
                                }
                            }
                        }
                        _ => {
                            send_error(id_str.as_str(), -32602, "Invalid params: params must be an object")
                        }
                    }
                } else {
                    send_error(id_str.as_str(), -32601, "Method not found")
                }
            }
            _ => {
                send_error("null", -32600, "Invalid Request")
            }
        }
    }
    return 0
}
