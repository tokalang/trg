pub shape JsonIdResult (
    has_id: bool,
    is_valid: bool,
    id_str: string
)

fn json_map_extract_id(map: HashMap<string, JsonNode>) -> JsonIdResult {
    match map.try_borrow(string::from("id")) {
        auto Option<&JsonNode>::Some(&node) => {
            match node {
                auto JsonNode::NumNode(n) => {
                    if is_finite(n) && n == floor(n) && n >= -9007199254740991.0 && n <= 9007199254740991.0 {
                        return JsonIdResult(has_id = true, is_valid = true, id_str = i64_to_string(n as i64))
                    }
                    return JsonIdResult(has_id = true, is_valid = false, id_str = string::from("null"))
                }
                auto JsonNode::StrNode(&s) => {
                    auto out# = string::from("\"")
                    out#.push_str(json_escape(s.as_str()).as_str())
                    out#.push_str("\"")
                    return JsonIdResult(has_id = true, is_valid = true, id_str = cede out)
                }
                auto JsonNode::NullNode(_) => {
                    return JsonIdResult(has_id = true, is_valid = true, id_str = string::from("null"))
                }
                _ => {
                    return JsonIdResult(has_id = true, is_valid = false, id_str = string::from("null"))
                }
            }
        }
        _ => {
            return JsonIdResult(has_id = false, is_valid = true, id_str = string::from("null"))
        }
    }
}

fn send_mcp_response(resp: str) -> bool {
    auto s# = string::from(resp)
    if !s.as_str().ends_with("\n") {
        s#.push_str("\n")
    }
    auto res = posix_write_stdout(s.as_str())
    return res == 0
}

fn send_error(id_str: str, code: i32, message: str) -> bool {
    auto resp# = string::from("{\"jsonrpc\":\"2.0\",\"id\":")
    resp#.push_str(id_str)
    resp#.push_str(",\"error\":{\"code\":")
    resp#.push_str(string::from_int(code).as_str())
    resp#.push_str(",\"message\":\"")
    resp#.push_str(json_escape(message).as_str())
    resp#.push_str("\"}}\n")
    return send_mcp_response(resp.as_str())
}

fn send_tool_error(id_str: str, message: str) -> bool {
    auto resp# = string::from("{\"jsonrpc\":\"2.0\",\"id\":")
    resp#.push_str(id_str)
    resp#.push_str(",\"result\":{\"content\":[{\"type\":\"text\",\"text\":\"")
    resp#.push_str(json_escape(message).as_str())
    resp#.push_str("\"}],\"isError\":true}}\n")
    return send_mcp_response(resp.as_str())
}

fn send_tool_error_json(id_str: str, message: str) -> bool {
    auto err_obj# = string::from("{\"error\":\"")
    err_obj#.push_str(json_escape(message).as_str())
    err_obj#.push_str("\"}")

    auto resp# = string::from("{\"jsonrpc\":\"2.0\",\"id\":")
    resp#.push_str(id_str)
    resp#.push_str(",\"result\":{\"content\":[{\"type\":\"text\",\"text\":\"")
    resp#.push_str(json_escape(err_obj.as_str()).as_str())
    resp#.push_str("\"}],\"isError\":true}}\n")
    return send_mcp_response(resp.as_str())
}

fn is_strict_hex_digit(c: char) -> bool {
    if c >= ('0' as char) && c <= ('9' as char) { return true }
    if c >= ('a' as char) && c <= ('f' as char) { return true }
    if c >= ('A' as char) && c <= ('F' as char) { return true }
    return false
}

fn is_non_null_arg(node_opt: Option<&JsonNode>) -> bool {
    match node_opt {
        auto Option<&JsonNode>::Some(&n) => {
            match n {
                auto JsonNode::NullNode(_) => {
                    return false
                }
                _ => {
                    return true
                }
            }
        }
        auto Option<&JsonNode>::None => {
            return false
        }
    }
}

fn hex_char_to_val(c: char) -> usize {
    if c >= ('0' as char) && c <= ('9' as char) {
        return (c as usize) - (('0' as char) as usize)
    }
    if c >= ('a' as char) && c <= ('f' as char) {
        return (c as usize) - (('a' as char) as usize) + 10:usize
    }
    if c >= ('A' as char) && c <= ('F' as char) {
        return (c as usize) - (('A' as char) as usize) + 10:usize
    }
    return 0:usize
}

fn skip_json_ws(s: str, pos#: usize) {
    loop pos < s.len {
        auto c = s.byte_at(pos)
        if c == (' ' as char) || c == ('\t' as char) || c == ('\n' as char) || c == ('\r' as char) {
            pos = pos + 1
        } else {
            break
        }
    }
}

fn parse_strict_json_string(s: str, pos#: usize) -> bool {
    if pos >= s.len || s.byte_at(pos) != ('"' as char) {
        return false
    }
    pos = pos + 1
    loop pos < s.len {
        auto sc = s.byte_at(pos)
        auto sc_val = (sc as u8) as usize
        if sc_val < 32 {
            return false
        }
        if sc == ('"' as char) {
            pos = pos + 1
            return true
        }
        if sc == ('\\' as char) {
            if pos + 1 >= s.len {
                return false
            }
            auto esc = s.byte_at(pos + 1)
            if esc == ('"' as char) || esc == ('\\' as char) || esc == ('/' as char) ||
               esc == ('b' as char) || esc == ('f' as char) || esc == ('n' as char) ||
               esc == ('r' as char) || esc == ('t' as char) {
                pos = pos + 2
                continue
            } else if esc == ('u' as char) {
                if pos + 5 >= s.len {
                    return false
                }
                if !is_strict_hex_digit(s.byte_at(pos + 2)) ||
                   !is_strict_hex_digit(s.byte_at(pos + 3)) ||
                   !is_strict_hex_digit(s.byte_at(pos + 4)) ||
                   !is_strict_hex_digit(s.byte_at(pos + 5)) {
                    return false
                }
                auto h1 = hex_char_to_val(s.byte_at(pos + 2))
                auto h2 = hex_char_to_val(s.byte_at(pos + 3))
                auto h3 = hex_char_to_val(s.byte_at(pos + 4))
                auto h4 = hex_char_to_val(s.byte_at(pos + 5))
                auto cp = (h1 << 12) | (h2 << 8) | (h3 << 4) | h4
                // UTF-16 surrogate checks:
                if cp >= 0xD800 && cp <= 0xDBFF {
                    // High surrogate: MUST be immediately followed by \uDC00..\uDFFF
                    if pos + 11 >= s.len {
                        return false
                    }
                    if s.byte_at(pos + 6) != ('\\' as char) || s.byte_at(pos + 7) != ('u' as char) {
                        return false
                    }
                    if !is_strict_hex_digit(s.byte_at(pos + 8)) ||
                       !is_strict_hex_digit(s.byte_at(pos + 9)) ||
                       !is_strict_hex_digit(s.byte_at(pos + 10)) ||
                       !is_strict_hex_digit(s.byte_at(pos + 11)) {
                        return false
                    }
                    auto l1 = hex_char_to_val(s.byte_at(pos + 8))
                    auto l2 = hex_char_to_val(s.byte_at(pos + 9))
                    auto l3 = hex_char_to_val(s.byte_at(pos + 10))
                    auto l4 = hex_char_to_val(s.byte_at(pos + 11))
                    auto low_cp = (l1 << 12) | (l2 << 8) | (l3 << 4) | l4
                    if low_cp < 0xDC00 || low_cp > 0xDFFF {
                        return false
                    }
                    pos = pos + 12
                    continue
                } else if cp >= 0xDC00 && cp <= 0xDFFF {
                    // Isolated low surrogate: invalid
                    return false
                }
                pos = pos + 6
                continue
            } else {
                return false
            }
        }
        pos = pos + 1
    }
    return false
}

fn parse_strict_json_number(s: str, pos#: usize) -> bool {
    if pos >= s.len {
        return false
    }
    if s.byte_at(pos) == ('-' as char) {
        pos = pos + 1
    }
    if pos >= s.len {
        return false
    }
    auto c = s.byte_at(pos)
    if c < ('0' as char) || c > ('9' as char) {
        return false
    }
    if c == ('0' as char) {
        pos = pos + 1
        if pos < s.len {
            auto nc = s.byte_at(pos)
            if nc >= ('0' as char) && nc <= ('9' as char) {
                return false
            }
        }
    } else {
        loop pos < s.len {
            auto dc = s.byte_at(pos)
            if dc >= ('0' as char) && dc <= ('9' as char) {
                pos = pos + 1
            } else {
                break
            }
        }
    }

    // Fraction
    if pos < s.len && s.byte_at(pos) == ('.' as char) {
        pos = pos + 1
        if pos >= s.len {
            return false
        }
        auto fc = s.byte_at(pos)
        if fc < ('0' as char) || fc > ('9' as char) {
            return false
        }
        loop pos < s.len {
            auto dc = s.byte_at(pos)
            if dc >= ('0' as char) && dc <= ('9' as char) {
                pos = pos + 1
            } else {
                break
            }
        }
    }

    // Exponent
    if pos < s.len && (s.byte_at(pos) == ('e' as char) || s.byte_at(pos) == ('E' as char)) {
        pos = pos + 1
        if pos < s.len && (s.byte_at(pos) == ('+' as char) || s.byte_at(pos) == ('-' as char)) {
            pos = pos + 1
        }
        if pos >= s.len {
            return false
        }
        auto ec = s.byte_at(pos)
        if ec < ('0' as char) || ec > ('9' as char) {
            return false
        }
        loop pos < s.len {
            auto dc = s.byte_at(pos)
            if dc >= ('0' as char) && dc <= ('9' as char) {
                pos = pos + 1
            } else {
                break
            }
        }
    }

    // Delimiter boundary check: character immediately after number MUST be whitespace, comma, bracket, brace, or EOF
    if pos < s.len {
        auto end_c = s.byte_at(pos)
        if end_c != (' ' as char) && end_c != ('\t' as char) && end_c != ('\r' as char) &&
           end_c != ('\n' as char) && end_c != (',' as char) && end_c != (']' as char) &&
           end_c != ('}' as char) {
            return false
        }
    }
    return true
}

fn parse_strict_json_value(s: str, pos#: usize, depth: usize) -> bool {
    if depth > 64 {
        return false
    }
    skip_json_ws(s, pos#)
    if pos >= s.len {
        return false
    }
    auto c = s.byte_at(pos)

    if c == ('"' as char) {
        return parse_strict_json_string(s, pos#)
    }

    if c == ('{' as char) {
        pos = pos + 1
        skip_json_ws(s, pos#)
        if pos < s.len && s.byte_at(pos) == ('}' as char) {
            pos = pos + 1
            return true
        }
        loop true {
            skip_json_ws(s, pos#)
            if pos >= s.len || s.byte_at(pos) != ('"' as char) {
                return false
            }
            if !parse_strict_json_string(s, pos#) {
                return false
            }
            skip_json_ws(s, pos#)
            if pos >= s.len || s.byte_at(pos) != (':' as char) {
                return false
            }
            pos = pos + 1
            skip_json_ws(s, pos#)
            if !parse_strict_json_value(s, pos#, depth + 1) {
                return false
            }
            skip_json_ws(s, pos#)
            if pos >= s.len {
                return false
            }
            auto sep = s.byte_at(pos)
            if sep == (',' as char) {
                pos = pos + 1
                skip_json_ws(s, pos#)
                if pos < s.len && s.byte_at(pos) == ('}' as char) {
                    return false
                }
            } else if sep == ('}' as char) {
                pos = pos + 1
                return true
            } else {
                return false
            }
        }
    }

    if c == ('[' as char) {
        pos = pos + 1
        skip_json_ws(s, pos#)
        if pos < s.len && s.byte_at(pos) == (']' as char) {
            pos = pos + 1
            return true
        }
        loop true {
            skip_json_ws(s, pos#)
            if !parse_strict_json_value(s, pos#, depth + 1) {
                return false
            }
            skip_json_ws(s, pos#)
            if pos >= s.len {
                return false
            }
            auto sep = s.byte_at(pos)
            if sep == (',' as char) {
                pos = pos + 1
                skip_json_ws(s, pos#)
                if pos < s.len && s.byte_at(pos) == (']' as char) {
                    return false
                }
            } else if sep == (']' as char) {
                pos = pos + 1
                return true
            } else {
                return false
            }
        }
    }

    if c == ('t' as char) {
        if pos + 3 < s.len && s.byte_at(pos + 1) == ('r' as char) &&
           s.byte_at(pos + 2) == ('u' as char) && s.byte_at(pos + 3) == ('e' as char) {
            pos = pos + 4
            if pos < s.len {
                auto nc = s.byte_at(pos)
                if nc != (' ' as char) && nc != ('\t' as char) && nc != ('\r' as char) &&
                   nc != ('\n' as char) && nc != (',' as char) && nc != (']' as char) &&
                   nc != ('}' as char) {
                    return false
                }
            }
            return true
        }
        return false
    }

    if c == ('f' as char) {
        if pos + 4 < s.len && s.byte_at(pos + 1) == ('a' as char) &&
           s.byte_at(pos + 2) == ('l' as char) && s.byte_at(pos + 3) == ('s' as char) &&
           s.byte_at(pos + 4) == ('e' as char) {
            pos = pos + 5
            if pos < s.len {
                auto nc = s.byte_at(pos)
                if nc != (' ' as char) && nc != ('\t' as char) && nc != ('\r' as char) &&
                   nc != ('\n' as char) && nc != (',' as char) && nc != (']' as char) &&
                   nc != ('}' as char) {
                    return false
                }
            }
            return true
        }
        return false
    }

    if c == ('n' as char) {
        if pos + 3 < s.len && s.byte_at(pos + 1) == ('u' as char) &&
           s.byte_at(pos + 2) == ('l' as char) && s.byte_at(pos + 3) == ('l' as char) {
            pos = pos + 4
            if pos < s.len {
                auto nc = s.byte_at(pos)
                if nc != (' ' as char) && nc != ('\t' as char) && nc != ('\r' as char) &&
                   nc != ('\n' as char) && nc != (',' as char) && nc != (']' as char) &&
                   nc != ('}' as char) {
                    return false
                }
            }
            return true
        }
        return false
    }

    auto is_digit = c >= ('0' as char) && c <= ('9' as char)
    if is_digit || c == ('-' as char) {
        return parse_strict_json_number(s, pos#)
    }

    return false
}

pub fn validate_strict_json(s: str) -> bool {
    if !is_valid_utf8(s) {
        return false
    }
    auto pos# = 0:usize
    skip_json_ws(s, pos#)
    if pos >= s.len {
        return false
    }
    if !parse_strict_json_value(s, pos#, 0:usize) {
        return false
    }
    skip_json_ws(s, pos#)
    if pos < s.len {
        return false
    }
    return true
}

pub fn run_mcp_server() -> i32 {
    auto server_state# = McpServerState::new()
    auto startup_cwd = normalize_cwd(env::current_dir().as_str())

    loop true {
        auto line_opt = posix_read_stdin_line()
        if line_opt.is_none() {
            break
        }
        auto line_str = line_opt.unwrap()
        auto trimmed = line_str.as_str().trim()
        if trimmed.len == 0 {
            continue
        }

        if !validate_strict_json(trimmed) {
            send_error("null", -32700, "Parse error")
            continue
        }

        auto root# = JsonNode::NullNode(0):JsonNode
        auto parse_err# = false
        match root#.parse_json(trimmed) {
            auto Result<str, str>::Ok('rem) => {
                if 'rem.trim().len > 0 {
                    parse_err = true
                }
            }
            auto Result<str, str>::Err('e) => {
                parse_err = true
            }
        }
        if parse_err {
            send_error("null", -32700, "Parse error")
            continue
        }

        match root {
            auto JsonNode::ObjectNode(&map) => {
                auto id_res = json_map_extract_id(map)
                auto has_id = id_res.has_id
                auto id_str = id_res.id_str.clone()

                if has_id && !id_res.is_valid {
                    send_error("null", -32600, "Invalid Request: id must be a string, safe integer, or null")
                    continue
                }

                // Verify "jsonrpc" == "2.0"
                auto valid_rpc# = false
                match map.try_borrow(string::from("jsonrpc")) {
                    auto Option<&JsonNode>::Some(&rpc_node) => {
                        match rpc_node {
                            auto JsonNode::StrNode(&rpc_s) => {
                                if rpc_s.as_str() == "2.0" {
                                    valid_rpc = true
                                }
                            }
                            _ => {}
                        }
                    }
                    _ => {}
                }
                if !valid_rpc {
                    send_error(id_str.as_str(), -32600, "Invalid Request")
                    continue
                }

                // Verify "method" is string
                auto method# = string::new()
                match map.try_borrow(string::from("method")) {
                    auto Option<&JsonNode>::Some(&m_node) => {
                        match m_node {
                            auto JsonNode::StrNode(&m_s) => {
                                method = m_s.clone()
                            }
                            _ => {
                                send_error(id_str.as_str(), -32600, "Invalid Request")
                                continue
                            }
                        }
                    }
                    _ => {
                        send_error(id_str.as_str(), -32600, "Invalid Request")
                        continue
                    }
                }

                // Notifications (no id) MUST NOT receive a response per JSON-RPC 2.0
                if !has_id {
                    if method.as_str() == "notifications/initialized" || method.as_str() == "initialized" {
                        server_state#.mark_ready()
                    }
                    continue
                }

                if method.as_str() == "initialize" {
                    if !server_state.is_uninitialized() {
                        send_error(id_str.as_str(), -32600, "Invalid Request: server already initialized")
                        continue
                    }
                    auto req_ver# = string::new()
                    auto valid_params# = false
                    match map.try_borrow(string::from("params")) {
                        auto Option<&JsonNode>::Some(&p_node) => {
                            match p_node {
                                auto JsonNode::ObjectNode(&p_map) => {
                                    match p_map.try_borrow(string::from("protocolVersion")) {
                                        auto Option<&JsonNode>::Some(&v_node) => {
                                            match v_node {
                                                auto JsonNode::StrNode(&v_s) => {
                                                    req_ver = v_s.clone()
                                                    valid_params = true
                                                }
                                                _ => {}
                                            }
                                        }
                                        _ => {}
                                    }
                                }
                                _ => {}
                            }
                        }
                        _ => {}
                    }
                    if !valid_params {
                        send_error(id_str.as_str(), -32602, "Invalid params: protocolVersion must be a string")
                        continue
                    }
                    auto negotiated = server_state#.handle_initialize(req_ver.as_str())
                    auto resp# = string::from("{\"jsonrpc\":\"2.0\",\"id\":")
                    resp#.push_str(id_str.as_str())
                    resp#.push_str(",\"result\":{\"protocolVersion\":\"")
                    resp#.push_str(negotiated.as_str())
                    resp#.push_str("\",\"capabilities\":{\"tools\":{}},\"serverInfo\":{\"name\":\"trg\",\"version\":\"0.18.0\"}}}\n")
                    send_mcp_response(resp.as_str())
                } else if method.as_str() == "ping" {
                    auto resp# = string::from("{\"jsonrpc\":\"2.0\",\"id\":")
                    resp#.push_str(id_str.as_str())
                    resp#.push_str(",\"result\":{}}\n")
                    send_mcp_response(resp.as_str())
                } else if method.as_str() == "tools/list" {
                    if server_state.is_uninitialized() {
                        send_error(id_str.as_str(), -32600, "Server not initialized: call 'initialize' first")
                        continue
                    }
                    if !server_state.is_ready() {
                        send_error(id_str.as_str(), -32600, "Server not ready: 'notifications/initialized' expected")
                        continue
                    }
                    auto resp = format_tools_list_response(id_str, server_state.negotiated_version.as_str())
                    send_mcp_response(resp.as_str())
                } else if method.as_str() == "tools/call" {
                    if server_state.is_uninitialized() {
                        send_error(id_str.as_str(), -32600, "Server not initialized: call 'initialize' first")
                        continue
                    }
                    if !server_state.is_ready() {
                        send_error(id_str.as_str(), -32600, "Server not ready: 'notifications/initialized' expected")
                        continue
                    }
                    match map.try_borrow(string::from("params")) {
                        auto Option<&JsonNode>::Some(&p_val) => {
                            match p_val {
                                auto JsonNode::ObjectNode(&p_map) => {
                                    auto tool_name# = string::new()
                                    match p_map.try_borrow(string::from("name")) {
                                        auto Option<&JsonNode>::Some(&name_node) => {
                                            match name_node {
                                                auto JsonNode::StrNode(&n_s) => {
                                                    tool_name = n_s.clone()
                                                }
                                                _ => {
                                                    send_error(id_str.as_str(), -32602, "Invalid params: 'name' must be a string")
                                                    continue
                                                }
                                            }
                                        }
                                        _ => {
                                            send_error(id_str.as_str(), -32602, "Invalid params: 'name' must be a string")
                                            continue
                                        }
                                    }
                                    if tool_name.as_str() != "trg_search" && tool_name.as_str() != "trg_view" && tool_name.as_str() != "trg_symbols" {
                                        send_error(id_str.as_str(), -32602, "Invalid params: Unknown tool")
                                        continue
                                    }

                                    if tool_name.as_str() == "trg_view" {
                                        match p_map.try_borrow(string::from("arguments")) {
                                            auto Option<&JsonNode>::Some(&a_val) => {
                                                match a_val {
                                                    auto JsonNode::ObjectNode(&arg_map) => {
                                                        auto iter# = arg_map.iter()
                                                        auto unexp_opt# = Option<string>::None
                                                        loop true {
                                                            auto nxt = iter#.next_ref()
                                                            if nxt.is_none() { break }
                                                            auto entry = nxt.unwrap()
                                                            auto k = entry.key().as_str()
