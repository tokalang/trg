                                                                send_tool_error_json(id_str.as_str(), view_res.unwrap_err().as_str())
                                                            } else {
                                                                send_tool_error(id_str.as_str(), view_res.unwrap_err().as_str())
                                                            }
                                                            continue
                                                        }
                                                        auto vr# = view_res.unwrap()

                                                        auto is_tool_err# = false
                                                        if vr.selection_status == "multiple_candidates" || vr.selection_status == "unsupported_syntax" || vr.selection_status == "scan_incomplete" || vr.selection_status == "io_error" {
                                                            is_tool_err = true
                                                        }

                                                        if format_is_json {
                                                            auto json_str# = string::new()
                                                            if max_bytes_opt.is_some() {
                                                                auto prune_res = vr#.prune_to_json_budget(max_bytes_opt.unwrap())
                                                                if prune_res.is_err() {
                                                                    send_tool_error_json(id_str.as_str(), prune_res.unwrap_err().as_str())
                                                                    continue
                                                                }
                                                                json_str = prune_res.unwrap()
                                                            } else {
                                                                auto conv_res = vr#.converge_structured()
                                                                if conv_res.is_err() {
                                                                    send_tool_error_json(id_str.as_str(), conv_res.unwrap_err().as_str())
                                                                    continue
                                                                }
                                                                json_str = conv_res.unwrap()
                                                            }

                                                            auto resp# = string::from("{\"jsonrpc\":\"2.0\",\"id\":")
                                                            resp#.push_str(id_str.as_str())
                                                            resp#.push_str(",\"result\":{\"content\":[{\"type\":\"text\",\"text\":\"")
                                                            resp#.push_str(json_escape(json_str.as_str()).as_str())
                                                            resp#.push_str("\"}]")
                                                            if is_tool_err {
                                                                resp#.push_str(",\"isError\":true")
                                                            }

                                                            if server_state.negotiated_version.as_str() == "2025-11-25" {
                                                                resp#.push_str(",\"structuredContent\":")
                                                                resp#.push_str(json_str.as_str())
                                                            }

                                                            resp#.push_str(",\"_meta\":{\"truncated\":")
                                                            if vr.truncated {
                                                                resp#.push_str("true,\"reason\":\"")
                                                                if vr.reason.len() > 0 {
                                                                    resp#.push_str(vr.reason.as_str())
                                                                } else {
                                                                    resp#.push_str("truncated")
                                                                }
                                                                resp#.push_str("\"")
                                                            } else {
                                                                resp#.push_str("false,\"reason\":null")
                                                            }
                                                            resp#.push_str(",\"lines\":")
                                                            resp#.push_str(u64_to_string(vr.lines_emitted as u64).as_str())
                                                            resp#.push_str(",\"bytes\":")
                                                            resp#.push_str(u64_to_string(vr.bytes_emitted as u64).as_str())
                                                            resp#.push_str(",\"continuation_token\":")
                                                            match vr.continuation_token {
                                                                auto Option<string>::Some(&t) => {
                                                                    resp#.push_str("\"")
                                                                    resp#.push_str(json_escape(t.as_str()).as_str())
                                                                    resp#.push_str("\"")
                                                                }
                                                                auto Option<string>::None => {
                                                                    resp#.push_str("null")
                                                                }
                                                            }
                                                            resp#.push_str(",\"summary\":{\"complete\":")
                                                            if vr.truncated {
                                                                resp#.push_str("false,\"truncated\":true,\"termination_reason\":\"")
                                                                if vr.reason.len() > 0 {
                                                                    resp#.push_str(vr.reason.as_str())
                                                                } else {
                                                                    resp#.push_str("truncated")
                                                                }
                                                                resp#.push_str("\"")
                                                            } else {
                                                                resp#.push_str("true,\"truncated\":false,\"termination_reason\":\"completed\"")
                                                            }
                                                            resp#.push_str("}}}}")
                                                            resp#.push_str("\n")
                                                            send_mcp_response(resp.as_str())
                                                            continue
                                                        }

                                                        auto resp# = string::from("{\"jsonrpc\":\"2.0\",\"id\":")
                                                        resp#.push_str(id_str.as_str())
                                                        resp#.push_str(",\"result\":{\"content\":[{\"type\":\"text\",\"text\":\"")
                                                        resp#.push_str(json_escape(vr.text.as_str()).as_str())
                                                        resp#.push_str("\"}],\"isError\":")
                                                        if is_tool_err {
                                                            resp#.push_str("true")
                                                        } else {
                                                            resp#.push_str("false")
                                                        }

                                                        if server_state.negotiated_version.as_str() == "2025-11-25" {
                                                            resp#.push_str(",\"structuredContent\":")
                                                            resp#.push_str(vr.format_structured().as_str())
                                                        }

                                                        resp#.push_str(",\"_meta\":{\"truncated\":")
                                                        if vr.truncated {
                                                            resp#.push_str("true,\"reason\":\"")
                                                            if vr.reason.len() > 0 {
                                                                resp#.push_str(vr.reason.as_str())
                                                            } else {
                                                                resp#.push_str("truncated")
                                                            }
                                                            resp#.push_str("\"")
                                                        } else {
                                                            resp#.push_str("false,\"reason\":null")
                                                        }
                                                        resp#.push_str(",\"lines\":")
                                                        resp#.push_str(u64_to_string(vr.lines_emitted as u64).as_str())
                                                        resp#.push_str(",\"bytes\":")
                                                        resp#.push_str(u64_to_string(vr.bytes_emitted as u64).as_str())
                                                        resp#.push_str(",\"continuation_token\":")
                                                        match vr.continuation_token {
                                                            auto Option<string>::Some(&t) => {
                                                                resp#.push_str("\"")
                                                                resp#.push_str(json_escape(t.as_str()).as_str())
                                                                resp#.push_str("\"")
                                                            }
                                                            auto Option<string>::None => {
                                                                resp#.push_str("null")
                                                            }
                                                        }
                                                        resp#.push_str(",\"summary\":{\"complete\":")
                                                        if vr.truncated {
                                                            resp#.push_str("false,\"truncated\":true,\"termination_reason\":\"")
                                                            if vr.reason.len() > 0 {
                                                                resp#.push_str(vr.reason.as_str())
                                                            } else {
                                                                resp#.push_str("truncated")
                                                            }
                                                            resp#.push_str("\"")
                                                        } else {
                                                            resp#.push_str("true,\"truncated\":false,\"termination_reason\":\"completed\"")
                                                        }
                                                        resp#.push_str("}}}}")
                                                        resp#.push_str("\n")
                                                        send_mcp_response(resp.as_str())
                                                        continue
                                                    }
                                                    _ => {
                                                        send_error(id_str.as_str(), -32602, "Invalid params: arguments must be an object")
                                                        continue
                                                    }
                                                }
                                            }
                                            _ => {
                                                send_error(id_str.as_str(), -32602, "Invalid params: arguments must be an object")
                                                continue
                                            }
                                        }
                                    }

                                    if tool_name.as_str() == "trg_symbols" {
                                        match p_map.try_borrow(string::from("arguments")) {
                                            auto Option<&JsonNode>::Some(&a_val) => {
                                                match a_val {
                                                    auto JsonNode::ObjectNode(&arg_map) => {
                                                        auto iter# = arg_map.iter()
                                                        auto unexp_opt# = Option<string>::None
                                                        loop true {
                                                            auto nxt = iter#.next_ref()
                                                            if nxt.is_none() { break }
                                                            auto entry = nxt.unwrap()
                                                            auto k = entry.key().as_str()
                                                            if k != "path" && k != "kinds" && k != "max_symbols" && k != "max_result_bytes" && k != "max_bytes" && k != "format" {
                                                                unexp_opt = Option<string>::Some(entry.key().clone())
                                                                break
                                                            }
                                                        }
                                                        if unexp_opt.is_some() {
                                                            auto err# = string::from("Invalid params: unexpected property '")
                                                            err#.push_str(unexp_opt.unwrap().as_str())
                                                            err#.push_str("'")
                                                            send_error(id_str.as_str(), -32602, err.as_str())
                                                            continue
                                                        }

                                                        auto path_str# = string::new()
                                                        auto has_path# = false
                                                        match arg_map.try_borrow(string::from("path")) {
                                                            auto Option<&JsonNode>::Some(&pn) => {
                                                                match pn {
                                                                    auto JsonNode::StrNode(&ps) => {
                                                                        if ps.len() > 0 {
                                                                            path_str = ps.clone()
                                                                            has_path = true
                                                                        }
                                                                    }
                                                                    _ => {}
                                                                }
                                                            }
                                                            _ => {}
                                                        }
                                                        if !has_path {
                                                            send_error(id_str.as_str(), -32602, "Invalid params: 'path' is required and must be a non-empty string")
                                                            continue
                                                        }

                                                        if startup_cwd.as_str() == "/" && !path_str.as_str().starts_with("/") {
                                                            send_error(id_str.as_str(), -32602, "Invalid params: relative path cannot be safely resolved when MCP server working directory is root ('/'); please provide an absolute path")
                                                            continue
                                                        }
                                                        if resolves_to_root(startup_cwd.as_str(), path_str.as_str()) {
                                                            send_error(id_str.as_str(), -32602, "Invalid params: target path resolves to filesystem root ('/'); outlining symbols on root is not allowed in MCP mode")
                                                            continue
                                                        }

                                                        auto kinds_opt# = Option<Vec<string>>::None
                                                        auto kinds_err# = false
                                                        match arg_map.try_borrow(string::from("kinds")) {
                                                            auto Option<&JsonNode>::Some(&kn) => {
                                                                match kn {
                                                                    auto JsonNode::ArrayNode(&k_arr) => {
                                                                        if k_arr.len() == 0 {
                                                                            kinds_err = true
                                                                        } else {
                                                                            auto k_vec# = Vec<string>::new()
                                                                            auto ki# = 0:usize
                                                                            loop ki < k_arr.len() {
                                                                                auto &k_elem = k_arr.borrow(ki)
                                                                                match k_elem {
                                                                                    auto JsonNode::StrNode(&ks) => {
                                                                                        k_vec#.push(ks.clone())
                                                                                    }
                                                                                    _ => {
                                                                                        kinds_err = true
                                                                                        break
                                                                                    }
                                                                                }
                                                                                ki = ki + 1
                                                                            }
                                                                            if !kinds_err {
                                                                                kinds_opt = Option<Vec<string>>::Some(cede k_vec)
                                                                            }
                                                                        }
                                                                    }
                                                                    auto JsonNode::NullNode(_) => {}
                                                                    _ => {
                                                                        kinds_err = true
                                                                    }
                                                                }
                                                            }
                                                            _ => {}
                                                        }
                                                        if kinds_err {
                                                            send_error(id_str.as_str(), -32602, "Invalid params: 'kinds' must be a non-empty array of strings or null")
                                                            continue
                                                        }

                                                        auto max_symbols_opt# = Option<usize>::None
                                                        auto max_symbols_err# = false
                                                        match arg_map.try_borrow(string::from("max_symbols")) {
                                                            auto Option<&JsonNode>::Some(&ms_node) => {
                                                                match ms_node {
                                                                    auto JsonNode::NumNode(n) => {
                                                                        if is_finite(n) && n == floor(n) && n >= 1.0 && n <= 10000.0 {
                                                                            max_symbols_opt = Option<usize>::Some(n as usize)
                                                                        } else {
                                                                            max_symbols_err = true
                                                                        }
                                                                    }
                                                                    auto JsonNode::NullNode(_) => {}
                                                                    _ => {
                                                                        max_symbols_err = true
                                                                    }
                                                                }
                                                            }
                                                            _ => {}
                                                        }
                                                        if max_symbols_err {
                                                            send_error(id_str.as_str(), -32602, "Invalid params: 'max_symbols' must be an integer between 1 and 10000 or null")
                                                            continue
                                                        }

                                                        auto has_mrb = arg_map.try_borrow(string::from("max_result_bytes")).is_some()
                                                        auto has_mb = arg_map.try_borrow(string::from("max_bytes")).is_some()
                                                        if has_mrb && has_mb {
                                                            send_error(id_str.as_str(), -32602, "Invalid params: Cannot provide both 'max_bytes' and 'max_result_bytes'")
                                                            continue
                                                        }

                                                        auto max_bytes_opt# = Option<usize>::Some(65536:usize)
                                                        auto max_bytes_err# = false
                                                        auto max_bytes_err_msg# = string::from("Invalid params: 'max_result_bytes' must be a size string (e.g. '64K'), non-negative integer, or null")

                                                        auto check_bytes_node# = Option<&JsonNode>::None
                                                        auto key_used# = "max_result_bytes"
                                                        if has_mrb {
                                                            check_bytes_node = arg_map.try_borrow(string::from("max_result_bytes"))
                                                        } else if has_mb {
                                                            check_bytes_node = arg_map.try_borrow(string::from("max_bytes"))
                                                            key_used = "max_bytes"
                                                        }

                                                        match check_bytes_node {
                                                            auto Option<&JsonNode>::Some(&mbn) => {
                                                                match mbn {
                                                                    auto JsonNode::NumNode(n) => {
                                                                        if is_finite(n) && n == floor(n) && n >= 0.0 && n <= 9007199254740991.0 {
                                                                            max_bytes_opt = Option<usize>::Some(n as usize)
                                                                        } else {
                                                                            max_bytes_err = true
                                                                        }
                                                                    }
                                                                    auto JsonNode::StrNode(&s) => {
                                                                        auto p_res = parse_size_bytes_strict(s.as_str(), key_used)
                                                                        if p_res.is_ok() {
                                                                            max_bytes_opt = Option<usize>::Some(p_res.unwrap())
                                                                        } else {
                                                                            max_bytes_err = true
                                                                            max_bytes_err_msg = string::from("Invalid params: ")
                                                                            max_bytes_err_msg#.push_str(p_res.unwrap_err().as_str())
                                                                        }
                                                                    }
                                                                    auto JsonNode::NullNode(_) => {
                                                                        max_bytes_opt = Option<usize>::None
                                                                    }
                                                                    _ => {
                                                                        max_bytes_err = true
                                                                    }
                                                                }
                                                            }
                                                            _ => {}
                                                        }
                                                        if max_bytes_err {
                                                            send_error(id_str.as_str(), -32602, max_bytes_err_msg.as_str())
                                                            continue
                                                        }

                                                        auto format_is_json# = false
                                                        auto format_err# = false
                                                        match arg_map.try_borrow(string::from("format")) {
                                                            auto Option<&JsonNode>::Some(&fmn) => {
                                                                match fmn {
                                                                    auto JsonNode::StrNode(&fms) => {
                                                                        if fms.as_str() == "json" {
                                                                            format_is_json = true
                                                                        } else if fms.as_str() == "text" {
                                                                            format_is_json = false
                                                                        } else {
                                                                            format_err = true
                                                                        }
                                                                    }
                                                                    _ => {
                                                                        format_err = true
                                                                    }
                                                                }
                                                            }
                                                            _ => {}
                                                        }
                                                        if format_err {
                                                            send_error(id_str.as_str(), -32602, "Invalid params: 'format' must be one of [\"text\", \"json\"]")
                                                            continue
                                                        }

                                                        auto target_res = compute_identity_key(startup_cwd.as_str(), path_str.as_str())
                                                        if target_res.is_err() {
                                                            if format_is_json {
                                                                send_tool_error_json(id_str.as_str(), "Failed to resolve target path")
                                                            } else {
                                                                send_tool_error(id_str.as_str(), "Failed to resolve target path")
                                                            }
                                                            continue
                                                        }
                                                        auto target_path = target_res.unwrap()

                                                        auto sym_opts = SymbolsOptions(
                                                            file_path = cede target_path,
                                                            kinds = cede kinds_opt,
                                                            max_symbols = max_symbols_opt,
                                                            max_result_bytes = max_bytes_opt,
                                                            json_output = format_is_json
                                                        )
                                                        auto sym_res = outline_symbols_file(sym_opts)
                                                        if sym_res.is_err() {
                                                            if format_is_json {
                                                                send_tool_error_json(id_str.as_str(), sym_res.unwrap_err().as_str())
                                                            } else {
                                                                send_tool_error(id_str.as_str(), sym_res.unwrap_err().as_str())
                                                            }
                                                            continue
                                                        }
                                                        auto sr = sym_res.unwrap()

                                                        auto text_content# = string::new()
                                                        if format_is_json {
                                                            text_content = format_symbols_structured(sr)
                                                        } else {
                                                            text_content = format_symbols_text_tree(sr)
                                                        }

                                                        auto resp# = string::from("{\"jsonrpc\":\"2.0\",\"id\":")
                                                        resp#.push_str(id_str.as_str())
                                                        resp#.push_str(",\"result\":{\"content\":[{\"type\":\"text\",\"text\":\"")
                                                        resp#.push_str(json_escape(text_content.as_str()).as_str())
                                                        resp#.push_str("\"}],\"isError\":false")

                                                        if server_state.negotiated_version.as_str() == "2025-11-25" {
                                                            resp#.push_str(",\"structuredContent\":")
                                                            resp#.push_str(format_symbols_structured(sr).as_str())
                                                        }

                                                        resp#.push_str(",\"_meta\":{\"truncated\":")
                                                        if sr.truncated {
                                                            resp#.push_str("true,\"reason\":\"")
                                                            if sr.termination_reason.len() > 0 {
                                                                resp#.push_str(sr.termination_reason.as_str())
                                                            } else {
                                                                resp#.push_str("truncated")
                                                            }
                                                            resp#.push_str("\"")
                                                        } else {
                                                            resp#.push_str("false,\"reason\":null")
                                                        }
                                                        resp#.push_str(",\"total_symbols\":")
                                                        resp#.push_str(u64_to_string(sr.total_symbols as u64).as_str())
                                                        resp#.push_str(",\"summary\":{\"complete\":")
                                                        if sr.truncated {
                                                            resp#.push_str("false,\"truncated\":true,\"termination_reason\":\"")
                                                            if sr.termination_reason.len() > 0 {
                                                                resp#.push_str(sr.termination_reason.as_str())
                                                            } else {
                                                                resp#.push_str("truncated")
                                                            }
                                                            resp#.push_str("\"")
                                                        } else {
                                                            resp#.push_str("true,\"truncated\":false,\"termination_reason\":\"completed\"")
                                                        }
                                                        resp#.push_str("}}}}")
                                                        resp#.push_str("\n")
                                                        send_mcp_response(resp.as_str())
                                                        continue
                                                    }
                                                    _ => {
                                                        send_error(id_str.as_str(), -32602, "Invalid params: arguments must be an object")
                                                        continue
                                                    }
                                                }
                                            }
                                            _ => {
                                                send_error(id_str.as_str(), -32602, "Invalid params: arguments must be an object")
                                                continue
                                            }
                                        }
                                    }

                                    match p_map.try_borrow(string::from("arguments")) {
                                        auto Option<&JsonNode>::Some(&a_val) => {
                                            auto is_format_json# = false
                                            match a_val {
                                                auto JsonNode::ObjectNode(&arg_map) => {
                                                    match arg_map.try_borrow(string::from("format")) {
                                                        auto Option<&JsonNode>::Some(&fn_node) => {
                                                            match fn_node {
                                                                auto JsonNode::StrNode(&fs) => {
                                                                    if fs.as_str() == "json" {
                                                                        is_format_json = true
                                                                    }
                                                                }
                                                                _ => {}
                                                            }
                                                        }
                                                        _ => {}
                                                    }
                                                }
                                                _ => {}
                                            }
                                            auto build_res = build_mcp_cli_args(a_val, startup_cwd.as_str())
                                            if build_res.is_err() {
                                                send_error(id_str.as_str(), -32602, build_res.unwrap_err().as_str())
                                                continue
                                            }
                                                    auto argv = build_res.unwrap()
                                                    auto opts_res = parse_cli_args_from_vec(argv)
                                                    if opts_res.is_err() {
                                                        send_error(id_str.as_str(), -32602, opts_res.unwrap_err().as_str())
                                                        continue
                                                    }
                                                    auto search_opts = opts_res.unwrap()
                                                    auto val_res = validate_mcp_cli_options(search_opts, startup_cwd.as_str())
                                                    if val_res.is_err() {
                                                        send_error(id_str.as_str(), -32602, val_res.unwrap_err().as_str())
                                                        continue
                                                    }
                                                    auto fmt_cfg = FormatConfig::from_options(&search_opts)
                                                    auto writer# = OutputBudgetWriter::new_mcp(
                                                        startup_cwd.clone(),
                                                        search_opts.text_layout,
                                                        search_opts.path_style,
                                                        fmt_cfg
                                                    )
                                                    auto search_res = execute_search(search_opts, writer#)
                                                    auto report# = SearchReport(
                                                        found_result = false,
                                                        had_error = false,
                                                        is_broken_pipe = false,
                                                        budget_state = BudgetState::new(search_opts.budget_limits),
                                                        elapsed_nanos = 0:u64,
                                                        diagnostics = Vec<SearchDiagnostic>::new()
                                                    )
                                                    if search_res.is_err() {
                                                        auto diag = search_res.unwrap_err()
                                                        auto all_diag# = Vec<SearchDiagnostic>::new()
                                                        all_diag#.push(diag)
                                                        auto bstate = BudgetState::new(search_opts.budget_limits)
                                                        report = SearchReport(
                                                            found_result = false,
                                                            had_error = true,
                                                            is_broken_pipe = false,
                                                            budget_state = cede bstate,
                                                            elapsed_nanos = 0:u64,
                                                            diagnostics = cede all_diag
                                                        )
                                                    } else {
                                                        report = search_res.unwrap()
                                                        finalize_search(search_opts, writer#, report)
                                                    }
                                                    auto resp = format_tool_call_response(id_str, report, search_opts, writer, server_state.negotiated_version.as_str(), is_format_json)
                                                    send_mcp_response(resp.as_str())
                                        }
                                        _ => {
                                            send_error(id_str.as_str(), -32602, "Invalid params: arguments must be an object")
                                        }
                                    }
                                }
                                _ => {
                                    send_error(id_str.as_str(), -32602, "Invalid params: params must be an object")
                                }
                            }
                        }
                        _ => {
                            send_error(id_str.as_str(), -32602, "Invalid params: params must be an object")
                        }
                    }
                } else {
                    send_error(id_str.as_str(), -32601, "Method not found")
                }
            }
            _ => {
                send_error("null", -32600, "Invalid Request")
            }
        }
    }
    return 0
}
