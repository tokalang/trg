// Application entrypoint and exit code orchestrator for trg.
import std/vec::{Vec}
import src/types::{CliOptions, GlobalStats, BudgetState}
import src/posix::{posix_init_signals, posix_write_stdout, print_err}
import src/cli::{parse_cli_args}
import src/matcher::{SearchPlan}
import src/walker::{collect_search_targets, WalkResult}
import src/scanner::{scan_file_stream, scan_file_stream_with_pass}
import src/mcp::{run_mcp_server}
import src/printer::{
    OutputBudgetWriter,
    FileFrameState,
    OutputBatch,
    EmitOutcome,
    format_summary_json,
    format_summary_json_compact,
    print_truncation_notice_stderr
}
import src/file_types::{print_type_list}

fn emit_summary_json(opts: CliOptions, stats: GlobalStats, budget_state: BudgetState, global_had_error: bool) -> i32 {
    auto sum_str# = string::new()
    if opts.json_compact {
        sum_str = format_summary_json_compact(stats, budget_state, global_had_error)
    } else {
        sum_str = format_summary_json(stats, budget_state, global_had_error)
    }
    return posix_write_stdout(sum_str.as_str())
}

fn main() -> i32 {
    // Phase -1: Initialize POSIX signals (ignore SIGPIPE to prevent crash on broken pipe)
    posix_init_signals()

    auto cli_res = parse_cli_args()
    if cli_res.is_err() {
        auto err = cli_res.unwrap_err()
        if err.as_str() == "HELP_EXIT" || err.as_str() == "VERSION_EXIT" {
            return 0
        }
        print_err(err.as_str())
        return 2
    }

    auto opts = cli_res.unwrap()

    if opts.mcp_mode {
        return run_mcp_server()
    }

    if opts.type_list_only {
        auto res = print_type_list()
        if res == 1 { return 0 } // Broken pipe on stdout -> exit 0
        if res == 2 { return 2 } // Write error -> exit 2
        return 0
    }

    auto plan_res = SearchPlan::create(opts)
    if !opts.files_mode && plan_res.is_err() {
        print_err(plan_res.unwrap_err().as_str())
        return 2
    }

    auto walk_res = collect_search_targets(opts)
    auto global_had_error# = walk_res.had_error
    auto files = walk_res.files.clone()
    auto num_files = files.len()

    auto budget_state# = BudgetState::new(opts.budget_limits)
    budget_state.files_selected = num_files
    auto writer = OutputBudgetWriter::new(opts.json_mode, opts.json_compact, opts.budget_limits.is_budget_active())

    if opts.files_mode {
        if opts.quiet {
            if num_files > 0 { return 0 }
            if global_had_error { return 2 }
            return 1
        }
        auto f_idx# = 0:usize
        auto dummy_frame# = FileFrameState(target_path = string::from(""), begin_emitted = false)
        loop f_idx < num_files {
            if budget_state.is_truncated { break }
            auto &path_str = files.borrow(f_idx)
            auto wire_str# = path_str.clone()
            wire_str#.push_str("\n")
            auto batch = OutputBatch(payload_str = cede wire_str, path = path_str.clone(), line_number = 0, is_payload = true)
            auto outcome = writer.emit_payload(budget_state#, dummy_frame#, batch)
            match outcome {
                EmitOutcome::Written => {}
                EmitOutcome::Truncated => { break }
                EmitOutcome::BrokenPipe => {
                    if global_had_error { return 2 }
                    return 0
                }
                EmitOutcome::FatalError => { return 2 }
            }
            f_idx = f_idx + 1
        }
        print_truncation_notice_stderr(budget_state)
        if global_had_error { return 2 }
        if budget_state.is_truncated || f_idx > 0 { return 0 }
        if num_files > 0 { return 0 }
        return 1
    }

    auto plan = plan_res.unwrap()

    if num_files == 0 {
        if opts.json_mode {
            auto stats = GlobalStats(
                total_files = 0:usize,
                files_with_match = 0:usize,
                total_matches = 0:usize,
                elapsed_nanos = 0:u64
            )
            auto s_res = emit_summary_json(opts, stats, budget_state, global_had_error)
            if s_res == 1 {
                if global_had_error { return 2 }
                return 0
            }
            if s_res == 2 { return 2 }
        }
        if global_had_error {
            return 2
        }
        return 1
    }

    auto multiple_files = num_files > 1 || opts.paths.len() > 1
    auto total_matches# = 0:usize
    auto files_with_match# = 0:usize
    auto broken_pipe_occurred# = false

    if opts.def_first {
        auto file_matched# = Vec<bool>::with_capacity(num_files)
        auto init_idx# = 0:usize
        loop init_idx < num_files {
            file_matched#.push(false)
            init_idx = init_idx + 1
        }

        auto i# = 0:usize
        loop i < num_files {
            if budget_state.is_truncated {
                break
            }
            auto &target_file = files.borrow(i)
            auto is_stdin = target_file.as_str() == "-"
            auto cur_pass# = 1:usize
            if is_stdin {
                cur_pass = 0:usize
            }
            auto scan_res = scan_file_stream_with_pass(target_file.clone(), opts, plan, multiple_files, writer, budget_state#, cur_pass)

            if scan_res.had_error {
                global_had_error = true
            }

            if scan_res.is_broken_pipe {
                broken_pipe_occurred = true
                break
            }

            if !scan_res.is_binary && !scan_res.had_error {
                if scan_res.has_match {
                    file_matched#.set(i, true)
                    files_with_match = files_with_match + 1
                    total_matches = total_matches + scan_res.matches_count
                    if opts.quiet {
                        if opts.json_mode {
                            auto stats = GlobalStats(
                                total_files = num_files,
                                files_with_match = files_with_match,
                                total_matches = total_matches,
                                elapsed_nanos = 0:u64
                            )
                            auto s_res = emit_summary_json(opts, stats, budget_state, global_had_error)
                            if s_res == 2 { return 2 }
                        }
                        return 0
                    }
                }
            }

            i = i + 1
        }

        if !budget_state.is_truncated && !broken_pipe_occurred {
            auto j# = 0:usize
            loop j < num_files {
                if budget_state.is_truncated {
                    break
                }
                auto &target_file = files.borrow(j)
                auto is_stdin = target_file.as_str() == "-"
                if !is_stdin {
                    auto scan_res = scan_file_stream_with_pass(target_file.clone(), opts, plan, multiple_files, writer, budget_state#, 2:usize)

                    if scan_res.had_error {
                        global_had_error = true
                    }

                    if scan_res.is_broken_pipe {
                        broken_pipe_occurred = true
                        break
                    }

                    if !scan_res.is_binary && !scan_res.had_error {
                        if scan_res.has_match {
                            if !file_matched.get(j) {
                                file_matched#.set(j, true)
                                files_with_match = files_with_match + 1
                            }
                            total_matches = total_matches + scan_res.matches_count
                            if opts.quiet {
                                if opts.json_mode {
                                    auto stats = GlobalStats(
                                        total_files = num_files,
                                        files_with_match = files_with_match,
                                        total_matches = total_matches,
                                        elapsed_nanos = 0:u64
                                    )
                                    auto s_res = emit_summary_json(opts, stats, budget_state, global_had_error)
                                    if s_res == 2 { return 2 }
                                }
                                return 0
                            }
                        }
                    }
                }

                j = j + 1
            }
        }
    } else {
        auto i# = 0:usize
        loop i < num_files {
            if budget_state.is_truncated {
                break
            }
            auto &target_file = files.borrow(i)
            auto scan_res = scan_file_stream(target_file.clone(), opts, plan, multiple_files, writer, budget_state#)

            if scan_res.had_error {
                global_had_error = true
            }

            if scan_res.is_broken_pipe {
                broken_pipe_occurred = true
                break
            }

            if !scan_res.is_binary && !scan_res.had_error {
                if scan_res.has_match {
                    files_with_match = files_with_match + 1
                    total_matches = total_matches + scan_res.matches_count
                    if opts.quiet {
                        if opts.json_mode {
                            auto stats = GlobalStats(
                                total_files = num_files,
                                files_with_match = files_with_match,
                                total_matches = total_matches,
                                elapsed_nanos = 0:u64
                            )
                            auto s_res = emit_summary_json(opts, stats, budget_state, global_had_error)
                            if s_res == 2 { return 2 }
                        }
                        return 0
                    }
                }
            }

            i = i + 1
        }
    }

    print_truncation_notice_stderr(budget_state)

    if broken_pipe_occurred {
        if global_had_error {
            return 2
        }
        return 0
    }

    if opts.json_mode {
        auto stats = GlobalStats(
            total_files = num_files,
            files_with_match = files_with_match,
            total_matches = total_matches,
            elapsed_nanos = 0:u64
        )
        auto s_res = emit_summary_json(opts, stats, budget_state, global_had_error)
        if s_res == 1 {
            if global_had_error { return 2 }
            return 0 // Broken pipe on summary -> exit 0
        }
        if s_res == 2 {
            return 2 // Write error on summary -> exit 2
        }
    }

    // Ripgrep standard error precedence: if any error occurred during walk or scan, exit with code 2
    if global_had_error {
        return 2
    }

    if total_matches > 0 || files_with_match > 0 || budget_state.files_with_match_emitted > 0 || budget_state.is_truncated {
        return 0
    }

    return 1
}
