import src/types::{OutputFormat}
import src/posix::{posix_init_signals, print_err}
import src/cli::{parse_cli_args}
import src/mcp::{run_mcp_server}
import src/printer::{
    OutputBudgetWriter,
    EmitOutcome,
    print_truncation_notice_stderr
}
import src/file_types::{print_type_list}
import src/executor::{execute_search, finalize_search}

fn main() -> i32 {
    // Phase -1: Initialize POSIX signals (ignore SIGPIPE to prevent crash on broken pipe)
    posix_init_signals()

    auto cli_res = parse_cli_args()
    if cli_res.is_err() {
        auto err = cli_res.unwrap_err()
        if err.as_str() == "HELP_EXIT" || err.as_str() == "VERSION_EXIT" {
            return 0
        }
        print_err(err.as_str())
        return 2
    }

    auto opts = cli_res.unwrap()

    if opts.mcp_mode {
        return run_mcp_server()
    }

    if opts.type_list_only {
        auto res = print_type_list()
        if res == 1 { return 0 } // Broken pipe on stdout -> exit 0
        if res == 2 { return 2 } // Write error -> exit 2
        return 0
    }

    auto format = OutputFormat::from_cli_options(opts)
    auto writer = OutputBudgetWriter::new(format)
    auto search_res = execute_search(opts, writer)
    if search_res.is_err() {
        print_err(search_res.unwrap_err().as_str())
        return 2
    }
    auto report = search_res.unwrap()

    print_truncation_notice_stderr(report.budget_state)

    if report.is_broken_pipe {
        if report.had_error {
            return 2
        }
        return 0
    }

    auto fin_outcome = finalize_search(opts, writer, report)
    match fin_outcome {
        EmitOutcome::FatalError => { return 2 }
        EmitOutcome::BrokenPipe => {
            if report.had_error { return 2 }
            return 0
        }
        _ => {}
    }

    if opts.quiet {
        if report.found_result {
            return 0
        }
        if report.had_error {
            return 2
        }
        return 1
    }

    if report.had_error {
        return 2
    }

    if report.found_result || report.budget_state.files_with_match_emitted > 0 || report.budget_state.is_truncated {
        return 0
    }

    return 1
}
