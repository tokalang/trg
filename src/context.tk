// Context ring buffer and syntactic block context calculation for trg.
import std/vec::{Vec}
import src/types::{LogicalLine, SyntaxFamily, InternedRecord, BlockDelimiter}

pub shape BeforeRing (
    lines: Vec<LogicalLine>,
    head: usize,
    count: usize,
    capacity: usize,
    bytes: usize
)

pub shape ContextState (
    ring: BeforeRing,
    pending_after: usize,
    last_emitted_line_num: usize,
    had_emitted_group: bool,
    block_active: bool,
    block_delim: BlockDelimiter,
    block_target_depth: usize,
    block_target_indent: usize,
    block_archetype: SyntaxFamily,
    block_lines_emitted: usize,
    current_group_id: usize,
    block_window: Vec<InternedRecord>,
    block_start_line: usize,
    block_separator_needed: bool
)

pub fn make_context_state(before_cap: usize, archetype: SyntaxFamily) -> ContextState {
    return ContextState(
        ring = BeforeRing(
            lines = Vec<LogicalLine>::with_capacity(before_cap),
            head = 0:usize,
            count = 0:usize,
            capacity = before_cap,
            bytes = 0:usize
        ),
        pending_after = 0:usize,
        last_emitted_line_num = 0:usize,
        had_emitted_group = false,
        block_active = false,
        block_delim = BlockDelimiter::Brace,
        block_target_depth = 0:usize,
        block_target_indent = 0:usize,
        block_archetype = archetype,
        block_lines_emitted = 0:usize,
        current_group_id = 0:usize,
        block_window = Vec<InternedRecord>::new(),
        block_start_line = 0:usize,
        block_separator_needed = false
    )
}

pub fn ring_clear(ring#: BeforeRing) {
    ring.lines#.clear()
    ring.head = 0:usize
    ring.count = 0:usize
    ring.bytes = 0:usize
}

pub fn calculate_block_context_start(
    lines: Vec<LogicalLine>,
    head: usize,
    count: usize,
    capacity: usize,
    max_block_lines: usize,
    before_context: usize,
    archetype: SyntaxFamily,
    cur_depth: usize,
    cur_indent: usize,
    match_is_def: bool,
    target_depth#: usize,
    target_indent#: usize
) -> usize {
    auto num_ring = count
    if num_ring == 0 {
        return 0:usize
    }

    auto emit_start_idx# = num_ring

    if match_is_def {
        auto outer_depth# = cur_depth
        match archetype {
            auto SyntaxFamily::Brace => {
                if outer_depth > 0 {
                    outer_depth = outer_depth - 1
                }
            }
            auto SyntaxFamily::Indent => {}
        }
        target_depth = outer_depth
        target_indent = cur_indent
        emit_start_idx = num_ring
    } else {
        auto found_start# = false
        auto s_idx# = num_ring
        loop s_idx > 0 {
            s_idx = s_idx - 1
            auto actual_idx = (head + s_idx) % capacity
            auto &r_line = lines.borrow(actual_idx)
            match archetype {
                auto SyntaxFamily::Indent => {
                    // IndentFamily: find shallower indent line
                    if r_line.participates_in_indent && r_line.statement_indent < cur_indent {
                        emit_start_idx = s_idx
                        target_indent = r_line.statement_indent
                        found_start = true
                        break
                    }
                }
                auto SyntaxFamily::Brace => {
                    // BraceFamily: find declaration or outer depth
                    if r_line.brace_depth < cur_depth || r_line.is_scope_decl {
                        emit_start_idx = s_idx
                        auto r_depth = r_line.brace_depth
                        if r_line.is_scope_decl && r_depth > 0 {
                            target_depth = r_depth - 1
                        } else {
                            target_depth = r_depth
                        }
                        found_start = true
                        break
                    }
                }
            }
        }

        if !found_start {
            if num_ring > max_block_lines / 2 {
                emit_start_idx = num_ring - (max_block_lines / 2)
            }
        }
    }

    // Snap upwards over preceding decorator / attribute lines (with empty line hard-stop)
    auto cur_snap# = emit_start_idx
    loop cur_snap > 0 {
        auto check_idx = cur_snap - 1:usize
        auto actual_idx = (head + check_idx) % capacity
        auto &r_l = lines.borrow(actual_idx)
        auto trimmed = r_l.text.as_str().trim()
        if trimmed.len == 0 {
            // Hard stop on empty line
            break
        }
        if trimmed.starts_with("@") || trimmed.starts_with("#[") {
            cur_snap = check_idx
            continue
        }
        if trimmed.ends_with(")") || trimmed.ends_with("]") {
            auto p_depth# = 0:i32
            auto found_opener# = false
            auto scan_up# = check_idx
            loop scan_up > 0 {
                auto up_actual = (head + scan_up) % capacity
                auto &up_l = lines.borrow(up_actual)
                auto up_trimmed = up_l.text.as_str().trim()
                if up_trimmed.len == 0 {
                    break
                }
                auto c_i# = up_trimmed.len
                loop c_i > 0 {
                    c_i = c_i - 1
                    auto ch = up_trimmed.byte_at(c_i)
                    if ch == (')' as char) || ch == (']' as char) {
                        p_depth = p_depth + 1
                    } else if ch == ('(' as char) || ch == ('[' as char) {
                        p_depth = p_depth - 1
                    }
                }
                if p_depth <= 0 && (up_trimmed.starts_with("@") || up_trimmed.starts_with("#[")) {
                    found_opener = true
                    cur_snap = scan_up
                    break
                }
                scan_up = scan_up - 1
            }
            if found_opener {
                continue
            }
        }
        break
    }
    emit_start_idx = cur_snap

    // Enforce before_context as minimum
    if before_context > 0 && num_ring > before_context {
        auto min_start = num_ring - before_context
        if min_start < emit_start_idx {
            emit_start_idx = min_start
        }
    }

    return emit_start_idx
}
