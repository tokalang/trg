// True incremental 64KB chunk-buffered streaming scanner with O(1) circular BeforeRing, OpeningMatchBatch atomic preflight, and lazy JSON framing.
import core/str::{str}
import std/vec::{Vec}
import sys/libc::{libc_malloc, libc_free, libc_fopen, libc_fclose, libc_fread}
import src/types::{
    CliOptions,
    MatchEvent,
    SubMatch,
    LogicalLine,
    LineProcessOutcome,
    ScanResult,
    MatchRange,
    MatchDecision,
    BudgetState,
    ScopeFrame,
    FileRunState,
    ScanPass,
    SyntaxFamily
}
import src/matcher::{SearchPlan}
import src/posix::{posix_ferror}
import src/printer::{
    OutputBudgetWriter,
    FileFrameState,
    OutputBatch,
    EmitOutcome,
    format_json_begin,
    format_json_match,
    format_json_match_compact,
    format_json_context,
    format_json_context_compact,
    format_json_end,
    format_human_match,
    format_human_context,
    format_group_separator,
    emit_json_begin,
    emit_json_end,
    write_line,
    u64_to_string
}

extern fn write(fd: i32, *buf: void, count: usize) -> isize

import src/syntax::{
    detect_syntax_family,
    compute_line_indent,
    update_brace_depth,
    detect_declaration_scope,
    is_defining_symbol,
    extract_declared_identifier,
    utf8_truncate_len,
    ScopeTracker
}
import src/context::{
    BeforeRing,
    ContextState,
    make_context_state,
    ring_clear,
    calculate_block_context_start
}

fn log_scanner_err(path: str, msg: str) {
    unsafe {
        auto p1 = "trg: "
        write(2:i32, p1.raw_ptr() as *void, p1.len)
        write(2:i32, path.raw_ptr() as *void, path.len)
        auto p2 = ": "
        write(2:i32, p2.raw_ptr() as *void, p2.len)
        write(2:i32, msg.raw_ptr() as *void, msg.len)
        auto nl = "\n"
        write(2:i32, nl.raw_ptr() as *void, 1:usize)
    }
}

fn is_binary_chunk(content: str) -> bool {
    auto check_len# = content.len
    if check_len > 1024 { check_len = 1024 }
    auto i# = 0:usize
    loop i < check_len {
        if content.byte_at(i) == (0:char) {
            return true
        }
        i = i + 1
    }
    return false
}

fn process_logical_line(
    cede line: LogicalLine,
    line_matches: bool,
    ranges: Vec<MatchRange>,
    opts: CliOptions,
    state#: ContextState,
    target_path: str,
    multiple_files: bool,
    writer: OutputBudgetWriter,
    budget_state#: BudgetState,
    frame_state#: FileFrameState,
    file_matched_lines_emitted#: usize,
    file_has_emitted_match#: bool,
    file_match_observed#: bool,
    scope_name: str
) -> LineProcessOutcome {
    if line_matches {
        auto is_first_for_file = !file_has_emitted_match
        auto res_ok = budget_state#.reserve_match(target_path, line.line_number, is_first_for_file)
        if !res_ok {
            return LineProcessOutcome::Continue
        }

        auto batch_payload# = string::new()
        // 1. Group separator
        auto has_context = opts.before_context > 0 || opts.after_context > 0 || opts.context_block
        if has_context && state.last_emitted_line_num > 0 && state.had_emitted_group {
            auto first_to_emit# = line.line_number
            if state.ring.count > 0 {
                auto first_ring_line_num = state.ring.lines.borrow(state.ring.head).line_number
                if first_ring_line_num > state.last_emitted_line_num {
                    first_to_emit = first_ring_line_num
                }
            }
            if first_to_emit > state.last_emitted_line_num + 1 {
                if !opts.json_mode {
                    batch_payload#.push_str(format_group_separator().as_str())
                }
            }
        }

        // 2. Before-context lines
        auto num_ring = state.ring.count
        auto emit_start_idx# = 0:usize

        if opts.context_block && num_ring > 0 {
            auto target_depth# = 0:usize
            auto target_indent# = 0:usize
            auto is_def = detect_declaration_scope(line.text.as_str()).len() > 0
            emit_start_idx = calculate_block_context_start(
                state.ring.lines,
                state.ring.head,
                state.ring.count,
                state.ring.capacity,
                opts.max_block_lines,
                opts.before_context,
                state.block_archetype,
                line.brace_depth,
                line.indent_level,
                is_def,
                target_depth#,
                target_indent#
            )
            state.block_target_depth = target_depth
            state.block_target_indent = target_indent
            state.block_active = true
            state.block_lines_emitted = num_ring - emit_start_idx + 1
        }

        auto r_idx# = emit_start_idx
        loop r_idx < num_ring {
            auto actual_idx = (state.ring.head + r_idx) % state.ring.capacity
            auto r_line_num = state.ring.lines.borrow(actual_idx).line_number
            if r_line_num > state.last_emitted_line_num {
                auto ev = MatchEvent(
                    path = string::from(target_path),
                    line_text = state.ring.lines.borrow(actual_idx).text.clone(),
                    line_number = r_line_num,
                    absolute_offset = state.ring.lines.borrow(actual_idx).absolute_offset,
                    submatches = Vec<SubMatch>::new(),
                    scope_name = string::from(""),
                    block_truncated = false
                )
                if opts.json_mode {
                    if opts.json_compact {
                        batch_payload#.push_str(format_json_context_compact(ev).as_str())
                    } else {
                        batch_payload#.push_str(format_json_context(ev).as_str())
                    }
                } else {
                    batch_payload#.push_str(format_human_context(ev, opts, multiple_files).as_str())
                }
                state.last_emitted_line_num = r_line_num
            }
            r_idx = r_idx + 1
        }
        ring_clear(state.ring#)

        // 3. Match record
        auto submatches# = Vec<SubMatch>::new()
        if opts.json_mode || opts.only_matching {
            if !opts.invert_match {
                auto s_idx# = 0:usize
                loop s_idx < ranges.len() {
                    auto r = ranges.get(s_idx)
                    if r.end >= r.start && r.end <= line.text.len() {
                        auto match_text = string::from(line.text.as_str().substr(r.start, r.end - r.start))
                        submatches#.push(SubMatch(
                            match_text = cede match_text,
                            start = r.start,
                            end = r.end
                        ))
                    }
                    s_idx = s_idx + 1:usize
                }
            }
        }
        auto submatch_count = submatches.len()

        auto ev = MatchEvent(
            path = string::from(target_path),
            line_text = line.text.clone(),
            line_number = line.line_number,
            absolute_offset = line.absolute_offset,
            submatches = cede submatches,
            scope_name = string::from(scope_name),
            block_truncated = false
        )
        if opts.json_mode {
            if opts.json_compact {
                batch_payload#.push_str(format_json_match_compact(ev).as_str())
            } else {
                batch_payload#.push_str(format_json_match(ev).as_str())
            }
        } else {
            batch_payload#.push_str(format_human_match(ev, opts, multiple_files).as_str())
        }

        // 4. Emit via Writer (Atomic OpeningMatchBatch)
        auto is_first_emitted = !file_has_emitted_match
        auto batch = OutputBatch(
            payload_str = cede batch_payload,
            path = string::from(target_path),
            line_number = line.line_number,
            is_payload = true
        )
        auto outcome = writer.emit_payload(budget_state#, frame_state#, batch)
        match outcome {
            EmitOutcome::Written => {
                budget_state#.commit_match_emitted(submatch_count, is_first_emitted)
                file_has_emitted_match = true
                file_matched_lines_emitted = file_matched_lines_emitted + 1
                state.last_emitted_line_num = line.line_number
                state.pending_after = opts.after_context
                state.had_emitted_group = true
                return LineProcessOutcome::Continue
            }
            EmitOutcome::Truncated => {
                return LineProcessOutcome::Continue
            }
            EmitOutcome::BrokenPipe => {
                return LineProcessOutcome::BrokenPipe
            }
            EmitOutcome::FatalError => {
                return LineProcessOutcome::FatalError
            }
        }
    }

    // Non-matching line in block context
    if state.block_active {
        state.block_lines_emitted = state.block_lines_emitted + 1
        auto terminate_block# = false
        auto is_block_truncated# = false

        if state.block_lines_emitted >= opts.max_block_lines {
            terminate_block = true
            is_block_truncated = true
            budget_state.block_contexts_truncated = budget_state.block_contexts_truncated + 1
        } else {
            match state.block_archetype {
                auto SyntaxFamily::Indent => {
                    auto trimmed = line.text.as_str().trim()
                    if trimmed.len > 0 && !trimmed.starts_with("#") {
                        if line.indent_level <= state.block_target_indent {
                            state.block_active = false
                            return LineProcessOutcome::Continue
                        }
                    }
                }
                auto SyntaxFamily::Brace => {
                    if line.brace_depth <= state.block_target_depth && line.text.as_str().index_of('}' as char).is_some() {
                        terminate_block = true
                    }
                }
            }
        }

        if line.line_number > state.last_emitted_line_num {
            auto ev = MatchEvent(
                path = string::from(target_path),
                line_text = line.text.clone(),
                line_number = line.line_number,
                absolute_offset = line.absolute_offset,
                submatches = Vec<SubMatch>::new(),
                scope_name = string::from(""),
                block_truncated = is_block_truncated
            )
            auto ctx_payload# = string::new()
            if opts.json_mode {
                if opts.json_compact {
                    ctx_payload = format_json_context_compact(ev)
                } else {
                    ctx_payload = format_json_context(ev)
                }
            } else {
                ctx_payload = format_human_context(ev, opts, multiple_files)
                if is_block_truncated {
                    ctx_payload#.push_str("[block context truncated by --max-block-lines ")
                    ctx_payload#.push_str(u64_to_string(opts.max_block_lines as u64).as_str())
                    ctx_payload#.push_str("]\n")
                }
            }
            if ctx_payload.len() > 0 {
                auto batch = OutputBatch(
                    payload_str = cede ctx_payload,
                    path = string::from(target_path),
                    line_number = line.line_number,
                    is_payload = true
                )
                auto outcome = writer.emit_payload(budget_state#, frame_state#, batch)
                match outcome {
                    EmitOutcome::Written => {
                        state.last_emitted_line_num = line.line_number
                    }
                    EmitOutcome::Truncated => {
                        return LineProcessOutcome::Continue
                    }
                    EmitOutcome::BrokenPipe => {
                        return LineProcessOutcome::BrokenPipe
                    }
                    EmitOutcome::FatalError => {
                        return LineProcessOutcome::FatalError
                    }
                }
            }
        }

        if terminate_block && state.pending_after == 0 {
            state.block_active = false
        }
        if state.pending_after > 0 {
            state.pending_after = state.pending_after - 1
        }
        return LineProcessOutcome::Continue
    }

    // Normal pending after-context line
    if state.pending_after > 0 {
        if line.line_number > state.last_emitted_line_num {
            auto ev = MatchEvent(
                path = string::from(target_path),
                line_text = line.text.clone(),
                line_number = line.line_number,
                absolute_offset = line.absolute_offset,
                submatches = Vec<SubMatch>::new(),
                scope_name = string::from(""),
                block_truncated = false
            )
            auto ctx_payload# = string::new()
            if opts.json_mode {
                if opts.json_compact {
                    ctx_payload = format_json_context_compact(ev)
                } else {
                    ctx_payload = format_json_context(ev)
                }
            } else {
                ctx_payload = format_human_context(ev, opts, multiple_files)
            }
            if ctx_payload.len() > 0 {
                auto batch = OutputBatch(
                    payload_str = cede ctx_payload,
                    path = string::from(target_path),
                    line_number = line.line_number,
                    is_payload = true
                )
                auto outcome = writer.emit_payload(budget_state#, frame_state#, batch)
                match outcome {
                    EmitOutcome::Written => {
                        state.last_emitted_line_num = line.line_number
                    }
                    EmitOutcome::Truncated => {
                        return LineProcessOutcome::Continue
                    }
                    EmitOutcome::BrokenPipe => {
                        return LineProcessOutcome::BrokenPipe
                    }
                    EmitOutcome::FatalError => {
                        return LineProcessOutcome::FatalError
                    }
                }
            }
        }
        state.pending_after = state.pending_after - 1
        return LineProcessOutcome::Continue
    }

    // Push non-matching line to O(1) circular before_ring
    auto ring_needed = opts.before_context > 0 || opts.context_block
    if ring_needed && state.ring.capacity > 0 {
        if state.ring.count >= state.ring.capacity {
            auto old_len = state.ring.lines.borrow(state.ring.head).text.len()
            auto next_bytes = state.ring.bytes - old_len + line.text.len()
            if next_bytes > 67108864:usize {
                log_scanner_err(target_path, "Maximum before-context memory limit exceeded (64MB limit)")
                return LineProcessOutcome::FatalError
            }
            state.ring.bytes = next_bytes
            state.ring.lines#.set(state.ring.head, cede line)
            state.ring.head = (state.ring.head + 1:usize) % state.ring.capacity
            return LineProcessOutcome::Continue
        }

        auto next_bytes = state.ring.bytes + line.text.len()
        if next_bytes > 67108864:usize {
            log_scanner_err(target_path, "Maximum before-context memory limit exceeded (64MB limit)")
            return LineProcessOutcome::FatalError
        }
        state.ring.bytes = next_bytes
        state.ring.lines#.push(cede line)
        state.ring.count = state.ring.count + 1
    }

    return LineProcessOutcome::Continue
}

fn scan_and_process_line(
    plan: SearchPlan,
    opts: CliOptions,
    context_state#: ContextState,
    target_path: str,
    multiple_files: bool,
    line_text: str,
    line_num: usize,
    abs_offset: usize,
    delim_len: usize,
    line_brace_depth: usize,
    line_indent: usize,
    scope_tracker: ScopeTracker,
    pass_mode: ScanPass,
    matches_count#: usize,
    has_match#: bool,
    max_count_reached#: bool,
    writer: OutputBudgetWriter,
    budget_state#: BudgetState,
    frame_state#: FileFrameState,
    file_matched_lines_emitted#: usize,
    file_has_emitted_match#: bool,
    file_match_observed#: bool
) -> LineProcessOutcome {
    auto line_matches# = false
    auto ranges# = Vec<MatchRange>::new()

    if !max_count_reached {
        if opts.json_mode || opts.only_matching {
            auto decision = plan.find_matches(line_text)
            if !opts.invert_match {
                line_matches = decision.matched
            } else {
                line_matches = !decision.matched
            }
            ranges = cede decision.ranges
        } else {
            auto matched = plan.is_match(line_text)
            if !opts.invert_match {
                line_matches = matched
            } else {
                line_matches = !matched
            }
        }

        // Two-pass filter for --def-first
        if line_matches {
            auto is_def = is_defining_symbol(line_text, plan)
            match pass_mode {
                auto ScanPass::DefinitionsOnly => {
                    if !is_def {
                        line_matches = false
                    }
                }
                auto ScanPass::UsagesOnly => {
                    if is_def {
                        line_matches = false
                    }
                }
                auto ScanPass::All => {}
            }
        }

        if line_matches {
            has_match = true
            matches_count = matches_count + 1
            if opts.max_count_enabled && matches_count >= opts.max_count {
                max_count_reached = true
            }

            auto is_first_obs = !file_match_observed
            file_match_observed = true
            budget_state#.observe_match(is_first_obs)

            if opts.quiet || opts.count {
                return LineProcessOutcome::Continue
            }

            if opts.files_with_matches {
                auto is_first = !file_has_emitted_match
                auto res_ok = budget_state#.reserve_match(target_path, line_num, is_first)
                if !res_ok {
                    return LineProcessOutcome::Continue
                }
                auto path_line# = string::from(target_path)
                path_line#.push_str("\n")
                auto batch = OutputBatch(
                    payload_str = cede path_line,
                    path = string::from(target_path),
                    line_number = line_num,
                    is_payload = true
                )
                auto outcome = writer.emit_payload(budget_state#, frame_state#, batch)
                match outcome {
                    EmitOutcome::Written => {
                        budget_state#.commit_match_emitted(0, is_first)
                        file_has_emitted_match = true
                        file_matched_lines_emitted = file_matched_lines_emitted + 1
                        return LineProcessOutcome::Continue
                    }
                    EmitOutcome::Truncated => {
                        return LineProcessOutcome::Continue
                    }
                    EmitOutcome::BrokenPipe => {
                        return LineProcessOutcome::BrokenPipe
                    }
                    EmitOutcome::FatalError => {
                        return LineProcessOutcome::FatalError
                    }
                }
            }
        }
    }

    if !opts.files_with_matches && !opts.count && !opts.quiet {
        auto l_record = LogicalLine(
            text = string::from(line_text),
            line_number = line_num,
            absolute_offset = abs_offset,
            delim_len = delim_len,
            brace_depth = line_brace_depth,
            indent_level = line_indent
        )
        auto cur_scope = scope_tracker.current_scope()
        return process_logical_line(
            cede l_record,
            line_matches,
            ranges,
            opts,
            context_state#,
            target_path,
            multiple_files,
            writer,
            budget_state#,
            frame_state#,
            file_matched_lines_emitted#,
            file_has_emitted_match#,
            file_match_observed#,
            cur_scope.as_str()
        )
    }

    return LineProcessOutcome::Continue
}

pub fn scan_file_stream(
    target_path: string,
    opts: CliOptions,
    plan: SearchPlan,
    multiple_files: bool,
    writer: OutputBudgetWriter,
    budget_state#: BudgetState,
    file_state#: FileRunState
) -> ScanResult {
    return scan_file_stream_with_pass(
        target_path,
        opts,
        plan,
        multiple_files,
        writer,
        budget_state#,
        ScanPass::All,
        file_state#
    )
}

pub fn scan_file_stream_with_pass(
    target_path: string,
    opts: CliOptions,
    plan: SearchPlan,
    multiple_files: bool,
    writer: OutputBudgetWriter,
    budget_state#: BudgetState,
    pass_mode: ScanPass,
    file_state#: FileRunState
) -> ScanResult {
    budget_state.file_scan_passes = budget_state.file_scan_passes + 1
    if !file_state.scanned_unique {
        file_state.scanned_unique = true
        budget_state.files_scanned = budget_state.files_scanned + 1
    }

    auto is_stdin = target_path.as_str() == "-"
    auto open_path# = target_path.clone()
    if is_stdin {
        open_path = string::from("/dev/stdin")
    }

    auto mode_buf# = [0:char; 8]
    mode_buf[0] = 'r' as char
    mode_buf[1] = 'b' as char
    mode_buf[2] = 0 as char

    unsafe {
        auto *mode_ptr = &mode_buf[0] as *char
        auto *path_c = open_path.c_str()
        auto nul *fp = libc_fopen(*path_c, *mode_ptr)
        if *fp == null {
            log_scanner_err(target_path.as_str(), "Permission denied or failed to open file")
            return ScanResult(
                path = target_path.clone(),
                matches_count = 0,
                has_match = false,
                is_binary = false,
                had_error = true,
                is_broken_pipe = false
            )
        }

        auto *file = fp.unwrap()
        auto nul *raw_buf = libc_malloc(65536:usize)
        if *raw_buf == null {
            libc_fclose(*file)
            log_scanner_err(target_path.as_str(), "Out of memory allocating chunk buffer")
            return ScanResult(
                path = target_path.clone(),
                matches_count = 0,
                has_match = false,
                is_binary = false,
                had_error = true,
                is_broken_pipe = false
            )
        }
        auto *buf = raw_buf.unwrap()

        auto matches_count# = 0:usize
        auto has_match# = false
        auto is_binary# = false
        auto had_error# = false
        auto is_broken_pipe# = false
        auto first_chunk# = true
        auto max_count_reached# = opts.max_count_enabled && opts.max_count == 0

        auto file_matched_lines_emitted# = 0:usize
        auto file_match_observed# = file_state.match_observed
        auto file_has_emitted_match# = file_state.match_emitted
        auto frame_state# = FileFrameState(
            target_path = target_path.clone(),
            begin_emitted = false
        )

        // If not in budget mode, JSON begins immediately on file open (unless compact)
        if opts.json_mode && !opts.json_compact && !opts.quiet && !opts.budget_limits.is_budget_active() {
            auto b_res = emit_json_begin(target_path.as_str())
            if b_res == 1 { is_broken_pipe = true }
            else if b_res == 2 { had_error = true }
            frame_state.begin_emitted = true
            budget_state.protocol_bytes_emitted = budget_state.protocol_bytes_emitted + format_json_begin(target_path.as_str()).len()
        }

        auto family = detect_syntax_family(target_path.as_str())
        auto before_cap# = opts.before_context
        if opts.context_block && opts.max_block_lines > before_cap {
            before_cap = opts.max_block_lines
        }
        auto context_state# = make_context_state(before_cap, family)
        auto scope_tracker# = ScopeTracker::new()
        auto cur_brace_depth# = 0:usize
        auto line_num# = 1:usize
        auto abs_offset# = 0:usize
        auto line_buf# = string::new()

        loop !is_broken_pipe && !had_error && !budget_state.is_truncated {
            auto bytes_read = libc_fread(*buf, 1:usize, 65536:usize, *file)
            if bytes_read == 0 {
                if posix_ferror((*file) as Addr) {
                    had_error = true
                    log_scanner_err(target_path.as_str(), "I/O read error")
                }
                break
            }

            auto *c_ptr = ((*buf) as Addr) as *char
            auto chunk_str = string::from_with_len(*c_ptr, bytes_read)
            auto chunk_view = chunk_str.as_str()

            if first_chunk {
                first_chunk = false
                if is_binary_chunk(chunk_view) {
                    is_binary = true
                    break
                }
            }

            auto chunk_pos# = 0:usize
            loop chunk_pos < chunk_view.len && !is_broken_pipe && !had_error && !budget_state.is_truncated {
                auto rem_chunk = chunk_view.substr(chunk_pos, chunk_view.len - chunk_pos)
                auto nl_opt = rem_chunk.index_of('\n' as char)

                if nl_opt.is_none() {
                    // Transition 3: no newline in remaining chunk -> buffer and advance to next chunk
                    line_buf#.push_str(rem_chunk)
                    chunk_pos = chunk_view.len
                } else {
                    auto nl_idx = nl_opt.unwrap()
                    auto outcome# = LineProcessOutcome::Continue
                    auto advance_len# = 0:usize

                    if line_buf.len() == 0 {
                        // Transition 1: Fast-path in-chunk line
                        auto raw_slice = rem_chunk.substr(0, nl_idx)
                        auto line_text# = raw_slice
                        auto delim_len# = 1:usize
                        if line_text.len > 0 && line_text.byte_at(line_text.len - 1) == ('\r' as char) {
                            line_text = line_text.substr(0, line_text.len - 1)
                            delim_len = 2:usize
                        }
                        advance_len = nl_idx + 1:usize

                        auto line_indent = compute_line_indent(line_text)
                        update_brace_depth(line_text, cur_brace_depth#)
                        auto line_brace_depth = cur_brace_depth
                        scope_tracker#.update(line_text, line_brace_depth, line_indent, family)

                        outcome = scan_and_process_line(
                            plan, opts, context_state#, target_path.as_str(), multiple_files,
                            line_text, line_num, abs_offset, delim_len,
                            line_brace_depth, line_indent, scope_tracker, pass_mode,
                            matches_count#, has_match#, max_count_reached#,
                            writer, budget_state#, frame_state#,
                            file_matched_lines_emitted#, file_has_emitted_match#, file_match_observed#
                        )
                    } else {
                        // Transition 2: Multi-chunk line completion
                        line_buf#.push_str(rem_chunk.substr(0, nl_idx))
                        advance_len = line_buf.len() + 1:usize
                        {
                            auto raw_line = line_buf.as_str()
                            auto line_text# = raw_line
                            auto delim_len# = 1:usize
                            if line_text.len > 0 && line_text.byte_at(line_text.len - 1) == ('\r' as char) {
                                line_text = line_text.substr(0, line_text.len - 1)
                                delim_len = 2:usize
                            }

                            auto line_indent = compute_line_indent(line_text)
                            update_brace_depth(line_text, cur_brace_depth#)
                            auto line_brace_depth = cur_brace_depth
                            scope_tracker#.update(line_text, line_brace_depth, line_indent, family)

                            outcome = scan_and_process_line(
                                plan, opts, context_state#, target_path.as_str(), multiple_files,
                                line_text, line_num, abs_offset, delim_len,
                                line_brace_depth, line_indent, scope_tracker, pass_mode,
                                matches_count#, has_match#, max_count_reached#,
                                writer, budget_state#, frame_state#,
                                file_matched_lines_emitted#, file_has_emitted_match#, file_match_observed#
                            )
                        }
                        line_buf#.clear()
                    }

                    chunk_pos = chunk_pos + nl_idx + 1:usize
                    match outcome {
                        LineProcessOutcome::Continue => {}
                        LineProcessOutcome::BrokenPipe => {
                            is_broken_pipe = true
                            break
                        }
                        LineProcessOutcome::FatalError => {
                            had_error = true
                            break
                        }
                    }
                    abs_offset = abs_offset + advance_len
                    line_num = line_num + 1

                    if has_match && (opts.files_with_matches || opts.quiet) {
                        break
                    }
                    if max_count_reached && (opts.count || opts.files_with_matches || (context_state.pending_after == 0 && !context_state.block_active)) {
                        break
                    }
                }
            }

            if is_broken_pipe || had_error || budget_state.is_truncated {
                break
            }
            if has_match && (opts.files_with_matches || opts.quiet) {
                break
            }
            if max_count_reached && (opts.count || (context_state.pending_after == 0 && !context_state.block_active)) {
                break
            }
        }

        // Transition 4: Process leftover final line at EOF
        if !is_binary && !had_error && !is_broken_pipe && !budget_state.is_truncated && line_buf.len() > 0 && !(has_match && (opts.files_with_matches || opts.quiet)) {
            if !(max_count_reached && (opts.count || opts.files_with_matches || (context_state.pending_after == 0 && !context_state.block_active))) {
                auto advance_len# = 0:usize
                auto outcome# = LineProcessOutcome::Continue
                {
                    auto raw_line = line_buf.as_str()
                    auto line_text# = raw_line
                    auto delim_len# = 0:usize
                    if line_text.len > 0 && line_text.byte_at(line_text.len - 1) == ('\r' as char) {
                        line_text = line_text.substr(0, line_text.len - 1)
                        delim_len = 1:usize
                    }
                    advance_len = line_text.len + delim_len

                    auto line_indent = compute_line_indent(line_text)
                    update_brace_depth(line_text, cur_brace_depth#)
                    auto line_brace_depth = cur_brace_depth
                    scope_tracker#.update(line_text, line_brace_depth, line_indent, family)

                    outcome = scan_and_process_line(
                        plan, opts, context_state#, target_path.as_str(), multiple_files,
                        line_text, line_num, abs_offset, delim_len,
                        line_brace_depth, line_indent, scope_tracker, pass_mode,
                        matches_count#, has_match#, max_count_reached#,
                        writer, budget_state#, frame_state#,
                        file_matched_lines_emitted#, file_has_emitted_match#, file_match_observed#
                    )
                }
                line_buf#.clear()
                match outcome {
                    LineProcessOutcome::Continue => {}
                    LineProcessOutcome::BrokenPipe => {
                        is_broken_pipe = true
                    }
                    LineProcessOutcome::FatalError => {
                        had_error = true
                    }
                }
                abs_offset = abs_offset + advance_len
                line_num = line_num + 1
            }
        }

        if !is_binary && !had_error && !is_broken_pipe && opts.count {
            if matches_count > 0 || opts.include_zero {
                auto out# = string::new()
                if multiple_files && target_path.as_str() != "-" {
                    out#.push_str(target_path.as_str())
                    out#.push_str(":")
                }
                auto cnt_str = u64_to_string(matches_count as u64)
                out#.push_str(cnt_str.as_str())
                auto c_res = write_line(out.as_str())
                if c_res == 1 { is_broken_pipe = true }
                else if c_res == 2 { had_error = true }
            }
        }

        // In JSON mode: emit end event only if begin was emitted (and not in compact mode)
        if opts.json_mode && !opts.json_compact && !opts.quiet && !is_broken_pipe && frame_state.begin_emitted {
            auto e_res = emit_json_end(target_path.as_str(), file_matched_lines_emitted)
            if e_res == 1 { is_broken_pipe = true }
            else if e_res == 2 { had_error = true }
            budget_state.protocol_bytes_emitted = budget_state.protocol_bytes_emitted + format_json_end(target_path.as_str(), file_matched_lines_emitted).len()
        }

        libc_free(*buf)
        libc_fclose(*file)

        if file_match_observed || has_match {
            file_state.match_observed = true
        }
        if file_has_emitted_match {
            file_state.match_emitted = true
        }

        auto ret_matches# = file_matched_lines_emitted
        if opts.quiet || opts.count {
            ret_matches = matches_count
        }

        return ScanResult(
            path = target_path.clone(),
            matches_count = ret_matches,
            has_match = has_match,
            is_binary = is_binary,
            had_error = had_error,
            is_broken_pipe = is_broken_pipe
        )
    }
}
