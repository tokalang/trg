// True incremental 64KB chunk-buffered streaming scanner with O(1) circular BeforeRing, 1MB line limit, 64MB context bound, and trg-json-v2 framing.
import core/types::{usize, char, Addr}
import core/str::{str}
import core/option::{Option}
import std/vec::{Vec}
import sys/libc::{libc_malloc, libc_free, libc_fopen, libc_fclose, libc_fread}
import src/types::{CliOptions, MatchEvent, SubMatch, LogicalLine, LineProcessOutcome, ScanResult}
import src/posix::{posix_ferror}
import src/printer::{
    emit_json_begin,
    emit_json_match,
    emit_json_context,
    emit_json_end,
    emit_human_match,
    emit_human_context,
    emit_group_separator,
    write_line,
    u64_to_string
}

extern fn write(fd: i32, *buf: void, count: usize) -> isize

pub shape BeforeRing (
    lines: Vec<LogicalLine>,
    head: usize,
    count: usize,
    capacity: usize,
    bytes: usize
)

pub shape ContextState (
    ring: BeforeRing,
    pending_after: usize,
    last_emitted_line_num: usize,
    had_emitted_group: bool
)

fn make_context_state(before_cap: usize) -> ContextState {
    return ContextState(
        ring = BeforeRing(
            lines = Vec<LogicalLine>::new(),
            head = 0:usize,
            count = 0:usize,
            capacity = before_cap,
            bytes = 0:usize
        ),
        pending_after = 0:usize,
        last_emitted_line_num = 0:usize,
        had_emitted_group = false
    )
}

fn ring_clear(ring#: BeforeRing) {
    ring.lines = Vec<LogicalLine>::new()
    ring.head = 0:usize
    ring.count = 0:usize
    ring.bytes = 0:usize
}

fn log_scanner_err(path: str, msg: str) {
    unsafe {
        auto p1 = "trg: "
        write(2:i32, p1.raw_ptr() as *void, p1.len)
        write(2:i32, path.raw_ptr() as *void, path.len)
        auto p2 = ": "
        write(2:i32, p2.raw_ptr() as *void, p2.len)
        write(2:i32, msg.raw_ptr() as *void, msg.len)
        auto nl = "\n"
        write(2:i32, nl.raw_ptr() as *void, 1:usize)
    }
}

fn is_binary_chunk(content: str) -> bool {
    auto check_len# = content.len
    if check_len > 1024 { check_len = 1024 }
    auto i# = 0:usize
    loop i < check_len {
        if content.byte_at(i) == (0:char) {
            return true
        }
        i = i + 1
    }
    return false
}

fn index_of_str_ascii_case(haystack: str, needle: str) -> Option<usize> {
    if needle.len == 0 { return Option<usize>::Some(0:usize) }
    if needle.len > haystack.len { return Option<usize>::None }

    auto max_i = haystack.len - needle.len
    auto i# = 0:usize
    loop i <= max_i {
        auto sub = haystack.substr(i, needle.len)
        if sub.eq_ignore_ascii_case(needle) {
            return Option<usize>::Some(i)
        }
        i = i + 1
    }
    return Option<usize>::None
}

fn find_all_submatches(line: str, needle: str, ignore_case: bool) -> Vec<SubMatch> {
    auto list# = Vec<SubMatch>::new()
    if needle.len == 0 { return cede list }

    auto offset# = 0:usize
    loop offset < line.len {
        auto rem = line.substr(offset, line.len - offset)
        auto found_opt# = Option<usize>::None
        if ignore_case {
            found_opt = index_of_str_ascii_case(rem, needle)
        } else {
            found_opt = rem.index_of_str(needle)
        }

        if found_opt.is_none() { break }
        auto match_idx = found_opt.unwrap()
        auto start = offset + match_idx
        auto end = start + needle.len

        auto match_text = string::from(line.substr(start, needle.len))
        auto sm = SubMatch(
            match_text = cede match_text,
            start = start,
            end = end
        )
        list#.push(cede sm)

        offset = end
        if needle.len == 0 { break }
    }
    return cede list
}

fn process_logical_line(
    cede line: LogicalLine,
    line_matches: bool,
    opts: CliOptions,
    state#: ContextState,
    target_path: str,
    needle: str,
    multiple_files: bool
) -> LineProcessOutcome {
    if line_matches {
        // Group separator logic (human mode only, active when context is requested)
        auto has_context = opts.before_context > 0 || opts.after_context > 0
        if has_context && state.last_emitted_line_num > 0 && state.had_emitted_group {
            auto first_to_emit# = line.line_number
            if state.ring.count > 0 {
                auto &first_ring = state.ring.lines.borrow(state.ring.head)
                if first_ring.line_number > state.last_emitted_line_num {
                    first_to_emit = first_ring.line_number
                }
            }
            if first_to_emit > state.last_emitted_line_num + 1 {
                if !opts.json_mode {
                    auto sep_res = emit_group_separator()
                    if sep_res == 1 { return LineProcessOutcome::BrokenPipe }
                    if sep_res == 2 { return LineProcessOutcome::FatalError }
                }
            }
        }

        // Flush before_ring in O(1) FIFO order
        auto num_ring = state.ring.count
        auto r_idx# = 0:usize
        loop r_idx < num_ring {
            auto actual_idx = (state.ring.head + r_idx) % state.ring.capacity
            auto &r_line = state.ring.lines.borrow(actual_idx)
            if r_line.line_number > state.last_emitted_line_num {
                auto ev = MatchEvent(
                    path = string::from(target_path),
                    line_text = r_line.text.clone(),
                    line_number = r_line.line_number,
                    absolute_offset = r_line.absolute_offset,
                    submatches = Vec<SubMatch>::new()
                )
                if opts.json_mode {
                    auto c_res = emit_json_context(ev)
                    if c_res == 1 { return LineProcessOutcome::BrokenPipe }
                    if c_res == 2 { return LineProcessOutcome::FatalError }
                } else {
                    auto h_res = emit_human_context(ev, opts, multiple_files)
                    if h_res == 1 { return LineProcessOutcome::BrokenPipe }
                    if h_res == 2 { return LineProcessOutcome::FatalError }
                }
                state.last_emitted_line_num = r_line.line_number
            }
            r_idx = r_idx + 1
        }
        ring_clear(state.ring#)

        // Emit match event
        if opts.json_mode {
            auto submatches# = Vec<SubMatch>::new()
            if needle.len > 0 {
                submatches = find_all_submatches(line.text.as_str(), needle, opts.ignore_case)
            }
            auto ev = MatchEvent(
                path = string::from(target_path),
                line_text = line.text.clone(),
                line_number = line.line_number,
                absolute_offset = line.absolute_offset,
                submatches = cede submatches
            )
            auto m_res = emit_json_match(ev)
            if m_res == 1 { return LineProcessOutcome::BrokenPipe }
            if m_res == 2 { return LineProcessOutcome::FatalError }
        } else {
            auto ev = MatchEvent(
                path = string::from(target_path),
                line_text = line.text.clone(),
                line_number = line.line_number,
                absolute_offset = line.absolute_offset,
                submatches = Vec<SubMatch>::new()
            )
            auto m_res = emit_human_match(ev, opts, multiple_files)
            if m_res == 1 { return LineProcessOutcome::BrokenPipe }
            if m_res == 2 { return LineProcessOutcome::FatalError }
        }

        state.last_emitted_line_num = line.line_number
        state.pending_after = opts.after_context
        state.had_emitted_group = true
        return LineProcessOutcome::Continue
    }

    // Non-matching line
    if state.pending_after > 0 {
        if line.line_number > state.last_emitted_line_num {
            auto ev = MatchEvent(
                path = string::from(target_path),
                line_text = line.text.clone(),
                line_number = line.line_number,
                absolute_offset = line.absolute_offset,
                submatches = Vec<SubMatch>::new()
            )
            if opts.json_mode {
                auto c_res = emit_json_context(ev)
                if c_res == 1 { return LineProcessOutcome::BrokenPipe }
                if c_res == 2 { return LineProcessOutcome::FatalError }
            } else {
                auto h_res = emit_human_context(ev, opts, multiple_files)
                if h_res == 1 { return LineProcessOutcome::BrokenPipe }
                if h_res == 2 { return LineProcessOutcome::FatalError }
            }
            state.last_emitted_line_num = line.line_number
        }
        state.pending_after = state.pending_after - 1
        return LineProcessOutcome::Continue
    }

    // Push non-matching line to O(1) circular before_ring
    if opts.before_context > 0 && state.ring.capacity > 0 {
        if state.ring.count >= state.ring.capacity {
            auto old_len = state.ring.lines.borrow(state.ring.head).text.len()
            auto next_bytes = state.ring.bytes - old_len + line.text.len()
            if next_bytes > 67108864:usize {
                log_scanner_err(target_path, "Maximum before-context memory limit exceeded (64MB limit)")
                return LineProcessOutcome::FatalError
            }
            state.ring.bytes = next_bytes
            state.ring.lines#.set(state.ring.head, cede line)
            state.ring.head = (state.ring.head + 1:usize) % state.ring.capacity
            return LineProcessOutcome::Continue
        }

        auto next_bytes = state.ring.bytes + line.text.len()
        if next_bytes > 67108864:usize {
            log_scanner_err(target_path, "Maximum before-context memory limit exceeded (64MB limit)")
            return LineProcessOutcome::FatalError
        }
        state.ring.bytes = next_bytes
        state.ring.lines#.push(cede line)
        state.ring.count = state.ring.count + 1
    }

    return LineProcessOutcome::Continue
}

pub fn scan_file_stream(
    target_path: string,
    opts: CliOptions,
    multiple_files: bool
) -> ScanResult {
    auto is_stdin = target_path.as_str() == "-"
    auto open_path# = target_path.clone()
    if is_stdin {
        open_path = string::from("/dev/stdin")
    }

    auto mode_buf# = [0:char; 8]
    mode_buf[0] = 'r' as char
    mode_buf[1] = 'b' as char
    mode_buf[2] = 0 as char

    unsafe {
        auto *mode_ptr = &mode_buf[0] as *char
        auto *path_c = open_path.c_str()
        auto nul *fp = libc_fopen(*path_c, *mode_ptr)
        if *fp == null {
            log_scanner_err(target_path.as_str(), "Permission denied or failed to open file")
            return ScanResult(
                path = target_path.clone(),
                matches_count = 0,
                has_match = false,
                is_binary = false,
                had_error = true,
                is_broken_pipe = false
            )
        }

        auto *file = fp.unwrap()
        auto nul *raw_buf = libc_malloc(65536:usize)
        if *raw_buf == null {
            libc_fclose(*file)
            return ScanResult(
                path = target_path.clone(),
                matches_count = 0,
                has_match = false,
                is_binary = false,
                had_error = true,
                is_broken_pipe = false
            )
        }
        auto *buf = raw_buf.unwrap()

        // In JSON mode, emit begin event immediately upon file opening (trg-json-v2)
        if opts.json_mode {
            auto b_res = emit_json_begin(target_path.as_str())
            if b_res != 0 {
                libc_free(*buf)
                libc_fclose(*file)
                auto is_bp = b_res == 1
                auto had_err = b_res == 2
                return ScanResult(
                    path = target_path.clone(),
                    matches_count = 0,
                    has_match = false,
                    is_binary = false,
                    had_error = had_err,
                    is_broken_pipe = is_bp
                )
            }
        }

        auto needle = opts.pattern.as_str()
        auto carry# = string::new()
        auto line_num# = 1:usize
        auto abs_offset# = 0:usize
        auto matches_count# = 0:usize
        auto has_match# = false
        auto is_first_chunk# = true
        auto is_binary# = false
        auto had_error# = false
        auto is_broken_pipe# = false

        auto context_state# = make_context_state(opts.before_context)

        loop true {
            auto n = libc_fread(*buf, 1:usize, 65536:usize, *file)
            if n == 0 {
                if posix_ferror((*file) as Addr) {
                    log_scanner_err(target_path.as_str(), "Read error occurred during file streaming")
                    had_error = true
                }
                break
            }

            auto *c_ptr = ((*buf) as Addr) as *char
            auto chunk_str = string::from_with_len(*c_ptr, n)
            auto chunk_view = chunk_str.as_str()

            if is_first_chunk {
                is_first_chunk = false
                if is_binary_chunk(chunk_view) {
                    is_binary = true
                    if opts.json_mode {
                        auto end_res = emit_json_end(target_path.as_str(), 0)
                        if end_res == 1 { is_broken_pipe = true }
                        else if end_res == 2 { had_error = true }
                    }
                    break
                }
            }

            auto block# = string::new()
            if carry.len() > 0 {
                block#.push_str(carry.as_str())
            }
            block#.push_str(chunk_view)

            auto block_view = block.as_str()
            auto cursor# = 0:usize

            loop cursor < block_view.len {
                auto rem = block_view.substr(cursor, block_view.len - cursor)
                auto nl_opt = rem.index_of('\n' as char)
                if nl_opt.is_none() {
                    // Check if remaining unterminated logical line exceeds 1MB limit
                    if rem.len > 1048576:usize {
                        log_scanner_err(target_path.as_str(), "Maximum logical line length exceeded (1MB limit)")
                        had_error = true
                        break
                    }
                    carry = string::from(rem)
                    break
                }
                auto nl_pos = nl_opt.unwrap()
                auto line_raw = rem.substr(0, nl_pos)
                auto line_text# = line_raw
                auto delim_len# = 1:usize
                if line_raw.len > 0 && line_raw.byte_at(line_raw.len - 1) == ('\r' as char) {
                    line_text = line_raw.substr(0, line_raw.len - 1)
                    delim_len = 2:usize
                }

                // Check if terminated logical line exceeds 1MB limit
                if line_text.len > 1048576:usize {
                    log_scanner_err(target_path.as_str(), "Maximum logical line length exceeded (1MB limit)")
                    had_error = true
                    break
                }

                auto is_needle_found# = false
                if needle.len == 0 {
                    is_needle_found = true
                } else if opts.ignore_case {
                    is_needle_found = index_of_str_ascii_case(line_text, needle).is_some()
                } else {
                    is_needle_found = line_text.index_of_str(needle).is_some()
                }

                auto line_matches# = false
                if !opts.invert_match {
                    line_matches = is_needle_found
                } else {
                    line_matches = !is_needle_found
                }

                if line_matches {
                    has_match = true
                    matches_count = matches_count + 1

                    if opts.files_with_matches {
                        auto w_res = write_line(target_path.as_str())
                        if w_res == 1 { is_broken_pipe = true }
                        else if w_res == 2 { had_error = true }
                        break
                    }
                }

                if !opts.files_with_matches && !opts.count {
                    auto l_record = LogicalLine(
                        text = string::from(line_text),
                        line_number = line_num,
                        absolute_offset = abs_offset,
                        delim_len = delim_len
                    )
                    auto outcome = process_logical_line(
                        cede l_record,
                        line_matches,
                        opts,
                        context_state#,
                        target_path.as_str(),
                        needle,
                        multiple_files
                    )
                    match outcome {
                        LineProcessOutcome::Continue => {}
                        LineProcessOutcome::BrokenPipe => {
                            is_broken_pipe = true
                            break
                        }
                        LineProcessOutcome::FatalError => {
                            had_error = true
                            break
                        }
                    }
                }

                abs_offset = abs_offset + line_text.len + delim_len
                line_num = line_num + 1
                cursor = cursor + nl_pos + 1
                carry = string::new()
            }

            if is_broken_pipe || had_error || (opts.files_with_matches && has_match) {
                break
            }
        }

        // Process leftover final line at EOF
        if !is_binary && !had_error && !is_broken_pipe && carry.len() > 0 && !(opts.files_with_matches && has_match) {
            auto line_raw = carry.as_str()
            auto line_text# = line_raw
            auto delim_len# = 0:usize
            if line_raw.len > 0 && line_raw.byte_at(line_raw.len - 1) == ('\r' as char) {
                line_text = line_raw.substr(0, line_raw.len - 1)
                delim_len = 1:usize
            }

            // Check if final logical line exceeds 1MB limit
            if line_text.len > 1048576:usize {
                log_scanner_err(target_path.as_str(), "Maximum logical line length exceeded (1MB limit)")
                had_error = true
            } else {
                auto is_needle_found# = false
                if needle.len == 0 {
                    is_needle_found = true
                } else if opts.ignore_case {
                    is_needle_found = index_of_str_ascii_case(line_text, needle).is_some()
                } else {
                    is_needle_found = line_text.index_of_str(needle).is_some()
                }

                auto line_matches# = false
                if !opts.invert_match {
                    line_matches = is_needle_found
                } else {
                    line_matches = !is_needle_found
                }

                if line_matches {
                    has_match = true
                    matches_count = matches_count + 1

                    if opts.files_with_matches {
                        auto w_res = write_line(target_path.as_str())
                        if w_res == 1 { is_broken_pipe = true }
                        else if w_res == 2 { had_error = true }
                    }
                }

                if !opts.files_with_matches && !opts.count {
                    auto l_record = LogicalLine(
                        text = string::from(line_text),
                        line_number = line_num,
                        absolute_offset = abs_offset,
                        delim_len = delim_len
                    )
                    auto outcome = process_logical_line(
                        cede l_record,
                        line_matches,
                        opts,
                        context_state#,
                        target_path.as_str(),
                        needle,
                        multiple_files
                    )
                    match outcome {
                        LineProcessOutcome::Continue => {}
                        LineProcessOutcome::BrokenPipe => {
                            is_broken_pipe = true
                        }
                        LineProcessOutcome::FatalError => {
                            had_error = true
                        }
                    }
                }

                abs_offset = abs_offset + line_text.len + delim_len
                line_num = line_num + 1
            }
        }

        if !is_binary && !had_error && !is_broken_pipe && opts.count {
            auto out# = string::new()
            if multiple_files && target_path.as_str() != "-" {
                out#.push_str(target_path.as_str())
                out#.push_str(":")
            }
            auto cnt_str = u64_to_string(matches_count as u64)
            out#.push_str(cnt_str.as_str())
            auto c_res = write_line(out.as_str())
            if c_res == 1 { is_broken_pipe = true }
            else if c_res == 2 { had_error = true }
        }

        // Always emit matching end event in JSON mode if begin was emitted
        if !is_binary && opts.json_mode && !is_broken_pipe {
            auto e_res = emit_json_end(target_path.as_str(), matches_count)
            if e_res == 1 { is_broken_pipe = true }
            else if e_res == 2 { had_error = true }
        }

        libc_free(*buf)
        libc_fclose(*file)

        return ScanResult(
            path = target_path.clone(),
            matches_count = matches_count,
            has_match = has_match,
            is_binary = is_binary,
            had_error = had_error,
            is_broken_pipe = is_broken_pipe
        )
    }
}
