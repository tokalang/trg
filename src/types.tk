// Shared shapes and types for trg.
import core/types::{usize}
import std/vec::{Vec}

pub shape GlobRule (
    pattern: string,
    is_negation: bool,
    dir_only: bool
)

pub shape CliOptions (
    pattern: string,
    paths: Vec<string>,
    fixed_strings: bool,
    regexp: bool,
    word_regexp: bool,
    line_regexp: bool,
    no_prefilter: bool,
    line_number: bool,
    files_with_matches: bool,
    count: bool,
    invert_match: bool,
    ignore_case: bool,
    files_mode: bool,
    json_mode: bool,
    hidden: bool,
    before_context: usize,
    after_context: usize,
    globs: Vec<GlobRule>
)

pub shape MatchRange (
    start: usize,
    end: usize
)

pub shape MatchDecision (
    matched: bool,
    ranges: Vec<MatchRange>
)

pub shape SubMatch (
    match_text: string,
    start: usize,
    end: usize
)

pub shape MatchEvent (
    path: string,
    line_text: string,
    line_number: usize,
    absolute_offset: usize,
    submatches: Vec<SubMatch>
)

pub shape LogicalLine (
    text: string,
    line_number: usize,
    absolute_offset: usize,
    delim_len: usize
)

pub shape LineProcessOutcome (
    Continue = 0 |
    BrokenPipe = 1 |
    FatalError = 2
)

pub shape ScanResult (
    path: string,
    matches_count: usize,
    has_match: bool,
    is_binary: bool,
    had_error: bool,
    is_broken_pipe: bool
)

pub shape GlobalStats (
    total_files: usize,
    files_with_match: usize,
    total_matches: usize,
    elapsed_nanos: u64
)
