// Shared shapes and types for trg.
import core/option::{Option}
import std/vec::{Vec}

pub shape OutputMode (
    CliStreaming = 0 |
    McpCollecting = 1
)

pub shape PathStyle (
    AsGiven = 0 |
    WorkspaceRelative = 1 |
    Absolute = 2
)

pub shape TextLayout (
    Auto = 0 |
    Grouped = 1 |
    Flat = 2
)

pub shape PathKind (
    Relative = 0 |
    Absolute = 1 |
    Stdin = 2
)

pub fn path_kind_name(kind: PathKind) -> str {
    match kind {
        auto PathKind::Relative => { return "workspace_relative" }
        auto PathKind::Absolute => { return "absolute" }
        auto PathKind::Stdin => { return "stdin" }
    }
}

pub fn scan_pass_name(p: ScanPass) -> str {
    match p {
        auto ScanPass::All => { return "all" }
        auto ScanPass::DefinitionsOnly => { return "definitions" }
        auto ScanPass::UsagesOnly => { return "usages" }
    }
}

pub shape ResolvedPath (
    identity_key: string,
    display_path: string,
    path_kind: PathKind
)

pub shape PathBase (
    kind: string,
    path: string
)

pub shape FileEntry (
    id: usize,
    path: string,
    path_kind: PathKind
)

pub shape ProjectionConfig (
    path_style: PathStyle,
    text_layout: TextLayout
)

pub shape CaseMode (
    Sensitive = 0 |
    Insensitive = 1 |
    Smart = 2
)

pub shape SortMode (
    None = 0 |
    Path = 1 |
    PathReverse = 2
)

pub shape GlobRule (
    pattern: string,
    is_negation: bool,
    dir_only: bool
)

pub shape BudgetLimits (
    max_total_matches_enabled: bool,
    max_total_matches: usize,
    max_result_bytes_enabled: bool,
    max_result_bytes: usize,
    max_files_with_matches_enabled: bool,
    max_files_with_matches: usize,
    no_truncation_notice: bool
)

impl BudgetLimits {
    pub fn new() -> BudgetLimits {
        return BudgetLimits(
            max_total_matches_enabled = false,
            max_total_matches = 0,
            max_result_bytes_enabled = false,
            max_result_bytes = 0,
            max_files_with_matches_enabled = false,
            max_files_with_matches = 0,
            no_truncation_notice = false
        )
    }

    pub fn is_budget_active(self) -> bool {
        return self.max_total_matches_enabled ||
               self.max_result_bytes_enabled ||
               self.max_files_with_matches_enabled
    }
}

pub shape ScanPass (
    All = 0 |
    DefinitionsOnly = 1 |
    UsagesOnly = 2
)

pub shape SyntaxFamily (
    Brace = 0 |
    Indent = 1
)

pub shape OutputFormat (
    Human = 0 |
    JsonFull = 1 |
    JsonCompact = 2
)

pub shape OutputSink (
    Stdout = 0 |
    Memory = 1
)

pub shape BudgetState (
    limits: BudgetLimits,
    files_selected#: usize,
    files_scanned#: usize,
    file_scan_passes#: usize,
    files_with_match_observed#: usize,
    files_with_match_emitted#: usize,
    matched_lines_observed#: usize,
    matched_lines_emitted#: usize,
    submatches_emitted#: usize,
    result_payload_bytes_emitted#: usize,
    protocol_bytes_emitted#: usize,
    block_contexts_truncated#: usize,
    is_truncated#: bool,
    truncation_reason#: string,
    stopped_path#: string,
    stopped_line_num#: usize
)

impl BudgetState {
    pub fn new(limits: BudgetLimits) -> BudgetState {
        return BudgetState(
            limits = limits,
            files_selected = 0,
            files_scanned = 0,
            file_scan_passes = 0,
            files_with_match_observed = 0,
            files_with_match_emitted = 0,
            matched_lines_observed = 0,
            matched_lines_emitted = 0,
            submatches_emitted = 0,
            result_payload_bytes_emitted = 0,
            protocol_bytes_emitted = 0,
            block_contexts_truncated = 0,
            is_truncated = false,
            truncation_reason = string::from(""),
            stopped_path = string::from(""),
            stopped_line_num = 0
        )
    }

    pub fn clone(self) -> BudgetState {
        return BudgetState(
            limits = self.limits,
            files_selected = self.files_selected,
            files_scanned = self.files_scanned,
            file_scan_passes = self.file_scan_passes,
            files_with_match_observed = self.files_with_match_observed,
            files_with_match_emitted = self.files_with_match_emitted,
            matched_lines_observed = self.matched_lines_observed,
            matched_lines_emitted = self.matched_lines_emitted,
            submatches_emitted = self.submatches_emitted,
            result_payload_bytes_emitted = self.result_payload_bytes_emitted,
            protocol_bytes_emitted = self.protocol_bytes_emitted,
            block_contexts_truncated = self.block_contexts_truncated,
            is_truncated = self.is_truncated,
            truncation_reason = self.truncation_reason.clone(),
            stopped_path = self.stopped_path.clone(),
            stopped_line_num = self.stopped_line_num
        )
    }

    pub fn observe_match(self#, is_first_observed_for_file: bool) {
        self.matched_lines_observed = self.matched_lines_observed + 1
        if is_first_observed_for_file {
            self.files_with_match_observed = self.files_with_match_observed + 1
        }
    }

    pub fn reserve_match(self#, path: str, line_num: usize, is_first_for_file: bool) -> bool {
        if self.is_truncated { return false }

        // Priority 1: max_total_matches
        if self.limits.max_total_matches_enabled && self.matched_lines_emitted >= self.limits.max_total_matches {
            self.is_truncated = true
            self.truncation_reason = string::from("max_total_matches")
            self.stopped_path = string::from(path)
            self.stopped_line_num = line_num
            return false
        }
        // Priority 2: max_files_with_matches
        if self.limits.max_files_with_matches_enabled && is_first_for_file && self.files_with_match_emitted >= self.limits.max_files_with_matches {
            self.is_truncated = true
            self.truncation_reason = string::from("max_files_with_matches")
            self.stopped_path = string::from(path)
            self.stopped_line_num = line_num
            return false
        }
        return true
    }

    pub fn commit_match_emitted(self#, submatch_count: usize, is_first_emitted_for_file: bool) {
        self.matched_lines_emitted = self.matched_lines_emitted + 1
        self.submatches_emitted = self.submatches_emitted + submatch_count
        if is_first_emitted_for_file {
            self.files_with_match_emitted = self.files_with_match_emitted + 1
        }
    }
}

pub shape CliOptions (
    patterns: Vec<string>,
    paths: Vec<string>,
    pattern_source_given: bool,
    fixed_strings: bool,
    regexp: bool,
    word_regexp: bool,
    line_regexp: bool,
    no_prefilter: bool,
    line_number: bool,
    files_with_matches: bool,
    count: bool,
    include_zero: bool,
    quiet: bool,
    only_matching: bool,
    invert_match: bool,
    case_mode: CaseMode,
    sort_mode: SortMode,
    no_ignore: bool,
    files_mode: bool,
    json_mode: bool,
    json_compact: bool,
    hidden: bool,
    type_list_only: bool,
    before_context: usize,
    after_context: usize,
    max_count_enabled: bool,
    max_count: usize,
    max_columns: usize,
    budget_limits: BudgetLimits,
    globs: Vec<GlobRule>,
    include_type_exts: Vec<string>,
    exclude_type_exts: Vec<string>,
    include_types: Vec<string>,
    exclude_types: Vec<string>,
    context_block: bool,
    max_block_lines: usize,
    scope: bool,
    def_first: bool,
    mcp_mode: bool,
    path_style: PathStyle,
    text_layout: TextLayout,
    with_filename: Option<bool>,
    deduplicate_targets: bool
)

pub shape ScopeFrame (
    name: string,
    depth: usize
)

pub shape MatchRange (
    start: usize,
    end: usize
)

pub shape MatchDecision (
    matched: bool,
    ranges: Vec<MatchRange>
)

pub shape SubMatch (
    match_text: string,
    start: usize,
    end: usize
)

impl SubMatch {
    pub fn clone(self) -> SubMatch {
        return SubMatch(
            match_text = self.match_text.clone(),
            start = self.start,
            end = self.end
        )
    }
}

pub shape InternedRecord (
    kind: string,
    group_id: usize,
    line_number: usize,
    absolute_offset: usize,
    text: string,
    submatches: Vec<SubMatch>,
    scope: Option<string>,
    block_truncated: bool
)

impl InternedRecord {
    pub fn clone(self) -> InternedRecord {
        auto subs# = Vec<SubMatch>::new()
        auto i# = 0:usize
        loop i < self.submatches.len() {
            subs#.push(self.submatches.borrow(i).clone())
            i = i + 1
        }
        auto sc# = Option<string>::None
        match self.scope {
            auto Option<string>::Some(&s) => {
                sc = Option<string>::Some(s.clone())
            }
            _ => {}
        }
        return InternedRecord(
            kind = self.kind.clone(),
            group_id = self.group_id,
            line_number = self.line_number,
            absolute_offset = self.absolute_offset,
            text = self.text.clone(),
            submatches = cede subs,
            scope = cede sc,
            block_truncated = self.block_truncated
        )
    }
}

pub shape ResultSegment (
    file_id: usize,
    scan_pass: ScanPass,
    records: Vec<InternedRecord>
)

impl ResultSegment {
    pub fn add_record(self#, cede rec: InternedRecord) {
        self.records#.push(cede rec)
    }
}

pub shape MatchEvent (
    path: string,
    line_text: string,
    line_number: usize,
    absolute_offset: usize,
    submatches: Vec<SubMatch>,
    scope_name: string,
    block_truncated: bool,
    is_context: bool,
    group_id: usize,
    context_roles: Vec<string>
)

pub shape LogicalLine (
    text: string,
    line_number: usize,
    absolute_offset: usize,
    delim_len: usize,
    brace_depth: usize,
    indent_level: usize
)

pub shape LineProcessOutcome (
    Continue = 0 |
    BrokenPipe = 1 |
    FatalError = 2
)

pub shape SearchDiagnostic (
    kind: string,
    path: Option<string>,
    message: string,
    errno: Option<i32>
)

impl SearchDiagnostic {
    pub fn new(cede kind: string, cede path: Option<string>, cede message: string, errno: Option<i32>) -> SearchDiagnostic {
        return SearchDiagnostic(
            kind = cede kind,
            path = cede path,
            message = cede message,
            errno = errno
        )
    }
}

pub shape ScanResult (
    path: string,
    matches_count: usize,
    has_match: bool,
    is_binary: bool,
    had_error: bool,
    is_broken_pipe: bool,
    diagnostics: Vec<SearchDiagnostic>
)

pub shape GlobalStats (
    total_files: usize,
    files_with_match: usize,
    total_matches: usize,
    elapsed_nanos: u64
)

pub shape FileRunState (
    scanned_unique#: bool,
    match_observed#: bool,
    match_emitted#: bool
)

impl FileRunState {
    pub fn new() -> FileRunState {
        return FileRunState(
            scanned_unique = false,
            match_observed = false,
            match_emitted = false
        )
    }
}

pub shape SearchReport (
    found_result: bool,
    had_error: bool,
    is_broken_pipe: bool,
    budget_state: BudgetState,
    elapsed_nanos: u64,
    diagnostics: Vec<SearchDiagnostic>
)

pub shape EffectiveQuery (
    patterns: Vec<string>,
    mode: string,
    match_boundary: string,
    case_mode: string,
    paths: Vec<string>,
    globs: Vec<string>,
    types: Vec<string>,
    exclude_types: Vec<string>,
    ignore_enabled: bool,
    hidden_enabled: bool,
    no_prefilter: bool,
    invert_match: bool,
    max_columns: Option<usize>,
    symlink_policy: string,
    binary_policy: string,
    sort: string,
    context: Option<usize>,
    before_context: usize,
    after_context: usize,
    block: bool,
    max_block_lines: Option<usize>,
    scope: bool,
    def_first: bool,
    deduplicate_targets: bool
)

impl EffectiveQuery {
    pub fn from_cli_options(opts: CliOptions) -> EffectiveQuery {
        auto mode_str# = string::from("regex")
        if opts.fixed_strings {
            mode_str = string::from("literal")
        }

        auto bound_str# = string::from("substring")
        if opts.line_regexp {
            bound_str = string::from("line")
        } else if opts.word_regexp {
            bound_str = string::from("word")
        }

        auto case_str# = string::from("sensitive")
        match opts.case_mode {
            auto CaseMode::Smart => {
                case_str = string::from("smart")
            }
            auto CaseMode::Insensitive => {
                case_str = string::from("ignore")
            }
            auto CaseMode::Sensitive => {
                case_str = string::from("sensitive")
            }
        }

        auto paths_vec# = Vec<string>::new()
        auto p_idx# = 0:usize
        loop p_idx < opts.paths.len() {
            paths_vec#.push(opts.paths.borrow(p_idx).clone())
            p_idx = p_idx + 1
        }

        auto globs_vec# = Vec<string>::new()
        auto g_idx# = 0:usize
        loop g_idx < opts.globs.len() {
            auto &g = opts.globs.borrow(g_idx)
            auto s# = string::new()
            if g.is_negation {
                s#.push_str("!")
            }
            s#.push_str(g.pattern.as_str())
            if g.dir_only {
                s#.push_str("/")
            }
            globs_vec#.push(cede s)
            g_idx = g_idx + 1
        }

        auto types_vec# = Vec<string>::new()
        auto t_idx# = 0:usize
        loop t_idx < opts.include_types.len() {
            types_vec#.push(opts.include_types.borrow(t_idx).clone())
            t_idx = t_idx + 1
        }

        auto exclude_types_vec# = Vec<string>::new()
        auto et_idx# = 0:usize
        loop et_idx < opts.exclude_types.len() {
            exclude_types_vec#.push(opts.exclude_types.borrow(et_idx).clone())
            et_idx = et_idx + 1
        }

        auto sort_str# = string::from("path")
        match opts.sort_mode {
            auto SortMode::Path => {
                sort_str = string::from("path")
            }
            auto SortMode::PathReverse => {
                sort_str = string::from("reverse_path")
            }
            auto SortMode::None => {
                sort_str = string::from("none")
            }
        }

        auto ctx_opt# = Option<usize>::None
        if opts.before_context > 0 && opts.before_context == opts.after_context {
            ctx_opt = Option<usize>::Some(opts.before_context)
        }

        auto max_col_opt# = Option<usize>::None
        if opts.max_columns > 0 {
            max_col_opt = Option<usize>::Some(opts.max_columns)
        }

        auto pats_vec# = Vec<string>::new()
        auto pat_idx# = 0:usize
        loop pat_idx < opts.patterns.len() {
            pats_vec#.push(opts.patterns.borrow(pat_idx).clone())
            pat_idx = pat_idx + 1
        }

        auto mbl_opt# = Option<usize>::None
        if opts.context_block {
            mbl_opt = Option<usize>::Some(opts.max_block_lines)
        }

        return EffectiveQuery(
            patterns = cede pats_vec,
            mode = cede mode_str,
            match_boundary = cede bound_str,
            case_mode = cede case_str,
            paths = cede paths_vec,
            globs = cede globs_vec,
            types = cede types_vec,
            exclude_types = cede exclude_types_vec,
            ignore_enabled = !opts.no_ignore,
            hidden_enabled = opts.hidden,
            no_prefilter = opts.no_prefilter,
            invert_match = opts.invert_match,
            max_columns = max_col_opt,
            symlink_policy = string::from("skip"),
            binary_policy = string::from("skip"),
            sort = cede sort_str,
            context = ctx_opt,
            before_context = opts.before_context,
            after_context = opts.after_context,
            block = opts.context_block,
            max_block_lines = mbl_opt,
            scope = opts.scope,
            def_first = opts.def_first,
            deduplicate_targets = opts.deduplicate_targets
        )
    }
}

impl OutputFormat {
    pub fn from_cli_options(opts: CliOptions) -> OutputFormat {
        if opts.json_compact {
            return OutputFormat::JsonCompact
        } else if opts.json_mode {
            return OutputFormat::JsonFull
        }
        return OutputFormat::Human
    }
}
