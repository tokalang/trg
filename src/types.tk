// Shared shapes and types for trg.
import std/vec::{Vec}

pub shape CaseMode (
    Sensitive = 0 |
    Insensitive = 1 |
    Smart = 2
)

pub shape SortMode (
    None = 0 |
    Path = 1 |
    PathReverse = 2
)

pub shape GlobRule (
    pattern: string,
    is_negation: bool,
    dir_only: bool
)

pub shape BudgetLimits (
    max_total_matches_enabled: bool,
    max_total_matches: usize,
    max_result_bytes_enabled: bool,
    max_result_bytes: usize,
    max_files_with_matches_enabled: bool,
    max_files_with_matches: usize,
    no_truncation_notice: bool
)

impl BudgetLimits {
    pub fn new() -> BudgetLimits {
        return BudgetLimits(
            max_total_matches_enabled = false,
            max_total_matches = 0,
            max_result_bytes_enabled = false,
            max_result_bytes = 0,
            max_files_with_matches_enabled = false,
            max_files_with_matches = 0,
            no_truncation_notice = false
        )
    }

    pub fn is_budget_active(self) -> bool {
        return self.max_total_matches_enabled ||
               self.max_result_bytes_enabled ||
               self.max_files_with_matches_enabled
    }
}

pub shape ScanPass (
    All = 0 |
    DefinitionsOnly = 1 |
    UsagesOnly = 2
)

pub shape SyntaxFamily (
    Brace = 0 |
    Indent = 1
)

pub shape OutputFormat (
    Human = 0 |
    JsonFull = 1 |
    JsonCompact = 2
)

pub shape OutputSink (
    Stdout = 0 |
    Memory = 1
)

pub shape BudgetState (
    limits: BudgetLimits,
    files_selected#: usize,
    files_scanned#: usize,
    file_scan_passes#: usize,
    files_with_match_observed#: usize,
    files_with_match_emitted#: usize,
    matched_lines_observed#: usize,
    matched_lines_emitted#: usize,
    submatches_emitted#: usize,
    result_payload_bytes_emitted#: usize,
    protocol_bytes_emitted#: usize,
    block_contexts_truncated#: usize,
    is_truncated#: bool,
    truncation_reason#: string,
    stopped_path#: string,
    stopped_line_num#: usize
)

impl BudgetState {
    pub fn new(limits: BudgetLimits) -> BudgetState {
        return BudgetState(
            limits = limits,
            files_selected = 0,
            files_scanned = 0,
            file_scan_passes = 0,
            files_with_match_observed = 0,
            files_with_match_emitted = 0,
            matched_lines_observed = 0,
            matched_lines_emitted = 0,
            submatches_emitted = 0,
            result_payload_bytes_emitted = 0,
            protocol_bytes_emitted = 0,
            block_contexts_truncated = 0,
            is_truncated = false,
            truncation_reason = string::from(""),
            stopped_path = string::from(""),
            stopped_line_num = 0
        )
    }

    pub fn clone(self) -> BudgetState {
        return BudgetState(
            limits = self.limits,
            files_selected = self.files_selected,
            files_scanned = self.files_scanned,
            file_scan_passes = self.file_scan_passes,
            files_with_match_observed = self.files_with_match_observed,
            files_with_match_emitted = self.files_with_match_emitted,
            matched_lines_observed = self.matched_lines_observed,
            matched_lines_emitted = self.matched_lines_emitted,
            submatches_emitted = self.submatches_emitted,
            result_payload_bytes_emitted = self.result_payload_bytes_emitted,
            protocol_bytes_emitted = self.protocol_bytes_emitted,
            block_contexts_truncated = self.block_contexts_truncated,
            is_truncated = self.is_truncated,
            truncation_reason = self.truncation_reason.clone(),
            stopped_path = self.stopped_path.clone(),
            stopped_line_num = self.stopped_line_num
        )
    }

    pub fn observe_match(self#, is_first_observed_for_file: bool) {
        self.matched_lines_observed = self.matched_lines_observed + 1
        if is_first_observed_for_file {
            self.files_with_match_observed = self.files_with_match_observed + 1
        }
    }

    pub fn reserve_match(self#, path: str, line_num: usize, is_first_for_file: bool) -> bool {
        if self.is_truncated { return false }

        // Priority 1: max_total_matches
        if self.limits.max_total_matches_enabled && self.matched_lines_emitted >= self.limits.max_total_matches {
            self.is_truncated = true
            self.truncation_reason = string::from("max_total_matches")
            self.stopped_path = string::from(path)
            self.stopped_line_num = line_num
            return false
        }
        // Priority 2: max_files_with_matches
        if self.limits.max_files_with_matches_enabled && is_first_for_file && self.files_with_match_emitted >= self.limits.max_files_with_matches {
            self.is_truncated = true
            self.truncation_reason = string::from("max_files_with_matches")
            self.stopped_path = string::from(path)
            self.stopped_line_num = line_num
            return false
        }
        return true
    }

    pub fn commit_match_emitted(self#, submatch_count: usize, is_first_emitted_for_file: bool) {
        self.matched_lines_emitted = self.matched_lines_emitted + 1
        self.submatches_emitted = self.submatches_emitted + submatch_count
        if is_first_emitted_for_file {
            self.files_with_match_emitted = self.files_with_match_emitted + 1
        }
    }
}

pub shape CliOptions (
    patterns: Vec<string>,
    paths: Vec<string>,
    pattern_source_given: bool,
    fixed_strings: bool,
    regexp: bool,
    word_regexp: bool,
    line_regexp: bool,
    no_prefilter: bool,
    line_number: bool,
    files_with_matches: bool,
    count: bool,
    include_zero: bool,
    quiet: bool,
    only_matching: bool,
    invert_match: bool,
    case_mode: CaseMode,
    sort_mode: SortMode,
    no_ignore: bool,
    files_mode: bool,
    json_mode: bool,
    json_compact: bool,
    hidden: bool,
    type_list_only: bool,
    before_context: usize,
    after_context: usize,
    max_count_enabled: bool,
    max_count: usize,
    max_columns: usize,
    budget_limits: BudgetLimits,
    globs: Vec<GlobRule>,
    include_type_exts: Vec<string>,
    exclude_type_exts: Vec<string>,
    context_block: bool,
    max_block_lines: usize,
    scope: bool,
    def_first: bool,
    mcp_mode: bool
)

pub shape ScopeFrame (
    name: string,
    depth: usize
)

pub shape MatchRange (
    start: usize,
    end: usize
)

pub shape MatchDecision (
    matched: bool,
    ranges: Vec<MatchRange>
)

pub shape SubMatch (
    match_text: string,
    start: usize,
    end: usize
)

pub shape MatchEvent (
    path: string,
    line_text: string,
    line_number: usize,
    absolute_offset: usize,
    submatches: Vec<SubMatch>,
    scope_name: string,
    block_truncated: bool
)

pub shape LogicalLine (
    text: string,
    line_number: usize,
    absolute_offset: usize,
    delim_len: usize,
    brace_depth: usize,
    indent_level: usize
)

pub shape LineProcessOutcome (
    Continue = 0 |
    BrokenPipe = 1 |
    FatalError = 2
)

pub shape ScanResult (
    path: string,
    matches_count: usize,
    has_match: bool,
    is_binary: bool,
    had_error: bool,
    is_broken_pipe: bool
)

pub shape GlobalStats (
    total_files: usize,
    files_with_match: usize,
    total_matches: usize,
    elapsed_nanos: u64
)

pub shape FileRunState (
    scanned_unique#: bool,
    match_observed#: bool,
    match_emitted#: bool
)

impl FileRunState {
    pub fn new() -> FileRunState {
        return FileRunState(
            scanned_unique = false,
            match_observed = false,
            match_emitted = false
        )
    }
}

pub shape SearchReport (
    found_result: bool,
    had_error: bool,
    is_broken_pipe: bool,
    budget_state: BudgetState,
    elapsed_nanos: u64
)

impl OutputFormat {
    pub fn from_cli_options(opts: CliOptions) -> OutputFormat {
        if opts.json_compact {
            return OutputFormat::JsonCompact
        } else if opts.json_mode {
            return OutputFormat::JsonFull
        }
        return OutputFormat::Human
    }
}
