)

pub shape BlockDelimiter (
    Brace = 0 |
    Paren = 1
)

pub shape BlockRange (
    start: usize,
    end: usize
)

impl BlockRange {
    pub fn clone(self) -> BlockRange {
        return BlockRange(
            start = self.start,
            end = self.end
        )
    }
}

pub shape ScopeFrame (
    name: string,
    delimiter: BlockDelimiter,
    depth: usize
)

pub shape MatchRange (
    start: usize,
    end: usize
)

pub shape MatchDecision (
    matched: bool,
    ranges: Vec<MatchRange>
)

pub shape SubMatch (
    match_text: string,
    start: usize,
    end: usize
)

impl SubMatch {
    pub fn clone(self) -> SubMatch {
        return SubMatch(
            match_text = self.match_text.clone(),
            start = self.start,
            end = self.end
        )
    }
}

pub shape SnippetProjection (
    text: string,
    submatches: Vec<SubMatch>
)

impl SnippetProjection {
    pub fn clone(self) -> SnippetProjection {
        auto subs# = Vec<SubMatch>::new()
        auto i# = 0:usize
        loop i < self.submatches.len() {
            subs#.push(self.submatches.borrow(i).clone())
            i = i + 1
        }
        return SnippetProjection(
            text = self.text.clone(),
            submatches = cede subs
        )
    }
}

pub shape ScopeMetadata (
    name: string,
    kind: string,
    range_start: usize,
    range_end: usize,
    has_range_end: bool,
    reliability: string,
    is_repeated: bool
)

pub shape InternedRecord (
    kind: string,
    group_id: usize,
    line_number: usize,
    absolute_offset: usize,
    text: string,
    submatches: Vec<SubMatch>,
    scope: Option<string>,
    scope_name: string,
    has_scope_meta: bool,
    scope_kind: string,
    scope_start: usize,
    scope_end: usize,
    scope_has_end: bool,
    scope_reliability: string,
    block_truncated: bool,
    block_range: Option<BlockRange>,
    snippet: Option<SnippetProjection>
)

impl InternedRecord {
    pub fn clone(self) -> InternedRecord {
        auto subs# = Vec<SubMatch>::new()
        auto i# = 0:usize
        loop i < self.submatches.len() {
            subs#.push(self.submatches.borrow(i).clone())
            i = i + 1
        }
        auto sc# = Option<string>::None
        match self.scope {
            auto Option<string>::Some(&s) => {
                sc = Option<string>::Some(s.clone())
            }
            _ => {}
        }
        auto br_opt# = Option<BlockRange>::None
        match self.block_range {
            auto Option<BlockRange>::Some(&br) => {
                br_opt = Option<BlockRange>::Some(br.clone())
            }
            _ => {}
        }
        auto snip_opt# = Option<SnippetProjection>::None
        match self.snippet {
            auto Option<SnippetProjection>::Some(&sn) => {
                snip_opt = Option<SnippetProjection>::Some(sn.clone())
            }
            _ => {}
        }
        return InternedRecord(
            kind = self.kind.clone(),
            group_id = self.group_id,
            line_number = self.line_number,
            absolute_offset = self.absolute_offset,
            text = self.text.clone(),
            submatches = cede subs,
            scope = cede sc,
            scope_name = self.scope_name.clone(),
            has_scope_meta = self.has_scope_meta,
            scope_kind = self.scope_kind.clone(),
            scope_start = self.scope_start,
            scope_end = self.scope_end,
            scope_has_end = self.scope_has_end,
            scope_reliability = self.scope_reliability.clone(),
            block_truncated = self.block_truncated,
            block_range = cede br_opt,
            snippet = cede snip_opt
        )
    }
}

pub shape ResultSegment (
    file_id: usize,
