pub fn print_help() {
    println("trg 0.13.0 - Fast, agent-friendly code search tool")
    println("Usage:")
    println("  trg [OPTIONS] <PATTERN> [PATH...]")
    println("  trg -e <PATTERN>... [OPTIONS] [PATH...]")
    println("  trg -f <FILE>... [OPTIONS] [PATH...]")
    println("  trg -F [OPTIONS] <PATTERN> [PATH...]")
    println("  trg -E [OPTIONS] <PATTERN> [PATH...]")
    println("  trg --files [OPTIONS] [PATH...]")
    println("  trg --type-list")
    println("  trg view <PATH>:<LINE> [-C N] [--block]")
    println("  trg view <PATH> --lines <M-N>")
    println("")
    println("Options:")
    println("  -e, --regexp <PATTERN>     Use PATTERN for matching (can be repeated)")
    println("  -f, --file <FILE>          Load patterns from FILE (one per line, can be repeated)")
    println("  -i, --ignore-case          Case-insensitive matching")
    println("  -s, --case-sensitive       Case-sensitive matching")
    println("  -S, --smart-case           Case-insensitive if pattern is lowercase, sensitive otherwise")
    println("  -v, --invert-match         Select non-matching lines")
    println("  -n, --line-number          Show line numbers (1-based, default: on)")
    println("  -N, --no-line-number       Suppress line numbers")
    println("  -l, --files-with-matches   Only print paths with at least one match")
    println("  -c, --count                Only print count of matching lines per file")
    println("      --include-zero         Include zero counts in --count output")
    println("  -q, --quiet                Do not print search results; exit 0 if match found, 1 otherwise")
    println("  -o, --only-matching        Print only the matched parts of a line")
    println("  -F, --fixed-strings        Interpret patterns as literal strings (default)")
    println("  -E, --extended-regexp      Interpret patterns as regular expressions")
    println("  -w, --word-regexp          Match patterns only at whole word boundaries")
    println("  -x, --line-regexp          Match patterns only on complete lines")
    println("  -m, --max-count <NUM>      Stop scanning a file after NUM matching lines")
    println("      --max-columns <NUM>    Omit matching/context lines exceeding NUM bytes (0 = unlimited)")
    println("      --max-total-matches <N> Stop search after emitting N total matches across files (alias: --max-matches)")
    println("      --max-result-bytes <SZ> Stop search after emitting canonical bytes (e.g. 64K, 1M, 500000; alias: --max-bytes)")
    println("      --max-files-with-matches <N> Stop search after N files with matches")
    println("      --sort <TYPE>          Sort order: path, none (default: path)")
    println("      --sortr <TYPE>         Reverse sort order: path (default: path)")
    println("      --path-style <STYLE>   Path output style: as-given, workspace-relative, absolute")
    println("      --heading              Print file path once above grouped matching lines")
    println("      --no-heading           Print file path on each matching line")
    println("  -A, --after-context <NUM>  Show NUM lines after each match (max 1000)")
    println("  -B, --before-context <NUM> Show NUM lines before each match (max 1000)")
    println("  -C, --context <NUM>        Show NUM lines before and after each match (max 1000)")
    println("      --block                Expand context to enclose syntactic code block (alias: --context-block)")
    println("      --context-block        Expand context to enclose syntactic code block")
    println("      --max-block-lines <NUM> Maximum lines for syntactic block context (default: 80)")
    println("      --scope                Show enclosing symbol scope (human: [scope], JSON: scope field)")
    println("      --group-by-scope       Group matches by enclosing scope hierarchy")
    println("      --symbol-variants      Expand search pattern to naming variants (snake, camel, pascal, etc.)")
    println("      --snippet              KWIC centered snippet view around matches (alias: --kwic)")
    println("      --snippet-chars <NUM>  Preserve NUM characters on each side of match in snippet (default: 30)")
    println("      --def-first            Prioritize definition matches before usages under budgets")
    println("      --mcp                  Run as a native Model Context Protocol (MCP) stdio server")
    println("  -g, --glob <GLOB>          Include or exclude files matching GLOB (last match wins)")
    println("      --files                Print the files that would be searched")
    println("      --json                 Output newline-delimited JSONL search events (trg-json-v2)")
    println("      --json=compact         Output streamlined compact JSONL without control frames (alias: --json-compact)")
    println("      --hidden               Search hidden files and directories")
    println("  -h, --help                 Print this help message")
}

pub fn print_version() {
    println("trg 0.13.0 (Toka)")
}

fn parse_non_negative_int(s: str, flag_name: str) -> Result<usize, string> {
    if s.len == 0 {
        auto err# = string::from("Flag ")
        err#.push_str(flag_name)
        err#.push_str(" requires a non-negative integer argument")
        return Result<usize, string>::Err(cede err)
    }
    auto val# = 0:usize
    auto i# = 0:usize
    loop i < s.len {
        auto ch = s.byte_at(i)
        if ch < ('0' as char) || ch > ('9' as char) {
            auto err# = string::from("Flag ")
            err#.push_str(flag_name)
            err#.push_str(" requires a non-negative integer argument")
            return Result<usize, string>::Err(cede err)
        }
        auto digit = (ch as usize) - ('0' as usize)
        if val > (9223372036854775807:usize - digit) / 10:usize {
            auto err# = string::from("Flag ")
            err#.push_str(flag_name)
            err#.push_str(" value exceeds maximum integer limit")
            return Result<usize, string>::Err(cede err)
        }
        val = val * 10:usize + digit
        i = i + 1
    }
    return Result<usize, string>::Ok(val)
}

fn parse_context_num(s: str) -> Result<usize, string> {
    if s.len == 0 {
        return Result<usize, string>::Err(string::from("Context line count cannot be empty"))
    }
    auto val# = 0:usize
    auto i# = 0:usize
    loop i < s.len {
        auto ch = s.byte_at(i)
        if ch < ('0' as char) || ch > ('9' as char) {
            return Result<usize, string>::Err(string::from("Context line count must be a non-negative integer"))
        }
        auto digit = (ch as usize) - ('0' as usize)
        if val > (1000:usize - digit) / 10:usize {
            return Result<usize, string>::Err(string::from("Context lines limit exceeded (maximum is 1000)"))
        }
        val = val * 10:usize + digit
        if val > 1000:usize {
            return Result<usize, string>::Err(string::from("Context lines limit exceeded (maximum is 1000)"))
        }
        i = i + 1
    }
    return Result<usize, string>::Ok(val)
}

fn merge_extensions(cede target: Vec<string>, exts: Vec<string>) -> Vec<string> {
    auto res# = cede target
    auto i# = 0:usize
    loop i < exts.len() {
        auto &ext_item = exts.borrow(i)
        auto ext_str = ext_item.as_str()
        auto already_present# = false
        auto j# = 0:usize
        loop j < res.len() {
            if res.borrow(j).as_str().equals(ext_str) {
                already_present = true
                break
            }
            j = j + 1
        }
        if !already_present {
            res#.push(string::from(ext_str))
        }
        i = i + 1
    }
    return cede res
}

fn load_patterns_from_file(file_path: str) -> Result<Vec<string>, string> {
    auto path_str = string::from(file_path)
    auto mode_buf# = [0:char; 4]
    mode_buf[0] = 'r' as char
    mode_buf[1] = 'b' as char
    mode_buf[2] = 0 as char

    auto patterns# = Vec<string>::new()

    unsafe {
        auto *mode_ptr = &mode_buf[0] as *char
        auto *path_c = path_str.c_str()
        auto nul *fp = libc_fopen(*path_c, *mode_ptr)
        if *fp == null {
            auto err# = string::from("Failed to open pattern file '")
            err#.push_str(file_path)
            err#.push_str("': No such file or directory or permission denied")
            return Result<Vec<string>, string>::Err(cede err)
        }
        auto *file = fp.unwrap()
        auto nul *raw_buf = libc_malloc(65536:usize)
        if *raw_buf == null {
            libc_fclose(*file)
            return Result<Vec<string>, string>::Err(string::from("Out of memory reading pattern file"))
        }
        auto *buf = raw_buf.unwrap()
        auto line_buf# = string::new()
        auto read_err# = false

        loop true {
            auto n = libc_fread(*buf, 1:usize, 65536:usize, *file)
            if n == 0 {
                if posix_ferror((*file) as Addr) {
                    read_err = true
                }
                break
            }

            auto *c_ptr = ((*buf) as Addr) as *char
            auto chunk_str = string::from_with_len(*c_ptr, n)
            auto chunk_view = chunk_str.as_str()
            auto cursor# = 0:usize

            loop cursor < chunk_view.len {
                auto rem = chunk_view.substr(cursor, chunk_view.len - cursor)
                auto nl_opt = rem.index_of('\n' as char)
                if nl_opt.is_none() {
                    line_buf#.push_str(rem)
                    break
                }
                auto nl_pos = nl_opt.unwrap()
                auto chunk_slice = rem.substr(0, nl_pos)
                line_buf#.push_str(chunk_slice)
                {
                    auto full_view = line_buf.as_str()
                    auto pat_text# = full_view
                    if full_view.len > 0 && full_view.byte_at(full_view.len - 1) == ('\r' as char) {
                        pat_text = full_view.substr(0, full_view.len - 1)
                    }
                    patterns#.push(string::from(pat_text))
                }
                line_buf#.clear()
                cursor = cursor + nl_pos + 1
            }
        }

        if !read_err && line_buf.len() > 0 {
            {
                auto full_view = line_buf.as_str()
                auto pat_text# = full_view
                if full_view.len > 0 && full_view.byte_at(full_view.len - 1) == ('\r' as char) {
                    pat_text = full_view.substr(0, full_view.len - 1)
                }
                patterns#.push(string::from(pat_text))
            }
            line_buf#.clear()
        }

        libc_free(*buf)
        libc_fclose(*file)

        if read_err {
            auto err# = string::from("Error reading pattern file '")
            err#.push_str(file_path)
            err#.push_str("'")
            return Result<Vec<string>, string>::Err(cede err)
        }
    }

    return Result<Vec<string>, string>::Ok(cede patterns)
}

pub fn parse_cli_args() -> Result<CliOptions, string> {
    return parse_cli_args_from_vec(env::args())
}

pub fn parse_cli_args_from_vec(args: Vec<string>) -> Result<CliOptions, string> {
    auto num_args = args.len()

    auto fixed_strings# = false
    auto regexp# = false
    auto word_regexp# = false
    auto line_regexp# = false
    auto no_prefilter# = false
    auto line_number# = true
    auto files_with_matches# = false
    auto count# = false
    auto include_zero# = false
    auto quiet# = false
    auto only_matching# = false
    auto invert_match# = false
    auto case_mode# = CaseMode::Sensitive
    auto sort_mode# = SortMode::None
    auto no_ignore# = false
    auto max_count_enabled# = false
    auto max_count# = 0:usize
    auto max_columns# = 0:usize
    auto max_total_matches_enabled# = false
    auto max_total_matches# = 0:usize
    auto max_result_bytes_enabled# = false
    auto max_result_bytes# = 0:usize
    auto max_files_with_matches_enabled# = false
    auto max_files_with_matches# = 0:usize
    auto no_truncation_notice# = false
    auto files_mode# = false
    auto json_mode# = false
    auto json_compact# = false
    auto hidden# = false
    auto type_list_only# = false
    auto before_context# = 0:usize
    auto after_context# = 0:usize
    auto context_set_explicitly# = false
    auto context_block# = false
    auto max_block_lines# = 80:usize
    auto scope# = false
    auto group_by_scope# = false
    auto symbol_variants# = false
    auto snippet# = false
    auto snippet_chars# = 30:usize
    auto def_first# = false
    auto mcp_mode# = false
    auto path_style# = PathStyle::AsGiven
    auto text_layout# = TextLayout::Auto
    auto with_filename# = Option<bool>::None
    auto deduplicate_targets_explicit# = Option<bool>::None
    auto globs# = Vec<GlobRule>::new()
    auto include_type_exts# = Vec<string>::new()
    auto exclude_type_exts# = Vec<string>::new()
    auto include_types# = Vec<string>::new()
    auto exclude_types# = Vec<string>::new()

    auto patterns# = Vec<string>::new()
    auto raw_positionals# = Vec<string>::new()
    auto paths# = Vec<string>::new()
    auto pattern_source_given# = false
    auto end_of_options# = false

    auto i# = 1:usize
    loop i < num_args {
        auto &arg_str = args.borrow(i)
        auto view = arg_str.as_str()

        if end_of_options {
            raw_positionals#.push(arg_str.clone())
            i = i + 1
            continue
        }

        if view == "--" {
            end_of_options = true
            i = i + 1
            continue
        }

        if view == "-h" || view == "--help" {
            print_help()
            return Result<CliOptions, string>::Err(string::from("HELP_EXIT"))
        }

        if view == "-V" || view == "--version" {
            print_version()
            return Result<CliOptions, string>::Err(string::from("VERSION_EXIT"))
        }

        if view == "--type-list" {
            type_list_only = true
            i = i + 1
            continue
        }

        if view == "-F" || view == "--fixed-strings" {
            fixed_strings = true
            i = i + 1
            continue
        }

        if view == "-E" || view == "--extended-regexp" || view == "--regex-mode" {
            regexp = true
            i = i + 1
            continue
        }

        if view == "-e" || view == "--regexp" {
            if i + 1 >= num_args {
                return Result<CliOptions, string>::Err(string::from("Flag -e / --regexp requires a pattern argument"))
            }
            i = i + 1
            patterns#.push(args.borrow(i).clone())
            pattern_source_given = true
            i = i + 1
            continue
        }

        if view.starts_with("-e=") {
            auto p_str = view.substr(3:usize, view.len - 3:usize)
            patterns#.push(string::from(p_str))
            pattern_source_given = true
            i = i + 1
            continue
        }

        if view.starts_with("-e") && view.len > 2 {
            auto p_str = view.substr(2:usize, view.len - 2:usize)
            patterns#.push(string::from(p_str))
            pattern_source_given = true
            i = i + 1
            continue
        }

        if view.starts_with("--regexp=") {
            auto p_str = view.substr(9:usize, view.len - 9:usize)
            patterns#.push(string::from(p_str))
            pattern_source_given = true
            i = i + 1
            continue
        }

        if view == "-f" || view == "--file" {
            if i + 1 >= num_args {
                return Result<CliOptions, string>::Err(string::from("Flag -f / --file requires a file argument"))
            }
            i = i + 1
            auto &file_arg = args.borrow(i)
            auto load_res = load_patterns_from_file(file_arg.as_str())
            if load_res.is_err() {
                return Result<CliOptions, string>::Err(load_res.unwrap_err())
            }
            auto loaded = load_res.unwrap()
            auto l_idx# = 0:usize
            loop l_idx < loaded.len() {
                patterns#.push(loaded.borrow(l_idx).clone())
                l_idx = l_idx + 1
            }
            pattern_source_given = true
            i = i + 1
            continue
        }

        if view.starts_with("-f=") {
            auto f_path = view.substr(3:usize, view.len - 3:usize)
            auto load_res = load_patterns_from_file(f_path)
            if load_res.is_err() {
                return Result<CliOptions, string>::Err(load_res.unwrap_err())
            }
            auto loaded = load_res.unwrap()
            auto l_idx# = 0:usize
            loop l_idx < loaded.len() {
                patterns#.push(loaded.borrow(l_idx).clone())
                l_idx = l_idx + 1
            }
            pattern_source_given = true
            i = i + 1
            continue
        }

        if view.starts_with("-f") && view.len > 2 {
            auto f_path = view.substr(2:usize, view.len - 2:usize)
            auto load_res = load_patterns_from_file(f_path)
            if load_res.is_err() {
                return Result<CliOptions, string>::Err(load_res.unwrap_err())
            }
            auto loaded = load_res.unwrap()
            auto l_idx# = 0:usize
            loop l_idx < loaded.len() {
                patterns#.push(loaded.borrow(l_idx).clone())
                l_idx = l_idx + 1
            }
            pattern_source_given = true
            i = i + 1
            continue
        }

        if view.starts_with("--file=") {
            auto f_path = view.substr(7:usize, view.len - 7:usize)
            auto load_res = load_patterns_from_file(f_path)
            if load_res.is_err() {
                return Result<CliOptions, string>::Err(load_res.unwrap_err())
            }
            auto loaded = load_res.unwrap()
            auto l_idx# = 0:usize
            loop l_idx < loaded.len() {
                patterns#.push(loaded.borrow(l_idx).clone())
                l_idx = l_idx + 1
            }
            pattern_source_given = true
            i = i + 1
            continue
        }

        if view == "-q" || view == "--quiet" {
            quiet = true
            i = i + 1
            continue
        }

        if view == "-o" || view == "--only-matching" {
            only_matching = true
            i = i + 1
            continue
        }

        if view == "-w" || view == "--word-regexp" {
            word_regexp = true
            i = i + 1
            continue
        }

        if view == "-x" || view == "--line-regexp" {
            line_regexp = true
            i = i + 1
            continue
        }

        if view == "--no-prefilter" {
            no_prefilter = true
            i = i + 1
            continue
        }

        if view == "-n" || view == "--line-number" {
            line_number = true
            i = i + 1
            continue
        }

        if view == "-N" || view == "--no-line-number" {
            line_number = false
            i = i + 1
            continue
        }

        if view == "-l" || view == "--files-with-matches" {
            files_with_matches = true
            i = i + 1
            continue
        }

        if view == "-c" || view == "--count" {
            count = true
            i = i + 1
            continue
        }

        if view == "--include-zero" {
            include_zero = true
            i = i + 1
            continue
        }

        if view == "-v" || view == "--invert-match" {
            invert_match = true
            i = i + 1
            continue
        }

        if view == "-i" || view == "--ignore-case" {
            case_mode = CaseMode::Insensitive
            i = i + 1
            continue
        }

        if view == "-S" || view == "--smart-case" {
            case_mode = CaseMode::Smart
            i = i + 1
            continue
        }

        if view == "--no-ignore" {
            no_ignore = true
            i = i + 1
            continue
        }

        if view == "--sort" {
            if i + 1 >= num_args {
                return Result<CliOptions, string>::Err(string::from("Flag --sort requires a type argument (path, none)"))
            }
            i = i + 1
            auto &val_arg = args.borrow(i)
            auto val_str = val_arg.as_str()
            if val_str == "path" {
                sort_mode = SortMode::Path
            } else if val_str == "none" {
                sort_mode = SortMode::None
            } else {
                auto err# = string::from("Unrecognized sort type: '")
                err#.push_str(val_str)
                err#.push_str("'. Supported types: path, none")
                return Result<CliOptions, string>::Err(cede err)
            }
            i = i + 1
            continue
        }

        if view.starts_with("--sort=") {
            auto val_str = view.substr(7:usize, view.len - 7:usize)
            if val_str == "path" {
                sort_mode = SortMode::Path
            } else if val_str == "none" {
                sort_mode = SortMode::None
            } else {
                auto err# = string::from("Unrecognized sort type: '")
                err#.push_str(val_str)
                err#.push_str("'. Supported types: path, none")
                return Result<CliOptions, string>::Err(cede err)
            }
            i = i + 1
            continue
        }

        if view == "--sortr" {
            if i + 1 >= num_args {
                return Result<CliOptions, string>::Err(string::from("Flag --sortr requires a type argument (path, none)"))
            }
            i = i + 1
            auto &val_arg = args.borrow(i)
            auto val_str = val_arg.as_str()
            if val_str == "path" {
                sort_mode = SortMode::PathReverse
            } else if val_str == "none" {
                sort_mode = SortMode::None
            } else {
                auto err# = string::from("Unrecognized sort type: '")
                err#.push_str(val_str)
                err#.push_str("'. Supported types: path, none")
                return Result<CliOptions, string>::Err(cede err)
            }
            i = i + 1
            continue
        }

        if view.starts_with("--sortr=") {
            auto val_str = view.substr(8:usize, view.len - 8:usize)
            if val_str == "path" {
                sort_mode = SortMode::PathReverse
            } else if val_str == "none" {
                sort_mode = SortMode::None
            } else {
                auto err# = string::from("Unrecognized sort type: '")
                err#.push_str(val_str)
                err#.push_str("'. Supported types: path, none")
                return Result<CliOptions, string>::Err(cede err)
            }
            i = i + 1
            continue
        }

        if view == "-m" || view == "--max-count" {
            if i + 1 >= num_args {
                return Result<CliOptions, string>::Err(string::from("Flag -m / --max-count requires an argument"))
            }
            i = i + 1
            auto &val_arg = args.borrow(i)
            auto parse_res = parse_non_negative_int(val_arg.as_str(), "-m / --max-count")
            if parse_res.is_err() { return Result<CliOptions, string>::Err(parse_res.unwrap_err()) }
            max_count = parse_res.unwrap()
            max_count_enabled = true
            i = i + 1
            continue
        }

        if view.starts_with("--max-count=") {
            auto val_str = view.substr(12:usize, view.len - 12:usize)
            auto parse_res = parse_non_negative_int(val_str, "--max-count")
            if parse_res.is_err() { return Result<CliOptions, string>::Err(parse_res.unwrap_err()) }
            max_count = parse_res.unwrap()
            max_count_enabled = true
            i = i + 1
            continue
        }

        if view.starts_with("-m=") {
            auto val_str = view.substr(3:usize, view.len - 3:usize)
            auto parse_res = parse_non_negative_int(val_str, "-m")
            if parse_res.is_err() { return Result<CliOptions, string>::Err(parse_res.unwrap_err()) }
            max_count = parse_res.unwrap()
            max_count_enabled = true
            i = i + 1
            continue
        }

        if view.starts_with("-m") && view.len > 2 {
            auto val_str = view.substr(2:usize, view.len - 2:usize)
            auto parse_res = parse_non_negative_int(val_str, "-m")
            if parse_res.is_err() { return Result<CliOptions, string>::Err(parse_res.unwrap_err()) }
            max_count = parse_res.unwrap()
            max_count_enabled = true
            i = i + 1
            continue
        }

        if view == "--max-columns" {
            if i + 1 >= num_args {
                return Result<CliOptions, string>::Err(string::from("Flag --max-columns requires an argument"))
            }
            i = i + 1
            auto &val_arg = args.borrow(i)
            auto parse_res = parse_non_negative_int(val_arg.as_str(), "--max-columns")
            if parse_res.is_err() { return Result<CliOptions, string>::Err(parse_res.unwrap_err()) }
            max_columns = parse_res.unwrap()
            i = i + 1
            continue
        }

        if view.starts_with("--max-columns=") {
            auto val_str = view.substr(14:usize, view.len - 14:usize)
            auto parse_res = parse_non_negative_int(val_str, "--max-columns")
            if parse_res.is_err() { return Result<CliOptions, string>::Err(parse_res.unwrap_err()) }
            max_columns = parse_res.unwrap()
            i = i + 1
            continue
        }

        if view == "--max-total-matches" {
            if i + 1 >= num_args {
                return Result<CliOptions, string>::Err(string::from("Flag --max-total-matches requires an argument"))
            }
            i = i + 1
            auto &val_arg = args.borrow(i)
            auto parse_res = parse_usize_strict(val_arg.as_str(), "--max-total-matches")
            if parse_res.is_err() { return Result<CliOptions, string>::Err(parse_res.unwrap_err()) }
            max_total_matches = parse_res.unwrap()
            max_total_matches_enabled = true
            i = i + 1
            continue
        }

        if view.starts_with("--max-total-matches=") {
            auto val_str = view.substr(20:usize, view.len - 20:usize)
            auto parse_res = parse_usize_strict(val_str, "--max-total-matches")
            if parse_res.is_err() { return Result<CliOptions, string>::Err(parse_res.unwrap_err()) }
            max_total_matches = parse_res.unwrap()
            max_total_matches_enabled = true
            i = i + 1
            continue
        }

        if view == "--max-result-bytes" {
            if i + 1 >= num_args {
                return Result<CliOptions, string>::Err(string::from("Flag --max-result-bytes requires an argument"))
            }
            i = i + 1
            auto &val_arg = args.borrow(i)
            auto parse_res = parse_size_bytes_strict(val_arg.as_str(), "--max-result-bytes")
            if parse_res.is_err() { return Result<CliOptions, string>::Err(parse_res.unwrap_err()) }
            max_result_bytes = parse_res.unwrap()
            max_result_bytes_enabled = true
            i = i + 1
            continue
        }

        if view.starts_with("--max-result-bytes=") {
            auto val_str = view.substr(19:usize, view.len - 19:usize)
            auto parse_res = parse_size_bytes_strict(val_str, "--max-result-bytes")
            if parse_res.is_err() { return Result<CliOptions, string>::Err(parse_res.unwrap_err()) }
            max_result_bytes = parse_res.unwrap()
            max_result_bytes_enabled = true
            i = i + 1
            continue
        }

        if view == "--max-files-with-matches" {
            if i + 1 >= num_args {
                return Result<CliOptions, string>::Err(string::from("Flag --max-files-with-matches requires an argument"))
            }
            i = i + 1
            auto &val_arg = args.borrow(i)
            auto parse_res = parse_usize_strict(val_arg.as_str(), "--max-files-with-matches")
            if parse_res.is_err() { return Result<CliOptions, string>::Err(parse_res.unwrap_err()) }
            max_files_with_matches = parse_res.unwrap()
            max_files_with_matches_enabled = true
            i = i + 1
            continue
        }

        if view.starts_with("--max-files-with-matches=") {
            auto val_str = view.substr(25:usize, view.len - 25:usize)
            auto parse_res = parse_usize_strict(val_str, "--max-files-with-matches")
            if parse_res.is_err() { return Result<CliOptions, string>::Err(parse_res.unwrap_err()) }
            max_files_with_matches = parse_res.unwrap()
            max_files_with_matches_enabled = true
            i = i + 1
            continue
        }

        if view == "--no-truncation-notice" {
            no_truncation_notice = true
            i = i + 1
            continue
        }

        if view == "--files" {
            files_mode = true
            i = i + 1
            continue
        }

        if view == "--json" {
            json_mode = true
            i = i + 1
            continue
        }

        if view == "--json-compact" || view == "--json=compact" {
            json_mode = true
            json_compact = true
            i = i + 1
            continue
        }

        if view.starts_with("--json=") {
            auto opt_val = view.substr(7:usize, view.len - 7:usize)
            if opt_val == "compact" {
                json_mode = true
                json_compact = true
                i = i + 1
                continue
            } else {
                auto err# = string::from("Unknown value for --json: '")
                err#.push_str(opt_val)
                err#.push_str("'. Supported: compact")
                return Result<CliOptions, string>::Err(cede err)
            }
        }

        if view == "--hidden" {
            hidden = true
            i = i + 1
            continue
        }

        if view == "--heading" {
            text_layout = TextLayout::Grouped
            i = i + 1
            continue
        }

        if view == "--no-heading" {
            text_layout = TextLayout::Flat
            i = i + 1
            continue
        }

        if view == "-H" || view == "--with-filename" {
            with_filename = Option<bool>::Some(true)
            i = i + 1
            continue
        }

        if view == "-I" || view == "--no-filename" {
            with_filename = Option<bool>::Some(false)
            i = i + 1
            continue
        }

        if view == "--path-style" {
            if i + 1 >= num_args {
                return Result<CliOptions, string>::Err(string::from("Flag --path-style requires an argument"))
            }
            i = i + 1
            auto &style_arg = args.borrow(i)
            auto s_view = style_arg.as_str()
            if s_view == "as-given" {
                path_style = PathStyle::AsGiven
            } else if s_view == "workspace-relative" {
                path_style = PathStyle::WorkspaceRelative
            } else if s_view == "absolute" {
                path_style = PathStyle::Absolute
            } else {
                auto err# = string::from("Unrecognized path style: '")
                err#.push_str(s_view)
                err#.push_str("'. Expected 'as-given', 'workspace-relative', or 'absolute'")
                return Result<CliOptions, string>::Err(cede err)
            }
            i = i + 1
            continue
        }

        if view.starts_with("--path-style=") {
            auto s_view = view.substr(13:usize, view.len - 13:usize)
            if s_view == "as-given" {
                path_style = PathStyle::AsGiven
            } else if s_view == "workspace-relative" {
                path_style = PathStyle::WorkspaceRelative
            } else if s_view == "absolute" {
                path_style = PathStyle::Absolute
            } else {
                auto err# = string::from("Unrecognized path style: '")
                err#.push_str(s_view)
                err#.push_str("'. Expected 'as-given', 'workspace-relative', or 'absolute'")
                return Result<CliOptions, string>::Err(cede err)
            }
            i = i + 1
            continue
        }

        // -t / --type options
        if view == "-t" || view == "--type" {
            if i + 1 >= num_args {
                return Result<CliOptions, string>::Err(string::from("Flag -t / --type requires an argument"))
            }
            i = i + 1
            auto &type_arg = args.borrow(i)
            auto exts_res = lookup_type_extensions(type_arg.as_str())
            if exts_res.is_err() {
                return Result<CliOptions, string>::Err(exts_res.unwrap_err())
            }
            include_type_exts = merge_extensions(cede include_type_exts, exts_res.unwrap())
            include_types#.push(type_arg.clone())
            i = i + 1
            continue
        }

        if view.starts_with("--type=") {
            auto type_name = view.substr(7:usize, view.len - 7:usize)
            auto exts_res = lookup_type_extensions(type_name)
            if exts_res.is_err() {
                return Result<CliOptions, string>::Err(exts_res.unwrap_err())
            }
            include_type_exts = merge_extensions(cede include_type_exts, exts_res.unwrap())
            include_types#.push(string::from(type_name))
            i = i + 1
            continue
        }

        if view.starts_with("-t") && view.len > 2 {
            auto type_name = view.substr(2:usize, view.len - 2:usize)
            auto exts_res = lookup_type_extensions(type_name)
            if exts_res.is_err() {
                return Result<CliOptions, string>::Err(exts_res.unwrap_err())
            }
            include_type_exts = merge_extensions(cede include_type_exts, exts_res.unwrap())
            include_types#.push(string::from(type_name))
            i = i + 1
            continue
        }

        // -T / --type-not options
        if view == "-T" || view == "--type-not" {
            if i + 1 >= num_args {
                return Result<CliOptions, string>::Err(string::from("Flag -T / --type-not requires an argument"))
            }
            i = i + 1
            auto &type_arg = args.borrow(i)
            auto exts_res = lookup_type_extensions(type_arg.as_str())
            if exts_res.is_err() {
                return Result<CliOptions, string>::Err(exts_res.unwrap_err())
            }
            exclude_types#.push(type_arg.clone())
            exclude_type_exts = merge_extensions(cede exclude_type_exts, exts_res.unwrap())
            i = i + 1
            continue
        }

        if view.starts_with("--type-not=") {
            auto type_name = view.substr(11:usize, view.len - 11:usize)
            auto exts_res = lookup_type_extensions(type_name)
            if exts_res.is_err() {
                return Result<CliOptions, string>::Err(exts_res.unwrap_err())
            }
            exclude_types#.push(string::from(type_name))
            exclude_type_exts = merge_extensions(cede exclude_type_exts, exts_res.unwrap())
            i = i + 1
            continue
        }

        if view.starts_with("-T") && view.len > 2 {
            auto type_name = view.substr(2:usize, view.len - 2:usize)
            auto exts_res = lookup_type_extensions(type_name)
            if exts_res.is_err() {
                return Result<CliOptions, string>::Err(exts_res.unwrap_err())
            }
            exclude_types#.push(string::from(type_name))
            exclude_type_exts = merge_extensions(cede exclude_type_exts, exts_res.unwrap())
            i = i + 1
            continue
        }

        // Context options
        if view == "-A" || view == "--after-context" {
            if i + 1 >= num_args {
                return Result<CliOptions, string>::Err(string::from("Flag -A / --after-context requires an argument"))
            }
            i = i + 1
            auto &num_arg = args.borrow(i)
            auto num_res = parse_context_num(num_arg.as_str())
            if num_res.is_err() {
                return Result<CliOptions, string>::Err(num_res.unwrap_err())
            }
            after_context = num_res.unwrap()
            context_set_explicitly = true
            i = i + 1
            continue
        }

        if view.starts_with("--after-context=") {
            auto num_str = view.substr(16:usize, view.len - 16:usize)
            auto num_res = parse_context_num(num_str)
            if num_res.is_err() {
                return Result<CliOptions, string>::Err(num_res.unwrap_err())
            }
            after_context = num_res.unwrap()
            context_set_explicitly = true
            i = i + 1
            continue
        }

        if view.starts_with("-A=") {
            auto num_str = view.substr(3:usize, view.len - 3:usize)
            auto num_res = parse_context_num(num_str)
            if num_res.is_err() {
                return Result<CliOptions, string>::Err(num_res.unwrap_err())
            }
            after_context = num_res.unwrap()
            context_set_explicitly = true
            i = i + 1
            continue
        }

        if view.starts_with("-A") && view.len > 2 {
            auto num_str = view.substr(2:usize, view.len - 2:usize)
            auto num_res = parse_context_num(num_str)
            if num_res.is_err() {
                return Result<CliOptions, string>::Err(num_res.unwrap_err())
            }
            after_context = num_res.unwrap()
            context_set_explicitly = true
            i = i + 1
            continue
        }

        if view == "-B" || view == "--before-context" {
            if i + 1 >= num_args {
                return Result<CliOptions, string>::Err(string::from("Flag -B / --before-context requires an argument"))
            }
            i = i + 1
            auto &num_arg = args.borrow(i)
            auto num_res = parse_context_num(num_arg.as_str())
            if num_res.is_err() {
                return Result<CliOptions, string>::Err(num_res.unwrap_err())
            }
            before_context = num_res.unwrap()
            context_set_explicitly = true
            i = i + 1
            continue
        }

        if view.starts_with("--before-context=") {
            auto num_str = view.substr(17:usize, view.len - 17:usize)
            auto num_res = parse_context_num(num_str)
            if num_res.is_err() {
                return Result<CliOptions, string>::Err(num_res.unwrap_err())
            }
            before_context = num_res.unwrap()
            context_set_explicitly = true
            i = i + 1
            continue
        }

        if view.starts_with("-B=") {
            auto num_str = view.substr(3:usize, view.len - 3:usize)
            auto num_res = parse_context_num(num_str)
            if num_res.is_err() {
                return Result<CliOptions, string>::Err(num_res.unwrap_err())
            }
            before_context = num_res.unwrap()
            context_set_explicitly = true
            i = i + 1
            continue
        }

        if view.starts_with("-B") && view.len > 2 {
            auto num_str = view.substr(2:usize, view.len - 2:usize)
            auto num_res = parse_context_num(num_str)
            if num_res.is_err() {
                return Result<CliOptions, string>::Err(num_res.unwrap_err())
            }
            before_context = num_res.unwrap()
            context_set_explicitly = true
            i = i + 1
            continue
        }

        if view == "-C" || view == "--context" {
            if i + 1 >= num_args {
                return Result<CliOptions, string>::Err(string::from("Flag -C / --context requires an argument"))
            }
            i = i + 1
            auto &num_arg = args.borrow(i)
            auto num_res = parse_context_num(num_arg.as_str())
            if num_res.is_err() {
                return Result<CliOptions, string>::Err(num_res.unwrap_err())
            }
            auto c_val = num_res.unwrap()
            before_context = c_val
            after_context = c_val
            context_set_explicitly = true
            i = i + 1
            continue
        }

        if view.starts_with("--context=") {
            auto num_str = view.substr(10:usize, view.len - 10:usize)
            auto num_res = parse_context_num(num_str)
            if num_res.is_err() {
                return Result<CliOptions, string>::Err(num_res.unwrap_err())
            }
            auto c_val = num_res.unwrap()
            before_context = c_val
            after_context = c_val
            context_set_explicitly = true
            i = i + 1
            continue
        }

        if view.starts_with("-C=") {
            auto num_str = view.substr(3:usize, view.len - 3:usize)
            auto num_res = parse_context_num(num_str)
            if num_res.is_err() {
                return Result<CliOptions, string>::Err(num_res.unwrap_err())
            }
            auto c_val = num_res.unwrap()
            before_context = c_val
            after_context = c_val
            context_set_explicitly = true
            i = i + 1
            continue
        }

        if view.starts_with("-C") && view.len > 2 {
            auto num_str = view.substr(2:usize, view.len - 2:usize)
            auto num_res = parse_context_num(num_str)
            if num_res.is_err() {
                return Result<CliOptions, string>::Err(num_res.unwrap_err())
            }
            auto c_val = num_res.unwrap()
            before_context = c_val
            after_context = c_val
            context_set_explicitly = true
            i = i + 1
            continue
        }

        // Glob options
        if view == "-g" || view == "--glob" {
            if i + 1 >= num_args {
                return Result<CliOptions, string>::Err(string::from("Flag -g / --glob requires an argument"))
            }
            i = i + 1
            auto &g_arg = args.borrow(i)
            globs#.push(parse_glob_rule(g_arg.clone()))
            i = i + 1
            continue
        }

        if view.starts_with("--glob=") {
            auto g_str = view.substr(7:usize, view.len - 7:usize)
            globs#.push(parse_glob_rule(string::from(g_str)))
            i = i + 1
            continue
        }

        if view.starts_with("-g") && view.len > 2 {
            auto g_str = view.substr(2:usize, view.len - 2:usize)
            globs#.push(parse_glob_rule(string::from(g_str)))
            i = i + 1
            continue
        }

        if view == "--context-block" || view == "--block" {
            context_block = true
            context_set_explicitly = true
            i = i + 1
            continue
        }

        if view == "--max-block-lines" {
            if i + 1 >= num_args {
                return Result<CliOptions, string>::Err(string::from("Flag --max-block-lines requires an argument"))
            }
            i = i + 1
            auto &val_arg = args.borrow(i)
            auto parse_res = parse_context_num(val_arg.as_str())
            if parse_res.is_err() { return Result<CliOptions, string>::Err(parse_res.unwrap_err()) }
            max_block_lines = parse_res.unwrap()
            if max_block_lines == 0 {
                return Result<CliOptions, string>::Err(string::from("Flag --max-block-lines must be greater than 0"))
            }
            i = i + 1
            continue
        }

        if view.starts_with("--max-block-lines=") {
            auto val_str = view.substr(18:usize, view.len - 18:usize)
            auto parse_res = parse_context_num(val_str)
            if parse_res.is_err() { return Result<CliOptions, string>::Err(parse_res.unwrap_err()) }
            max_block_lines = parse_res.unwrap()
            if max_block_lines == 0 {
                return Result<CliOptions, string>::Err(string::from("Flag --max-block-lines must be greater than 0"))
            }
            i = i + 1
            continue
        }

        if view == "--scope" {
            scope = true
            i = i + 1
            continue
        }

        if view == "--group-by-scope" {
            group_by_scope = true
            i = i + 1
            continue
        }

        if view == "--symbol-variants" {
            symbol_variants = true
            i = i + 1
            continue
        }

        if view == "--snippet" || view == "--kwic" {
            snippet = true
            i = i + 1
            continue
        }

        if view == "--snippet-chars" {
            if i + 1 >= num_args {
                return Result<CliOptions, string>::Err(string::from("Flag --snippet-chars requires an argument"))
            }
            i = i + 1
            auto &val_arg = args.borrow(i)
            auto parse_res = parse_context_num(val_arg.as_str())
            if parse_res.is_err() { return Result<CliOptions, string>::Err(parse_res.unwrap_err()) }
            snippet_chars = parse_res.unwrap()
            if snippet_chars < 5:usize || snippet_chars > 500:usize {
                return Result<CliOptions, string>::Err(string::from("Flag --snippet-chars must be between 5 and 500"))
            }
            snippet = true
            i = i + 1
            continue
        }

        if view.starts_with("--snippet-chars=") {
            auto val_str = view.substr(16:usize, view.len - 16:usize)
            auto parse_res = parse_context_num(val_str)
            if parse_res.is_err() { return Result<CliOptions, string>::Err(parse_res.unwrap_err()) }
            snippet_chars = parse_res.unwrap()
            if snippet_chars < 5:usize || snippet_chars > 500:usize {
                return Result<CliOptions, string>::Err(string::from("Flag --snippet-chars must be between 5 and 500"))
            }
            snippet = true
            i = i + 1
            continue
        }

        if view == "--def-first" {
            def_first = true
            i = i + 1
            continue
        }

        if view == "--mcp" {
            mcp_mode = true
            i = i + 1
            continue
        }

        if view == "--deduplicate-targets" {
            deduplicate_targets_explicit = Option<bool>::Some(true)
            i = i + 1
            continue
        }

        if view == "--no-deduplicate-targets" {
            deduplicate_targets_explicit = Option<bool>::Some(false)
            i = i + 1
            continue
        }

        // Handle short flag clustering e.g. -nF, -iE, -lc, -q, -o, -N
        if view.starts_with("-") && !view.starts_with("--") && view.len > 1 {
            auto is_flag_cluster# = true
            auto j# = 1:usize
            loop j < view.len {
                auto ch = view.byte_at(j)
                if ch == ('F' as char) { fixed_strings = true }
                else if ch == ('E' as char) { regexp = true }
                else if ch == ('w' as char) { word_regexp = true }
                else if ch == ('x' as char) { line_regexp = true }
                else if ch == ('n' as char) { line_number = true }
                else if ch == ('N' as char) { line_number = false }
                else if ch == ('H' as char) { with_filename = Option<bool>::Some(true) }
                else if ch == ('I' as char) { with_filename = Option<bool>::Some(false) }
                else if ch == ('o' as char) { only_matching = true }
                else if ch == ('q' as char) { quiet = true }
                else if ch == ('l' as char) { files_with_matches = true }
                else if ch == ('c' as char) { count = true }
                else if ch == ('v' as char) { invert_match = true }
                else if ch == ('i' as char) { case_mode = CaseMode::Insensitive }
                else if ch == ('S' as char) { case_mode = CaseMode::Smart }
                else {
                    is_flag_cluster = false
                    break
                }
                j = j + 1
            }

            if is_flag_cluster {
                i = i + 1
                continue
            }
        }

        // Check if unknown option
        if view.starts_with("-") && view != "-" {
            auto err_msg# = string::from("Unknown option: ")
            err_msg#.push_str(view)
            return Result<CliOptions, string>::Err(cede err_msg)
        }

        // Collect positional argument
        raw_positionals#.push(arg_str.clone())
        i = i + 1
    }

    auto is_any_budget = max_total_matches_enabled || max_result_bytes_enabled || max_files_with_matches_enabled
    if count && is_any_budget {
        return Result<CliOptions, string>::Err(string::from("Flag -c (--count) cannot be combined with budget options (--max-total-matches, --max-result-bytes, --max-files-with-matches)"))
    }
    if quiet && is_any_budget {
        return Result<CliOptions, string>::Err(string::from("Flag -q (--quiet) cannot be combined with budget options"))
    }
    if type_list_only && is_any_budget {
        return Result<CliOptions, string>::Err(string::from("Flag --type-list cannot be combined with budget options"))
    }
    if files_mode && (max_total_matches_enabled || max_files_with_matches_enabled) {
        return Result<CliOptions, string>::Err(string::from("Flag --files cannot be combined with match budgets (--max-total-matches, --max-files-with-matches)"))
    }

    auto budget_limits = BudgetLimits(
        max_total_matches_enabled = max_total_matches_enabled,
        max_total_matches = max_total_matches,
        max_result_bytes_enabled = max_result_bytes_enabled,
        max_result_bytes = max_result_bytes,
        max_files_with_matches_enabled = max_files_with_matches_enabled,
        max_files_with_matches = max_files_with_matches,
        no_truncation_notice = no_truncation_notice
    )

    if type_list_only {
        return Result<CliOptions, string>::Ok(CliOptions(
            patterns = Vec<string>::new(),
            paths = Vec<string>::new(),
            pattern_source_given = false,
            fixed_strings = false,
            regexp = false,
            word_regexp = false,
            line_regexp = false,
            no_prefilter = false,
            line_number = false,
            files_with_matches = false,
            count = false,
            include_zero = false,
            quiet = false,
            only_matching = false,
            invert_match = false,
            case_mode = CaseMode::Sensitive,
            sort_mode = SortMode::None,
            no_ignore = false,
            files_mode = false,
            json_mode = false,
            json_compact = false,
            hidden = false,
            type_list_only = true,
            before_context = 0,
            after_context = 0,
            max_count_enabled = false,
            max_count = 0,
            max_columns = 0,
            budget_limits = budget_limits,
            globs = Vec<GlobRule>::new(),
            include_type_exts = Vec<string>::new(),
            exclude_type_exts = Vec<string>::new(),
            include_types = Vec<string>::new(),
            exclude_types = Vec<string>::new(),
            context_block = false,
            max_block_lines = 80,
            scope = false,
            def_first = false,
            mcp_mode = false,
            path_style = PathStyle::AsGiven,
            text_layout = TextLayout::Auto,
            with_filename = Option<bool>::None,
            deduplicate_targets = false,
            group_by_scope = false,
            symbol_variants = false,
            snippet = false,
            snippet_chars = 30:usize
        ))
    }

    // Resolve positionals independent of option order
    if pattern_source_given {
        auto p_idx# = 0:usize
        loop p_idx < raw_positionals.len() {
            paths#.push(raw_positionals.borrow(p_idx).clone())
            p_idx = p_idx + 1
        }
    } else {
        if mcp_mode {
            // In MCP mode, no search pattern is required from CLI
        } else if !files_mode {
            if raw_positionals.len() > 0 {
                patterns#.push(raw_positionals.borrow(0).clone())
                pattern_source_given = true
                auto p_idx# = 1:usize
                loop p_idx < raw_positionals.len() {
                    paths#.push(raw_positionals.borrow(p_idx).clone())
                    p_idx = p_idx + 1
                }
            } else if !type_list_only {
                return Result<CliOptions, string>::Err(string::from("Missing search pattern. Use 'trg -h' for usage."))
            }
        } else {
            auto p_idx# = 0:usize
            loop p_idx < raw_positionals.len() {
                paths#.push(raw_positionals.borrow(p_idx).clone())
                p_idx = p_idx + 1
            }
        }
    }

    // Mutual exclusion: -E and -F cannot be combined
    if fixed_strings && regexp {
        return Result<CliOptions, string>::Err(string::from("Flag -E (--extended-regexp) cannot be combined with -F (--fixed-strings)"))
    }

    if symbol_variants {
        if regexp {
            return Result<CliOptions, string>::Err(string::from("Flag --symbol-variants cannot be combined with -E (--extended-regexp)"))
        }
        if patterns.len() != 1 || !is_valid_identifier(patterns.borrow(0).as_str()) {
            return Result<CliOptions, string>::Err(string::from("Flag --symbol-variants requires a single valid identifier"))
        }
        auto ignore_case = (case_mode == CaseMode::Insensitive)
        patterns = generate_symbol_variants(patterns.borrow(0).as_str(), ignore_case)
    }

    // Flag conflict validation: --json cannot be combined with -l, -c, or --files
    if json_mode && (files_with_matches || count || files_mode) {
        return Result<CliOptions, string>::Err(string::from("Flag --json cannot be combined with -l (--files-with-matches), -c (--count), or --files"))
    }

    // Flag conflict validation: --files cannot be combined with context options (-A, -B, -C, --context-block)
    if files_mode && (context_set_explicitly || context_block) {
        return Result<CliOptions, string>::Err(string::from("Flag --files cannot be combined with context options (-A, -B, -C, --context-block)"))
    }

    // Flag conflict validation: -o cannot be combined with --files or -c
    if only_matching && (files_mode || count) {
        return Result<CliOptions, string>::Err(string::from("Flag -o (--only-matching) cannot be combined with --files or -c (--count)"))
    }

    // Effective context zeroing on -l, -c, -o, -q: ignore context lines, do not allocate ring or enforce context limits
    if files_with_matches || count || quiet || only_matching {
        before_context = 0
        after_context = 0
        context_block = false
    }

    // If no paths specified, default to current directory "."
    if paths.len() == 0 {
        paths#.push(string::from("."))
    }

    auto deduplicate_targets# = false
    match deduplicate_targets_explicit {
        auto Option<bool>::Some(val) => {
            deduplicate_targets = val
        }
        _ => {
            if mcp_mode {
                deduplicate_targets = true
            } else {
                deduplicate_targets = false
            }
        }
    }

    return Result<CliOptions, string>::Ok(CliOptions(
        patterns = cede patterns,
        paths = cede paths,
        pattern_source_given = pattern_source_given,
        fixed_strings = fixed_strings,
        regexp = regexp,
        word_regexp = word_regexp,
        line_regexp = line_regexp,
        no_prefilter = no_prefilter,
        line_number = line_number,
        files_with_matches = files_with_matches,
        count = count,
        include_zero = include_zero,
        quiet = quiet,
        only_matching = only_matching,
        invert_match = invert_match,
        case_mode = case_mode,
        sort_mode = sort_mode,
        no_ignore = no_ignore,
        files_mode = files_mode,
        json_mode = json_mode,
        json_compact = json_compact,
        hidden = hidden,
        type_list_only = false,
        before_context = before_context,
        after_context = after_context,
        max_count_enabled = max_count_enabled,
        max_count = max_count,
        max_columns = max_columns,
        budget_limits = budget_limits,
        globs = cede globs,
        include_type_exts = cede include_type_exts,
        exclude_type_exts = cede exclude_type_exts,
        include_types = cede include_types,
        exclude_types = cede exclude_types,
        context_block = context_block,
        max_block_lines = max_block_lines,
        scope = scope,
        def_first = def_first,
        mcp_mode = mcp_mode,
        path_style = path_style,
        text_layout = text_layout,
        with_filename = with_filename,
        deduplicate_targets = deduplicate_targets,
        group_by_scope = group_by_scope,
        symbol_variants = symbol_variants,
        snippet = snippet,
        snippet_chars = snippet_chars
    ))
}
