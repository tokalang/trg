// Strict command-line argument parser for trg.
import core/result::{Result}
import core/str::{str}
import std/vec::{Vec}
import std/env as env
import std/io::{println}
import src/types::{CliOptions, GlobRule}
import src/glob::{parse_glob_rule}

pub fn print_help() {
    println("trg 0.3.1 - Fast, agent-friendly code search tool")
    println("Usage:")
    println("  trg [OPTIONS] <PATTERN> [PATH...]")
    println("  trg -F [OPTIONS] <PATTERN> [PATH...]")
    println("  trg -E [OPTIONS] <PATTERN> [PATH...]")
    println("  trg --files [OPTIONS] [PATH...]")
    println("")
    println("Options:")
    println("  -F, --fixed-strings        Treat the pattern as a fixed literal string (default)")
    println("  -E, --regexp               Treat the pattern as a regular expression")
    println("  -w, --word-regexp          Only show matches surrounded by word boundaries")
    println("  -x, --line-regexp          Only show matches that match the full line")
    println("  -n, --line-number          Show line numbers (1-based)")
    println("  -l, --files-with-matches   Only print the paths of matching files")
    println("  -c, --count                Only print the count of matching lines per file")
    println("  -v, --invert-match         Invert the match (select non-matching lines)")
    println("  -i, --ignore-case          Case-insensitive search (ASCII)")
    println("  -A, --after-context <NUM>  Show NUM lines after each match (max 1000)")
    println("  -B, --before-context <NUM> Show NUM lines before each match (max 1000)")
    println("  -C, --context <NUM>        Show NUM lines before and after each match (max 1000)")
    println("  -g, --glob <GLOB>          Include or exclude files matching GLOB (last match wins)")
    println("      --files                Print the files that would be searched")
    println("      --json                 Output newline-delimited JSONL search events (trg-json-v2)")
    println("      --hidden               Search hidden files and directories")
    println("  -V, --version              Print version information")
    println("  -h, --help                 Print this help message")
}

pub fn print_version() {
    println("trg 0.3.1 (Toka)")
}

fn parse_context_num(s: str) -> Result<usize, string> {
    if s.len == 0 {
        return Result<usize, string>::Err(string::from("Context line count cannot be empty"))
    }
    auto val# = 0:usize
    auto i# = 0:usize
    loop i < s.len {
        auto ch = s.byte_at(i)
        if ch < ('0' as char) || ch > ('9' as char) {
            return Result<usize, string>::Err(string::from("Context line count must be a non-negative integer"))
        }
        auto digit = (ch as usize) - ('0' as usize)
        val = val * 10:usize + digit
        if val > 1000:usize {
            return Result<usize, string>::Err(string::from("Context lines limit exceeded (maximum is 1000)"))
        }
        i = i + 1
    }
    return Result<usize, string>::Ok(val)
}

pub fn parse_cli_args() -> Result<CliOptions, string> {
    auto args = env::args()
    auto num_args = args.len()

    auto fixed_strings# = false
    auto regexp# = false
    auto word_regexp# = false
    auto line_regexp# = false
    auto no_prefilter# = false
    auto line_number# = true
    auto files_with_matches# = false
    auto count# = false
    auto invert_match# = false
    auto ignore_case# = false
    auto files_mode# = false
    auto json_mode# = false
    auto hidden# = false
    auto before_context# = 0:usize
    auto after_context# = 0:usize
    auto context_set_explicitly# = false
    auto globs# = Vec<GlobRule>::new()

    auto pattern# = string::from("")
    auto paths# = Vec<string>::new()
    auto pattern_set# = false

    auto i# = 1:usize
    loop i < num_args {
        auto &arg_str = args.borrow(i)
        auto view = arg_str.as_str()

        if view == "-h" || view == "--help" {
            print_help()
            return Result<CliOptions, string>::Err(string::from("HELP_EXIT"))
        }

        if view == "-V" || view == "--version" {
            print_version()
            return Result<CliOptions, string>::Err(string::from("VERSION_EXIT"))
        }

        if view == "-F" || view == "--fixed-strings" {
            fixed_strings = true
            i = i + 1
            continue
        }

        if view == "-E" || view == "--regexp" {
            regexp = true
            i = i + 1
            continue
        }

        if view == "-w" || view == "--word-regexp" {
            word_regexp = true
            i = i + 1
            continue
        }

        if view == "-x" || view == "--line-regexp" {
            line_regexp = true
            i = i + 1
            continue
        }

        if view == "--no-prefilter" {
            no_prefilter = true
            i = i + 1
            continue
        }

        if view == "-n" || view == "--line-number" {
            line_number = true
            i = i + 1
            continue
        }

        if view == "-l" || view == "--files-with-matches" {
            files_with_matches = true
            i = i + 1
            continue
        }

        if view == "-c" || view == "--count" {
            count = true
            i = i + 1
            continue
        }

        if view == "-v" || view == "--invert-match" {
            invert_match = true
            i = i + 1
            continue
        }

        if view == "-i" || view == "--ignore-case" {
            ignore_case = true
            i = i + 1
            continue
        }

        if view == "--files" {
            files_mode = true
            i = i + 1
            continue
        }

        if view == "--json" {
            json_mode = true
            i = i + 1
            continue
        }

        if view == "--hidden" {
            hidden = true
            i = i + 1
            continue
        }

        // Long form context with equals: --after-context=N, --before-context=N, --context=N
        if view.starts_with("--after-context=") {
            auto val_str = view.substr(16:usize, view.len - 16:usize)
            auto parse_res = parse_context_num(val_str)
            if parse_res.is_err() { return Result<CliOptions, string>::Err(parse_res.unwrap_err()) }
            after_context = parse_res.unwrap()
            context_set_explicitly = true
            i = i + 1
            continue
        }

        if view.starts_with("--before-context=") {
            auto val_str = view.substr(17:usize, view.len - 17:usize)
            auto parse_res = parse_context_num(val_str)
            if parse_res.is_err() { return Result<CliOptions, string>::Err(parse_res.unwrap_err()) }
            before_context = parse_res.unwrap()
            context_set_explicitly = true
            i = i + 1
            continue
        }

        if view.starts_with("--context=") {
            auto val_str = view.substr(10:usize, view.len - 10:usize)
            auto parse_res = parse_context_num(val_str)
            if parse_res.is_err() { return Result<CliOptions, string>::Err(parse_res.unwrap_err()) }
            auto n = parse_res.unwrap()
            before_context = n
            after_context = n
            context_set_explicitly = true
            i = i + 1
            continue
        }

        // Context flags with space: -A <N>, -B <N>, -C <N>, --after-context <N>, etc.
        if view == "-A" || view == "--after-context" {
            if i + 1 >= num_args {
                return Result<CliOptions, string>::Err(string::from("Flag -A / --after-context requires a non-negative integer argument"))
            }
            i = i + 1
            auto &val_arg = args.borrow(i)
            auto parse_res = parse_context_num(val_arg.as_str())
            if parse_res.is_err() { return Result<CliOptions, string>::Err(parse_res.unwrap_err()) }
            after_context = parse_res.unwrap()
            context_set_explicitly = true
            i = i + 1
            continue
        }

        if view == "-B" || view == "--before-context" {
            if i + 1 >= num_args {
                return Result<CliOptions, string>::Err(string::from("Flag -B / --before-context requires a non-negative integer argument"))
            }
            i = i + 1
            auto &val_arg = args.borrow(i)
            auto parse_res = parse_context_num(val_arg.as_str())
            if parse_res.is_err() { return Result<CliOptions, string>::Err(parse_res.unwrap_err()) }
            before_context = parse_res.unwrap()
            context_set_explicitly = true
            i = i + 1
            continue
        }

        if view == "-C" || view == "--context" {
            if i + 1 >= num_args {
                return Result<CliOptions, string>::Err(string::from("Flag -C / --context requires a non-negative integer argument"))
            }
            i = i + 1
            auto &val_arg = args.borrow(i)
            auto parse_res = parse_context_num(val_arg.as_str())
            if parse_res.is_err() { return Result<CliOptions, string>::Err(parse_res.unwrap_err()) }
            auto n = parse_res.unwrap()
            before_context = n
            after_context = n
            context_set_explicitly = true
            i = i + 1
            continue
        }

        // Attached short forms: -A2, -B3, -C4
        if view.starts_with("-A") && view.len > 2 {
            auto val_str = view.substr(2:usize, view.len - 2:usize)
            auto parse_res = parse_context_num(val_str)
            if parse_res.is_err() { return Result<CliOptions, string>::Err(parse_res.unwrap_err()) }
            after_context = parse_res.unwrap()
            context_set_explicitly = true
            i = i + 1
            continue
        }

        if view.starts_with("-B") && view.len > 2 {
            auto val_str = view.substr(2:usize, view.len - 2:usize)
            auto parse_res = parse_context_num(val_str)
            if parse_res.is_err() { return Result<CliOptions, string>::Err(parse_res.unwrap_err()) }
            before_context = parse_res.unwrap()
            context_set_explicitly = true
            i = i + 1
            continue
        }

        if view.starts_with("-C") && view.len > 2 {
            auto val_str = view.substr(2:usize, view.len - 2:usize)
            auto parse_res = parse_context_num(val_str)
            if parse_res.is_err() { return Result<CliOptions, string>::Err(parse_res.unwrap_err()) }
            auto n = parse_res.unwrap()
            before_context = n
            after_context = n
            context_set_explicitly = true
            i = i + 1
            continue
        }

        if view == "-g" || view == "--glob" {
            if i + 1 >= num_args {
                return Result<CliOptions, string>::Err(string::from("Flag -g / --glob requires an argument"))
            }
            i = i + 1
            auto &glob_arg = args.borrow(i)
            auto rule = parse_glob_rule(glob_arg.clone())
            globs#.push(cede rule)
            i = i + 1
            continue
        }

        // Handle short flag clusters e.g. -nli, -Fnl, -iF, -Ew, -ix (reject clusters containing digits or unknown characters)
        if view.starts_with("-") && !view.starts_with("--") && view.len > 1 {
            auto is_flag_cluster# = true
            auto c_idx# = 1:usize
            loop c_idx < view.len {
                auto ch = view.byte_at(c_idx)
                if ch == ('F' as char) { fixed_strings = true }
                else if ch == ('E' as char) { regexp = true }
                else if ch == ('w' as char) { word_regexp = true }
                else if ch == ('x' as char) { line_regexp = true }
                else if ch == ('n' as char) { line_number = true }
                else if ch == ('l' as char) { files_with_matches = true }
                else if ch == ('c' as char) { count = true }
                else if ch == ('v' as char) { invert_match = true }
                else if ch == ('i' as char) { ignore_case = true }
                else {
                    is_flag_cluster = false
                    break
                }
                c_idx = c_idx + 1
            }

            if is_flag_cluster {
                i = i + 1
                continue
            }
        }

        // Check if unknown option
        if view.starts_with("-") && view != "-" {
            auto err_msg# = string::from("Unknown option: ")
            err_msg#.push_str(view)
            return Result<CliOptions, string>::Err(cede err_msg)
        }

        // Positional argument
        if !files_mode && !pattern_set {
            pattern = arg_str.clone()
            pattern_set = true
        } else {
            paths#.push(arg_str.clone())
        }

        i = i + 1
    }

    if !files_mode && !pattern_set {
        return Result<CliOptions, string>::Err(string::from("Missing search pattern. Use 'trg -h' for usage."))
    }

    // Mutual exclusion: -E and -F cannot be combined
    if fixed_strings && regexp {
        return Result<CliOptions, string>::Err(string::from("Flag -E (--regexp) cannot be combined with -F (--fixed-strings)"))
    }

    // Flag conflict validation: --json cannot be combined with -l, -c, or --files
    if json_mode && (files_with_matches || count || files_mode) {
        return Result<CliOptions, string>::Err(string::from("Flag --json cannot be combined with -l (--files-with-matches), -c (--count), or --files"))
    }

    // Flag conflict validation: --files cannot be combined with -A, -B, -C
    if files_mode && context_set_explicitly {
        return Result<CliOptions, string>::Err(string::from("Flag --files cannot be combined with context options (-A, -B, -C)"))
    }

    // Effective context zeroing on -l and -c: ignore context lines, do not allocate ring or enforce context limits
    if files_with_matches || count {
        before_context = 0
        after_context = 0
    }

    // If no paths specified, default to current directory "."
    if paths.len() == 0 {
        paths#.push(string::from("."))
    }

    return Result<CliOptions, string>::Ok(CliOptions(
        pattern = cede pattern,
        paths = cede paths,
        fixed_strings = fixed_strings,
        regexp = regexp,
        word_regexp = word_regexp,
        line_regexp = line_regexp,
        no_prefilter = no_prefilter,
        line_number = line_number,
        files_with_matches = files_with_matches,
        count = count,
        invert_match = invert_match,
        ignore_case = ignore_case,
        files_mode = files_mode,
        json_mode = json_mode,
        hidden = hidden,
        before_context = before_context,
        after_context = after_context,
        globs = cede globs
    ))
}
