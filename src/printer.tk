// Output formatting module supporting Human, -l, -c, --files, context lines, trg-json-v2 JSONL streaming, and OutputBudgetWriter.
import core/str::{str}
import core/option::{Option}
import std/vec::{Vec}
import std/hashmap::{HashMap}
import src/types::{
    CliOptions,
    MatchEvent,
    SubMatch,
    GlobalStats,
    BudgetState,
    BudgetLimits,
    OutputFormat,
    OutputSink,
    OutputMode,
    PathStyle,
    TextLayout,
    PathKind,
    path_kind_name,
    ResolvedPath,
    InternedRecord,
    PathBase,
    FileEntry,
    ResultSegment,
    ProjectionConfig,
    ScanPass,
    scan_pass_name
}
import src/posix::{posix_write_stdout, print_err}
import src/snippet::{format_kwic_snippet}

pub shape EmitOutcome (
    Written = 0 |
    Truncated = 1 |
    BrokenPipe = 2 |
    FatalError = 3
)

pub shape FileFrameState (
    target_path: string,
    begin_emitted#: bool,
    file_changed#: bool
)

pub shape FormatConfig (
    line_number: bool,
    only_matching: bool,
    max_columns: usize,
    scope: bool,
    group_by_scope: bool,
    with_filename: bool,
    max_block_lines: usize,
    snippet: bool,
    snippet_chars: usize
)

impl FormatConfig {
    pub fn new() -> FormatConfig {
        return FormatConfig(
            line_number = true,
            only_matching = false,
            max_columns = 0:usize,
            scope = false,
            group_by_scope = false,
            with_filename = true,
            max_block_lines = 80:usize,
            snippet = false,
            snippet_chars = 30:usize
        )
    }

    pub fn from_options(opts: CliOptions) -> FormatConfig {
        auto wf# = true
        match opts.with_filename {
            auto Option<bool>::Some(val) => {
                wf = val
            }
            _ => {
                wf = true
            }
        }
        return FormatConfig(
            line_number = opts.line_number,
            only_matching = opts.only_matching,
            max_columns = opts.max_columns,
            scope = opts.scope,
            group_by_scope = opts.group_by_scope,
            with_filename = wf,
            max_block_lines = opts.max_block_lines,
            snippet = opts.snippet,
            snippet_chars = opts.snippet_chars
        )
    }
}

pub shape OutputBatch (
    records: Vec<InternedRecord>,
    separator_needed: bool,
    is_payload: bool
)

impl OutputBatch {
    pub fn new(cede records: Vec<InternedRecord>, separator_needed: bool) -> OutputBatch {
        return OutputBatch(
            records = cede records,
            separator_needed = separator_needed,
            is_payload = true
        )
    }
}

pub fn format_file_entry_json(id: usize, path: str, path_kind: PathKind) -> string {
    auto s# = string::from("{\"id\":")
    s#.push_str(u64_to_string(id as u64).as_str())
    s#.push_str(",\"path\":\"")
    s#.push_str(json_escape(path).as_str())
    s#.push_str("\",\"kind\":\"")
    s#.push_str(path_kind_name(path_kind))
    s#.push_str("\"}")
    return cede s
}

pub fn format_segment_opening(file_id: usize, scan_pass: ScanPass) -> string {
    auto s# = string::from("{\"file_id\":")
    s#.push_str(u64_to_string(file_id as u64).as_str())
    s#.push_str(",\"pass\":\"")
    s#.push_str(scan_pass_name(scan_pass))
    s#.push_str("\",\"records\":[")
    return cede s
}

pub fn format_interned_record_json(rec: InternedRecord) -> string {
    auto s# = string::from("{\"kind\":\"")
    s#.push_str(rec.kind.as_str())
    s#.push_str("\",\"group_id\":")
    s#.push_str(u64_to_string(rec.group_id as u64).as_str())
    s#.push_str(",\"line_number\":")
    s#.push_str(u64_to_string(rec.line_number as u64).as_str())
    s#.push_str(",\"absolute_offset\":")
    s#.push_str(u64_to_string(rec.absolute_offset as u64).as_str())
    s#.push_str(",\"text\":\"")
    s#.push_str(json_escape(rec.text.as_str()).as_str())
    s#.push_str("\"")

    if rec.kind == "match" {
        s#.push_str(",\"submatches\":[")
        auto si# = 0:usize
        loop si < rec.submatches.len() {
            if si > 0 { s#.push_str(",") }
            auto &sm = rec.submatches.borrow(si)
            s#.push_str("{\"match_text\":\"")
            s#.push_str(json_escape(sm.match_text.as_str()).as_str())
            s#.push_str("\",\"start\":")
            s#.push_str(u64_to_string(sm.start as u64).as_str())
            s#.push_str(",\"end\":")
            s#.push_str(u64_to_string(sm.end as u64).as_str())
            s#.push_str("}")
            si = si + 1
        }
        s#.push_str("],\"scope\":")
        match rec.scope {
            auto Option<string>::Some(&sc) => {
                s#.push_str("\"")
                s#.push_str(json_escape(sc.as_str()).as_str())
                s#.push_str("\"")
            }
            _ => {
                s#.push_str("null")
            }
        }
        s#.push_str(",\"block_truncated\":")
        if rec.block_truncated { s#.push_str("true") } else { s#.push_str("false") }
        match rec.block_range {
            auto Option<BlockRange>::Some(&br) => {
                s#.push_str(",\"block_range\":[")
                s#.push_str(u64_to_string(br.start as u64).as_str())
                s#.push_str(",")
                s#.push_str(u64_to_string(br.end as u64).as_str())
                s#.push_str("]")
            }
            _ => {}
        }
    } else {
        s#.push_str(",\"block_truncated\":")
        if rec.block_truncated { s#.push_str("true") } else { s#.push_str("false") }
    }
    s#.push_str("}")
    return cede s
}

pub fn format_json_match_interned(path: str, rec: InternedRecord) -> string {
    auto esc_path = json_escape(path)
    auto match_json# = string::from("{\"type\":\"match\",\"data\":{\"path\":{\"text\":\"")
    match_json#.push_str(esc_path.as_str())
    match_json#.push_str("\"},\"lines\":{\"text\":\"")
    auto esc_line = json_escape(rec.text.as_str())
    match_json#.push_str(esc_line.as_str())
    match_json#.push_str("\\n\"},\"line_number\":")
    auto lnum_str = u64_to_string(rec.line_number as u64)
    match_json#.push_str(lnum_str.as_str())
    match_json#.push_str(",\"absolute_offset\":")
    auto abs_str = u64_to_string(rec.absolute_offset as u64)
    match_json#.push_str(abs_str.as_str())
    match_json#.push_str(",\"submatches\":[")

    auto num_sub = rec.submatches.len()
    auto s_idx# = 0:usize
    loop s_idx < num_sub {
        auto &sm = rec.submatches.borrow(s_idx)
        if s_idx > 0 {
            match_json#.push_str(",")
        }
        match_json#.push_str("{\"match\":{\"text\":\"")
        auto esc_sm = json_escape(sm.match_text.as_str())
        match_json#.push_str(esc_sm.as_str())
        match_json#.push_str("\"},\"start\":")
        auto start_str = u64_to_string(sm.start as u64)
        match_json#.push_str(start_str.as_str())
        match_json#.push_str(",\"end\":")
        auto end_str = u64_to_string(sm.end as u64)
        match_json#.push_str(end_str.as_str())
        match_json#.push_str("}")
        s_idx = s_idx + 1
    }

    match rec.scope {
        auto Option<string>::Some(&sc) => {
            match_json#.push_str("],\"scope\":{\"text\":\"")
            auto esc_scope = json_escape(sc.as_str())
            match_json#.push_str(esc_scope.as_str())
            match_json#.push_str("\"}")
        }
        _ => {
            match_json#.push_str("]")
        }
    }
    match rec.block_range {
        auto Option<BlockRange>::Some(&br) => {
            match_json#.push_str(",\"block_range\":[")
            match_json#.push_str(u64_to_string(br.start as u64).as_str())
            match_json#.push_str(",")
            match_json#.push_str(u64_to_string(br.end as u64).as_str())
            match_json#.push_str("]")
        }
        _ => {}
    }
    match_json#.push_str("}}\n")
    return cede match_json
}

pub fn format_json_context_interned(path: str, rec: InternedRecord) -> string {
    auto esc_path = json_escape(path)
    auto ctx_json# = string::from("{\"type\":\"context\",\"data\":{\"path\":{\"text\":\"")
    ctx_json#.push_str(esc_path.as_str())
    ctx_json#.push_str("\"},\"lines\":{\"text\":\"")
    auto esc_line = json_escape(rec.text.as_str())
    ctx_json#.push_str(esc_line.as_str())
    ctx_json#.push_str("\\n\"},\"line_number\":")
    auto lnum_str = u64_to_string(rec.line_number as u64)
    ctx_json#.push_str(lnum_str.as_str())
    ctx_json#.push_str(",\"absolute_offset\":")
    auto abs_str = u64_to_string(rec.absolute_offset as u64)
    ctx_json#.push_str(abs_str.as_str())
    if rec.block_truncated {
        ctx_json#.push_str(",\"submatches\":[],\"block_truncated\":true}}\n")
    } else {
        ctx_json#.push_str(",\"submatches\":[]}}\n")
    }
    return cede ctx_json
}

pub fn format_json_match_compact_interned(path: str, rec: InternedRecord) -> string {
    auto esc_path = json_escape(path)
    auto res# = string::from("{\"type\":\"match\",\"path\":\"")
    res#.push_str(esc_path.as_str())
    res#.push_str("\",\"line\":")
    auto lnum_str = u64_to_string(rec.line_number as u64)
    res#.push_str(lnum_str.as_str())
    res#.push_str(",\"text\":\"")
    auto esc_line = json_escape(rec.text.as_str())
    res#.push_str(esc_line.as_str())
    res#.push_str("\\n\"")
    match rec.scope {
        auto Option<string>::Some(&sc) => {
            res#.push_str(",\"scope\":\"")
            auto esc_scope = json_escape(sc.as_str())
            res#.push_str(esc_scope.as_str())
            res#.push_str("\"")
        }
        _ => {}
    }
    match rec.block_range {
        auto Option<BlockRange>::Some(&br) => {
            res#.push_str(",\"block_range\":[")
            res#.push_str(u64_to_string(br.start as u64).as_str())
            res#.push_str(",")
            res#.push_str(u64_to_string(br.end as u64).as_str())
            res#.push_str("]")
        }
        _ => {}
    }
    res#.push_str("}\n")
    return cede res
}

pub fn format_json_context_compact_interned(path: str, rec: InternedRecord) -> string {
    auto esc_path = json_escape(path)
    auto res# = string::from("{\"type\":\"context\",\"path\":\"")
    res#.push_str(esc_path.as_str())
    res#.push_str("\",\"line\":")
    auto lnum_str = u64_to_string(rec.line_number as u64)
    res#.push_str(lnum_str.as_str())
    res#.push_str(",\"text\":\"")
    auto esc_line = json_escape(rec.text.as_str())
    res#.push_str(esc_line.as_str())
    res#.push_str("\\n\"")
    if rec.block_truncated {
        res#.push_str(",\"block_truncated\":true")
    }
    res#.push_str("}\n")
    return cede res
}

fn render_batch_text(
    format: OutputFormat,
    layout: TextLayout,
    fmt_cfg: FormatConfig,
    resolved_path: ResolvedPath,
    records: Vec<InternedRecord>,
    separator_needed: bool,
    needs_heading: bool,
    has_emitted_heading: bool,
    last_scope#: Option<string>
) -> string {
    auto out# = string::new()
    match format {
        auto OutputFormat::Human => {
            auto first_block_range# = Option<BlockRange>::None
            auto b_idx# = 0:usize
            loop b_idx < records.len() {
                auto &r = records.borrow(b_idx)
                match r.block_range {
                    auto Option<BlockRange>::Some(&br) => {
                        first_block_range = Option<BlockRange>::Some(br.clone())
                        break
                    }
                    _ => {}
                }
                b_idx = b_idx + 1
            }

            if layout == TextLayout::Grouped {
                auto show_heading = fmt_cfg.with_filename && needs_heading && resolved_path.display_path.len() > 0
                if show_heading {
                    if has_emitted_heading {
                        out#.push_str("\n")
                    }
                    out#.push_str(resolved_path.display_path.as_str())
                    out#.push_str("\n")
                }
                if separator_needed {
                    out#.push_str("--\n")
                }

                if fmt_cfg.group_by_scope {
                    auto b_scope# = Option<string>::None
                    auto bsi# = 0:usize
                    loop bsi < records.len() {
                        auto &r = records.borrow(bsi)
                        if r.kind == "match" {
                            match r.scope {
                                auto Option<string>::Some(&sc) => {
                                    b_scope = Option<string>::Some(sc.clone())
                                    break
                                }
                                _ => {}
                            }
                        }
                        bsi = bsi + 1
                    }
                    match b_scope {
                        auto Option<string>::Some(&sc) => {
                            auto sc_changed# = false
                            match last_scope {
                                auto Option<string>::Some(&prev) => {
                                    if !prev.equals(sc.as_str()) {
                                        sc_changed = true
                                    }
                                }
                                _ => {
                                    sc_changed = true
                                }
                            }
                            if sc_changed {
                                out#.push_str("scope: ")
                                out#.push_str(sc.as_str())
                                out#.push_str("\n")
                                last_scope = Option<string>::Some(sc.clone())
                            }
                        }
                        _ => {}
                    }
                }

                if !fmt_cfg.only_matching {
                    match first_block_range {
                        auto Option<BlockRange>::Some(&br) => {
                            out#.push_str("[block: L")
                            out#.push_str(u64_to_string(br.start as u64).as_str())
                            out#.push_str("-L")
                            out#.push_str(u64_to_string(br.end as u64).as_str())
                            out#.push_str("]\n")
                        }
                        _ => {}
                    }
                }

                auto ri# = 0:usize
                loop ri < records.len() {
                    auto &rec = records.borrow(ri)
                    if rec.kind == "match" {
                        if fmt_cfg.group_by_scope {
                            match rec.scope {
                                auto Option<string>::Some(&sc) => {
                                    auto sc_changed# = false
                                    match last_scope {
                                        auto Option<string>::Some(&prev) => {
                                            if !prev.equals(sc.as_str()) {
                                                sc_changed = true
                                            }
                                        }
                                        _ => {
                                            sc_changed = true
                                        }
                                    }
                                    if sc_changed {
                                        out#.push_str("scope: ")
                                        out#.push_str(sc.as_str())
                                        out#.push_str("\n")
                                        last_scope = Option<string>::Some(sc.clone())
                                    }
                                }
                                _ => {}
                            }
                        }
                        if fmt_cfg.only_matching {
                            auto si# = 0:usize
                            loop si < rec.submatches.len() {
                                auto &sm = rec.submatches.borrow(si)
                                if fmt_cfg.line_number {
                                    out#.push_str(u64_to_string(rec.line_number as u64).as_str())
                                    out#.push_str(":")
                                }
                                out#.push_str(sm.match_text.as_str())
                                out#.push_str("\n")
                                si = si + 1
                            }
                        } else {
                            if fmt_cfg.line_number {
                                out#.push_str(u64_to_string(rec.line_number as u64).as_str())
                                out#.push_str(":")
                            }
                            if fmt_cfg.scope {
                                match rec.scope {
                                    auto Option<string>::Some(&sc) => {
                                        out#.push_str("[")
                                        out#.push_str(sc.as_str())
                                        out#.push_str("] ")
                                    }
                                    _ => {}
                                }
                            }
                            if fmt_cfg.max_columns > 0 && rec.text.len() > fmt_cfg.max_columns {
                                out#.push_str("[Omitted long matching line]\n")
                            } else if fmt_cfg.snippet && rec.submatches.len() > 0 {
                                auto snip = format_kwic_snippet(rec.text.as_str(), rec.submatches, fmt_cfg.snippet_chars)
                                out#.push_str(snip.as_str())
                                out#.push_str("\n")
                            } else {
                                out#.push_str(rec.text.as_str())
                                out#.push_str("\n")
                            }
                        }
                    } else {
                        if !fmt_cfg.only_matching {
                            if fmt_cfg.line_number {
                                out#.push_str(u64_to_string(rec.line_number as u64).as_str())
                                out#.push_str("-")
                            }
                            if fmt_cfg.max_columns > 0 && rec.text.len() > fmt_cfg.max_columns {
                                out#.push_str("[Omitted long context line]\n")
                            } else {
                                out#.push_str(rec.text.as_str())
                                out#.push_str("\n")
                            }
                            if rec.block_truncated {
                                out#.push_str("[block context truncated by --max-block-lines ")
                                out#.push_str(u64_to_string(fmt_cfg.max_block_lines as u64).as_str())
                                out#.push_str("]\n")
                            }
                        }
                    }
                    ri = ri + 1
                }
            } else {
                if separator_needed {
                    out#.push_str("--\n")
                }
                if !fmt_cfg.only_matching {
                    match first_block_range {
                        auto Option<BlockRange>::Some(&br) => {
                            out#.push_str("[block: L")
                            out#.push_str(u64_to_string(br.start as u64).as_str())
                            out#.push_str("-L")
                            out#.push_str(u64_to_string(br.end as u64).as_str())
                            out#.push_str("]\n")
                        }
                        _ => {}
                    }
                }
                auto ri# = 0:usize
                loop ri < records.len() {
                    auto &rec = records.borrow(ri)
                    if rec.kind == "match" {
                        if fmt_cfg.only_matching {
                            auto si# = 0:usize
                            loop si < rec.submatches.len() {
                                auto &sm = rec.submatches.borrow(si)
                                if fmt_cfg.with_filename && resolved_path.display_path.len() > 0 {
                                    out#.push_str(resolved_path.display_path.as_str())
                                    out#.push_str(":")
                                }
                                if fmt_cfg.line_number {
                                    out#.push_str(u64_to_string(rec.line_number as u64).as_str())
                                    out#.push_str(":")
                                }
                                out#.push_str(sm.match_text.as_str())
                                out#.push_str("\n")
                                si = si + 1
                            }
                        } else {
                            if fmt_cfg.with_filename && resolved_path.display_path.len() > 0 {
                                out#.push_str(resolved_path.display_path.as_str())
                                out#.push_str(":")
                            }
                            if fmt_cfg.line_number {
                                out#.push_str(u64_to_string(rec.line_number as u64).as_str())
                                out#.push_str(":")
                            }
                            if fmt_cfg.scope || fmt_cfg.group_by_scope {
                                match rec.scope {
                                    auto Option<string>::Some(&sc) => {
                                        out#.push_str("[")
                                        out#.push_str(sc.as_str())
                                        out#.push_str("] ")
                                    }
                                    _ => {}
                                }
                            }
                            if fmt_cfg.max_columns > 0 && rec.text.len() > fmt_cfg.max_columns {
                                out#.push_str("[Omitted long matching line]\n")
                            } else if fmt_cfg.snippet && rec.submatches.len() > 0 {
                                auto snip = format_kwic_snippet(rec.text.as_str(), rec.submatches, fmt_cfg.snippet_chars)
                                out#.push_str(snip.as_str())
                                out#.push_str("\n")
                            } else {
                                out#.push_str(rec.text.as_str())
                                out#.push_str("\n")
                            }
                        }
                    } else {
                        if !fmt_cfg.only_matching {
                            if fmt_cfg.with_filename && resolved_path.display_path.len() > 0 {
                                out#.push_str(resolved_path.display_path.as_str())
                                out#.push_str("-")
                            }
                            if fmt_cfg.line_number {
                                out#.push_str(u64_to_string(rec.line_number as u64).as_str())
                                out#.push_str("-")
                            }
                            if fmt_cfg.max_columns > 0 && rec.text.len() > fmt_cfg.max_columns {
                                out#.push_str("[Omitted long context line]\n")
                            } else {
                                out#.push_str(rec.text.as_str())
                                out#.push_str("\n")
                            }
                            if rec.block_truncated {
                                out#.push_str("[block context truncated by --max-block-lines ")
                                out#.push_str(u64_to_string(fmt_cfg.max_block_lines as u64).as_str())
                                out#.push_str("]\n")
                            }
                        }
                    }
                    ri = ri + 1
                }
            }
        }
        auto OutputFormat::JsonFull => {
            auto ri# = 0:usize
            loop ri < records.len() {
                auto &rec = records.borrow(ri)
                if rec.kind == "match" {
                    out#.push_str(format_json_match_interned(resolved_path.display_path.as_str(), rec).as_str())
                } else {
                    out#.push_str(format_json_context_interned(resolved_path.display_path.as_str(), rec).as_str())
                }
                ri = ri + 1
            }
        }
        auto OutputFormat::JsonCompact => {
            auto ri# = 0:usize
            loop ri < records.len() {
                auto &rec = records.borrow(ri)
                if rec.kind == "match" {
                    out#.push_str(format_json_match_compact_interned(resolved_path.display_path.as_str(), rec).as_str())
                } else {
                    out#.push_str(format_json_context_compact_interned(resolved_path.display_path.as_str(), rec).as_str())
                }
                ri = ri + 1
            }
        }
    }
    return cede out
}

pub shape OutputBudgetWriter (
    mode: OutputMode,
    format: OutputFormat,
    sink: OutputSink,
    memory_str#: string,
    path_base: PathBase,
    files#: Vec<FileEntry>,
    file_lookup#: HashMap<string, usize>,
    segments#: Vec<ResultSegment>,
    active_segment_file_id#: Option<usize>,
    last_emitted_file_key#: string,
    projection#: ProjectionConfig,
    has_emitted_heading#: bool,
    canonical_record_bytes#: usize,
    text_record_bytes#: usize,
    records_emitted#: usize,
    current_scan_pass#: ScanPass,
    fmt_cfg: FormatConfig,
    last_scope#: Option<string>
)

impl OutputBudgetWriter {
    pub fn new_cli(
        format: OutputFormat,
        sink: OutputSink,
        layout: TextLayout,
        style: PathStyle,
        fmt_cfg: FormatConfig
    ) -> OutputBudgetWriter {
        return OutputBudgetWriter(
            mode = OutputMode::CliStreaming,
            format = format,
            sink = sink,
            memory_str = string::new(),
            path_base = PathBase(kind = string::from("cwd"), path = string::new()),
            files = Vec<FileEntry>::new(),
            file_lookup = HashMap<string, usize>::new(),
            segments = Vec<ResultSegment>::new(),
            active_segment_file_id = Option<usize>::None,
            last_emitted_file_key = string::new(),
            projection = ProjectionConfig(path_style = style, text_layout = layout),
            has_emitted_heading = false,
            canonical_record_bytes = 0:usize,
            text_record_bytes = 0:usize,
            records_emitted = 0:usize,
            current_scan_pass = ScanPass::All,
            fmt_cfg = fmt_cfg,
            last_scope = Option<string>::None
        )
    }

    pub fn new_mcp(
        cede startup_cwd: string,
        layout: TextLayout,
        style: PathStyle,
        fmt_cfg: FormatConfig
    ) -> OutputBudgetWriter {
        return OutputBudgetWriter(
            mode = OutputMode::McpCollecting,
            format = OutputFormat::Human,
            sink = OutputSink::Memory,
            memory_str = string::new(),
            path_base = PathBase(kind = string::from("cwd"), path = cede startup_cwd),
            files = Vec<FileEntry>::new(),
            file_lookup = HashMap<string, usize>::new(),
            segments = Vec<ResultSegment>::new(),
            active_segment_file_id = Option<usize>::None,
            last_emitted_file_key = string::new(),
            projection = ProjectionConfig(path_style = style, text_layout = layout),
            has_emitted_heading = false,
            canonical_record_bytes = 0:usize,
            text_record_bytes = 0:usize,
            records_emitted = 0:usize,
            current_scan_pass = ScanPass::All,
            fmt_cfg = fmt_cfg,
            last_scope = Option<string>::None
        )
    }

    pub fn reset_active_segment(self#, next_pass: ScanPass) {
        self.active_segment_file_id = Option<usize>::None
        self.last_emitted_file_key = string::new()
        self.last_scope = Option<string>::None
        self.current_scan_pass = next_pass
    }

    pub fn reset_scope_state(self#) {
        self.last_scope = Option<string>::None
    }

    pub fn set_effective_projection(self#, layout: TextLayout, style: PathStyle, with_filename: bool) {
        self.projection.text_layout = layout
        self.projection.path_style = style
        self.fmt_cfg.with_filename = with_filename
    }

    pub fn take_output(self) -> string {
        return self.memory_str.clone()
    }

    pub fn emit_files_mode_path(self#, budget_state#: BudgetState, path: str) -> EmitOutcome {
        if budget_state.is_truncated { return EmitOutcome::Truncated }
        auto s# = string::from(path)
        s#.push_str("\n")
        auto delta = s.len()
        if budget_state.limits.max_result_bytes_enabled {
            if budget_state.result_payload_bytes_emitted >= budget_state.limits.max_result_bytes ||
               delta > budget_state.limits.max_result_bytes - budget_state.result_payload_bytes_emitted {
                budget_state.is_truncated = true
                budget_state.truncation_reason = string::from("max_result_bytes")
                budget_state.stopped_path = string::from(path)
                budget_state.stopped_line_num = 0:usize
                return EmitOutcome::Truncated
            }
        }
        match self.sink {
            auto OutputSink::Memory => { self.memory_str#.push_str(s.as_str()) }
            auto OutputSink::Stdout => {
                auto res = posix_write_stdout(s.as_str())
                if res == 1 { return EmitOutcome::BrokenPipe }
                else if res == 2 { return EmitOutcome::FatalError }
            }
        }
        budget_state.result_payload_bytes_emitted = budget_state.result_payload_bytes_emitted + delta
        return EmitOutcome::Written
    }

    pub fn try_commit_batch(
        self#,
        budget_state#: BudgetState,
        frame_state#: FileFrameState,
        resolved_path: ResolvedPath,
        batch: OutputBatch
    ) -> EmitOutcome {
        if budget_state.is_truncated {
            return EmitOutcome::Truncated
        }

        match self.mode {
            auto OutputMode::CliStreaming => {
                auto needs_heading = (self.projection.text_layout == TextLayout::Grouped) &&
                                     self.fmt_cfg.with_filename &&
                                     (self.last_emitted_file_key != resolved_path.identity_key)

                if self.last_emitted_file_key != resolved_path.identity_key {
                    self.last_scope = Option<string>::None
                }

                auto text = render_batch_text(
                    self.format,
                    self.projection.text_layout,
                    self.fmt_cfg,
                    resolved_path,
                    batch.records,
                    batch.separator_needed,
                    needs_heading,
                    self.has_emitted_heading,
                    self.last_scope#
                )

                auto delta = text.len()

                // Preflight text bytes
                if budget_state.limits.max_result_bytes_enabled {
                    if budget_state.result_payload_bytes_emitted >= budget_state.limits.max_result_bytes ||
                       delta > budget_state.limits.max_result_bytes - budget_state.result_payload_bytes_emitted {
                        budget_state.is_truncated = true
                        budget_state.truncation_reason = string::from("max_result_bytes")
                        budget_state.stopped_path = resolved_path.display_path.clone()
                        if batch.records.len() > 0 {
                            budget_state.stopped_line_num = batch.records.borrow(0).line_number
                        } else {
                            budget_state.stopped_line_num = 0:usize
                        }
                        return EmitOutcome::Truncated
                    }
                }

                // Lazy JSON begin frame
                match self.format {
                    auto OutputFormat::JsonFull => {
                        if !frame_state.begin_emitted {
                            auto b_str = format_json_begin(resolved_path.display_path.as_str())
                            match self.sink {
                                auto OutputSink::Memory => { self.memory_str#.push_str(b_str.as_str()) }
                                auto OutputSink::Stdout => {
                                    auto b_res = posix_write_stdout(b_str.as_str())
                                    if b_res == 1 { return EmitOutcome::BrokenPipe }
                                    else if b_res == 2 { return EmitOutcome::FatalError }
                                }
                            }
                            frame_state.begin_emitted = true
                            budget_state.protocol_bytes_emitted = budget_state.protocol_bytes_emitted + b_str.len()
                        }
                    }
                    _ => {}
                }

                // Emit wire text
                match self.sink {
                    auto OutputSink::Memory => {
                        self.memory_str#.push_str(text.as_str())
                    }
                    auto OutputSink::Stdout => {
                        auto w_res = posix_write_stdout(text.as_str())
                        if w_res == 1 { return EmitOutcome::BrokenPipe }
                        else if w_res == 2 { return EmitOutcome::FatalError }
                    }
                }

                if needs_heading {
                    self.has_emitted_heading = true
                    self.last_emitted_file_key = resolved_path.identity_key.clone()
                }

                if batch.is_payload {
                    budget_state.result_payload_bytes_emitted = budget_state.result_payload_bytes_emitted + delta
                } else {
                    budget_state.protocol_bytes_emitted = budget_state.protocol_bytes_emitted + delta
                }

                return EmitOutcome::Written
            }

            auto OutputMode::McpCollecting => {
                // Preflight exact canonical structural JSON bytes
                auto prospective_delta# = 0:usize
                auto is_new_file# = false
                auto target_file_id# = 0:usize

                auto lookup_opt = self.file_lookup.get(resolved_path.identity_key.clone())
                match lookup_opt {
                    auto Option<usize>::Some(fid) => {
                        target_file_id = fid
                        is_new_file = false
                    }
                    _ => {
                        target_file_id = self.files.len()
                        is_new_file = true
                        if self.files.len() > 0 {
                            prospective_delta = prospective_delta + 1:usize
                        }
                        auto fe_str = format_file_entry_json(target_file_id, resolved_path.display_path.as_str(), resolved_path.path_kind)
                        prospective_delta = prospective_delta + fe_str.len()
                    }
                }

                auto is_new_segment# = false
                match self.active_segment_file_id {
                    auto Option<usize>::Some(cur_fid) => {
                        if cur_fid == target_file_id {
                            is_new_segment = false
                        } else {
                            is_new_segment = true
                        }
                    }
                    _ => {
                        is_new_segment = true
                    }
                }

                if is_new_segment {
                    if self.segments.len() > 0 {
                        prospective_delta = prospective_delta + 1:usize
                    }
                    auto seg_open = format_segment_opening(target_file_id, self.current_scan_pass)
                    prospective_delta = prospective_delta + seg_open.len()
                    prospective_delta = prospective_delta + 2:usize // reserved closing ]}
                }

                auto ri# = 0:usize
                loop ri < batch.records.len() {
                    auto &rec = batch.records.borrow(ri)
                    if !is_new_segment && self.segments.len() > 0 {
                        auto &seg = self.segments.borrow(self.segments.len() - 1:usize)
                        if seg.records.len() + ri > 0 {
                            prospective_delta = prospective_delta + 1:usize
                        }
                    } else if ri > 0 {
                        prospective_delta = prospective_delta + 1:usize
                    }
                    auto rec_json = format_interned_record_json(rec)
                    prospective_delta = prospective_delta + rec_json.len()
                    ri = ri + 1
                }

                // Preflight canonical structural bytes
                if budget_state.limits.max_result_bytes_enabled {
                    if self.canonical_record_bytes >= budget_state.limits.max_result_bytes ||
                       prospective_delta > budget_state.limits.max_result_bytes - self.canonical_record_bytes {
                        budget_state.is_truncated = true
                        budget_state.truncation_reason = string::from("max_result_bytes")
                        budget_state.stopped_path = resolved_path.display_path.clone()
                        if batch.records.len() > 0 {
                            budget_state.stopped_line_num = batch.records.borrow(0).line_number
                        } else {
                            budget_state.stopped_line_num = 0:usize
                        }
                        return EmitOutcome::Truncated
                    }
                }

                // Commit canonical records
                if is_new_file {
                    self.file_lookup#.insert(resolved_path.identity_key.clone(), target_file_id)
                    self.files#.push(FileEntry(
                        id = target_file_id,
                        path = resolved_path.display_path.clone(),
                        path_kind = resolved_path.path_kind
                    ))
                }

                if is_new_segment {
                    self.segments#.push(ResultSegment(
                        file_id = target_file_id,
                        scan_pass = self.current_scan_pass,
                        records = Vec<InternedRecord>::new()
                    ))
                    self.active_segment_file_id = Option<usize>::Some(target_file_id)
                }

                auto cur_seg_idx = self.segments.len() - 1:usize
                auto &seg# = self.segments#.borrow_mut(cur_seg_idx)
                auto r_add# = 0:usize
                loop r_add < batch.records.len() {
                    seg#.add_record(batch.records.borrow(r_add).clone())
                    r_add = r_add + 1
                }

                self.canonical_record_bytes = self.canonical_record_bytes + prospective_delta
                self.records_emitted = self.records_emitted + batch.records.len()
                budget_state.result_payload_bytes_emitted = self.canonical_record_bytes

                // Render presentation projection into memory_str
                auto needs_heading = (self.projection.text_layout == TextLayout::Grouped) &&
                                     (self.last_emitted_file_key != resolved_path.identity_key)

                if self.last_emitted_file_key != resolved_path.identity_key {
                    self.last_scope = Option<string>::None
                }

                auto text = render_batch_text(
                    OutputFormat::Human,
                    self.projection.text_layout,
                    self.fmt_cfg,
                    resolved_path,
                    batch.records,
                    batch.separator_needed,
                    needs_heading,
                    self.has_emitted_heading,
                    self.last_scope#
                )

                if needs_heading {
                    self.has_emitted_heading = true
                    self.last_emitted_file_key = resolved_path.identity_key.clone()
                }

                self.memory_str#.push_str(text.as_str())
                self.text_record_bytes = self.text_record_bytes + text.len()

                return EmitOutcome::Written
            }
        }
    }

    pub fn write_raw(self#, s: str) -> EmitOutcome {
        match self.sink {
            auto OutputSink::Memory => {
                self.memory_str#.push_str(s)
                return EmitOutcome::Written
            }
            auto OutputSink::Stdout => {
                auto res = posix_write_stdout(s)
                if res == 1 { return EmitOutcome::BrokenPipe }
                else if res == 2 { return EmitOutcome::FatalError }
                return EmitOutcome::Written
            }
        }
    }

    pub fn emit_protocol_frame(
        self,
        budget_state#: BudgetState,
        frame_str: str
    ) -> EmitOutcome {
        match self.sink {
            auto OutputSink::Memory => {
                self.memory_str#.push_str(frame_str)
                budget_state.protocol_bytes_emitted = budget_state.protocol_bytes_emitted + frame_str.len
                return EmitOutcome::Written
            }
            auto OutputSink::Stdout => {
                auto w_res = posix_write_stdout(frame_str)
                if w_res == 1 { return EmitOutcome::BrokenPipe }
                else if w_res == 2 { return EmitOutcome::FatalError }
                budget_state.protocol_bytes_emitted = budget_state.protocol_bytes_emitted + frame_str.len
                return EmitOutcome::Written
            }
        }
    }
}

fn hex_digit(v: u8) -> char {
    if v < 10:u8 {
        return (48:u8 + v) as char
    }
    return (97:u8 + (v - 10:u8)) as char
}

pub fn u64_to_string(val: u64) -> string {
    if val == 0:u64 {
        return string::from("0")
    }
    auto digits# = [0:char; 32]
    auto n# = val
    auto count# = 0:usize
    loop n > 0:u64 {
        auto d = (n % 10:u64) as u8
        digits[count] = (48:u8 + d) as char
        n = n / 10:u64
        count = count + 1
    }
    auto out# = string::new()
    auto i# = count
    loop i > 0 {
        i = i - 1
        out#.push_char(digits[i])
    }
    return cede out
}

pub fn i64_to_string(val: i64) -> string {
    if val == 0:i64 {
        return string::from("0")
    }
    if val < 0:i64 {
        auto u_val = (0:i64 - val) as u64
        auto u_str = u64_to_string(u_val)
        auto res# = string::from("-")
        res#.push_str(u_str.as_str())
        return cede res
    }
    return u64_to_string(val as u64)
}

pub fn json_escape(s: str) -> string {
    auto out# = string::new()
    auto i# = 0:usize
    loop i < s.len {
        auto ch = s.byte_at(i)
        auto b = ch as u8
        if b == (92:u8) { // '\\'
            out#.push_str("\\\\")
        } else if b == (34:u8) { // '"'
            out#.push_str("\\\"")
        } else if b == (10:u8) { // '\n'
            out#.push_str("\\n")
        } else if b == (13:u8) { // '\r'
            out#.push_str("\\r")
        } else if b == (9:u8) { // '\t'
            out#.push_str("\\t")
        } else if b == (8:u8) { // '\b'
            out#.push_str("\\b")
        } else if b == (12:u8) { // '\f'
            out#.push_str("\\f")
        } else if b < 32:u8 {
            out#.push_str("\\u00")
            auto hi = b / 16:u8
            auto lo = b % 16:u8
            out#.push_char(hex_digit(hi))
            out#.push_char(hex_digit(lo))
        } else {
            out#.push_char(ch)
        }
        i = i + 1
    }
    return cede out
}

pub fn write_line(line: str) -> i32 {
    auto s# = string::from(line)
    s#.push_str("\n")
    return posix_write_stdout(s.as_str())
}

pub fn format_json_begin(path: str) -> string {
    auto begin_json# = string::from("{\"type\":\"begin\",\"schema\":\"trg-json-v2\",\"data\":{\"path\":{\"text\":\"")
    auto esc_path = json_escape(path)
    begin_json#.push_str(esc_path.as_str())
    begin_json#.push_str("\"}}}\n")
    return cede begin_json
}

pub fn format_json_match(ev: MatchEvent) -> string {
    auto esc_path = json_escape(ev.path.as_str())
    auto match_json# = string::from("{\"type\":\"match\",\"data\":{\"path\":{\"text\":\"")
    match_json#.push_str(esc_path.as_str())
    match_json#.push_str("\"},\"lines\":{\"text\":\"")
    auto esc_line = json_escape(ev.line_text.as_str())
    match_json#.push_str(esc_line.as_str())
    match_json#.push_str("\\n\"},\"line_number\":")
    auto lnum_str = u64_to_string(ev.line_number as u64)
    match_json#.push_str(lnum_str.as_str())
    match_json#.push_str(",\"absolute_offset\":")
    auto abs_str = u64_to_string(ev.absolute_offset as u64)
    match_json#.push_str(abs_str.as_str())
    match_json#.push_str(",\"submatches\":[")

    auto num_sub = ev.submatches.len()
    auto s_idx# = 0:usize
    loop s_idx < num_sub {
        auto &sm = ev.submatches.borrow(s_idx)
        if s_idx > 0 {
            match_json#.push_str(",")
        }
        match_json#.push_str("{\"match\":{\"text\":\"")
        auto esc_sm = json_escape(sm.match_text.as_str())
        match_json#.push_str(esc_sm.as_str())
        match_json#.push_str("\"},\"start\":")
        auto start_str = u64_to_string(sm.start as u64)
        match_json#.push_str(start_str.as_str())
        match_json#.push_str(",\"end\":")
        auto end_str = u64_to_string(sm.end as u64)
        match_json#.push_str(end_str.as_str())
        match_json#.push_str("}")
        s_idx = s_idx + 1
    }

    if ev.scope_name.len() > 0 {
        match_json#.push_str("],\"scope\":{\"text\":\"")
        auto esc_scope = json_escape(ev.scope_name.as_str())
        match_json#.push_str(esc_scope.as_str())
        match_json#.push_str("\"}}}\n")
    } else {
        match_json#.push_str("]}}\n")
    }
    return cede match_json
}

pub fn format_json_context(ev: MatchEvent) -> string {
    auto esc_path = json_escape(ev.path.as_str())
    auto ctx_json# = string::from("{\"type\":\"context\",\"data\":{\"path\":{\"text\":\"")
    ctx_json#.push_str(esc_path.as_str())
    ctx_json#.push_str("\"},\"lines\":{\"text\":\"")
    auto esc_line = json_escape(ev.line_text.as_str())
    ctx_json#.push_str(esc_line.as_str())
    ctx_json#.push_str("\\n\"},\"line_number\":")
    auto lnum_str = u64_to_string(ev.line_number as u64)
    ctx_json#.push_str(lnum_str.as_str())
    ctx_json#.push_str(",\"absolute_offset\":")
    auto abs_str = u64_to_string(ev.absolute_offset as u64)
    ctx_json#.push_str(abs_str.as_str())
    if ev.block_truncated {
        ctx_json#.push_str(",\"submatches\":[],\"block_truncated\":true}}\n")
    } else {
        ctx_json#.push_str(",\"submatches\":[]}}\n")
    }
    return cede ctx_json
}

pub fn format_json_match_compact(ev: MatchEvent) -> string {
    auto esc_path = json_escape(ev.path.as_str())
    auto res# = string::from("{\"type\":\"match\",\"path\":\"")
    res#.push_str(esc_path.as_str())
    res#.push_str("\",\"line\":")
    auto lnum_str = u64_to_string(ev.line_number as u64)
    res#.push_str(lnum_str.as_str())
    res#.push_str(",\"text\":\"")
    auto esc_line = json_escape(ev.line_text.as_str())
    res#.push_str(esc_line.as_str())
    res#.push_str("\\n\"")
    if ev.scope_name.len() > 0 {
        res#.push_str(",\"scope\":\"")
        auto esc_scope = json_escape(ev.scope_name.as_str())
        res#.push_str(esc_scope.as_str())
        res#.push_str("\"")
    }
    res#.push_str("}\n")
    return cede res
}

pub fn format_json_context_compact(ev: MatchEvent) -> string {
    auto esc_path = json_escape(ev.path.as_str())
    auto res# = string::from("{\"type\":\"context\",\"path\":\"")
    res#.push_str(esc_path.as_str())
    res#.push_str("\",\"line\":")
    auto lnum_str = u64_to_string(ev.line_number as u64)
    res#.push_str(lnum_str.as_str())
    res#.push_str(",\"text\":\"")
    auto esc_line = json_escape(ev.line_text.as_str())
    res#.push_str(esc_line.as_str())
    res#.push_str("\\n\"")
    if ev.block_truncated {
        res#.push_str(",\"block_truncated\":true")
    }
    res#.push_str("}\n")
    return cede res
}

pub fn format_json_end(path: str, matches_emitted: usize) -> string {
    auto esc_path = json_escape(path)
    auto end_json# = string::from("{\"type\":\"end\",\"data\":{\"path\":{\"text\":\"")
    end_json#.push_str(esc_path.as_str())
    end_json#.push_str("\"},\"binary_offset\":null,\"stats\":{\"elapsed\":{\"secs\":0,\"nanos\":0},\"searches\":1,\"matches\":")
    auto cnt_str = u64_to_string(matches_emitted as u64)
    end_json#.push_str(cnt_str.as_str())
    end_json#.push_str("}}}\n")
    return cede end_json
}

pub fn emit_json_begin(path: str) -> i32 {
    auto s = format_json_begin(path)
    return posix_write_stdout(s.as_str())
}

pub fn emit_json_match(ev: MatchEvent) -> i32 {
    auto s = format_json_match(ev)
    return posix_write_stdout(s.as_str())
}

pub fn emit_json_context(ev: MatchEvent) -> i32 {
    auto s = format_json_context(ev)
    return posix_write_stdout(s.as_str())
}

pub fn emit_json_end(path: str, matches_emitted: usize) -> i32 {
    auto s = format_json_end(path, matches_emitted)
    return posix_write_stdout(s.as_str())
}

pub fn format_human_match(ev: MatchEvent, opts: CliOptions, multiple_files: bool) -> string {
    if opts.only_matching {
        auto out# = string::new()
        auto num_sub = ev.submatches.len()
        auto s_idx# = 0:usize
        loop s_idx < num_sub {
            auto &sm = ev.submatches.borrow(s_idx)
            if multiple_files && ev.path.len() > 0 {
                out#.push_str(ev.path.as_str())
                out#.push_str(":")
            }

            if opts.line_number {
                auto lnum_str = u64_to_string(ev.line_number as u64)
                out#.push_str(lnum_str.as_str())
                out#.push_str(":")
            }

            out#.push_str(sm.match_text.as_str())
            out#.push_str("\n")
            s_idx = s_idx + 1
        }
        return cede out
    }

    auto out# = string::new()
    if multiple_files && ev.path.len() > 0 {
        out#.push_str(ev.path.as_str())
        out#.push_str(":")
    }

    if opts.line_number {
        auto lnum_str = u64_to_string(ev.line_number as u64)
        out#.push_str(lnum_str.as_str())
        out#.push_str(":")
    }

    if opts.scope && ev.scope_name.len() > 0 {
        out#.push_str("[")
        out#.push_str(ev.scope_name.as_str())
        out#.push_str("] ")
    }

    if opts.max_columns > 0 && ev.line_text.len() > opts.max_columns {
        out#.push_str("[Omitted long matching line]\n")
    } else {
        out#.push_str(ev.line_text.as_str())
        out#.push_str("\n")
    }
    return cede out
}

pub fn format_human_context(ev: MatchEvent, opts: CliOptions, multiple_files: bool) -> string {
    if opts.only_matching {
        return string::from("")
    }

    auto out# = string::new()
    if multiple_files && ev.path.len() > 0 {
        out#.push_str(ev.path.as_str())
        out#.push_str("-")
    }

    if opts.line_number {
        auto lnum_str = u64_to_string(ev.line_number as u64)
        out#.push_str(lnum_str.as_str())
        out#.push_str("-")
    }

    if opts.max_columns > 0 && ev.line_text.len() > opts.max_columns {
        out#.push_str("[Omitted long context line]\n")
    } else {
        out#.push_str(ev.line_text.as_str())
        out#.push_str("\n")
    }
    return cede out
}

pub fn format_group_separator() -> string {
    return string::from("--\n")
}

pub fn emit_group_separator() -> i32 {
    return posix_write_stdout("--\n")
}

pub fn emit_human_match(ev: MatchEvent, opts: CliOptions, multiple_files: bool) -> i32 {
    auto s = format_human_match(ev, opts, multiple_files)
    return posix_write_stdout(s.as_str())
}

pub fn emit_human_context(ev: MatchEvent, opts: CliOptions, multiple_files: bool) -> i32 {
    auto s = format_human_context(ev, opts, multiple_files)
    if s.len() == 0 { return 0 }
    return posix_write_stdout(s.as_str())
}

fn format_summary_json_raw(
    stats: GlobalStats,
    budget_state: BudgetState,
    had_error: bool,
    protocol_bytes: usize,
    stdout_bytes: usize
) -> string {
    auto is_trunc = budget_state.is_truncated
    auto is_comp = !is_trunc && !had_error
    auto term_reason# = string::from("completed")
    if is_trunc {
        term_reason = budget_state.truncation_reason.clone()
    } else if had_error {
        term_reason = string::from("search_error")
    }

    auto s# = string::from("{\"type\":\"summary\",\"data\":{\"complete\":")
    if is_comp { s#.push_str("true") } else { s#.push_str("false") }
    s#.push_str(",\"truncated\":")
    if is_trunc { s#.push_str("true") } else { s#.push_str("false") }
    s#.push_str(",\"had_error\":")
    if had_error { s#.push_str("true") } else { s#.push_str("false") }
    s#.push_str(",\"block_truncated\":")
    if budget_state.block_contexts_truncated > 0 { s#.push_str("true") } else { s#.push_str("false") }
    s#.push_str(",\"termination_reason\":\"")
    s#.push_str(term_reason.as_str())
    s#.push_str("\",\"limits\":{\"max_total_matches\":")
    if budget_state.limits.max_total_matches_enabled {
        s#.push_str(u64_to_string(budget_state.limits.max_total_matches as u64).as_str())
    } else {
        s#.push_str("null")
    }
    s#.push_str(",\"max_result_bytes\":")
    if budget_state.limits.max_result_bytes_enabled {
        s#.push_str(u64_to_string(budget_state.limits.max_result_bytes as u64).as_str())
    } else {
        s#.push_str("null")
    }
    s#.push_str(",\"max_files_with_matches\":")
    if budget_state.limits.max_files_with_matches_enabled {
        s#.push_str(u64_to_string(budget_state.limits.max_files_with_matches as u64).as_str())
    } else {
        s#.push_str("null")
    }
    s#.push_str("},\"stats\":{\"elapsed_total\":{\"secs\":0,\"nanos\":0},\"files_selected\":")
    s#.push_str(u64_to_string(budget_state.files_selected as u64).as_str())
    s#.push_str(",\"files_scanned\":")
    s#.push_str(u64_to_string(budget_state.files_scanned as u64).as_str())
    s#.push_str(",\"file_scan_passes\":")
    s#.push_str(u64_to_string(budget_state.file_scan_passes as u64).as_str())
    s#.push_str(",\"files_with_match_observed\":")
    s#.push_str(u64_to_string(budget_state.files_with_match_observed as u64).as_str())
    s#.push_str(",\"files_with_match_emitted\":")
    s#.push_str(u64_to_string(budget_state.files_with_match_emitted as u64).as_str())
    s#.push_str(",\"matched_lines_observed\":")
    s#.push_str(u64_to_string(budget_state.matched_lines_observed as u64).as_str())
    s#.push_str(",\"matched_lines_emitted\":")
    s#.push_str(u64_to_string(budget_state.matched_lines_emitted as u64).as_str())
    s#.push_str(",\"submatches_emitted\":")
    s#.push_str(u64_to_string(budget_state.submatches_emitted as u64).as_str())
    s#.push_str(",\"result_payload_bytes_emitted\":")
    s#.push_str(u64_to_string(budget_state.result_payload_bytes_emitted as u64).as_str())
    s#.push_str(",\"protocol_bytes_emitted\":")
    s#.push_str(u64_to_string(protocol_bytes as u64).as_str())
    s#.push_str(",\"stdout_bytes_emitted\":")
    s#.push_str(u64_to_string(stdout_bytes as u64).as_str())
    s#.push_str(",\"searches\":")
    s#.push_str(u64_to_string(stats.total_files as u64).as_str())
    s#.push_str(",\"searches_with_match\":")
    s#.push_str(u64_to_string(stats.files_with_match as u64).as_str())
    s#.push_str(",\"matches\":")
    s#.push_str(u64_to_string(stats.total_matches as u64).as_str())
    s#.push_str(",\"block_contexts_truncated\":")
    s#.push_str(u64_to_string(budget_state.block_contexts_truncated as u64).as_str())
    s#.push_str("},\"stopped_at\":")
    if is_trunc && budget_state.stopped_path.len() > 0 {
        s#.push_str("{\"path\":\"")
        auto esc_p = json_escape(budget_state.stopped_path.as_str())
        s#.push_str(esc_p.as_str())
        s#.push_str("\",\"line_number\":")
        s#.push_str(u64_to_string(budget_state.stopped_line_num as u64).as_str())
        s#.push_str("}")
    } else {
        s#.push_str("null")
    }
    s#.push_str("}}\n")
    return cede s
}

pub fn format_summary_json_compact(
    stats: GlobalStats,
    budget_state: BudgetState,
    had_error: bool
) -> string {
    auto is_trunc = budget_state.is_truncated
    auto is_comp = !is_trunc && !had_error
    auto term_reason# = string::from("completed")
    if is_trunc {
        term_reason = budget_state.truncation_reason.clone()
    } else if had_error {
        term_reason = string::from("search_error")
    }
    auto s# = string::from("{\"type\":\"summary\",\"complete\":")
    if is_comp { s#.push_str("true") } else { s#.push_str("false") }
    s#.push_str(",\"truncated\":")
    if is_trunc { s#.push_str("true") } else { s#.push_str("false") }
    s#.push_str(",\"had_error\":")
    if had_error { s#.push_str("true") } else { s#.push_str("false") }
    s#.push_str(",\"reason\":\"")
    s#.push_str(term_reason.as_str())
    s#.push_str("\",\"matches_emitted\":")
    s#.push_str(u64_to_string(budget_state.matched_lines_emitted as u64).as_str())
    s#.push_str(",\"files_emitted\":")
    s#.push_str(u64_to_string(budget_state.files_with_match_emitted as u64).as_str())
    s#.push_str(",\"files_observed\":")
    s#.push_str(u64_to_string(budget_state.files_with_match_observed as u64).as_str())
    s#.push_str(",\"files_scanned\":")
    s#.push_str(u64_to_string(budget_state.files_scanned as u64).as_str())
    s#.push_str(",\"file_scan_passes\":")
    s#.push_str(u64_to_string(budget_state.file_scan_passes as u64).as_str())
    s#.push_str(",\"block_truncated\":")
    if budget_state.block_contexts_truncated > 0 { s#.push_str("true") } else { s#.push_str("false") }
    s#.push_str("}\n")
    return cede s
}

pub fn format_summary_json(
    stats: GlobalStats,
    budget_state: BudgetState,
    had_error: bool
) -> string {
    auto p_prior = budget_state.protocol_bytes_emitted
    auto r_emitted = budget_state.result_payload_bytes_emitted

    // Fixed-point iteration to include summary string length in protocol_bytes_emitted and stdout_bytes_emitted
    auto guess_len# = 400:usize
    auto s# = string::new()
    auto iter# = 0:usize
    loop iter < 5:usize {
        auto p_test = p_prior + guess_len
        auto stdout_test = r_emitted + p_test
        s = format_summary_json_raw(stats, budget_state, had_error, p_test, stdout_test)
        if s.len() == guess_len {
            break
        }
        guess_len = s.len()
        iter = iter + 1
    }
    return cede s
}

pub fn print_summary_json(stats: GlobalStats) -> i32 {
    auto default_limits = BudgetLimits::new()
    auto default_budget = BudgetState::new(default_limits)
    auto s = format_summary_json(stats, default_budget, false)
    return posix_write_stdout(s.as_str())
}

pub fn print_truncation_notice_stderr(budget_state: BudgetState) {
    if !budget_state.is_truncated || budget_state.limits.no_truncation_notice {
        return
    }
    auto msg# = string::from("search stopped early: ")
    msg#.push_str(budget_state.truncation_reason.as_str())
    msg#.push_str(" limit reached (additional matches may exist)")
    print_err(msg.as_str())
}

pub fn print_files_list(files: Vec<string>) -> i32 {
    auto num_files = files.len()
    auto i# = 0:usize
    loop i < num_files {
        auto &path_str = files.borrow(i)
        auto res = write_line(path_str.as_str())
        if res != 0 {
            return res
        }
        i = i + 1
    }
    return 0
}

pub fn format_mcp_structured_match(ev: MatchEvent) -> string {
    auto rec# = string::from("{\"kind\":\"match\",\"group_id\":")
    rec#.push_str(u64_to_string(ev.group_id as u64).as_str())
    rec#.push_str(",\"path\":\"")
    rec#.push_str(json_escape(ev.path.as_str()).as_str())
    rec#.push_str("\",\"line_number\":")
    rec#.push_str(u64_to_string(ev.line_number as u64).as_str())
    rec#.push_str(",\"absolute_offset\":")
    rec#.push_str(u64_to_string(ev.absolute_offset as u64).as_str())
    rec#.push_str(",\"text\":\"")
    rec#.push_str(json_escape(ev.line_text.as_str()).as_str())
    rec#.push_str("\",\"submatches\":[")
    auto i# = 0:usize
    loop i < ev.submatches.len() {
        if i > 0 { rec#.push_str(",") }
        auto &sm = ev.submatches.borrow(i)
        rec#.push_str("{\"match_text\":\"")
        rec#.push_str(json_escape(sm.match_text.as_str()).as_str())
        rec#.push_str("\",\"start\":")
        rec#.push_str(u64_to_string(sm.start as u64).as_str())
        rec#.push_str(",\"end\":")
        rec#.push_str(u64_to_string(sm.end as u64).as_str())
        rec#.push_str("}")
        i = i + 1
    }
    rec#.push_str("],\"scope\":")
    if ev.scope_name.len() > 0 {
        rec#.push_str("\"")
        rec#.push_str(json_escape(ev.scope_name.as_str()).as_str())
        rec#.push_str("\"")
    } else {
        rec#.push_str("null")
    }
    rec#.push_str(",\"block_truncated\":")
    if ev.block_truncated {
        rec#.push_str("true}")
    } else {
        rec#.push_str("false}")
    }
    return cede rec
}

pub fn format_mcp_structured_context(ev: MatchEvent) -> string {
    auto rec# = string::from("{\"kind\":\"context\",\"group_id\":")
    rec#.push_str(u64_to_string(ev.group_id as u64).as_str())
    rec#.push_str(",\"path\":\"")
    rec#.push_str(json_escape(ev.path.as_str()).as_str())
    rec#.push_str("\",\"line_number\":")
    rec#.push_str(u64_to_string(ev.line_number as u64).as_str())
    rec#.push_str(",\"absolute_offset\":")
    rec#.push_str(u64_to_string(ev.absolute_offset as u64).as_str())
    rec#.push_str(",\"text\":\"")
    rec#.push_str(json_escape(ev.line_text.as_str()).as_str())
    rec#.push_str("\",\"block_truncated\":")
    if ev.block_truncated {
        rec#.push_str("true}")
    } else {
        rec#.push_str("false}")
    }
    return cede rec
}
