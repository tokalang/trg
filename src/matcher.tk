// SearchPlan, MatchDecision, and unified match evaluation for trg.
import core/option::{Option}
import core/result::{Result}
import std/vec::{Vec}
import official/regex::{Regex, RegexOptions, RegexAnalysis, CompiledRegex, RegexError}
import src/types::{CliOptions, MatchRange, MatchDecision, CaseMode, SearchDiagnostic}

pub shape LiteralMatcher (
    needles: Vec<string>,
    ignore_case: bool,
    word_regexp: bool,
    line_regexp: bool
)

pub shape RegexMatcher (
    compiled: CompiledRegex,
    required_literal: Option<string>,
    alternation_literals: Option<Vec<string>>,
    no_prefilter: bool,
    is_empty_plan: bool
)

pub shape SearchPlan (
    Literal(LiteralMatcher) = 0 |
    RegexPlan(RegexMatcher) = 1
)

fn is_pure_regex_literal(s: str) -> bool {
    if s.len == 0 { return false }
    auto i# = 0:usize
    loop i < s.len {
        auto c = s.byte_at(i)
        if c == ('\\' as char) || c == ('.' as char) || c == ('*' as char) ||
           c == ('+' as char) || c == ('?' as char) || c == ('(' as char) ||
           c == (')' as char) || c == ('[' as char) || c == (']' as char) ||
           c == ('{' as char) || c == ('}' as char) || c == ('^' as char) ||
           c == ('$' as char) || c == ('|' as char) {
            return false
        }
        i = i + 1:usize
    }
    return true
}

fn extract_alternation_literals(pattern: str) -> Option<Vec<string>> {
    auto pat# = pattern.trim()
    if pat.len == 0 { return Option<Vec<string>>::None }

    if pat.starts_with("(") && pat.ends_with(")") {
        auto depth# = 0:usize
        auto all_enclosed# = true
        auto k# = 0:usize
        loop k < pat.len - 1:usize {
            auto c = pat.byte_at(k)
            if c == ('(' as char) { depth = depth + 1:usize }
            else if c == (')' as char) {
                if depth > 0:usize { depth = depth - 1:usize }
                if depth == 0:usize {
                    all_enclosed = false
                    break
                }
            }
            k = k + 1:usize
        }
        if all_enclosed {
            pat = pat.substr(1:usize, pat.len - 2:usize).trim()
        }
    }

    auto alts# = Vec<string>::new()
    auto cur_part# = string::new()
    auto p_depth# = 0:usize
    auto i# = 0:usize
    loop i < pat.len {
        auto c = pat.byte_at(i)
        if c == ('\\' as char) && i + 1:usize < pat.len {
            return Option<Vec<string>>::None
        }
        if c == ('(' as char) {
            p_depth = p_depth + 1:usize
        } else if c == (')' as char) {
            if p_depth > 0:usize { p_depth = p_depth - 1:usize }
        } else if c == ('|' as char) && p_depth == 0:usize {
            if !is_pure_regex_literal(cur_part.as_str()) {
                return Option<Vec<string>>::None
            }
            alts#.push(cur_part.clone())
            cur_part#.clear()
            i = i + 1:usize
            continue
        }
        cur_part#.push_char(c)
        i = i + 1:usize
    }

    if !is_pure_regex_literal(cur_part.as_str()) {
        return Option<Vec<string>>::None
    }
    alts#.push(cur_part.clone())

    if alts.len() > 1:usize {
        return Option<Vec<string>>::Some(cede alts)
    }
    return Option<Vec<string>>::None
}

fn is_ascii_word_byte(b: u8) -> bool {
    return (b >= 'a' as u8 && b <= 'z' as u8) ||
           (b >= 'A' as u8 && b <= 'Z' as u8) ||
           (b >= '0' as u8 && b <= '9' as u8) ||
           (b == '_' as u8)
}

fn index_of_str_ascii_case(haystack: str, needle: str) -> Option<usize> {
    if needle.len == 0 { return Option<usize>::Some(0:usize) }
    if needle.len > haystack.len { return Option<usize>::None }

    auto max_i = haystack.len - needle.len
    auto i# = 0:usize
    loop i <= max_i {
        auto sub = haystack.substr(i, needle.len)
        if sub.eq_ignore_ascii_case(needle) {
            return Option<usize>::Some(i)
        }
        i = i + 1
    }
    return Option<usize>::None
}

impl LiteralMatcher {
    pub fn is_match(self, line: str) -> bool {
        auto num_needles = self.needles.len()
        if num_needles == 0 { return false }

        auto k# = 0:usize
        loop k < num_needles {
            auto &needle_str = self.needles.borrow(k)
            auto needle = needle_str.as_str()

            if needle.len == 0 {
                if !self.line_regexp || line.len == 0 {
                    return true
                }
                k = k + 1
                continue
            }

            // Fast path: no word boundary and no whole-line boundary
            if !self.word_regexp && !self.line_regexp {
                auto hit# = false
                if self.ignore_case {
                    hit = index_of_str_ascii_case(line, needle).is_some()
                } else {
                    hit = line.index_of_str(needle).is_some()
                }
                if hit { return true }
                k = k + 1
                continue
            }

            // Boundary-aware search loop
            auto offset# = 0:usize
            loop offset <= line.len {
                if offset + needle.len > line.len { break }
                auto rem = line.substr(offset, line.len - offset)
                auto found_opt# = Option<usize>::None
                if self.ignore_case {
                    found_opt = index_of_str_ascii_case(rem, needle)
                } else {
                    found_opt = rem.index_of_str(needle)
                }

                if found_opt.is_none() { break }
                auto match_idx = found_opt.unwrap()
                auto start = offset + match_idx
                auto end = start + needle.len

                auto valid# = true
                if self.word_regexp {
                    auto prev_is_word = start > 0 && is_ascii_word_byte(line.byte_at(start - 1:usize) as u8)
                    auto next_is_word = end < line.len && is_ascii_word_byte(line.byte_at(end) as u8)
                    if prev_is_word || next_is_word {
                        valid = false
                    }
                }

                if self.line_regexp {
                    if start != 0 || end != line.len {
                        valid = false
                    }
                }

                if valid {
                    return true
                }

                offset = start + 1
                if needle.len == 0 { break }
            }

            k = k + 1
        }

        return false
    }

    pub fn evaluate(self, line: str) -> MatchDecision {
        auto ranges# = Vec<MatchRange>::new()
        auto num_needles = self.needles.len()

        if num_needles == 0 {
            return MatchDecision(matched = false, ranges = cede ranges)
        }

        if line.len == 0 {
            auto i# = 0:usize
            loop i < num_needles {
                if self.needles.borrow(i).len() == 0 {
                    ranges#.push(MatchRange(start = 0:usize, end = 0:usize))
                    return MatchDecision(matched = true, ranges = cede ranges)
                }
                i = i + 1
            }
            return MatchDecision(matched = false, ranges = cede ranges)
        }

        auto offset# = 0:usize
        loop offset <= line.len {
            auto best_start# = line.len + 1:usize
            auto best_len# = 0:usize
            auto best_found# = false

            auto k# = 0:usize
            loop k < num_needles {
                auto &needle_str = self.needles.borrow(k)
                auto needle = needle_str.as_str()

                if needle.len == 0 {
                    if !self.line_regexp || line.len == 0 {
                        if offset < best_start {
                            best_start = offset
                            best_len = 0:usize
                            best_found = true
                        }
                    }
                    k = k + 1
                    continue
                }

                auto scan# = offset
                loop scan + needle.len <= line.len {
                    if scan >= best_start { break }
                    auto rem = line.substr(scan, line.len - scan)
                    auto found_opt# = Option<usize>::None
                    if self.ignore_case {
                        found_opt = index_of_str_ascii_case(rem, needle)
                    } else {
                        found_opt = rem.index_of_str(needle)
                    }

                    if found_opt.is_none() { break }
                    auto match_idx = found_opt.unwrap()
                    auto start = scan + match_idx
                    auto end = start + needle.len

                    if start >= best_start { break }

                    auto valid# = true
                    if self.word_regexp {
                        auto prev_is_word = start > 0 && is_ascii_word_byte(line.byte_at(start - 1:usize) as u8)
                        auto next_is_word = end < line.len && is_ascii_word_byte(line.byte_at(end) as u8)
                        if prev_is_word || next_is_word {
                            valid = false
                        }
                    }

                    if self.line_regexp {
                        if start != 0 || end != line.len {
                            valid = false
                        }
                    }

                    if valid {
                        if start < best_start {
                            best_start = start
                            best_len = needle.len
                            best_found = true
                        }
                        break
                    }

                    scan = start + 1
                }

                k = k + 1
            }

            if !best_found { break }

            ranges#.push(MatchRange(start = best_start, end = best_start + best_len))
            if best_len == 0 {
                offset = best_start + 1
            } else {
                offset = best_start + best_len
            }
        }

        auto is_match = ranges.len() > 0
        return MatchDecision(matched = is_match, ranges = cede ranges)
    }
}

impl RegexMatcher {
    pub fn is_match(self, line: str) -> bool {
        if self.is_empty_plan { return false }

        // Line-level conservative Required Literal Prefilter
        if !self.no_prefilter {
            match self.required_literal {
                auto Option<string>::Some(&req_lit) => {
                    auto req_str = req_lit.as_str()
                    if req_str.len > 0 {
                        auto prefilter_hit# = false
                        if self.compiled.options().ignore_ascii_case {
                            prefilter_hit = index_of_str_ascii_case(line, req_str).is_some()
                        } else {
                            prefilter_hit = line.index_of_str(req_str).is_some()
                        }
                        if !prefilter_hit {
                            return false
                        }
                    }
                }
                _ => {
                    match self.alternation_literals {
                        auto Option<Vec<string>>::Some(&alts) => {
                            auto any_hit# = false
                            auto ai# = 0:usize
                            loop ai < alts.len() {
                                auto alt_str = alts.borrow(ai).as_str()
                                auto hit# = false
                                if self.compiled.options().ignore_ascii_case {
                                    hit = index_of_str_ascii_case(line, alt_str).is_some()
                                } else {
                                    hit = line.index_of_str(alt_str).is_some()
                                }
                                if hit {
                                    any_hit = true
                                    break
                                }
                                ai = ai + 1
                            }
                            if !any_hit {
                                return false
                            }
                        }
                        _ => {}
                    }
                }
            }
        }

        return self.compiled.is_match(line)
    }

    pub fn evaluate(self, line: str) -> MatchDecision {
        if self.is_empty_plan {
            return MatchDecision(matched = false, ranges = Vec<MatchRange>::new())
        }

        // Line-level conservative Required Literal Prefilter
        if !self.no_prefilter {
            match self.required_literal {
                auto Option<string>::Some(&req_lit) => {
                    auto req_str = req_lit.as_str()
                    if req_str.len > 0 {
                        auto prefilter_hit# = false
                        if self.compiled.options().ignore_ascii_case {
                            prefilter_hit = index_of_str_ascii_case(line, req_str).is_some()
                        } else {
                            prefilter_hit = line.index_of_str(req_str).is_some()
                        }
                        if !prefilter_hit {
                            return MatchDecision(matched = false, ranges = Vec<MatchRange>::new())
                        }
                    }
                }
                _ => {
                    match self.alternation_literals {
                        auto Option<Vec<string>>::Some(&alts) => {
                            auto any_hit# = false
                            auto ai# = 0:usize
                            loop ai < alts.len() {
                                auto alt_str = alts.borrow(ai).as_str()
                                auto hit# = false
                                if self.compiled.options().ignore_ascii_case {
                                    hit = index_of_str_ascii_case(line, alt_str).is_some()
                                } else {
                                    hit = line.index_of_str(alt_str).is_some()
                                }
                                if hit {
                                    any_hit = true
                                    break
                                }
                                ai = ai + 1
                            }
                            if !any_hit {
                                return MatchDecision(matched = false, ranges = Vec<MatchRange>::new())
                            }
                        }
                        _ => {}
                    }
                }
            }
        }

        auto matches = self.compiled.find_all(line)
        auto ranges# = Vec<MatchRange>::new()
        auto i# = 0:usize
        loop i < matches.len() {
            auto m = matches.get(i)
            ranges#.push(MatchRange(start = m.start_offset(), end = m.end_offset()))
            i = i + 1:usize
        }

        auto is_match = ranges.len() > 0
        return MatchDecision(matched = is_match, ranges = cede ranges)
    }
}

fn has_ascii_uppercase(s: str) -> bool {
    auto i# = 0:usize
    loop i < s.len {
        auto ch = s.byte_at(i)
        if ch >= ('A' as char) && ch <= ('Z' as char) {
            return true
        }
        i = i + 1
    }
    return false
}

fn has_regex_uppercase_literal(s: str) -> bool {
    auto i# = 0:usize
    loop i < s.len {
        auto ch = s.byte_at(i)
        if ch == ('\\' as char) {
            i = i + 1
            if i < s.len {
                auto esc = s.byte_at(i)
                if esc == ('S' as char) || esc == ('D' as char) || esc == ('W' as char) ||
                   esc == ('B' as char) || esc == ('A' as char) || esc == ('Z' as char) ||
                   esc == ('s' as char) || esc == ('d' as char) || esc == ('w' as char) ||
                   esc == ('b' as char) || esc == ('n' as char) || esc == ('r' as char) ||
                   esc == ('t' as char) || esc == ('v' as char) || esc == ('f' as char) ||
                   esc == ('\\' as char) {
                    i = i + 1
                    continue
                }
                if esc == ('x' as char) {
                    i = i + 1
                    if i < s.len { i = i + 1 }
                    if i < s.len { i = i + 1 }
                    continue
                }
                if esc == ('u' as char) {
                    i = i + 1
                    if i < s.len { i = i + 1 }
                    if i < s.len { i = i + 1 }
                    if i < s.len { i = i + 1 }
                    if i < s.len { i = i + 1 }
                    continue
                }
                if esc >= ('A' as char) && esc <= ('Z' as char) {
                    return true
                }
                i = i + 1
                continue
            }
            break
        }
        if ch >= ('A' as char) && ch <= ('Z' as char) {
            return true
        }
        i = i + 1
    }
    return false
}

fn resolve_multi_ignore_case(patterns: Vec<string>, mode: CaseMode, is_regex: bool) -> bool {
    match mode {
        auto CaseMode::Sensitive => { return false }
        auto CaseMode::Insensitive => { return true }
        auto CaseMode::Smart => {
            auto i# = 0:usize
            loop i < patterns.len() {
                auto pat = patterns.borrow(i).as_str()
                if is_regex {
                    if has_regex_uppercase_literal(pat) {
                        return false
                    }
                } else {
                    if has_ascii_uppercase(pat) {
                        return false
                    }
                }
                i = i + 1
            }
            return true
        }
    }
}

impl SearchPlan {
    pub fn create(opts: CliOptions) -> Result<SearchPlan, SearchDiagnostic> {
        auto eff_ignore_case = resolve_multi_ignore_case(opts.patterns, opts.case_mode, opts.regexp)
        auto num_pats = opts.patterns.len()

        if opts.regexp {
            auto regex_opts = RegexOptions(
                ignore_ascii_case = eff_ignore_case,
                word_regexp = opts.word_regexp,
                line_regexp = opts.line_regexp
            )

            if num_pats == 0 {
                auto dummy_regex = Regex::compile_with_options("a^", regex_opts).unwrap()
                return Result<SearchPlan, SearchDiagnostic>::Ok(SearchPlan::RegexPlan(RegexMatcher(
                    compiled = cede dummy_regex,
                    required_literal = Option<string>::None,
                    alternation_literals = Option<Vec<string>>::None,
                    no_prefilter = opts.no_prefilter,
                    is_empty_plan = true
                )))
            }

            auto combined_regex_str# = string::new()
            if num_pats == 1 {
                combined_regex_str = opts.patterns.borrow(0).clone()
            } else {
                auto p_idx# = 0:usize
                loop p_idx < num_pats {
                    if p_idx > 0 {
                        combined_regex_str#.push_str("|")
                    }
                    combined_regex_str#.push_str("(")
                    combined_regex_str#.push_str(opts.patterns.borrow(p_idx).as_str())
                    combined_regex_str#.push_str(")")
                    p_idx = p_idx + 1
                }
            }

            auto compile_res = Regex::compile_with_options(combined_regex_str.as_str(), regex_opts)
            if compile_res.is_err() {
                auto err = compile_res.unwrap_err()
                auto kind = string::from("regex")
                auto path = Option<string>::None
                auto message = err.message()
                auto code = Option<string>::Some(string::from("INVALID_REGEX"))
                auto hint = Option<string>::Some(string::from("fix the regex syntax; if literal text was intended, use -F (--fixed-strings)"))
                return Result<SearchPlan, SearchDiagnostic>::Err(SearchDiagnostic::with_code_hint(
                    cede kind,
                    cede path,
                    cede message,
                    Option<i32>::None,
                    cede code,
                    cede hint
                ))
            }
            auto compiled = compile_res.unwrap()
            auto required# = Option<string>::None
            if num_pats == 1 {
                required = compiled.required_literal()
            }
            auto alts_opt# = Option<Vec<string>>::None
            if required.is_none() {
                if num_pats == 1 {
                    alts_opt = extract_alternation_literals(opts.patterns.borrow(0).as_str())
                } else {
                    auto all_lits# = true
                    auto multi_alts# = Vec<string>::new()
                    auto pi# = 0:usize
                    loop pi < num_pats {
                        auto p_str = opts.patterns.borrow(pi).as_str()
                        if is_pure_regex_literal(p_str) {
                            multi_alts#.push(string::from(p_str))
                        } else {
                            all_lits = false
                            break
                        }
                        pi = pi + 1
                    }
                    if all_lits && multi_alts.len() > 1:usize {
                        alts_opt = Option<Vec<string>>::Some(cede multi_alts)
                    }
                }
            }
            return Result<SearchPlan, SearchDiagnostic>::Ok(SearchPlan::RegexPlan(RegexMatcher(
                compiled = cede compiled,
                required_literal = cede required,
                alternation_literals = cede alts_opt,
                no_prefilter = opts.no_prefilter,
                is_empty_plan = false
            )))
        }

        return Result<SearchPlan, SearchDiagnostic>::Ok(SearchPlan::Literal(LiteralMatcher(
            needles = opts.patterns.clone(),
            ignore_case = eff_ignore_case,
            word_regexp = opts.word_regexp,
            line_regexp = opts.line_regexp
        )))
    }

    pub fn is_match(self, line: str) -> bool {
        match self {
            auto SearchPlan::Literal(lit) => {
                return lit.is_match(line)
            }
            auto SearchPlan::RegexPlan(reg) => {
                return reg.is_match(line)
            }
        }
    }

    pub fn find_matches(self, line: str) -> MatchDecision {
        match self {
            auto SearchPlan::Literal(lit) => {
                return lit.evaluate(line)
            }
            auto SearchPlan::RegexPlan(reg) => {
                return reg.evaluate(line)
            }
        }
    }

    pub fn evaluate(self, line: str) -> MatchDecision {
        return self.find_matches(line)
    }
}
