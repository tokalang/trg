// src/hints.tk
// Result-Driven Lightweight Hint Layer for trg CLI

import core/str::{str}
import src/posix::{posix_write_stderr, is_windows_target}
import src/types::{CliOptions, Hint, CaseMode, SearchReport}
import src/printer::{u64_to_string}

pub fn shell_quote(s: str) -> string {
    if s.len == 0 {
        return string::from("''")
    }
    auto res# = string::new()
    res#.push_char('\'')
    auto is_win = is_windows_target()
    auto i# = 0:usize
    loop i < s.len {
        auto ch = s.byte_at(i) as char
        if ch == ('\'' as char) {
            if is_win {
                res#.push_str("''")
            } else {
                res#.push_str("'\\''")
            }
        } else {
            res#.push_char(ch)
        }
        i = i + 1:usize
    }
    res#.push_char('\'')
    return cede res
}

pub shape HintSlot (
    emitted#: bool
)

impl HintSlot {
    pub fn new() -> HintSlot {
        return HintSlot(emitted = false)
    }

    pub fn can_emit(self, no_hints: bool) -> bool {
        if no_hints || self.emitted {
            return false
        }
        return true
    }

    pub fn try_emit(self#, no_hints: bool, message: str, cmd_opt: Option<str>) -> bool {
        if !self.can_emit(no_hints) {
            return false
        }
        auto out# = string::new()
        out#.push_str("hint: ")
        out#.push_str(message)
        match cmd_opt {
            auto Option<str>::Some(&cmd) => {
                out#.push_str("\n  $ ")
                out#.push_str(cmd)
            }
            auto Option<str>::None => {}
        }
        out#.push_str("\n")
        if out.len() > 1024:usize {
            return false
        }
        posix_write_stderr(out.as_str())
        self.emitted = true
        return true
    }
}

pub fn is_single_hit_hint_eligible(opts: CliOptions, report: SearchReport) -> bool {
    if opts.no_hints {
        return false
    }
    if opts.patterns.len() != 1:usize {
        return false
    }
    if opts.patterns.borrow(0).len() == 0 {
        return false
    }
    if opts.only_matching ||
       opts.quiet ||
       opts.count ||
       opts.files_with_matches ||
       opts.files_mode ||
       opts.type_list_only ||
       opts.json_mode ||
       opts.json_compact ||
       opts.mcp_mode ||
       opts.invert_match ||
       opts.max_count_enabled ||
       opts.code_only ||
       opts.symbol_variants ||
       opts.group_by_scope ||
       opts.snippet {
        return false
    }
    if opts.globs.len() > 0:usize ||
       opts.include_types.len() > 0:usize ||
       opts.exclude_types.len() > 0:usize ||
       opts.include_type_exts.len() > 0:usize ||
       opts.exclude_type_exts.len() > 0:usize {
        return false
    }
    if opts.before_context > 0 ||
       opts.after_context > 0 ||
       opts.context_block ||
       opts.scope {
        return false
    }
    if report.had_error ||
       report.is_broken_pipe ||
       report.budget_state.is_truncated ||
       report.budget_state.single_hit_disqualified {
        return false
    }
    if report.budget_state.matched_lines_observed != 1:usize ||
       report.budget_state.matched_lines_emitted != 1:usize {
        return false
    }
    if report.budget_state.files_with_match_observed != 1:usize ||
       report.budget_state.files_with_match_emitted != 1:usize {
        return false
    }
    if report.budget_state.single_hit_candidate_path.len() == 0 {
        return false
    }
    return true
}

pub fn build_single_hit_hint(opts: CliOptions, candidate_path: str) -> Option<Hint> {
    if opts.patterns.len() != 1:usize || candidate_path.len == 0 {
        return Option<Hint>::None
    }
    auto pat_str = opts.patterns.borrow(0).as_str()
    if pat_str.len == 0 {
        return Option<Hint>::None
    }

    auto cmd# = string::from("trg -n")
    if opts.fixed_strings {
        cmd#.push_str(" -F")
    }
    match opts.case_mode {
        auto CaseMode::Insensitive => {
            cmd#.push_str(" -i")
        }
        auto CaseMode::Smart => {
            cmd#.push_str(" -S")
        }
        _ => {}
    }
    if opts.word_regexp {
        cmd#.push_str(" -w")
    }
    if opts.line_regexp {
        cmd#.push_str(" -x")
    }
    cmd#.push_str(" -C 5 --scope --max-bytes 8K -e ")
    cmd#.push_str(shell_quote(pat_str).as_str())
    cmd#.push_str(" -- ")
    cmd#.push_str(shell_quote(candidate_path).as_str())

    return Option<Hint>::Some(Hint(
        kind = string::from("single_hit_enhancement"),
        message = string::from("to inspect enclosing symbol and context, run:"),
        command = cede cmd
    ))
}

pub fn build_symbol_preview_truncation_hint(
    path: str,
    next_start: usize,
    next_end: usize,
    max_lines_opt: Option<usize>,
    max_bytes_opt: Option<usize>,
    is_following: bool
) -> Option<Hint> {
    if next_end < next_start || path.len == 0 {
        return Option<Hint>::None
    }
    auto msg# = string::new()
    if is_following {
        msg#.push_str("to view unshown lines following this section under budget, run:")
    } else {
        msg#.push_str("to view unshown lines preceding this section under budget, run:")
    }

    auto cmd# = string::from("trg view ")
    cmd#.push_str(shell_quote(path).as_str())
    cmd#.push_str(" --lines ")
    cmd#.push_str(u64_to_string(next_start as u64).as_str())
    cmd#.push_str("-")
    cmd#.push_str(u64_to_string(next_end as u64).as_str())
    match max_lines_opt {
        auto Option<usize>::Some(ml) => {
            cmd#.push_str(" --max-lines ")
            cmd#.push_str(u64_to_string(ml as u64).as_str())
        }
        _ => {}
    }
    match max_bytes_opt {
        auto Option<usize>::Some(mb) => {
            cmd#.push_str(" --max-bytes ")
            cmd#.push_str(u64_to_string(mb as u64).as_str())
        }
        _ => {}
    }

    return Option<Hint>::Some(Hint(
        kind = string::from("symbol_preview_truncation"),
        message = cede msg,
        command = cede cmd
    ))
}
