// Shared numeric and byte size parsers for trg.
import core/types::{usize, char}
import core/str::{str}

pub fn parse_usize_strict(s: str, option_name: str) -> Result<usize, string> {
    if s.len == 0 {
        auto err# = string::from("Value for ")
        err#.push_str(option_name)
        err#.push_str(" cannot be empty")
        return Result<usize, string>::Err(cede err)
    }
    auto val# = 0:usize
    auto i# = 0:usize
    loop i < s.len {
        auto ch = s.byte_at(i)
        if ch < ('0' as char) || ch > ('9' as char) {
            auto err# = string::from("Invalid integer value '")
            err#.push_str(s)
            err#.push_str("' for ")
            err#.push_str(option_name)
            return Result<usize, string>::Err(cede err)
        }
        auto digit = (ch as usize) - ('0' as usize)
        if val > (9223372036854775807:usize - digit) / 10:usize {
            auto err# = string::from("Value '")
            err#.push_str(s)
            err#.push_str("' for ")
            err#.push_str(option_name)
            err#.push_str(" exceeds maximum integer limit")
            return Result<usize, string>::Err(cede err)
        }
        val = val * 10:usize + digit
        i = i + 1
    }
    return Result<usize, string>::Ok(val)
}

fn to_lower_char(c: char) -> char {
    if c >= ('A' as char) && c <= ('Z' as char) {
        return ((c as usize) + 32:usize) as char
    }
    return c
}

pub fn parse_size_bytes_strict(s: str, option_name: str) -> Result<usize, string> {
    if s.len == 0 {
        auto err# = string::from("Value for ")
        err#.push_str(option_name)
        err#.push_str(" cannot be empty")
        return Result<usize, string>::Err(cede err)
    }
    auto mult# = 1:usize
    auto num_len# = s.len
    if s.len >= 4 && to_lower_char(s.byte_at(s.len - 1)) == ('b' as char) && to_lower_char(s.byte_at(s.len - 2)) == ('i' as char) {
        auto unit_ch = to_lower_char(s.byte_at(s.len - 3))
        if unit_ch == ('k' as char) {
            mult = 1024:usize
            num_len = s.len - 3
        } else if unit_ch == ('m' as char) {
            mult = 1048576:usize
            num_len = s.len - 3
        } else if unit_ch == ('g' as char) {
            mult = 1073741824:usize
            num_len = s.len - 3
        }
    } else if s.len >= 3 && to_lower_char(s.byte_at(s.len - 1)) == ('b' as char) {
        auto unit_ch = to_lower_char(s.byte_at(s.len - 2))
        if unit_ch == ('k' as char) {
            mult = 1024:usize
            num_len = s.len - 2
        } else if unit_ch == ('m' as char) {
            mult = 1048576:usize
            num_len = s.len - 2
        } else if unit_ch == ('g' as char) {
            mult = 1073741824:usize
            num_len = s.len - 2
        }
    } else if s.len >= 2 {
        auto unit_ch = to_lower_char(s.byte_at(s.len - 1))
        if unit_ch == ('k' as char) {
            mult = 1024:usize
            num_len = s.len - 1
        } else if unit_ch == ('m' as char) {
            mult = 1048576:usize
            num_len = s.len - 1
        } else if unit_ch == ('g' as char) {
            mult = 1073741824:usize
            num_len = s.len - 1
        } else if unit_ch == ('b' as char) {
            mult = 1:usize
            num_len = s.len - 1
        }
    }

    if num_len == 0 {
        auto err# = string::from("Invalid size value '")
        err#.push_str(s)
        err#.push_str("' for ")
        err#.push_str(option_name)
        return Result<usize, string>::Err(cede err)
    }

    auto val# = 0:usize
    auto i# = 0:usize
    loop i < num_len {
        auto ch = s.byte_at(i)
        if ch < ('0' as char) || ch > ('9' as char) {
            auto err# = string::from("Invalid size value '")
            err#.push_str(s)
            err#.push_str("' for ")
            err#.push_str(option_name)
            return Result<usize, string>::Err(cede err)
        }
        auto digit = (ch as usize) - ('0' as usize)
        if val > (9223372036854775807:usize - digit) / 10:usize {
            auto err# = string::from("Value '")
            err#.push_str(s)
            err#.push_str("' for ")
            err#.push_str(option_name)
            err#.push_str(" exceeds maximum integer limit")
            return Result<usize, string>::Err(cede err)
        }
        val = val * 10:usize + digit
        i = i + 1
    }

    if mult > 1:usize && val > 9223372036854775807:usize / mult {
        auto err# = string::from("Value '")
        err#.push_str(s)
        err#.push_str("' for ")
        err#.push_str(option_name)
        err#.push_str(" exceeds maximum integer limit")
        return Result<usize, string>::Err(cede err)
    }

    return Result<usize, string>::Ok(val * mult)
}
