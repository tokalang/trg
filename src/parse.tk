// Shared numeric and byte size parsers for trg.
import core/types::{usize, char}
import core/str::{str}

pub fn parse_usize_strict(s: str, option_name: str) -> Result<usize, string> {
    if s.len == 0 {
        auto err# = string::from("Value for ")
        err#.push_str(option_name)
        err#.push_str(" cannot be empty")
        return Result<usize, string>::Err(cede err)
    }
    auto val# = 0:usize
    auto i# = 0:usize
    loop i < s.len {
        auto ch = s.byte_at(i)
        if ch < ('0' as char) || ch > ('9' as char) {
            auto err# = string::from("Invalid integer value '")
            err#.push_str(s)
            err#.push_str("' for ")
            err#.push_str(option_name)
            return Result<usize, string>::Err(cede err)
        }
        auto digit = (ch as usize) - ('0' as usize)
        if val > (9223372036854775807:usize - digit) / 10:usize {
            auto err# = string::from("Value '")
            err#.push_str(s)
            err#.push_str("' for ")
            err#.push_str(option_name)
            err#.push_str(" exceeds maximum integer limit")
            return Result<usize, string>::Err(cede err)
        }
        val = val * 10:usize + digit
        i = i + 1
    }
    return Result<usize, string>::Ok(val)
}

pub fn parse_size_bytes_strict(s: str, option_name: str) -> Result<usize, string> {
    if s.len == 0 {
        auto err# = string::from("Value for ")
        err#.push_str(option_name)
        err#.push_str(" cannot be empty")
        return Result<usize, string>::Err(cede err)
    }
    auto mult# = 1:usize
    auto num_len# = s.len
    auto last_ch = s.byte_at(s.len - 1)
    if last_ch == ('k' as char) || last_ch == ('K' as char) {
        mult = 1024:usize
        num_len = s.len - 1
    } else if last_ch == ('m' as char) || last_ch == ('M' as char) {
        mult = 1048576:usize
        num_len = s.len - 1
    }

    if num_len == 0 {
        auto err# = string::from("Invalid size value '")
        err#.push_str(s)
        err#.push_str("' for ")
        err#.push_str(option_name)
        return Result<usize, string>::Err(cede err)
    }

    auto val# = 0:usize
    auto i# = 0:usize
    loop i < num_len {
        auto ch = s.byte_at(i)
        if ch < ('0' as char) || ch > ('9' as char) {
            auto err# = string::from("Invalid size value '")
            err#.push_str(s)
            err#.push_str("' for ")
            err#.push_str(option_name)
            return Result<usize, string>::Err(cede err)
        }
        auto digit = (ch as usize) - ('0' as usize)
        if val > (9223372036854775807:usize - digit) / 10:usize {
            auto err# = string::from("Value '")
            err#.push_str(s)
            err#.push_str("' for ")
            err#.push_str(option_name)
            err#.push_str(" exceeds maximum integer limit")
            return Result<usize, string>::Err(cede err)
        }
        val = val * 10:usize + digit
        i = i + 1
    }

    if mult > 1:usize && val > 9223372036854775807:usize / mult {
        auto err# = string::from("Value '")
        err#.push_str(s)
        err#.push_str("' for ")
        err#.push_str(option_name)
        err#.push_str(" exceeds maximum integer limit")
        return Result<usize, string>::Err(cede err)
    }

    return Result<usize, string>::Ok(val * mult)
}
